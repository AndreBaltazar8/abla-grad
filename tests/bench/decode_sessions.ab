// Usage: decode_sessions MODEL STEPS LANES [CONTEXT]
import "abla/float"
import "abla/float/text"
import "abla/integer"
import "abla/io"
import "abla/process/arguments"
import "abla/process/time"
import "../../src/backend/backend.ab"
import "../../src/backend/cuda.ab"
import "../../src/gguf/reader.ab"
import "../../src/model/inkling.ab"
import "../../src/model/inkling_config.ab"
import "../../src/model/decode_batch.ab"

private fun seedLane(var backend: Backend, model: InklingModel, lane: int): bool {
    if (!model.reset(backend)) return false
    val depth = lane * 9 + 3
    for (position in 0 until depth) {
        if (!model.forward(backend, 300 + lane * 19 + position, position)) return false
    }
    model.seed(backend, 302 + lane * 17, depth)
}

private fun laneMatches(var backend: Backend, var model: InklingModel, lane: int, count: int): bool {
    val depth = lane * 9 + 3
    val actual = model.readLog(backend, depth, count) ?? return false
    val actualNext = model.readStepWord(backend, 0) ?? return false
    val actualLogits = model.readLogits(backend) ?? return false
    val single = model.capture(backend) ?? return false
    if (!seedLane(backend, model, lane) || !model.replayMany(backend, single, count)) return false
    val expected = model.readLog(backend, depth, count) ?? return false
    val expectedNext = model.readStepWord(backend, 0) ?? return false
    val expectedLogits = model.readLogits(backend) ?? return false
    for (index in 0 until count) {
        if (actual[index] != expected[index]) {
            eprintln("lane $lane token $index: expected ${expected[index]}, got ${actual[index]}")
            return false
        }
    }
    var different = 0
    for (i in 0 until actualLogits.size) {
        if (f32ToBits(actualLogits[i]) != f32ToBits(expectedLogits[i])) different += 1
    }
    println("lane $lane: $different differences in the final logits out of ${actualLogits.size}")
    actualNext == expectedNext && different == 0
}

private fun speed(nanos: int, tokens: int): f64 = f64FromInt(tokens) * 1000000000.0 / f64FromInt(nanos)

private fun measure(var backend: Backend, var model: InklingModel, count: int, lanes: int): bool {
    val single = model.capture(backend) ?? return false
    if (!seedLane(backend, model, 0) || !backend.synchronize()) return false
    val t0 = monotonicNanoseconds()
    if (!model.replayMany(backend, single, count)) return false
    println("single: ${speed(monotonicNanoseconds() - t0, count)} tok/s")
    var models: array<InklingModel> = []
    val active: array<int> = []
    for (lane in 0 until lanes) {
        val state = model.newDecodeLane(backend, count + 64) ?? return false
        models.append(move(state))
        active.append(lane)
    }
    val batch = inklingCaptureLanes(backend, models, active) ?? return false
    for (lane in active) if (!seedLane(backend, models[lane], lane)) return false
    if (!backend.synchronize()) return false
    val t1 = monotonicNanoseconds()
    if (!models[0].replayMany(backend, batch, count)) return false
    val rate = speed(monotonicNanoseconds() - t1, count)
    println("batch $lanes: ${rate * f64FromInt(lanes)} aggregate tok/s, $rate per lane")
    for (lane in active) if (!laneMatches(backend, models[lane], lane, count)) return false
    true
}

fun main: int {
    if (processArgumentCount() < 3 || processArgumentCount() > 4) return 2
    val count = processArgument(1).parseInt() ?? 0
    val lanes = processArgument(2).parseInt() ?? 0
    val context = if (processArgumentCount() == 4) processArgument(3).parseInt() ?? 0 else count + 64
    if (count <= 0 || lanes < 2 || lanes > 4 || context < count + 64) return 2
    val file = ggufOpen(processArgument(0)) ?? return 1
    val config = inklingConfigFrom(file) ?? return 1
    var backend = cudaBackend() ?? return 1
    var model = inklingLoad(backend, file, config, context) ?? return 1
    model.useStep = true
    if (!measure(backend, model, count, lanes)) {
        eprintln("decode-sessions: ${inklingLastError()} (${cudaLastDiagnostic()})")
        return 1
    }
    0
}
