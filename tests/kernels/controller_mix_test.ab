// The rank-64 gain/forget dots use the standalone FP32 warp reduction. Check
// equivalence to the three individual launches and the mathematical result.
import "abla/float"
import "abla/math"
import "../../src/backend/backend.ab"
import "../../src/backend/cuda.ab"
import "../../src/ops.ab"
import "support.ab"

private fun referenceTanh(x: f64): f64 {
    val e = exp(2.0 * x)
    (e - 1.0) / (e + 1.0)
}

fun main: int {
    val n = 21
    val rows = 5
    val curStride = n + 2
    val msgStride = n + 3
    val gain = testSignal(n * 64, 7)
    val forget = testSignal(n * 64, 11)
    val gate = testSignal(rows * 64, 17)
    for (i in 0 until gate.size) gate[i] = gate[i] / 16.0
    val cur = testSignal(rows * curStride, 19)
    val msg = testSignal(rows * msgStride, 23)
    var backend = cudaBackend() ?? return 1
    val wg = uploadFloats(backend, gain) ?? return 1
    val wf = uploadFloats(backend, forget) ?? return 1
    val dx = uploadFloats(backend, gate) ?? return 1
    val dc = uploadFloats(backend, cur) ?? return 1
    val dm = uploadFloats(backend, msg) ?? return 1
    val g = backend.allocate(n * 4) ?? return 1
    val f = backend.allocate(n * 4) ?? return 1
    val ref = backend.allocate(rows * n * 4) ?? return 1
    val out = backend.allocate(rows * n * 4) ?? return 1
    val args = kernelArgs().pointer(wg).pointer(wf).pointer(dx).pointer(dc).u32(curStride).pointer(dm).u32(msgStride).pointer(out).u32(n).u32(rows)
    if (!backend.launch("controller_gain_forget_mix", args, [n])) return 1
    for (t in 0 until rows) {
        if (!opMatvec(backend, "f32", wg, 0, dx, t * 64 * 4, g, 0, n, 64) ||
            !opMatvec(backend, "f32", wf, 0, dx, t * 64 * 4, f, 0, n, 64) ||
            !opControlMix(backend, dc, t * curStride * 4, dm, t * msgStride * 4, g, 0, f, 0, ref, t * n * 4, n)) return 1
    }
    val separate = downloadFloats(backend, ref, rows * n) ?? return 1
    val fused = downloadFloats(backend, out, rows * n) ?? return 1
    for (t in 0 until rows) for (r in 0 until n) {
        val i = t * n + r
        if (f32ToBits(separate[i]) != f32ToBits(fused[i])) return 1
        var a = 0.0
        var b = 0.0
        for (c in 0 until 64) {
            a += f32ToF64(gain[r * 64 + c]) * f32ToF64(gate[t * 64 + c])
            b += f32ToF64(forget[r * 64 + c]) * f32ToF64(gate[t * 64 + c])
        }
        val x = f32ToF64(cur[t * curStride + r])
        val expected = x - referenceTanh(b) * x + referenceTanh(a) * f32ToF64(msg[t * msgStride + r])
        if (!(fabs(f32ToF64(fused[i]) - expected) <= 0.000001 + 0.000002 * fabs(expected))) return 1
    }
    0
}
