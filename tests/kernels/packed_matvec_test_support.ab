import "../../src/backend/backend.ab"
import "device_test_support.ab"
import "abla/float"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

// All fixtures contain three blocks per row so Q8_0 and Q6_K also
// exercise alternating row alignment. The gather fetches an interior row.
trusted fun testPackedMatvec(backend: Backend, kind: string, elements: int, blockBytes: int,
    decode: (string) -> array<f32>, gather: bool = false, indexed: bool = true): bool {
    val rows = 7
    val blocks = if (elements == 1) 97 else 3
    val cols = blocks * elements
    val rowBytes = blockBytes * blocks
    val weights = nativeByteBuffer(rows * rowBytes)
    val x = nativeByteBuffer(cols * 4)
    val y = nativeByteBuffer(rows * 4)
    val gathered = nativeByteBuffer(cols * 4)
    val wa = nativePointerAddress(weights.address)
    val xa = nativePointerAddress(x.address)
    val ya = nativePointerAddress(y.address)
    val ga = nativePointerAddress(gathered.address)
    for (byte in 0 until weights.capacity) weights.store(byte, (byte * 29 + byte / 17 * 11) & 255)
    for (block in 0 until rows * blocks) {
        val p = block * blockBytes
        // Finite, signed binary16 factors for every packed format.
        val delta = if (kind == "q6_k") p + 208 else p
        weights.store(delta, (block * 17) & 255)
        weights.store(delta + 1, if (block % 3 == 0) 0xb4 else 0x34)
        if (kind == "q4_k" || kind == "q5_k") {
            weights.store(p + 2, (block * 9) & 255)
            weights.store(p + 3, 0x28)
        }
    }
    for (col in 0 until cols) testStoreFloat(xa, col, f32FromInt((col * 17 + col / 7) % 37 - 18) / 32.0)
    val dw = backend.allocate(weights.capacity)
    val dx = backend.allocate(x.capacity)
    val dy = backend.allocate(y.capacity)
    if (dw == null || dx == null || dy == null) return false
    if (!backend.upload(dw, 0, wa, weights.capacity) ||
        !backend.upload(dx, 0, xa, x.capacity) ||
        !backend.launch("matvec_${kind}", kernelArgs().pointer(dw).pointer(dx).pointer(dy).u32(rows).u32(cols), [rows]) ||
        !backend.download(dy, 0, ya, y.capacity)) return false

    val token = 5
    if (gather) {
        val dg = backend.allocate(gathered.capacity)
        if (dg == null || !backend.launch("gather_row_${kind}",
            kernelArgs().pointer(dw).u32(token).pointer(dg).u32(cols), [cols]) ||
            !backend.download(dg, 0, ga, gathered.capacity)) return false
    }
    for (row in 0 until rows) {
        var expected = 0.0
        for (block in 0 until blocks) {
            val values = decode(testBlockBytes(wa + row * rowBytes + block * blockBytes, blockBytes))
            if (values.size != elements) return false
            for (element in 0 until elements) {
                val col = block * elements + element
                val weighted = f32ToF64(values[element])
                expected += weighted * f32ToF64(testLoadFloat(xa, col))
                if (gather && row == token &&
                    !testNear("gather_row_${kind}", col, testLoadFloat(ga, col), weighted, 0.000001, 0.000001))
                    return false
            }
        }
        if (!testNear("matvec_${kind}", row, testLoadFloat(ya, row), expected)) return false
    }
    if (!indexed) return true
    // Two experts use the first six packed rows, selected out of order.
    val expertRows = 3
    val slots = 2
    val hostKeys = nativeByteBuffer(slots * 4)
    val keys = nativePointerAddress(hostKeys.address)
    ablaUnsafeStoreU32(nativePointerFromAddress(keys), 1)
    ablaUnsafeStoreU32(nativePointerFromAddress(keys + 4), 0)
    val hostScales = testFloatBuffer([f32(0.5), f32(-2.0)])
    val deviceKeys = backend.allocate(hostKeys.capacity)
    val deviceScales = backend.allocate(hostScales.capacity)
    if (deviceKeys == null || deviceScales == null) return false
    if (!backend.upload(deviceKeys, 0, keys, hostKeys.capacity) ||
        !backend.upload(deviceScales, 0, nativePointerAddress(hostScales.address), hostScales.capacity) ||
        !backend.launch("matvec_${kind}_indexed",
            kernelArgs().pointer(dw).pointer(dx).pointer(dy).u32(expertRows).u32(cols)
                .pointer(deviceKeys).u32(slots).u64(expertRows * rowBytes).u32(0).pointer(deviceScales),
            [expertRows, slots]) ||
        !backend.download(dy, 0, ya, y.capacity)) return false
    for (slot in 0 until slots) {
        val expert = 1 - slot
        val scale = if (expert == 0) 0.5 else -2.0
        for (row in 0 until expertRows) {
            val offset = (expert * expertRows + row) * rowBytes
            var expected = 0.0
            for (block in 0 until blocks) {
                val values = decode(testBlockBytes(wa + offset + block * blockBytes, blockBytes))
                for (col in 0 until elements) {
                    expected += f32ToF64(values[col]) * f32ToF64(testLoadFloat(xa, block * elements + col))
                }
            }
            val output = slot * expertRows + row
            if (!testNear("matvec_${kind}_indexed", output, testLoadFloat(ya, output), expected * scale))
                return false
        }
    }
    true
}
