import "abla/io"
import "abla/float"
import "abla/math"
import "abla/process/arguments"
import "abla/process/time"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../../src/backend/backend.ab"
import "../../src/backend/cuda.ab"
import "../../src/fuse/reference.ab"
import "../../src/kernels/fused_gate_up_situ.ab"
import "support.ab"

private fun fusedSample(var backend: Backend, recorded: Recording, tiles: int): int {
    val replays = 128
    val start = monotonicNanoseconds()
    for (i in 0 until replays) if (!backend.replay(recorded)) return -1
    if (!backend.synchronize()) return -1
    (monotonicNanoseconds() - start) / (tiles * replays)
}

trusted fun run(var backend: Backend): bool {
    // Exercise repeated selections, a high expert ID, negative/zero scales, and
    // nullable scales using the real Inkling 2 Mini launch dimensions.
    val ff = inklingGateUpSitu.geometry.problem[0]
    val used = inklingGateUpSitu.geometry.problem[1]
    val cols = inklingGateUpSitu.arguments[1].shape[0]
    val experts = inklingGateUpSitu.arguments[0].shape[0]
    val stride = cols / 64 * 36 * 2 * ff
    val packed = nativeByteBuffer(stride)
    for (i in 0 until stride) packed.store(i, (i * 53 + i / 36 * 17 + i / 11) & 255)
    packed.store(0, 0)
    packed.store(1, 127)
    packed.store(2, 7)
    packed.store(3, 126)
    val w = backend.allocate(experts * stride) ?? return false
    if (!backend.upload(w, 0, nativePointerAddress(packed.address), stride)) return false
    packed.store(8, 71)
    if (!backend.upload(w, 3 * stride, nativePointerAddress(packed.address), stride)) return false
    packed.store(11, 166)
    if (!backend.upload(w, (experts - 1) * stride, nativePointerAddress(packed.address), stride)) return false

    val x = uploadFloats(backend, testSignal(cols, 11)) ?? return false
    val ids = uploadWords(backend, [3, 0, experts - 1, 3, experts - 1, 0, 0, 3]) ?? return false
    val scaleValues = testSignal(experts, 23)
    scaleValues[0] = 0.0
    scaleValues[3] = -0.75
    scaleValues[experts - 1] = 0.5
    val scales = uploadFloats(backend, scaleValues) ?? return false
    val gu = backend.allocate(used * ff * 8) ?? return false
    val reference = backend.allocate(used * ff * 4) ?? return false
    val fused = backend.allocate(used * ff * 4) ?? return false
    for (useScales in [false, true]) {
        val args = kernelArgs().pointer(w).pointer(x).pointer(ids)
        if (useScales) args.pointer(scales)
        else args.u64(0)
        args.pointer(fused)
        if (backend.launch(inklingGateUpSitu.name, args, [ff - 1, used])) return false
        if (!backend.launch(inklingGateUpSitu.name, args, inklingGateUpSitu.geometry.problem)) return false
        if (!fuseGateUpReference(backend, inklingGateUpSitu, w, x, ids, scales, useScales, gu, reference)) return false
        val expected = downloadFloats(backend, reference, used * ff) ?? return false
        val actual = downloadFloats(backend, fused, used * ff) ?? return false
        var maxAbsolute = 0.0
        var different = 0
        for (index in 0 until actual.size) {
            val want = f32ToF64(expected[index])
            val error = fabs(f32ToF64(actual[index]) - want)
            if (!(error <= 0.000001 + fabs(want) * 0.000002)) {
                println("gate/up + SiTU mismatch at $index: ${actual[index]} versus ${expected[index]}")
                return false
            }
            if (error > maxAbsolute) maxAbsolute = error
            if (f32ToBits(actual[index]) != f32ToBits(expected[index])) different += 1
        }
        println("gate/up + SiTU scales=$useScales elements=${actual.size} bit differences=$different max absolute=$maxAbsolute")
        if (useScales && processArgumentCount() == 1 && processArgument(0) == "--bench") {
            val tiles = 32
            if (!backend.beginRecording()) return false
            for (i in 0 until tiles)
                if (!fuseGateUpReference(backend, inklingGateUpSitu, w, x, ids, scales, true, gu, reference))
                    return false
            val before = backend.endRecording() ?? return false
            if (!backend.beginRecording()) return false
            for (i in 0 until tiles)
                if (!backend.launch(inklingGateUpSitu.name, args, inklingGateUpSitu.geometry.problem))
                    return false
            val after = backend.endRecording() ?? return false
            if (!backend.replay(before) || !backend.replay(after) || !backend.synchronize()) return false
            for (round in 0 until 7) {
                var base = 0
                var changed = 0
                if (round % 2 == 0) {
                    base = fusedSample(backend, before, tiles)
                    changed = fusedSample(backend, after, tiles)
                } else {
                    changed = fusedSample(backend, after, tiles)
                    base = fusedSample(backend, before, tiles)
                }
                if (base < 0 || changed < 0) return false
                println("pair $round unfused_ns=$base fused_ns=$changed")
            }
        }
    }
    true
}

fun main: int {
    var backend = cudaBackend() ?? return 1
    if (run(backend)) return 0
    eprintln("fused gate/up + SiTU: ${cudaLastError()}")
    1
}
