// Report host-visible latency with the CUDA buffers already resident and the
// NVRTC/module warmup complete. Each timed batch ends in one synchronization.
import "../../src/backend/backend.ab"
import "../../src/backend/cuda.ab"
import "device_test_support.ab"
import "abla/float"
import "abla/float/text"
import "abla/io"
import "abla/process/time"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

fun benchKernel(backend: Backend, name: string, args: KernelArgs, problem: array<int>): bool {
    val repeats = 128
    for (warmup in 0 until 8) if (!backend.launch(name, args, problem)) return false
    if (!backend.synchronize()) return false
    for (sample in 0 until 5) {
        val start = monotonicNanoseconds()
        for (i in 0 until repeats) if (!backend.launch(name, args, problem)) return false
        if (!backend.synchronize()) return false
        val elapsed = monotonicNanoseconds() - start
        if (elapsed <= 0) return false
        println("${name} sample=${sample + 1} us=${f64FromInt(elapsed) / f64FromInt(repeats * 1000)}")
    }
    true
}

trusted fun benchFill(backend: Backend, device: DeviceBuffer): bool {
    val host = nativeByteBuffer(device.bytes)
    val address = nativePointerAddress(host.address)
    for (i in 0 until device.bytes / 4) {
        testStoreFloat(address, i, f32FromInt((i * 19 + i / 37 * 11) % 127 - 63) / 64.0)
    }
    backend.upload(device, 0, address, device.bytes)
}

trusted fun benchRmsAndRope(backend: Backend): bool {
    val n = 2304
    val rows = 32
    val input = backend.allocate(n * rows * 4)
    val weight = backend.allocate(n * 4)
    val output = backend.allocate(n * rows * 4)
    if (input == null || weight == null || output == null ||
        !benchFill(backend, input) || !benchFill(backend, weight)) return false
    benchKernel(backend, "rmsnorm",
        kernelArgs().pointer(input).pointer(weight).pointer(output).u32(n).f32(0.000001), [rows]) &&
        benchKernel(backend, "rope",
            kernelArgs().pointer(input).u64(0).u32(32).u32(128).u32(128).u32(1023).f32(500000.0).u32(0),
            [32 * 64])
}

trusted fun benchAttention(backend: Backend): bool {
    val heads = 24
    val kvHeads = 8
    val dim = 128
    val context = 1024
    val scale = f32(0.08838835)
    val q = backend.allocate(heads * dim * 4)
    val k = backend.allocate(kvHeads * dim * context * 4)
    val v = backend.allocate(kvHeads * dim * context * 4)
    val table = backend.allocate(heads * (context + 1) * 4)
    val out = backend.allocate(heads * dim * 4)
    if (q == null || k == null || v == null || table == null || out == null ||
        !benchFill(backend, q) || !benchFill(backend, k) ||
        !benchFill(backend, v) || !benchFill(backend, table)) return false
    val plain = kernelArgs().pointer(q).pointer(k).pointer(v).pointer(out)
        .u32(heads).u32(kvHeads).u32(dim).u32(0).u32(context - 1).u32(context).f32(scale)
    val relative = kernelArgs().pointer(q).pointer(k).pointer(v).pointer(table).pointer(out)
        .u32(heads).u32(kvHeads).u32(dim).u32(0).u32(context - 1)
        .u32(context - 1).u32(context).u32(context).f32(scale)
    benchKernel(backend, "attention_decode", plain, [heads]) &&
        benchKernel(backend, "attention_decode_rel", relative, [heads])
}

trusted fun benchGatedMlp(backend: Backend): bool {
    val experts = 8
    val width = 1152
    val gateUp = backend.allocate(2 * experts * width * 4)
    val out = backend.allocate(experts * width * 4)
    if (gateUp == null || out == null || !benchFill(backend, gateUp)) return false
    benchKernel(backend, "situ", kernelArgs().pointer(gateUp).pointer(out)
        .u32(experts).u32(width).f32(1.0).f32(1.0), [experts * width])
}

fun verifyTimings(backend: Backend): bool =
    benchRmsAndRope(backend) && benchAttention(backend) && benchGatedMlp(backend)

fun main: int {
    val backend = cudaBackend()
    if (backend == null) {
        eprintln(cudaLastError())
        return 1
    }
    val passed = verifyTimings(backend)
    val closed = backend.close()
    if (!passed || !closed) {
        eprintln(cudaLastError())
        return 1
    }
    0
}
