import "../../src/backend/backend.ab"
import "../../src/backend/cuda.ab"
import "support.ab"
import "device_test_support.ab"
import "abla/float"
import "abla/io"
import "abla/process/arguments"
import "abla/process/time"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"

private trusted fun verifyWeights(backend: Backend, kind: string, bytes: int, offset: int, expertStride: int = 0, expertPadding: int = 0): DeviceBuffer? {
    val host = nativeByteBuffer(bytes)
    val address = nativePointerAddress(host.address)
    val words = bytes / 4
    for (i in 0 until words) {
        val bits = (i * 2654435761) ^ (i * 2971215073 >> 17)
        ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * i),
            if (kind == "f32") (bits & 0x807fffff) | 0x3f000000 else bits)
    }
    for (i in words * 4 until bytes) host.store(i, i & 255)
    if (kind == "q5_k") {
        for (i in 0 until bytes / 176) {
            host.store(i * 176 + 1, 0x30 + (i & 3))
            host.store(i * 176 + 3, 0x28 + (i & 3))
        }
    }
    if (kind == "q8" || kind == "q8_0") {
        val stride = if (expertStride > 0) expertStride else bytes
        for (e in 0 until bytes / stride) {
            for (i in 0 until (stride - expertPadding) / 34) {
                host.store(e * stride + i * 34, (i * 31) & 255)
                host.store(e * stride + i * 34 + 1, 0x30 + (i & 3))
            }
        }
    }
    if (kind == "bf16") {
        for (i in 0 until bytes / 2) host.store(2 * i + 1, if (i % 2 == 0) 0x3e else 0xbe)
    }
    val buffer = backend.allocate(bytes + offset) ?? return null
    if (!backend.upload(buffer, offset, address, bytes)) return null
    buffer
}

private fun verifyOutput(var backend: Backend, count: int): DeviceBuffer? {
    val sentinels: array<int> = []
    for (i in 0 until count) sentinels.append(0x7fc00001)
    uploadWords(backend, sentinels)
}

private fun verifyEqual(var backend: Backend, name: string, vectors: int, output: DeviceBuffer,
    reference: DeviceBuffer, count: int): bool {
    val got = downloadWords(backend, output, count) ?? return false
    val expected = downloadWords(backend, reference, count) ?? return false
    for (i in 0 until count) {
        if (got[i] != expected[i]) {
            eprintln("${name} R=${vectors} index=${i} wanted bits ${expected[i]} got ${got[i]}")
            return false
        }
    }
    true
}

private fun timeVerify(backend: Backend, name: string, args: KernelArgs, shape: array<int>,
    label: string, vectors: int): bool {
    for (i in 0 until 8) if (!backend.launch(name, args, shape)) return false
    if (!backend.synchronize()) return false
    for (sample in 0 until 5) {
        val start = monotonicNanoseconds()
        for (i in 0 until 64) if (!backend.launch(name, args, shape)) return false
        if (!backend.synchronize()) return false
        val elapsed = monotonicNanoseconds() - start
        println("${label} R=${vectors} sample=${sample + 1} ns=${elapsed / 64}")
    }
    true
}

private fun verifyDense(var backend: Backend, kind: string, rows: int, cols: int,
    wOffset: int = 0, xOffset: int = 0, bench: bool = false): bool {
    val name = if (kind == "q8") "matvec_q8_0" else "matvec_$kind"
    val newName = name + "_rows"
    val rowBytes = if (kind == "q8") cols / 32 * 34 else if (kind == "bf16") cols * 2 else cols * 4
    val w = verifyWeights(backend, kind, rowBytes * rows, wOffset) ?? return false
    val x = uploadFloats(backend, testSignal(8 * cols + xOffset / 4, 5)) ?? return false
    val ref = backend.allocate(8 * rows * 4) ?? return false
    for (v in 0 until 8) {
        val args = kernelArgs().pointer(w, wOffset).pointer(x, xOffset + v * cols * 4)
            .pointer(ref, v * rows * 4).u32(rows).u32(cols)
        if (!backend.launch(name, args, [rows])) return false
        if (bench && v == 0 && !timeVerify(backend, name, args, [rows], "${name} ${rows}x${cols}", 1)) return false
    }
    for (vectors in [1, 2, 3, 4, 5, 8]) {
        val y = verifyOutput(backend, vectors * rows) ?? return false
        val args = kernelArgs().pointer(w, wOffset).pointer(x, xOffset).pointer(y)
            .u32(rows).u32(cols).u32(vectors)
        if (!backend.launch(newName, args, [rows]) || !backend.synchronize() ||
            !verifyEqual(backend, newName, vectors, y, ref, vectors * rows)) return false
        if ((kind == "bf16" || kind == "f32") && vectors <= 5) {
            val projection = "matvec_" + kind + "_output"
            val projected = verifyOutput(backend, vectors * rows) ?? return false
            val projectionArgs = kernelArgs().pointer(w, wOffset).pointer(x, xOffset).pointer(projected)
                .u32(rows).u32(cols).u32(vectors)
            if (!backend.launch(projection, projectionArgs, [rows, vectors]) || !backend.synchronize()) return false
            val got = downloadFloats(backend, projected, vectors * rows) ?? return false
            val expected = downloadFloats(backend, ref, vectors * rows) ?? return false
            for (i in 0 until got.size) if (!testNear(projection, i, got[i], f32ToF64(expected[i]))) return false
        }
        if (kind == "q8" && vectors >= 2 && vectors <= 4) {
            val decoded = verifyOutput(backend, vectors * rows) ?? return false
            var separate = kernelArgs().pointer(w, wOffset).u32(rows).u32(cols).u32(vectors)
            for (stream in 0 until 4) {
                val source = if (stream < vectors) stream else 0
                separate.pointer(x, xOffset + source * cols * 4)
                separate.pointer(decoded, source * rows * 4)
            }
            val batchName = "matvec_q8_0_decode_batch"
            if (!backend.launch(batchName, separate, [rows]) ||
                !verifyEqual(backend, batchName, vectors, decoded, ref, vectors * rows)) return false
        }
        if (bench && !timeVerify(backend, newName, args, [rows], "${newName} ${rows}x${cols}", vectors)) return false
    }
    true
}

private fun verifyIndexed(var backend: Backend, rows: int, cols: int, slots: int, pattern: string,
    slotStride: int, vectorPadding: int, withScales: bool, bench: bool = false, kind: string = "nvfp4",
    expertPadding: int = 0): bool {
    val maxVectors = 5
    val vectorStride = (slots - 1) * slotStride + cols + vectorPadding
    val name = "matvec_${kind}_indexed"
    val rowBytes = if (kind == "q5_k") cols / 256 * 176
        else if (kind == "q8_0") cols / 32 * 34
        else cols / 64 * 36
    val expertStride = rows * rowBytes + expertPadding
    val experts = if (pattern == "overlap") slots
        else if (pattern == "mixed") slots + ((maxVectors - 1) * (slots + 1) + 1) / 2
        else maxVectors * slots
    val w = verifyWeights(backend, kind, experts * expertStride, 0, expertStride, expertPadding) ?? return false
    val x = uploadFloats(backend, testSignal(maxVectors * vectorStride, 8)) ?? return false
    val scales = uploadFloats(backend, testSignal(experts, 6)) ?? return false
    val count = slots * rows
    val ref = backend.allocate(maxVectors * count * 4) ?? return false
    val allIds: array<int> = []
    for (v in 0 until maxVectors) {
        val ids: array<int> = []
        val base = if (pattern == "overlap") 0
            else if (pattern == "mixed") (v * (slots + 1) + 1) / 2
            else v * slots
        for (slot in 0 until slots) {
            val expert = base + (slot + v) % slots
            ids.append(expert)
            allIds.append(expert)
        }
        val dIds = uploadWords(backend, ids) ?? return false
        var args = kernelArgs().pointer(w).pointer(x, v * vectorStride * 4).pointer(ref, v * count * 4)
            .u32(rows).u32(cols).pointer(dIds).u32(slots).u64(expertStride).u32(slotStride)
        if (withScales) args.pointer(scales)
        else args.u64(0)
        if (!backend.launch(name, args, [rows, slots]) || !backend.synchronize()) return false
        if (bench && v == 0 && !timeVerify(backend, name, args, [rows, slots],
            "${kind}_single ${rows}x${cols} slots=${slots} ${pattern}", 1)) return false
    }
    val absent = 0xffffffff
    for (vectors in 1..maxVectors) {
        val pitch = if (vectors <= 3) 4 else 6
        val records: array<int> = []
        for (expert in 0 until experts) {
            val entry = [expert]
            for (word in 1 until pitch) entry.append(absent)
            var active = false
            for (v in 0 until vectors) {
                for (slot in 0 until slots) {
                    if (allIds[v * slots + slot] == expert) {
                        entry[v + 1] = slot
                        active = true
                    }
                }
            }
            if (active) {
                for (field in entry) records.append(field)
            }
        }
        // A fixed graph grid leaves spare, fully inactive entries at the end.
        val capacity = slots * (if (vectors <= 3) 3 else maxVectors)
        while (records.size < capacity * pitch) records.append(absent)
        val map = uploadWords(backend, records) ?? return false
        val y = verifyOutput(backend, vectors * count) ?? return false
        var args = kernelArgs().pointer(w).pointer(x).pointer(y).u32(rows).u32(cols).u32(vectors)
            .pointer(map).u32(capacity).u64(expertStride).u32(slots).u32(vectorStride).u32(slotStride)
        if (withScales) args.pointer(scales)
        else args.u64(0)
        val fixedFive = vectors == 5 && rows == 2304 && slots == 8 && kind == "nvfp4" && withScales &&
            vectorPadding == 0 && ((cols == 2304 && slotStride == 0) || (cols == 1152 && slotStride == cols))
        val rowKernel = if (fixedFive) "matvec_nvfp4_inkling_five" else name + "_rows"
        val shape = [rows, if (fixedFive) 20 else capacity]
        if (!backend.launch(rowKernel, args, shape) || !backend.synchronize() ||
            !verifyEqual(backend, rowKernel, vectors, y, ref, vectors * count)) return false
        if (bench && !timeVerify(backend, rowKernel, args, shape,
            "${kind}_rows ${rows}x${cols} slots=${slots} ${pattern}", vectors)) return false
    }
    true
}

private fun verifyAll(var backend: Backend): bool {
    if (processArgumentCount() > 0 && processArgument(0) == "--bench") {
        return verifyDense(backend, "q8", 3072, 2304, bench = true) &&
            verifyDense(backend, "q8", 51200, 2304, bench = true) &&
            verifyDense(backend, "f32", 2304, 2304, bench = true) &&
            verifyDense(backend, "f32", 16384, 2048, bench = true) &&
            verifyIndexed(backend, 2304, 1152, 8, "overlap", 0, 0, true, bench = true) &&
            verifyIndexed(backend, 2304, 1152, 8, "mixed", 0, 0, true, bench = true) &&
            verifyIndexed(backend, 2304, 1152, 8, "disjoint", 0, 0, true, bench = true) &&
            verifyIndexed(backend, 2304, 2304, 8, "mixed", 0, 0, false, bench = true, kind = "q5_k") &&
            verifyIndexed(backend, 2304, 1152, 8, "mixed", 1152, 0, false, bench = true, kind = "q8_0")
    }
    verifyDense(backend, "f32", 7, 93) &&
        verifyDense(backend, "bf16", 37, 2304) &&
        verifyDense(backend, "q8", 7, 160) &&
        verifyDense(backend, "q8", 11, 96, xOffset = 4) &&
        verifyDense(backend, "q8", 11, 96, wOffset = 1) &&
        verifyIndexed(backend, 2304, 2304, 8, "mixed", 0, 0, true) &&
        verifyIndexed(backend, 2304, 1152, 8, "overlap", 1152, 0, true) &&
        verifyIndexed(backend, 7, 320, 3, "overlap", 0, 0, false) &&
        verifyIndexed(backend, 7, 320, 3, "overlap", 321, 1, true) &&
        verifyIndexed(backend, 11, 1152, 4, "mixed", 1161, 1, true) &&
        verifyIndexed(backend, 11, 128, 8, "disjoint", 128, 0, true, expertPadding = 16) &&
        verifyIndexed(backend, 11, 256, 4, "mixed", 0, 1, true, kind = "q5_k") &&
        verifyIndexed(backend, 7, 512, 3, "overlap", 0, 0, false, kind = "q5_k") &&
        verifyIndexed(backend, 11, 96, 4, "overlap", 96, 0, false, kind = "q8_0", expertPadding = 1) &&
        verifyIndexed(backend, 11, 96, 4, "mixed", 97, 1, true, kind = "q8_0") &&
        verifyIndexed(backend, 11, 96, 4, "mixed", 96, 0, false, kind = "q8_0", expertPadding = 1)
}

private fun noVerifyCuda(): int {
    eprintln(cudaLastError())
    1
}

fun main: int {
    var backend = cudaBackend() ?? return noVerifyCuda()
    val passed = verifyAll(backend)
    val closed = backend.close()
    if (!passed || !closed) {
        eprintln("R-row CUDA matvec failed: ${cudaLastError()}")
        return 1
    }
    println("R-row matvecs match independent single-row calls")
    0
}
