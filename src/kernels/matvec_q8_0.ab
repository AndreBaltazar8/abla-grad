// GGML Q8_0 stores a binary16 delta followed by 32 signed bytes.
val kernelMatvecQ8_0 = """
static __device__ __forceinline__ float q8_scale(const unsigned char *bytes) {
    unsigned short bits = static_cast<unsigned short>(bytes[0] | (bytes[1] << 8));
    float value;
    asm("cvt.f32.f16 %0, %1;" : "=f"(value) : "h"(bits));
    return value;
}

static __device__ __forceinline__ float q8_dot_bytewise(const unsigned char *row,
    const float *x, unsigned cols) {
    unsigned lane = threadIdx.x & 31;
    float sum = 0.0f;
    for (unsigned block = 0; block < cols / 32; ++block) {
        const unsigned char *packed = row + static_cast<unsigned long long>(block) * 34;
        float value = q8_scale(packed) * float(static_cast<signed char>(packed[2 + lane]));
        sum = fmaf(value, x[block * 32 + lane], sum);
    }
    for (unsigned width = 16; width; width /= 2) {
        sum += __shfl_down_sync(0xffffffffu, sum, width);
    }
    return sum;
}

template <bool Aligned>
static __device__ __forceinline__ float q8_dot_packed(const unsigned short *row,
    const float *x, unsigned cols) {
    const unsigned lane = threadIdx.x & 31;
    const unsigned part = lane & 7;
    float sum = 0.0f;
    for (unsigned block = lane >> 3; block < cols / 32; block += 4) {
        const unsigned short *packed = row + static_cast<unsigned long long>(block) * 17;
        float scale;
        unsigned short scaleBits = packed[0];
        asm("cvt.f32.f16 %0, %1;" : "=f"(scale) : "h"(scaleBits));
        const unsigned a = packed[1 + part * 2];
        const unsigned b = packed[2 + part * 2];
        const float *input = x + block * 32 + part * 4;
        float4 values;
        if (Aligned) values = *reinterpret_cast<const float4 *>(input);
        else values = make_float4(input[0], input[1], input[2], input[3]);
        sum = fmaf(scale * float(static_cast<signed char>(a)), values.x, sum);
        sum = fmaf(scale * float(static_cast<signed char>(a >> 8)), values.y, sum);
        sum = fmaf(scale * float(static_cast<signed char>(b)), values.z, sum);
        sum = fmaf(scale * float(static_cast<signed char>(b >> 8)), values.w, sum);
    }
    for (unsigned width = 16; width; width /= 2) {
        sum += __shfl_down_sync(0xffffffffu, sum, width);
    }
    return sum;
}

static __device__ __forceinline__ float q8_dot(const unsigned char *row, const float *x, unsigned cols) {
    if (reinterpret_cast<unsigned long long>(row) & 1u) return q8_dot_bytewise(row, x, cols);
    const unsigned short *packed = reinterpret_cast<const unsigned short *>(row);
    if (reinterpret_cast<unsigned long long>(x) & 15u) return q8_dot_packed<false>(packed, x, cols);
    return q8_dot_packed<true>(packed, x, cols);
}

extern "C" __global__ void matvec_q8_0(const unsigned char *w, const float *x,
                                       float *y, unsigned rows, unsigned cols) {
    unsigned row = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32;
    if (row >= rows) return;
    unsigned long long rowBytes = static_cast<unsigned long long>(cols / 32) * 34;
    float sum = q8_dot(w + row * rowBytes, x, cols);
    if ((threadIdx.x & 31u) == 0) y[row] = sum;
}

extern "C" __global__ void matvec_q8_0_indexed(
    const unsigned char *w, const float *x, float *y, unsigned rows, unsigned cols,
    const unsigned *ids, unsigned nUsed, unsigned long long expertStrideBytes,
    unsigned xStrideElems, const float *expertScales) {
    unsigned row = blockIdx.x * (blockDim.x / 32) + threadIdx.x / 32;
    unsigned slot = blockIdx.y;
    if (row >= rows || slot >= nUsed) return;
    unsigned long long rowBytes = static_cast<unsigned long long>(cols / 32) * 34;
    unsigned expertId = ids[slot];
    const unsigned char *expert = w + expertId * expertStrideBytes;
    const float *input = x + static_cast<unsigned long long>(slot) * xStrideElems;
    float sum = q8_dot(expert + row * rowBytes, input, cols);
    if ((threadIdx.x & 31u) == 0) {
        y[static_cast<unsigned long long>(slot) * rows + row] = expertScales ?
            sum * expertScales[expertId] : sum;
    }
}

static __device__ __forceinline__ void q8_gather_row(const unsigned char *table,
    unsigned token, float *out, unsigned cols) {
    unsigned col = blockIdx.x * blockDim.x + threadIdx.x;
    if (col >= cols) return;
    unsigned long long block = static_cast<unsigned long long>(token) * (cols / 32) + col / 32;
    const unsigned char *packed = table + block * 34;
    out[col] = q8_scale(packed) * float(static_cast<signed char>(packed[2 + col % 32]));
}

extern "C" __global__ void gather_row_q8_0(const unsigned char *table, unsigned token,
                                            float *out, unsigned cols) {
    q8_gather_row(table, token, out, cols);
}

extern "C" __global__ void gather_row_q8_0_step(const unsigned char *table,
    const unsigned *step, float *out, unsigned cols) {
    q8_gather_row(table, step[0], out, cols);
}
"""
