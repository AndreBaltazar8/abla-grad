// Inkling's small non-quantized kernels (docs/kernels.md "Inkling additions", docs/inkling-graph.md): moe_combine, moe_route, rel_table, and conv_step. One CUDA C source string each. Geometry: moe_combine/rel_table/conv_step 256 threads, 256 items per block; moe_route one warp.

val kernelMoeCombine = """
extern "C" __global__ void moe_combine(const float *expertOut, const float *weights, float *out, unsigned rows, unsigned nUsed) {
    unsigned r = blockIdx.x * blockDim.x + threadIdx.x;
    if (r >= rows) return;
    float sum = 0.0f;
    for (unsigned i = 0; i < nUsed; ++i) sum += weights[i] * expertOut[(unsigned long long)i * rows + r];
    out[r] = sum;
}
"""

// The router: p = sigmoid(logits); the k largest of p + bias (the lowest index wins ties) are chosen; weights = p[chosen] / (sum + normEps) * weightScale.
// One warp; nExpert <= 256.
val kernelMoeRoute = """
static __device__ __noinline__ void moe_route_serial_nan(const float *logits, const float *bias, unsigned nExpert, unsigned k, unsigned *ids,
                                     float *weights, float normEps, float weightScale) {
    float prob[256];
    float sel[256];
    bool used[256];
    for (unsigned i = 0; i < nExpert; ++i) {
        prob[i] = 1.0f / (1.0f + expf(-logits[i]));
        sel[i] = prob[i] + (bias ? bias[i] : 0.0f);
        used[i] = false;
    }
    float chosen[64];
    unsigned count = k < 64 ? k : 64;
    float sum = 0.0f;
    for (unsigned t = 0; t < count; ++t) {
        int best = -1;
        for (unsigned i = 0; i < nExpert; ++i) {
            if (!used[i] && (best < 0 || sel[i] > sel[best])) best = (int)i;
        }
        used[best] = true;
        ids[t] = (unsigned)best;
        chosen[t] = prob[best];
        sum += prob[best];
    }
    for (unsigned t = 0; t < count; ++t) weights[t] = chosen[t] / (sum + normEps) * weightScale;
}

template <unsigned Candidates>
static __device__ __forceinline__ void moe_route_warp(
    const float *logits, const float *bias, unsigned nExpert, unsigned k,
    unsigned *ids, float *weights, float normEps, float weightScale) {
    const unsigned lane = threadIdx.x;
    const unsigned warp = 0xffffffffu;
    const unsigned absent = 0xffffffffu;
    const float negativeInfinity = -__int_as_float(0x7f800000);
    unsigned live = 0;
    float selection[Candidates];
    bool hasNan = false;
    #pragma unroll
    for (unsigned item = 0; item < Candidates; ++item) {
        const unsigned expert = lane + 32 * item;
        if (expert < nExpert) {
            live |= 1u << item;
            float p = 1.0f / (1.0f + expf(-logits[expert]));
            selection[item] = p + (bias ? bias[expert] : 0.0f);
            hasNan |= isnan(selection[item]);
        } else {
            selection[item] = negativeInfinity;
        }
    }
    // The serial scan treats a leading NaN as its initial best. Retain that
    // behavior for non-finite inputs without adding another fast-path reduction.
    if (__any_sync(warp, hasNan)) {
        if (lane == 0) moe_route_serial_nan(logits, bias, nExpert, k, ids, weights, normEps, weightScale);
        return;
    }
    float sum = 0.0f;
    for (unsigned rank = 0; rank < k; ++rank) {
        float bestScore = negativeInfinity;
        unsigned bestId = absent;
        #pragma unroll
        for (unsigned item = 0; item < Candidates; ++item) {
            const unsigned expert = lane + 32 * item;
            float score = selection[item];
            if ((live & (1u << item)) &&
                (score > bestScore || (score == bestScore && expert < bestId))) {
                bestScore = score;
                bestId = expert;
            }
        }
        for (unsigned distance = 16; distance; distance /= 2) {
            float score = __shfl_xor_sync(warp, bestScore, distance);
            unsigned expert = __shfl_xor_sync(warp, bestId, distance);
            if (score > bestScore || (score == bestScore && expert < bestId)) {
                bestScore = score;
                bestId = expert;
            }
        }
        if ((bestId & 31u) == lane) live &= ~(1u << (bestId / 32));
        // Accumulate un-biased probabilities in the same selected order.
        if (lane == 0) {
            float p = 1.0f / (1.0f + expf(-logits[bestId]));
            ids[rank] = bestId;
            weights[rank] = p;
            sum += p;
        }
    }
    if (lane == 0) {
        float divisor = sum + normEps;
        for (unsigned rank = 0; rank < k; ++rank) {
            weights[rank] = weights[rank] / divisor * weightScale;
        }
    }
}

extern "C" __global__ void moe_route(const float *logits, const float *bias, unsigned nExpert, unsigned k,
    unsigned *ids, float *weights, float normEps, float weightScale) {
    if (nExpert <= 128)
        moe_route_warp<4>(logits, bias, nExpert, k, ids, weights, normEps, weightScale);
    else
        moe_route_warp<8>(logits, bias, nExpert, k, ids, weights, normEps, weightScale);
}
"""

// table[h*(extent+1) + d] = sum_k relBias[d*nRel + k] * r[h*nRel + k] - sinks[h] for d < extent; the pad entry d == extent is 0 - sinks[h].
val kernelRelTable = """
extern "C" __global__ void rel_table(const float *relBias, const float *r, const float *sinks, float *table,
                                     unsigned nRel, unsigned extent, unsigned nHead) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    unsigned stride = extent + 1;
    if (i >= nHead * stride) return;
    unsigned h = i / stride;
    unsigned d = i % stride;
    float sum = 0.0f;
    if (d < extent) {
        for (unsigned k = 0; k < nRel; ++k) sum += relBias[(unsigned long long)d * nRel + k] * r[h * nRel + k];
    }
    table[i] = sum - sinks[h];
}
"""

// The short causal depthwise convolution with a residual (docs/inkling-graph.md "convolve"). Per channel c: the window is history[0..nConv-1)
// (oldest first) then x[c]; out = (x + sum_k w[c*nConv + k] * window[k] + sum_lag dyn[head*nConv + lag] * window[nConv-1-lag]) * outScale; then the history
// shifts by one and takes x[c]. history is [nConv-1][channels]; dyn may be null; x == out allowed.
val kernelConvStep = """
extern "C" __global__ void conv_step(const float *x, float *history, const float *w, const float *dyn, float *out,
                                     unsigned channels, unsigned nConv, unsigned heads, float outScale) {
    unsigned c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c >= channels || nConv > 64) return;
    float window[64];
    for (unsigned k = 0; k + 1 < nConv; ++k) window[k] = history[(unsigned long long)k * channels + c];
    float current = x[c];
    window[nConv - 1] = current;
    float sum = current;
    for (unsigned k = 0; k < nConv; ++k) sum += w[(unsigned long long)c * nConv + k] * window[k];
    if (dyn) {
        unsigned head = c / (channels / heads);
        for (unsigned lag = 0; lag < nConv; ++lag) sum += dyn[head * nConv + lag] * window[nConv - 1 - lag];
    }
    for (unsigned k = 0; k + 1 < nConv; ++k) history[(unsigned long long)k * channels + c] = window[k + 1];
    out[c] = sum * outScale;
}
"""
