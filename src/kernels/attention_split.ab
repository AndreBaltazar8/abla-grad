// Split-position decode attention with the relative-position table and sink (ablac-60-2). attention_decode_rel_step runs one block per head, so
// 24 blocks walk the whole context one position per warp step and the per-token cost grows with the position. Here the positions of one head are
// divided over `nSplit` blocks (grid = head * nSplit + split); each block leaves an unnormalised partial (m, total, acc[dim]) and `attention_rel_merge`
// combines the partials of a head (with the sink, whose logit is 0) into the output. nSplit is fixed per launch so the recorded graph stays static;
// blocks whose share of positions is empty write an empty partial.
// Partial layout per (head, split): acc[dim], then m, then total (dim + 2 floats).
val kernelAttentionSplit = """
extern "C" __global__ void attention_rel_split_step(
    const float *q, const float *k, const float *v, const float *table, float *part,
    const unsigned *step, unsigned nHead, unsigned nKvHead, unsigned dim,
    unsigned window, unsigned extent, unsigned maxCtx, float scale, unsigned nSplit) {
    const unsigned pos = step[1];
    if (pos >= maxCtx) return;
    const unsigned first = window && pos + 1 > window ? pos + 1 - window : 0;
    const unsigned head = blockIdx.x / nSplit;
    const unsigned split = blockIdx.x % nSplit;
    const unsigned warp = threadIdx.x / 32;
    const unsigned lane = threadIdx.x % 32;
    const unsigned kvHead = head / (nHead / nKvHead);
    const unsigned long long cacheBase = static_cast<unsigned long long>(kvHead) * maxCtx * dim;
    const unsigned long long headBase = static_cast<unsigned long long>(head) * dim;
    const float *query = q + headBase;
    __shared__ float warpMax[8];
    __shared__ float warpSum[8];
    __shared__ float partials[8][256];
    __shared__ float weights[8];
    __shared__ float blockMax;
    __shared__ float blockTotal;

    float accumulated[8] = {};
    float m = -__int_as_float(0x7f800000);
    float total = 0.0f;
    const unsigned stride = 8 * nSplit;
    for (unsigned long long j = static_cast<unsigned long long>(first) + split * 8 + warp; j <= pos; j += stride) {
        unsigned long long base = cacheBase + j * dim;
        float score = 0.0f;
        #pragma unroll
        for (unsigned i = 0; i < 8; ++i) {
            unsigned index = lane + i * 32;
            if (index < dim) score = fmaf(query[index], k[base + index], score);
        }
        for (unsigned width = 16; width; width /= 2) score += __shfl_down_sync(0xffffffffu, score, width);
        score = __shfl_sync(0xffffffffu, score, 0) * scale;
        unsigned d = pos - static_cast<unsigned>(j);
        score += table[static_cast<unsigned long long>(head) * (extent + 1ull) + (d < extent ? d : extent)];
        float next = fmaxf(m, score);
        float history = total == 0.0f ? 0.0f : expf(m - next);
        float current = expf(score - next);
        total = total * history + current;
        m = next;
        #pragma unroll
        for (unsigned i = 0; i < 8; ++i) {
            unsigned index = lane + i * 32;
            if (index < dim) accumulated[i] = fmaf(current, v[base + index], accumulated[i] * history);
        }
    }
    if (lane == 0) {
        warpSum[warp] = total;
        warpMax[warp] = m;
    }
    #pragma unroll
    for (unsigned i = 0; i < 8; ++i) {
        unsigned index = lane + i * 32;
        if (index < dim) partials[warp][index] = accumulated[i];
    }
    __syncthreads();
    if (threadIdx.x == 0) {
        float largest = -__int_as_float(0x7f800000);
        for (unsigned i = 0; i < 8; ++i) if (warpSum[i] != 0.0f) largest = fmaxf(largest, warpMax[i]);
        float sum = 0.0f;
        for (unsigned i = 0; i < 8; ++i) {
            float weight = warpSum[i] == 0.0f ? 0.0f : expf(warpMax[i] - largest);
            weights[i] = weight;
            sum = fmaf(weight, warpSum[i], sum);
        }
        blockMax = largest;
        blockTotal = sum;
    }
    __syncthreads();
    float *out = part + static_cast<unsigned long long>(blockIdx.x) * (dim + 2);
    if (threadIdx.x < dim) {
        float weighted = 0.0f;
        for (unsigned i = 0; i < 8; ++i) weighted = fmaf(weights[i], partials[i][threadIdx.x], weighted);
        out[threadIdx.x] = weighted;
    }
    if (threadIdx.x == 0) {
        out[dim] = blockMax;
        out[dim + 1] = blockTotal;
    }
}

static __device__ __forceinline__ void rel_merge(const float *part, float *out, const float *gate, unsigned dim, unsigned nSplit) {
    const unsigned head = blockIdx.x;
    __shared__ float weights[64];
    __shared__ float denominator;
    const float *base = part + static_cast<unsigned long long>(head) * nSplit * (dim + 2);
    if (threadIdx.x == 0) {
        float largest = 0.0f;  // the sink has logit 0
        for (unsigned s = 0; s < nSplit; ++s) {
            const float *p = base + s * (dim + 2);
            if (p[dim + 1] != 0.0f) largest = fmaxf(largest, p[dim]);
        }
        float sum = expf(-largest);
        for (unsigned s = 0; s < nSplit; ++s) {
            const float *p = base + s * (dim + 2);
            float weight = p[dim + 1] == 0.0f ? 0.0f : expf(p[dim] - largest);
            weights[s] = weight;
            sum = fmaf(weight, p[dim + 1], sum);
        }
        denominator = sum;
    }
    __syncthreads();
    if (threadIdx.x < dim) {
        float weighted = 0.0f;
        for (unsigned s = 0; s < nSplit; ++s) weighted = fmaf(weights[s], base[s * (dim + 2) + threadIdx.x], weighted);
        const unsigned long long at = static_cast<unsigned long long>(head) * dim + threadIdx.x;
        float value = weighted / denominator;
        // the output gate of the attention layer (value * sigmoid(gate)), when given
        if (gate != nullptr) value = value / (1.0f + expf(-gate[at]));
        out[at] = value;
    }
}

extern "C" __global__ void attention_rel_merge(const float *part, float *out, unsigned nHead, unsigned dim, unsigned nSplit) {
    rel_merge(part, out, nullptr, dim, nSplit);
}

extern "C" __global__ void attention_rel_merge_gated(const float *part, float *out, const float *gate, unsigned nHead, unsigned dim, unsigned nSplit) {
    rel_merge(part, out, gate, dim, nSplit);
}
"""
