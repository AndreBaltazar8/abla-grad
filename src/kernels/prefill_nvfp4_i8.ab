import "elementwise.ab"

// NVFP4 weights stay packed in global memory. Activations use a Q8_1 D4 scale per 32 values.
// Within each 16-byte group, qx interleaves the two eight-value halves so NVFP4 nibbles can
// expand directly into the same order via signed byte LUTs. sx holds the ordinary row scales.
val kernelPrefillQuantizeI8 = """
extern "C" __global__ void quantize_rows_i8(const float *x, unsigned *qx, float *sx, unsigned rows, unsigned cols) {
    const unsigned word = blockIdx.x * blockDim.x + threadIdx.x;
    const unsigned row = blockIdx.y;
    const bool active = word < cols / 4 && row < rows;
    const unsigned lo = (word / 4) * 16 + (word % 4) * 2;
    float a = 0.0f, b = 0.0f, c = 0.0f, d = 0.0f;
    if (active) {
        const float *r = x + static_cast<unsigned long long>(row) * cols;
        a = r[lo]; b = r[lo + 8]; c = r[lo + 1]; d = r[lo + 9];
    }
    float peak = fmaxf(fmaxf(fabsf(a), fabsf(b)), fmaxf(fabsf(c), fabsf(d)));
    #pragma unroll
    for (unsigned offset = 4; offset; offset >>= 1) {
        peak = fmaxf(peak, __shfl_xor_sync(0xffffffffu, peak, offset));
    }
    if (!active) return;
    const float inv = peak > 0.0f ? 127.0f / peak : 0.0f;
    const unsigned wa = unsigned(int(roundf(a * inv))) & 255u;
    const unsigned wb = unsigned(int(roundf(b * inv))) & 255u;
    const unsigned wc = unsigned(int(roundf(c * inv))) & 255u;
    const unsigned wd = unsigned(int(roundf(d * inv))) & 255u;
    qx[static_cast<unsigned long long>(row) * (cols / 4) + word] = wa | (wb << 8) | (wc << 16) | (wd << 24);
    if ((word & 7u) == 0)
        sx[static_cast<unsigned long long>(row) * (cols / 32) + word / 8] = inv != 0.0f ? 1.0f / inv : 0.0f;
}
"""

private val prefillNvfp4I8Body = """
#ifndef I8_LAUNCH_BOUNDS
#define I8_LAUNCH_BOUNDS __launch_bounds__(256)
#endif

#ifndef I8_Q5
#define I8_Q5 0
#endif
#ifndef I8_FUSED
#define I8_FUSED 0
#endif
#ifndef I8_PACK_SITU
#define I8_PACK_SITU 0
#endif
#ifndef I8_Q8
#define I8_Q8 0
#endif
#ifndef I8_X5
#define I8_X5 0
#endif
#ifndef I8_DENSE
#define I8_DENSE 0
#endif

enum { I8_ROWS = 128, I8_TOKENS = 64, I8_K = 128, I8_PITCH = I8_K / 4 + 4 };

static __device__ __forceinline__ unsigned i8_nvfp4_four(unsigned nibbles) {
    // Positive and negative tables yield signed two's-complement bytes without lane negation.
    const unsigned selector = nibbles & 0x7777u;
    const unsigned pos = __byte_perm(0x03020100u, 0x0c080604u, selector);
    const unsigned neg = __byte_perm(0xfdfeff00u, 0xf4f8fafcu, selector);
    return __byte_perm(pos, neg, 0x3210u | ((nibbles & 0x8888u) >> 1));
}

static __device__ __forceinline__ float i8_nvfp4_scale(unsigned code) {
    if (code == 0x7fu) return 0.0f;
    const unsigned exponent = (code >> 3) & 15u;
    const unsigned mantissa = code & 7u;
    return exponent ? __uint_as_float(((exponent + 119u) << 23) | (mantissa << 20))
                    : float(mantissa) * 0.0009765625f;
}

static __device__ __forceinline__ void i8_load_a(unsigned (&a)[2], const void *address) {
    const unsigned shared = static_cast<unsigned>(__cvta_generic_to_shared(address));
    asm volatile("ldmatrix.sync.aligned.m8n8.x2.shared.b16 {%0,%1}, [%2];"
        : "=r"(a[0]), "=r"(a[1]) : "r"(shared));
}

static __device__ __forceinline__ void i8_mma(int (&d)[4], const unsigned (&a)[2], unsigned b) {
    const int zero = 0;
    asm volatile("mma.sync.aligned.m16n8k16.row.col.s32.s8.s8.s32 {%0,%1,%2,%3}, {%4,%5}, {%6}, {%7,%7,%7,%7};"
        : "=r"(d[0]), "=r"(d[1]), "=r"(d[2]), "=r"(d[3])
        : "r"(a[0]), "r"(a[1]), "r"(b), "r"(zero));
}

#if I8_PACK_SITU
static __device__ __forceinline__ void i8_store_situ_pack(
    unsigned *out, float *scales, unsigned col, unsigned features, unsigned feature,
    unsigned g, bool validToken, float a, float b, float c, float d) {
    float peak = fmaxf(fmaxf(fabsf(a), fabsf(b)), fmaxf(fabsf(c), fabsf(d)));
    // Four lanes per feature group hold the four token pairs. For one
    // token, the lanes at strides of four collectively hold 32 features.
    #pragma unroll
    for (unsigned offset = 16; offset >= 4; offset >>= 1)
        peak = fmaxf(peak, __shfl_xor_sync(0xffffffffu, peak, offset));
    const float inv = peak > 0.0f ? 127.0f / peak : 0.0f;
    const unsigned qa = unsigned(int(roundf(a * inv))) & 255u;
    const unsigned qb = unsigned(int(roundf(b * inv))) & 255u;
    const unsigned qc = unsigned(int(roundf(c * inv))) & 255u;
    const unsigned qd = unsigned(int(roundf(d * inv))) & 255u;
    const unsigned low = qa | (qb << 8);
    const unsigned high = qc | (qd << 8);
    const unsigned lowPeer = __shfl_xor_sync(0xffffffffu, low, 4);
    const unsigned highPeer = __shfl_xor_sync(0xffffffffu, high, 4);
    if (validToken && (g & 1u) == 0) {
        const unsigned group = feature - g;
        const auto row = static_cast<unsigned long long>(col);
        const auto word = row * (features / 4) + group / 4 + g / 2;
        out[word] = low | (lowPeer << 16);
        out[word + 4] = high | (highPeer << 16);
        if (g == 0) scales[row * (features / 32) + group / 32] = inv != 0.0f ? 1.0f / inv : 0.0f;
    }
}
#endif

extern "C" __global__ void I8_LAUNCH_BOUNDS I8_KERNEL(
#if I8_X5
    const unsigned char *wq, const unsigned *xq, const float *sq, float *yq, unsigned nq,
    const unsigned char *wk, const unsigned *xk, const float *sk, float *yk, unsigned nk,
    const unsigned char *wv, const unsigned *xv, const float *sv, float *yv, unsigned nv,
    const unsigned char *wr, const unsigned *xr, const float *sr, float *yr, unsigned nr,
    const unsigned char *wg, const unsigned *xg, const float *sg, float *yg, unsigned ng,
    unsigned cols, unsigned tokens) {
    unsigned rowTile = blockIdx.x;
    const unsigned char *w = nullptr;
    const unsigned *qx = nullptr, *xmap = nullptr;
    const float *sx = nullptr;
    float *y = nullptr;
    unsigned rows = 0;
    const unsigned begin = blockIdx.y * I8_TOKENS;
    const unsigned end = tokens;
    const float scale = 1.0f;
    #define I8_CHOOSE(W, X, S, Y, N) \
        if (rowTile < (N + I8_ROWS - 1) / I8_ROWS) { w = W; qx = X; sx = S; y = Y; rows = N; } \
        else rowTile -= (N + I8_ROWS - 1) / I8_ROWS
    I8_CHOOSE(wq,xq,sq,yq,nq);
    if (!w) { I8_CHOOSE(wk,xk,sk,yk,nk); }
    if (!w) { I8_CHOOSE(wv,xv,sv,yv,nv); }
    if (!w) { I8_CHOOSE(wr,xr,sr,yr,nr); }
    if (!w) { I8_CHOOSE(wg,xg,sg,yg,ng); }
    #undef I8_CHOOSE
    if (!w) return;
#elif I8_DENSE
    const unsigned char *weights, const unsigned *qx, const float *sx, float *y,
    unsigned rows, unsigned cols, unsigned tokens) {
    const unsigned rowTile = blockIdx.x;
    const unsigned begin = blockIdx.y * I8_TOKENS;
    const unsigned end = tokens;
    const unsigned *xmap = nullptr;
    const unsigned char *w = weights;
    const float scale = 1.0f;
#else
    const unsigned char *weights, const unsigned *qx, const unsigned *xmap, float *y,
    const float *expertScales, const unsigned *plan, unsigned rows, unsigned cols,
    unsigned nExpert, unsigned long long expertStride, const float *sx
#if I8_FUSED
    , float beta, float lb
#endif
#if I8_PACK_SITU
    , float *packedScales
#endif
    ) {
    if (blockIdx.y >= plan[nExpert + 1]) return;
    const unsigned expert = plan[nExpert + 2 + 2 * blockIdx.y];
    const unsigned first = plan[nExpert + 3 + 2 * blockIdx.y];
    const unsigned begin = plan[expert] + first;
    const unsigned end = plan[expert + 1];
    const unsigned rowTile = blockIdx.x;
    const unsigned char *w = weights + expert * expertStride;
    const float scale = expertScales ? expertScales[expert] : 1.0f;
#endif
#if I8_FUSED
    const unsigned n0 = rowTile * (I8_ROWS / 2);
    const unsigned features = rows / 2;
#else
    const unsigned n0 = rowTile * I8_ROWS;
#endif
    const unsigned long long rowBytes = I8_Q5 ? static_cast<unsigned long long>(cols / 256) * 176 :
        I8_Q8 ? static_cast<unsigned long long>(cols / 32) * 34 :
        static_cast<unsigned long long>(cols / 64) * 36;

#if I8_FUSED
    // The last GEMM barrier ends all reads from the weight slab. Reuse it
    // for the paired gate values with a skew between adjacent token rows.
    union WeightStorage {
        unsigned matrix[I8_ROWS][I8_PITCH];
        float gate[I8_TOKENS][I8_ROWS / 2 + 1];
    };
    __shared__ __align__(16) WeightStorage storage;
    auto &wa = storage.matrix;
#else
    __shared__ __align__(16) unsigned wa[I8_ROWS][I8_PITCH];
#endif
    __shared__ __align__(16) unsigned xb[I8_TOKENS][I8_PITCH];
    __shared__ float saw[I8_ROWS][I8_K / 16];
    __shared__ float sbx[I8_TOKENS][I8_K / 32];
#if I8_Q5
    __shared__ float sawMin[I8_ROWS][I8_K / 16];
    __shared__ int sbSum[I8_TOKENS][I8_K / 16];
#endif

    const unsigned tid = threadIdx.x, lane = tid & 31u, warp = tid >> 5;
    const unsigned g = lane >> 2, t = lane & 3u;
    // Each warp covers 32 weight rows by 32 routed tokens.
    const unsigned mr = warp / (I8_TOKENS / 32) * 32;
    const unsigned mt = warp % (I8_TOKENS / 32) * 32;
    float acc[2][4][4] = {};

    for (unsigned k = 0; k < cols; k += I8_K) {
        for (unsigned job = tid; job < I8_ROWS * (I8_K / 16); job += blockDim.x) {
            const unsigned r = job / (I8_K / 16);
            const unsigned sub = job % (I8_K / 16);
            uint4 packed = make_uint4(0, 0, 0, 0);
            float scale = 0.0f;
#if I8_Q5
            float weightMin = 0.0f;
#endif
#if I8_FUSED
            const unsigned feature = n0 + r % (I8_ROWS / 2);
            const unsigned weightRow = feature + (r >= I8_ROWS / 2 ? features : 0);
            const bool validRow = feature < features;
#else
            const unsigned weightRow = n0 + r;
            const bool validRow = weightRow < rows;
#endif
            if (validRow && k + 16 * sub < cols) {
                const unsigned char *row = w + static_cast<unsigned long long>(weightRow) * rowBytes;
#if I8_Q5
                const unsigned column = k + 16 * sub;
                const unsigned group = (column / 32) & 7u;
                const unsigned char *block = row + (column / 256) * 176;
                const unsigned short *head = reinterpret_cast<const unsigned short *>(block);
                const unsigned short dBits = head[0], minBits = head[1];
                float d, dm;
                asm("cvt.f32.f16 %0, %1;" : "=f"(d) : "h"(dBits));
                asm("cvt.f32.f16 %0, %1;" : "=f"(dm) : "h"(minBits));
                unsigned qs, qm;
                if (group < 4) {
                    qs = block[4 + group] & 63u;
                    qm = block[8 + group] & 63u;
                } else {
                    const unsigned both = block[8 + group];
                    qs = (both & 15u) | ((block[group] >> 6) << 4);
                    qm = (both >> 4) | ((block[4 + group] >> 6) << 4);
                }
                scale = d * float(qs);
                weightMin = -dm * float(qm);
                const unsigned inner = column & 16u;
                const uint4 low = *reinterpret_cast<const uint4 *>(block + 48 + (group / 2) * 32 + inner);
                const uint4 high = *reinterpret_cast<const uint4 *>(block + 16 + inner);
                const unsigned l[4] = {low.x, low.y, low.z, low.w};
                const unsigned h[4] = {high.x, high.y, high.z, high.w};
                unsigned q[4];
                #pragma unroll
                for (int idx = 0; idx < 4; ++idx)
                    q[idx] = ((l[idx] >> ((group & 1u) * 4)) & 0x0f0f0f0fu) | (((h[idx] >> group) & 0x01010101u) << 4);
                packed = make_uint4(__byte_perm(q[0], q[2], 0x5140), __byte_perm(q[0], q[2], 0x7362),
                    __byte_perm(q[1], q[3], 0x5140), __byte_perm(q[1], q[3], 0x7362));
#elif I8_Q8
                const unsigned short *block = reinterpret_cast<const unsigned short *>(row + ((k + 16 * sub) / 32) * 34);
                const unsigned short bits = block[0];
                asm("cvt.f32.f16 %0, %1;" : "=f"(scale) : "h"(bits));
                const unsigned short *q = block + 1 + (sub & 1) * 8;
                const unsigned lo0 = unsigned(q[0]) | (unsigned(q[1]) << 16);
                const unsigned lo1 = unsigned(q[2]) | (unsigned(q[3]) << 16);
                const unsigned hi0 = unsigned(q[4]) | (unsigned(q[5]) << 16);
                const unsigned hi1 = unsigned(q[6]) | (unsigned(q[7]) << 16);
                packed = make_uint4(__byte_perm(lo0, hi0, 0x5140), __byte_perm(lo0, hi0, 0x7362),
                    __byte_perm(lo1, hi1, 0x5140), __byte_perm(lo1, hi1, 0x7362));
#else
                const unsigned char *block = row + ((k + 16 * sub) / 64) * 36;
                const unsigned *q = reinterpret_cast<const unsigned *>(block + 4 + (sub % 4) * 8);
                const unsigned q0 = q[0], q1 = q[1];
                scale = i8_nvfp4_scale(block[sub % 4]);
                packed = make_uint4(i8_nvfp4_four(q0), i8_nvfp4_four(q0 >> 16), i8_nvfp4_four(q1), i8_nvfp4_four(q1 >> 16));
#endif
            }
            *reinterpret_cast<uint4 *>(&wa[r][4 * sub]) = packed;
            saw[r][sub] = scale;
#if I8_Q5
            sawMin[r][sub] = weightMin;
#endif
        }

        for (unsigned job = tid; job < I8_TOKENS * (I8_K / 16); job += blockDim.x) {
            const unsigned token = job / (I8_K / 16);
            const unsigned part = job % (I8_K / 16);
            const unsigned column = k + 16 * part;
            uint4 packed = make_uint4(0, 0, 0, 0);
            float scale = 0.0f;
            if (begin + token < end && column < cols) {
                const unsigned source = xmap ? xmap[begin + token] : begin + token;
                const auto offset = static_cast<unsigned long long>(source) * cols + column;
                packed = *reinterpret_cast<const uint4 *>(qx + offset / 4);
                if ((part & 1u) == 0) scale = sx[offset / 32];
            }
            *reinterpret_cast<uint4 *>(&xb[token][4 * part]) = packed;
            if ((part & 1u) == 0) sbx[token][part / 2] = scale;
#if I8_Q5
            int sum = __dp4a(int(packed.x), 0x01010101, 0);
            sum = __dp4a(int(packed.y), 0x01010101, sum);
            sum = __dp4a(int(packed.z), 0x01010101, sum);
            sbSum[token][part] = __dp4a(int(packed.w), 0x01010101, sum);
#endif
        }
        __syncthreads();

        // Two K16 products share one activation scale, but each has its own NVFP4 scale.
        #pragma unroll
        for (unsigned pair = 0; pair < I8_K / 32; ++pair) {
            unsigned a[2][2][2];
            float sw[2][2][2];
#if I8_Q5
            float minimum[2][2];
#endif
            #pragma unroll
            for (unsigned i = 0; i < 2; ++i) {
                const unsigned r = mr + 16 * i;
                #pragma unroll
                for (unsigned j = 0; j < 2; ++j) {
                    const unsigned sub = 2 * pair + j;
                    i8_load_a(a[i][j], &wa[r + (lane & 15u)][4 * sub]);
                    sw[i][0][j] = saw[r + g][sub];
                    sw[i][1][j] = saw[r + g + 8][sub];
#if I8_Q5
                    if (j == 0) {
                        minimum[i][0] = sawMin[r + g][sub];
                        minimum[i][1] = sawMin[r + g + 8][sub];
                    }
#endif
                }
            }
            #pragma unroll
            for (unsigned n = 0; n < 4; ++n) {
                const unsigned col = mt + 8 * n;
                if (begin + col >= end) break;
                const unsigned b0 = xb[col + g][8 * pair + t];
                const unsigned b1 = xb[col + g][8 * pair + 4 + t];
                const float sx0 = sbx[col + 2 * t][pair];
                const float sx1 = sbx[col + 2 * t + 1][pair];
#if I8_Q5
                const float sum0 = float(sbSum[col + 2 * t][2 * pair] + sbSum[col + 2 * t][2 * pair + 1]);
                const float sum1 = float(sbSum[col + 2 * t + 1][2 * pair] + sbSum[col + 2 * t + 1][2 * pair + 1]);
#endif
                #pragma unroll
                for (unsigned i = 0; i < 2; ++i) {
                    int d0[4], d1[4];
                    i8_mma(d0, a[i][0], b0);
                    i8_mma(d1, a[i][1], b1);
#if I8_Q5
                    const float d00 = float(d0[0] + d1[0]) * sw[i][0][0];
                    const float d01 = float(d0[1] + d1[1]) * sw[i][0][0];
                    const float d10 = float(d0[2] + d1[2]) * sw[i][1][0];
                    const float d11 = float(d0[3] + d1[3]) * sw[i][1][0];
                    acc[i][n][0] = fmaf(sx0, fmaf(minimum[i][0], sum0, d00), acc[i][n][0]);
                    acc[i][n][1] = fmaf(sx1, fmaf(minimum[i][0], sum1, d01), acc[i][n][1]);
                    acc[i][n][2] = fmaf(sx0, fmaf(minimum[i][1], sum0, d10), acc[i][n][2]);
                    acc[i][n][3] = fmaf(sx1, fmaf(minimum[i][1], sum1, d11), acc[i][n][3]);
#else
                    acc[i][n][0] = fmaf(sx0, fmaf(float(d1[0]), sw[i][0][1], float(d0[0]) * sw[i][0][0]), acc[i][n][0]);
                    acc[i][n][1] = fmaf(sx1, fmaf(float(d1[1]), sw[i][0][1], float(d0[1]) * sw[i][0][0]), acc[i][n][1]);
                    acc[i][n][2] = fmaf(sx0, fmaf(float(d1[2]), sw[i][1][1], float(d0[2]) * sw[i][1][0]), acc[i][n][2]);
                    acc[i][n][3] = fmaf(sx1, fmaf(float(d1[3]), sw[i][1][1], float(d0[3]) * sw[i][1][0]), acc[i][n][3]);
#endif
                }
            }
        }
        __syncthreads();
    }

#if I8_FUSED
    const bool gateWarp = mr < I8_ROWS / 2;
    const unsigned featureLane = mr % (I8_ROWS / 2) + g;
    if (gateWarp) {
        #pragma unroll
        for (unsigned i = 0; i < 2; ++i) {
            const unsigned feature = featureLane + 16 * i;
            #pragma unroll
            for (unsigned n = 0; n < 4; ++n) {
                const unsigned col = mt + 8 * n + 2 * t;
                storage.gate[col][feature] = acc[i][n][0] * scale;
                storage.gate[col + 1][feature] = acc[i][n][1] * scale;
                storage.gate[col][feature + 8] = acc[i][n][2] * scale;
                storage.gate[col + 1][feature + 8] = acc[i][n][3] * scale;
            }
        }
    }
    __syncthreads();
#if I8_PACK_SITU
    if (!gateWarp && n0 + mr % (I8_ROWS / 2) < features) {
        #pragma unroll
        for (unsigned n = 0; n < 4; ++n) {
            if (begin + mt + 8 * n >= end) break;
            const unsigned col = mt + 8 * n + 2 * t;
            const unsigned r = n0 + featureLane;
            #pragma unroll
            for (unsigned j = 0; j < 2; ++j) {
                const float a = grad_situ(storage.gate[col + j][featureLane], acc[0][n][j] * scale, beta, lb);
                const float b = grad_situ(storage.gate[col + j][featureLane + 8], acc[0][n][j + 2] * scale, beta, lb);
                const float c = grad_situ(storage.gate[col + j][featureLane + 16], acc[1][n][j] * scale, beta, lb);
                const float d = grad_situ(storage.gate[col + j][featureLane + 24], acc[1][n][j + 2] * scale, beta, lb);
                i8_store_situ_pack(reinterpret_cast<unsigned *>(y), packedScales, begin + col + j, features, r, g,
                    begin + col + j < end, a, b, c, d);
            }
        }
    }
#else
    if (!gateWarp) {
        #pragma unroll
        for (unsigned i = 0; i < 2; ++i) {
            const unsigned feature = featureLane + 16 * i;
            const unsigned r = n0 + feature;
            #pragma unroll
            for (unsigned n = 0; n < 4; ++n) {
                const unsigned col = mt + 8 * n + 2 * t;
                if (begin + col < end && r < features)
                    y[static_cast<unsigned long long>(begin + col) * features + r] = grad_situ(storage.gate[col][feature], acc[i][n][0] * scale, beta, lb);
                if (begin + col + 1 < end && r < features)
                    y[static_cast<unsigned long long>(begin + col + 1) * features + r] = grad_situ(storage.gate[col + 1][feature], acc[i][n][1] * scale, beta, lb);
                if (begin + col < end && r + 8 < features)
                    y[static_cast<unsigned long long>(begin + col) * features + r + 8] = grad_situ(storage.gate[col][feature + 8], acc[i][n][2] * scale, beta, lb);
                if (begin + col + 1 < end && r + 8 < features)
                    y[static_cast<unsigned long long>(begin + col + 1) * features + r + 8] = grad_situ(storage.gate[col + 1][feature + 8], acc[i][n][3] * scale, beta, lb);
            }
        }
    }
#endif
#else
    #pragma unroll
    for (unsigned i = 0; i < 2; ++i) {
        const unsigned r = n0 + mr + 16 * i + g;
        #pragma unroll
        for (unsigned n = 0; n < 4; ++n) {
            const unsigned col = begin + mt + 8 * n + 2 * t;
            if (col < end && r < rows) y[static_cast<unsigned long long>(col) * rows + r] = acc[i][n][0] * scale;
            if (col + 1 < end && r < rows) y[static_cast<unsigned long long>(col + 1) * rows + r] = acc[i][n][1] * scale;
            if (col < end && r + 8 < rows) y[static_cast<unsigned long long>(col) * rows + r + 8] = acc[i][n][2] * scale;
            if (col + 1 < end && r + 8 < rows) y[static_cast<unsigned long long>(col + 1) * rows + r + 8] = acc[i][n][3] * scale;
        }
    }
#endif
}
"""

val kernelPrefillNvfp4I8 = "#define I8_LAUNCH_BOUNDS __launch_bounds__(256, 3)\n#define I8_KERNEL matmul_nvfp4_grouped_i8\n" + prefillNvfp4I8Body

val kernelPrefillQ8I8 = "#define I8_Q8 1\n#define I8_DENSE 1\n#define I8_KERNEL matmul_q8_0_i8\n" + prefillNvfp4I8Body
