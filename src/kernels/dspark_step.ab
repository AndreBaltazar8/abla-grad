import "attention_decode.ab"

// [step] is [anchor, P, proposal count, accepted count]. cursor is the number
// of tap rows already injected. A replay following the seed injects no rows.
private val dsparkTapRange = """
static __device__ __forceinline__ unsigned tap_rows(const unsigned *step, const unsigned *cursor,
    unsigned limit, unsigned capacity) {
    const unsigned p = step[1];
    const unsigned first = *cursor;
    if (p <= first || p > limit || step[3] >= capacity || p - first != step[3] + 1)
        return 0;
    return p - first;
}
"""

val kernelDsparkMixStep = dsparkTapRange + """
extern "C" __global__ void dspark_mix_step(const float *taps, const float *alpha, float *out,
    const unsigned *step, const unsigned *cursor, unsigned width, unsigned limit, unsigned capacity, unsigned lastOnly) {
    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    const unsigned rows = lastOnly ? 1 : capacity;
    if (i >= width * rows) return;
    const unsigned count = tap_rows(step, cursor, limit, capacity);
    const unsigned row = i / width;
    float value = 0.0f;
    if (row < count) {
        const unsigned pos = lastOnly ? step[1] - 1 : *cursor + row;
        const float *x = taps + static_cast<unsigned long long>(pos) * 4 * width + i % width;
        #pragma unroll
        for (unsigned j = 0; j < 4; ++j) value = fmaf(alpha[j], x[j * width], value);
    }
    out[i] = value;
}
"""

val kernelDsparkCommitTapsStep = dsparkTapRange + """
extern "C" __global__ void dspark_commit_taps_step(const float *mixed, float *context,
    const unsigned *step, unsigned *cursor, unsigned width, unsigned limit, unsigned capacity) {
    // One CTA prevents the cursor update from racing a lane's range check.
    if (!tap_rows(step, cursor, limit, capacity)) return;
    for (unsigned i = threadIdx.x; i < width; i += blockDim.x) context[i] = mixed[i];
    __syncthreads();
    if (threadIdx.x == 0) *cursor = step[1];
}
"""

val kernelDsparkRopeStep = """
extern "C" __global__ void dspark_rope_step(float *x, const unsigned *first, unsigned heads,
    unsigned dim, unsigned rows, float freqBase, unsigned limit) {
    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    const unsigned pairs = dim / 2;
    if (i >= rows * heads * pairs || *first >= limit) return;
    const unsigned pair = i % pairs;
    const unsigned vector = i / pairs;
    const unsigned pos = *first + vector / heads;
    const float theta = float(pos) / powf(freqBase, float(pair) / float(pairs));
    float s, c;
    sincosf(theta, &s, &c);
    float *row = x + vector * dim;
    const float a = row[pair], b = row[pair + pairs];
    row[pair] = a * c - b * s;
    row[pair + pairs] = a * s + b * c;
}
"""

val kernelDsparkKvStep = dsparkTapRange + """
extern "C" __global__ void dspark_kv_step(const float *k, const float *v, float *kc, float *vc,
    const unsigned *step, const unsigned *cursor, unsigned headDim, unsigned kvDim,
    unsigned cacheCtx, unsigned limit, unsigned capacity, unsigned block) {
    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    const unsigned row = blockIdx.y;
    if (block && step[2] == 0) return;
    const unsigned p = step[1];
    const unsigned first = block ? p : *cursor;
    const unsigned rows = block ? capacity : tap_rows(step, cursor, limit, capacity);
    if (i >= kvDim || row >= rows || first >= cacheCtx || row >= cacheCtx - first) return;
    const unsigned long long dst = (static_cast<unsigned long long>(i / headDim) * cacheCtx + first + row) * headDim + i % headDim;
    kc[dst] = k[row * kvDim + i];
    vc[dst] = v[row * kvDim + i];
}
"""

val kernelDsparkAttentionStep = kernelAttentionDecode + """
extern "C" __global__ void dspark_attention_step(const float *q, const float *k, const float *v,
    float *out, const unsigned *step, unsigned heads, unsigned kvHeads, unsigned dim,
    unsigned rows, unsigned cacheCtx, unsigned window, float scale) {
    const unsigned p = step[1];
    if (step[2] == 0 || p > cacheCtx - rows) return;
    const unsigned first = window && p >= window ? p + 1 - window : 0;
    const unsigned offset = blockIdx.y * heads * dim;
    attention<false>(q + offset, k, v, nullptr, out + offset, heads, kvHeads, dim,
                     first, p + rows - 1, 0, 0, cacheCtx, scale);
}
"""

// Each type is fixed for a loaded tensor. Q8_0 already has an equivalent gather.
val kernelDsparkGatherStep = """
extern "C" __global__ void dspark_gather_step(const unsigned char *table, const unsigned *id,
    float *out, unsigned cols, unsigned bf16) {
    const unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= cols) return;
    const unsigned long long at = static_cast<unsigned long long>(*id) * cols + i;
    out[i] = bf16 ? __uint_as_float(unsigned(reinterpret_cast<const unsigned short *>(table)[at]) << 16)
                  : reinterpret_cast<const float *>(table)[at];
}
"""

val kernelDsparkSpecStep = """
extern "C" __global__ void dspark_begin_step(unsigned *step, unsigned *spec, const unsigned *cursor,
    unsigned maxCtx, unsigned noiseLimit, unsigned nVocab, unsigned maxProposals, unsigned countIndex) {
    const unsigned p = step[1];
    const unsigned anchor = step[0];
    const bool inVocab = anchor < nVocab;
    unsigned count = 0;
    if (inVocab && p > 0 && p == *cursor && p < maxCtx && p <= noiseLimit)
        count = min(maxProposals, maxCtx - p - 1);
    step[2] = spec[countIndex] = count;
    spec[0] = inVocab ? anchor : 0;
}

extern "C" __global__ void dspark_pad_step(unsigned *spec, unsigned countIndex) {
    for (unsigned i = spec[countIndex] + 1; i < countIndex; ++i) spec[i] = 0;
}
"""

// One warp shortlists four IDs by base+bias, then computes each selected W2 dot in FP32.
val kernelDsparkShortlist = """
static __device__ __forceinline__ bool wins(float a, unsigned ai, float b, unsigned bi) {
    return a > b || (a == b && ai < bi);
}
extern "C" __global__ void dspark_shortlist_four(const float *base, const float *latent, const unsigned short *w, const float *bias,
    uint2 *pairs, unsigned n, float cap) {
    const unsigned lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
    const unsigned idx = blockIdx.x * blockDim.x + threadIdx.x;
    float s = idx < n ? base[idx] + bias[idx] : -__int_as_float(0x7f800000);
    float best = -__int_as_float(0x7f800000);
    unsigned idBest = ~0u;
    for (int rank = 0; rank < 4; ++rank) {
        float top = s;
        for (unsigned d = 16; d; d /= 2) top = fmaxf(top, __shfl_xor_sync(~0u, top, d));
        const unsigned winner = __ffs(__ballot_sync(~0u, s == top)) - 1;
        const unsigned id = __shfl_sync(~0u, idx, winner);
        if (id >= n) break;
        float dot = 0.f;
        for (unsigned c = lane; c < 256; c += 32) dot = fmaf(__uint_as_float(unsigned(w[id * 256 + c]) << 16), latent[c], dot);
        for (unsigned d = 16; d; d /= 2) dot += __shfl_down_sync(~0u, dot, d);
        if (!lane) {
            float value = cap * tanhf((base[id] + (dot + bias[id])) / cap);
            if (wins(value, id, best, idBest)) { best = value; idBest = id; }
        }
        if (lane == winner) s = -__int_as_float(0x7f800000);
    }
    __shared__ uint2 winners[4];
    if (!lane) winners[warp] = make_uint2(__float_as_uint(best), idBest);
    __syncthreads();
    if (!threadIdx.x) {
        #pragma unroll
        for (unsigned i = 1; i < 4; ++i) {
            uint2 item = winners[i];
            if (wins(__uint_as_float(item.x), item.y, best, idBest)) { best = __uint_as_float(item.x); idBest = item.y; }
        }
        pairs[blockIdx.x] = make_uint2(__float_as_uint(best), idBest);
    }
}
extern "C" __global__ void dspark_best_pair(const uint2 *pairs, unsigned *out, unsigned count) {
    __shared__ uint2 winners[256];
    float best = -__int_as_float(0x7f800000);
    unsigned id = ~0u;
    for (unsigned i = threadIdx.x; i < count; i += 256) {
        const uint2 p = pairs[i];
        const float v = __uint_as_float(p.x);
        if (wins(v, p.y, best, id)) { best = v; id = p.y; }
    }
    winners[threadIdx.x] = make_uint2(__float_as_uint(best), id);
    __syncthreads();
    for (unsigned d = 128; d; d /= 2) {
        if (threadIdx.x < d) {
            const uint2 p = winners[threadIdx.x + d];
            const float v = __uint_as_float(p.x);
            if (wins(v, p.y, best, id)) { best = v; id = p.y; winners[threadIdx.x] = p; }
        }
        __syncthreads();
    }
    if (!threadIdx.x) *out = id;
}
"""
