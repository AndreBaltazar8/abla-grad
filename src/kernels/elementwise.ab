// The small elementwise / row kernels (docs/kernels.md). One CUDA C source string per kernel; names and parameter lists are the contract.
// Geometry (for the backend registry): the elementwise kernels use blocks of 256 threads, 256 problem items per block; l2clip one block of 128
// threads per row; argmax a single block of 1024 threads.

val kernelAdd = """
extern "C" __global__ void add(const float *a, const float *b, float *out, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) out[i] = a[i] + b[i];
}
"""

val kernelCopyF32 = """
extern "C" __global__ void copy_f32(const float *src, float *dst, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) dst[i] = src[i];
}
"""

val kernelScaleF32 = """
extern "C" __global__ void scale_f32(float *x, float s, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) x[i] *= s;
}
"""

val kernelSiluMul = """
extern "C" __global__ void silu_mul(const float *gate, const float *up, float *out, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) {
        float g = gate[i];
        out[i] = g / (1.0f + expf(-g)) * up[i];
    }
}
"""

val kernelSoftcap = """
extern "C" __global__ void softcap(float *x, float cap, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) x[i] = cap * tanhf(x[i] / cap);
}
"""

val kernelSigmoidMul = """
extern "C" __global__ void sigmoid_mul(const float *a, const float *g, float *out, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) out[i] = a[i] / (1.0f + expf(-g[i]));
}
"""

// gateUp slot i holds nFf gate values then nFf up values. out[i*nFf + j] = beta*tanh(g/beta)*sigmoid(g) * (lb > 0 ? lb*tanh(u/lb) : u).
val kernelSituDeviceSource = """
static __device__ __forceinline__ float grad_situ(float g, float u, float beta, float lb) {
    float act = beta * tanhf(g / beta) * (1.0f / (1.0f + expf(-g)));
    float lin = lb > 0.0f ? lb * tanhf(u / lb) : u;
    return act * lin;
}
"""

val kernelSitu = kernelSituDeviceSource + "\n" + """
extern "C" __global__ void situ(const float *gateUp, float *out, unsigned nUsed, unsigned nFf, float beta, float lb) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= nUsed * nFf) return;
    unsigned slot = i / nFf;
    unsigned j = i % nFf;
    float g = gateUp[(unsigned long long)slot * 2 * nFf + j];
    float u = gateUp[(unsigned long long)slot * 2 * nFf + nFf + j];
    out[i] = grad_situ(g, u, beta, lb);
}
"""

val kernelControlMix = """
extern "C" __global__ void control_mix(const float *cur, const float *message, const float *gain, const float *forget, float *out, unsigned n) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) out[i] = cur[i] - tanhf(forget[i]) * cur[i] + tanhf(gain[i]) * message[i];
}
"""

// k and v are [kvHead][headDim]; the caches are [kvHead][maxCtx][headDim] (the pointers already point at the layer's slab).
val kernelKvStore = """
extern "C" __global__ void kv_store(const float *k, const float *v, float *kCache, float *vCache, unsigned pos,
                                    unsigned nKvHead, unsigned headDim, unsigned maxCtx) {
    unsigned i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= nKvHead * headDim) return;
    unsigned head = i / headDim;
    unsigned d = i % headDim;
    unsigned long long at = ((unsigned long long)head * maxCtx + pos) * headDim + d;
    kCache[at] = k[i];
    vCache[at] = v[i];
}
"""

// One block per row (dim <= any size; threads stride over it). v = scale ? x*scale : x; y = v * t / max(|v|_2, t). In place allowed.
val kernelL2Clip = """
extern "C" __global__ void l2clip(const float *x, const float *scale, float *y, unsigned rows, unsigned dim, float t) {
    unsigned row = blockIdx.x;
    if (row >= rows) return;
    const float *xr = x + (unsigned long long)row * dim;
    const float *sr = scale ? scale + (unsigned long long)row * dim : 0;
    float *yr = y + (unsigned long long)row * dim;
    __shared__ float partial[128];
    float sum = 0.0f;
    for (unsigned d = threadIdx.x; d < dim; d += blockDim.x) {
        float v = sr ? xr[d] * sr[d] : xr[d];
        sum += v * v;
    }
    partial[threadIdx.x] = sum;
    __syncthreads();
    for (unsigned width = blockDim.x / 2; width; width /= 2) {
        if (threadIdx.x < width) partial[threadIdx.x] += partial[threadIdx.x + width];
        __syncthreads();
    }
    float norm = sqrtf(partial[0]);
    float factor = t / fmaxf(norm, t);
    for (unsigned d = threadIdx.x; d < dim; d += blockDim.x) {
        float v = sr ? xr[d] * sr[d] : xr[d];
        yr[d] = v * factor;
    }
}
"""

// Index of the largest value (the lowest index on ties). A single block of 1024 threads.
val kernelArgmax = """
extern "C" __global__ void argmax(const float *x, unsigned n, unsigned *out) {
    __shared__ float bestValue[1024];
    __shared__ unsigned bestIndex[1024];
    float value = -3.402823466e38f;
    unsigned index = 0xffffffffu;
    for (unsigned i = threadIdx.x; i < n; i += blockDim.x) {
        if (x[i] > value || index == 0xffffffffu) {
            value = x[i];
            index = i;
        }
    }
    bestValue[threadIdx.x] = value;
    bestIndex[threadIdx.x] = index;
    __syncthreads();
    for (unsigned width = blockDim.x / 2; width; width /= 2) {
        if (threadIdx.x < width) {
            float other = bestValue[threadIdx.x + width];
            unsigned otherIndex = bestIndex[threadIdx.x + width];
            if (otherIndex != 0xffffffffu &&
                (bestIndex[threadIdx.x] == 0xffffffffu || other > bestValue[threadIdx.x] ||
                 (other == bestValue[threadIdx.x] && otherIndex < bestIndex[threadIdx.x]))) {
                bestValue[threadIdx.x] = other;
                bestIndex[threadIdx.x] = otherIndex;
            }
        }
        __syncthreads();
    }
    if (threadIdx.x == 0) out[0] = bestIndex[0];
}
"""
