val kernelRmsnorm = """
static __device__ __forceinline__ float rmsnorm_factor(float sum, unsigned n, float eps, float *sums) {
    unsigned lane = threadIdx.x;
    sums[lane] = sum;
    __syncthreads();
    if (lane < 32) {
        // Combine the first two levels in the same order as the old
        // 128-thread tree. The rest of the tree stays inside one warp.
        float lower = sums[lane] + sums[lane + 64];
        float upper = sums[lane + 32] + sums[lane + 96];
        sum = lower + upper;
        for (unsigned width = 16; width; width /= 2) {
            sum += __shfl_down_sync(0xffffffffu, sum, width);
        }
        if (lane == 0) sums[0] = rsqrtf(sum / float(n) + eps);
    }
    __syncthreads();
    return sums[0];
}

static __device__ __forceinline__ void rmsnorm_2304(const float *x, const float *w,
    float *y, float eps, float *sums) {
    const unsigned lane = threadIdx.x;
    float activation[18];
    float sum = 0.0f;
    #pragma unroll
    for (unsigned i = 0; i < 18; ++i) {
        activation[i] = x[lane + i * 128];
        sum = fmaf(activation[i], activation[i], sum);
    }
    const float factor = rmsnorm_factor(sum, 2304, eps, sums);
    if (w) {
        #pragma unroll
        for (unsigned i = 0; i < 18; ++i) {
            unsigned j = lane + i * 128;
            y[j] = (activation[i] * factor) * w[j];
        }
    } else {
        #pragma unroll
        for (unsigned i = 0; i < 18; ++i) y[lane + i * 128] = activation[i] * factor;
    }
}

extern "C" __global__ void rmsnorm(const float *x, const float *w, float *y,
                                    unsigned n, float eps) {
    __shared__ float sums[128];
    unsigned lane = threadIdx.x;
    unsigned long long base = static_cast<unsigned long long>(blockIdx.x) * n;
    if (n == 2304) {
        rmsnorm_2304(x + base, w, y + base, eps, sums);
        return;
    }
    float sum = 0.0f;
    for (unsigned long long i = lane; i < n; i += blockDim.x) {
        float v = x[base + i];
        sum = fmaf(v, v, sum);
    }
    float factor = rmsnorm_factor(sum, n, eps, sums);
    for (unsigned long long i = lane; i < n; i += blockDim.x) {
        float value = x[base + i] * factor;
        y[base + i] = w ? value * w[i] : value;
    }
}
"""
