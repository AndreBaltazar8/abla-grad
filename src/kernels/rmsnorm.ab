val kernelRmsnorm = """
extern "C" __global__ void rmsnorm(const float *x, const float *w, float *y,
                                    unsigned n, float eps) {
    __shared__ float sums[128];
    unsigned lane = threadIdx.x;
    unsigned long long base = static_cast<unsigned long long>(blockIdx.x) * n;
    float sum = 0.0f;
    for (unsigned long long i = lane; i < n; i += blockDim.x) {
        float v = x[base + i];
        sum = fmaf(v, v, sum);
    }
    sums[lane] = sum;
    __syncthreads();
    if (lane < 32) {
        // Combine the first two levels in the same order as the old
        // 128-thread tree. The rest of the tree stays inside one warp.
        float lower = sums[lane] + sums[lane + 64];
        float upper = sums[lane + 32] + sums[lane + 96];
        sum = lower + upper;
        for (unsigned width = 16; width; width /= 2) {
            sum += __shfl_down_sync(0xffffffffu, sum, width);
        }
        if (lane == 0) sums[0] = rsqrtf(sum / float(n) + eps);
    }
    __syncthreads();
    float factor = sums[0];
    for (unsigned long long i = lane; i < n; i += blockDim.x) {
        float value = x[base + i] * factor;
        y[base + i] = w ? value * w[i] : value;
    }
}
"""
