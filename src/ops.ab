fun opArgmax(var backend: Backend, x: DeviceBuffer, xOffset: int, n: int, out: DeviceBuffer, outOffset: int): bool =
    backend.launch("argmax", kernelArgs().pointer(x, xOffset).u32(n).pointer(out, outOffset), [1])

fun opCopy(var backend: Backend, src: DeviceBuffer, srcOffset: int, dst: DeviceBuffer, dstOffset: int, n: int): bool =
    backend.launch("copy_f32", kernelArgs().pointer(src, srcOffset).pointer(dst, dstOffset).u32(n), [n])

// ---- Inkling additions (docs/engine.md) ----

// Weightless rmsnorm (the weight pointer is null).
fun opRmsNormPlain(
    var backend: Backend, x: DeviceBuffer, xOffset: int, y: DeviceBuffer, yOffset: int, n: int, eps: f32, vectors: int
): bool = backend.launch(
    "rmsnorm", kernelArgs().pointer(x, xOffset).u64(0).pointer(y, yOffset).u32(n).f32(eps), [vectors]
)

// `scale` (rows * dim values) when `useScale`, else none.
fun opL2Clip(
    var backend: Backend, x: DeviceBuffer, xOffset: int, scale: DeviceBuffer, scaleOffset: int, useScale: bool,
    y: DeviceBuffer, yOffset: int, rows: int, dim: int, t: f32
): bool {
    if (useScale) {
        return backend.launch(
            "l2clip", kernelArgs().pointer(x, xOffset).pointer(scale, scaleOffset).pointer(y, yOffset).u32(rows).u32(dim).f32(t), [rows]
        )
    }
    backend.launch("l2clip", kernelArgs().pointer(x, xOffset).u64(0).pointer(y, yOffset).u32(rows).u32(dim).f32(t), [rows])
}

fun opScale(var backend: Backend, x: DeviceBuffer, xOffset: int, s: f32, n: int): bool =
    backend.launch("scale_f32", kernelArgs().pointer(x, xOffset).f32(s).u32(n), [n])

fun opSigmoidMul(
    var backend: Backend, a: DeviceBuffer, aOffset: int, g: DeviceBuffer, gOffset: int, out: DeviceBuffer, outOffset: int, n: int
): bool = backend.launch(
    "sigmoid_mul", kernelArgs().pointer(a, aOffset).pointer(g, gOffset).pointer(out, outOffset).u32(n), [n]
)

// states = bank[0..nBank) (n floats each, contiguous) + cur; out = [nQuery][n].
fun opDepthMix(
    var backend: Backend, bank: DeviceBuffer, bankOffset: int, nBank: int, cur: DeviceBuffer, curOffset: int,
    queries: DeviceBuffer, queriesOffset: int, nQuery: int, out: DeviceBuffer, outOffset: int, n: int, eps: f32
): bool = backend.launch(
    "depth_mix",
    kernelArgs().pointer(bank, bankOffset).u32(nBank).pointer(cur, curOffset).pointer(queries, queriesOffset).u32(nQuery)
        .pointer(out, outOffset).u32(n).f32(eps),
    [nQuery]
)

fun opConvStep(
    var backend: Backend, x: DeviceBuffer, xOffset: int, history: DeviceBuffer, historyOffset: int, w: DeviceBuffer, wOffset: int,
    dyn: DeviceBuffer, dynOffset: int, useDyn: bool, out: DeviceBuffer, outOffset: int,
    channels: int, nConv: int, heads: int, outScale: f32
): bool {
    if (useDyn) {
        return backend.launch(
            "conv_step",
            kernelArgs().pointer(x, xOffset).pointer(history, historyOffset).pointer(w, wOffset).pointer(dyn, dynOffset)
                .pointer(out, outOffset).u32(channels).u32(nConv).u32(heads).f32(outScale),
            [channels]
        )
    }
    backend.launch(
        "conv_step",
        kernelArgs().pointer(x, xOffset).pointer(history, historyOffset).pointer(w, wOffset).u64(0)
            .pointer(out, outOffset).u32(channels).u32(nConv).u32(heads).f32(outScale),
        [channels]
    )
}

fun opRelTable(
    var backend: Backend, relBias: DeviceBuffer, relBiasOffset: int, r: DeviceBuffer, rOffset: int, sinks: DeviceBuffer, sinksOffset: int,
    table: DeviceBuffer, tableOffset: int, nRel: int, extent: int, nHead: int
): bool = backend.launch(
    "rel_table",
    kernelArgs().pointer(relBias, relBiasOffset).pointer(r, rOffset).pointer(sinks, sinksOffset).pointer(table, tableOffset)
        .u32(nRel).u32(extent).u32(nHead),
    [nHead * (extent + 1)]
)

fun opAttentionDecodeRel(
    var backend: Backend, q: DeviceBuffer, qOffset: int, kCache: DeviceBuffer, kCacheOffset: int, vCache: DeviceBuffer, vCacheOffset: int,
    table: DeviceBuffer, tableOffset: int, out: DeviceBuffer, outOffset: int,
    nHead: int, nKvHead: int, headDim: int, first: int, last: int, pos: int, extent: int, maxCtx: int, scale: f32, ring: bool = false, half: bool = false, q8: bool = false, fp8: bool = false
): bool = backend.launch(
    "attention_decode_rel" + kvKernelSuffix(ring, half, q8, fp8),
    kernelArgs().pointer(q, qOffset).pointer(kCache, kCacheOffset).pointer(vCache, vCacheOffset).pointer(table, tableOffset)
        .pointer(out, outOffset).u32(nHead).u32(nKvHead).u32(headDim).u32(first).u32(last).u32(pos).u32(extent).u32(maxCtx).f32(scale),
    [nHead]
)

fun opMoeRoute(
    var backend: Backend, logits: DeviceBuffer, logitsOffset: int, bias: DeviceBuffer, biasOffset: int, useBias: bool,
    nExpert: int, k: int, ids: DeviceBuffer, idsOffset: int, weights: DeviceBuffer, weightsOffset: int, normEps: f32, weightScale: f32
): bool {
    if (useBias) {
        return backend.launch(
            "moe_route",
            kernelArgs().pointer(logits, logitsOffset).pointer(bias, biasOffset).u32(nExpert).u32(k).pointer(ids, idsOffset)
                .pointer(weights, weightsOffset).f32(normEps).f32(weightScale),
            [1]
        )
    }
    backend.launch(
        "moe_route",
        kernelArgs().pointer(logits, logitsOffset).u64(0).u32(nExpert).u32(k).pointer(ids, idsOffset)
            .pointer(weights, weightsOffset).f32(normEps).f32(weightScale),
        [1]
    )
}

fun opSitu(
    var backend: Backend, gateUp: DeviceBuffer, gateUpOffset: int, out: DeviceBuffer, outOffset: int,
    nUsed: int, nFf: int, beta: f32, lb: f32
): bool = backend.launch(
    "situ", kernelArgs().pointer(gateUp, gateUpOffset).pointer(out, outOffset).u32(nUsed).u32(nFf).f32(beta).f32(lb), [nUsed * nFf]
)

fun opControlMix(
    var backend: Backend, cur: DeviceBuffer, curOffset: int, message: DeviceBuffer, messageOffset: int,
    gain: DeviceBuffer, gainOffset: int, forget: DeviceBuffer, forgetOffset: int, out: DeviceBuffer, outOffset: int, n: int
): bool = backend.launch(
    "control_mix",
    kernelArgs().pointer(cur, curOffset).pointer(message, messageOffset).pointer(gain, gainOffset).pointer(forget, forgetOffset)
        .pointer(out, outOffset).u32(n),
    [n]
)

// ---- per-token step buffer (u32[4]: token, position, reserved x2); kernels in src/kernels/step.ab ----
fun opKvStoreStep(
    var backend: Backend, k: DeviceBuffer, kOffset: int, v: DeviceBuffer, vOffset: int,
    kCache: DeviceBuffer, kCacheOffset: int, vCache: DeviceBuffer, vCacheOffset: int,
    step: DeviceBuffer, nKvHead: int, headDim: int, maxCtx: int, ring: bool = false, half: bool = false, q8: bool = false, fp8: bool = false
): bool = backend.launch(
    "kv_store_step" + kvKernelSuffix(ring, half, q8, fp8),
    kernelArgs().pointer(k, kOffset).pointer(v, vOffset).pointer(kCache, kCacheOffset).pointer(vCache, vCacheOffset)
        .pointer(step, 0).u32(nKvHead).u32(headDim).u32(maxCtx),
    [nKvHead * headDim]
)

fun opScaleTau(var backend: Backend, x: DeviceBuffer, xOffset: int, step: DeviceBuffer, logFloor: f32, alpha: f32, n: int): bool =
    backend.launch("scale_tau", kernelArgs().pointer(x, xOffset).pointer(step, 0).f32(logFloor).f32(alpha).u32(n), [n])

fun opStepAdvance(var backend: Backend, step: DeviceBuffer): bool =
    backend.launch("step_advance", kernelArgs().pointer(step, 0), [1])

// The token and position come from `step` (e7's kernels: gather_row_q8_0_step, attention_decode_rel_step).
fun opGatherRowStep(
    var backend: Backend, kind: string, table: DeviceBuffer, tableOffset: int, step: DeviceBuffer, out: DeviceBuffer, outOffset: int, cols: int
): bool = backend.launch(
    "gather_row_${kind}_step", kernelArgs().pointer(table, tableOffset).pointer(step, 0).pointer(out, outOffset).u32(cols), [cols]
)

fun opAttentionDecodeRelStep(
    var backend: Backend, q: DeviceBuffer, qOffset: int, kCache: DeviceBuffer, kCacheOffset: int, vCache: DeviceBuffer, vCacheOffset: int,
    table: DeviceBuffer, tableOffset: int, out: DeviceBuffer, outOffset: int, step: DeviceBuffer,
    nHead: int, nKvHead: int, headDim: int, window: int, extent: int, maxCtx: int, scale: f32, ring: bool = false, half: bool = false, q8: bool = false, fp8: bool = false
): bool = backend.launch(
    "attention_decode_rel_step" + kvKernelSuffix(ring, half, q8, fp8),
    kernelArgs().pointer(q, qOffset).pointer(kCache, kCacheOffset).pointer(vCache, vCacheOffset).pointer(table, tableOffset)
        .pointer(out, outOffset).pointer(step, 0).u32(nHead).u32(nKvHead).u32(headDim).u32(window).u32(extent).u32(maxCtx).f32(scale),
    [nHead]
)

fun opStepRecord(var backend: Backend, step: DeviceBuffer): bool =
    backend.launch("step_record", kernelArgs().pointer(step, 0), [1])

// Split-position relative attention: nSplit blocks per head write partials, a merge block per head folds them (with the sink) into `out`.
// `part` needs nHead * nSplit * (headDim + 2) floats.
fun opAttentionRelSplitStep(
    var backend: Backend, q: DeviceBuffer, qOffset: int, kCache: DeviceBuffer, kCacheOffset: int, vCache: DeviceBuffer, vCacheOffset: int,
    table: DeviceBuffer, tableOffset: int, part: DeviceBuffer, partOffset: int, out: DeviceBuffer, outOffset: int, step: DeviceBuffer,
    nHead: int, nKvHead: int, headDim: int, window: int, extent: int, maxCtx: int, scale: f32, nSplit: int,
    gate: DeviceBuffer, gateOffset: int, useGate: bool, ring: bool = false, half: bool = false, q8: bool = false, grouped: bool = false, fp8: bool = false
): bool {
    val kernel = if (ring && half && !grouped && !q8 && !fp8 && headDim == 128 && nHead == 3 * nKvHead) "attention_rel_split_step_ring_f16_128"
        else (if (grouped) "attention_rel_grouped_step" else "attention_rel_split_step") + kvKernelSuffix(ring, half, q8, fp8)
    val ok = backend.launch(
        kernel,
        kernelArgs().pointer(q, qOffset).pointer(kCache, kCacheOffset).pointer(vCache, vCacheOffset).pointer(table, tableOffset)
            .pointer(part, partOffset).pointer(step, 0).u32(nHead).u32(nKvHead).u32(headDim).u32(window).u32(extent).u32(maxCtx).f32(scale).u32(nSplit),
        [(if (grouped) nKvHead else nHead) * nSplit]
    )
    if (useGate) {
        // the merge applies the attention output gate: out = merged * sigmoid(gate)
        return ok && backend.launch(
            "attention_rel_merge_gated",
            kernelArgs().pointer(part, partOffset).pointer(out, outOffset).pointer(gate, gateOffset).u32(nHead).u32(headDim).u32(nSplit), [nHead]
        )
    }
    ok && backend.launch(
        "attention_rel_merge", kernelArgs().pointer(part, partOffset).pointer(out, outOffset).u32(nHead).u32(headDim).u32(nSplit), [nHead]
    )
}

// The generated gate/up -> SiTU kernel (src/kernels/fused_gate_up_situ.ab): one launch for opMatvecIndexed("nvfp4") + opSitu on the Inkling 2 Mini shapes.
fun opGateUpSitu(
    var backend: Backend, gateUp: DeviceBuffer, gateUpOffset: int, x: DeviceBuffer, xOffset: int, ids: DeviceBuffer, idsOffset: int,
    scales: DeviceBuffer, scalesOffset: int, useScales: bool, out: DeviceBuffer, outOffset: int, nFf: int, nUsed: int
): bool {
    val args = kernelArgs().pointer(gateUp, gateUpOffset).pointer(x, xOffset).pointer(ids, idsOffset)
    if (useScales) args.pointer(scales, scalesOffset) else args.u64(0)
    backend.launch(inklingGateUpSitu.name, args.pointer(out, outOffset), [nFf, nUsed])
}

// Hidden-state taps for the speculative drafter: tap[pos][slot] = src (n floats), pos from the step buffer.
fun opTapStoreStep(
    var backend: Backend, src: DeviceBuffer, srcOffset: int, tap: DeviceBuffer, step: DeviceBuffer, n: int, slot: int, slots: int, ring: bool = false
): bool = backend.launch(
    if (ring) "tap_store_step_tap_ring" else "tap_store_step", kernelArgs().pointer(src, srcOffset).pointer(tap, 0).pointer(step, 0).u32(n).u32(slot).u32(slots), [n]
)

// ---- speculation cycle (docs/engine.md) ----
fun opSpecBegin(var backend: Backend, step: DeviceBuffer, spec: DeviceBuffer): bool =
    backend.launch("spec_begin", kernelArgs().pointer(step, 0).pointer(spec, 0), [1])

fun opSpecAccept(var backend: Backend, step: DeviceBuffer, spec: DeviceBuffer, maxCtx: int): bool =
    backend.launch("spec_accept", kernelArgs().pointer(step, 0).pointer(spec, 0).u32(maxCtx), [1])

fun opCopySelect(var backend: Backend, src: DeviceBuffer, srcOffset: int, dst: DeviceBuffer, dstOffset: int, step: DeviceBuffer, n: int, strideFloats: int): bool =
    backend.launch("copy_select_f32", kernelArgs().pointer(src, srcOffset).pointer(dst, dstOffset).pointer(step, 0).u32(n).u32(strideFloats), [n])

// Layout v2 (up to 4 proposals): see src/kernels/step.ab.
fun opSpecAcceptN(var backend: Backend, step: DeviceBuffer, spec: DeviceBuffer, maxCtx: int): bool =
    backend.launch("spec_accept_n", kernelArgs().pointer(step, 0).pointer(spec, 0).u32(maxCtx), [1])

// ---- fused elementwise tails (src/kernels/tail_fused.ab) ----
fun opConvStepResidual(
    var backend: Backend, x: DeviceBuffer, xOffset: int, history: DeviceBuffer, historyOffset: int, w: DeviceBuffer, wOffset: int,
    out: DeviceBuffer, outOffset: int, residual: DeviceBuffer, residualOffset: int, channels: int, nConv: int, outScale: f32
