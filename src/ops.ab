): bool = backend.launch(
    "gather_row_$kind", kernelArgs().pointer(table, tableOffset).u32(token).pointer(out, outOffset).u32(cols), [cols]
)

fun opTopkSoftmax(
    var backend: Backend, logits: DeviceBuffer, logitsOffset: int, nExpert: int, k: int,
