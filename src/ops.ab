// Two weightless norms followed by the static-shape controller down projection.
fun opControllerNormDown(
    var backend: Backend, cur: DeviceBuffer, curOffset: int, message: DeviceBuffer, messageOffset: int,
    weights: DeviceBuffer, weightOffset: int, out: DeviceBuffer, outOffset: int
): bool = backend.launch(inklingControllerNormDown.name,
    kernelArgs().pointer(cur, curOffset).pointer(message, messageOffset).pointer(weights, weightOffset)
        .pointer(out, outOffset), inklingControllerNormDown.geometry.problem)
