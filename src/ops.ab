)

fun opMoeCombineConvResidual(
    var backend: Backend, expertOut: DeviceBuffer, expertOutOffset: int, weights: DeviceBuffer, weightsOffset: int, history: DeviceBuffer, historyOffset: int,
    w: DeviceBuffer, wOffset: int, out: DeviceBuffer, outOffset: int, residual: DeviceBuffer, residualOffset: int,
    rows: int, nUsed: int, nConv: int, outScale: f32
