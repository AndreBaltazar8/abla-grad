// `abla-grad chat <model.gguf> [--tokenizer PATH] [--drafter PATH] [--system TEXT] [--ctx N] [--max-tokens N] [--show-thinking] [--speculate off]`:
// an interactive multi-turn chat with an Inkling model. The model's KV caches, convolution histories and drafter taps stay between turns, so a turn
// processes only its own new tokens (the previous reply is already there); the reply streams as it is decoded, greedily, with speculative decoding.
// Commands at the prompt: /reset starts a new conversation, /quit leaves (so does end of input), /help.
import "abla/io"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "abla/process/time"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/speculate.ab"
import "../tokenizer/tokenizer.ab"
import "chat.ab"
import "generate.ab"
import "utf8_stream.ab"

private val CHAT_DEFAULT_CTX = 8192
private val CHAT_DEFAULT_MAX_TOKENS = 1024

private fun chatFail(message: string): int {
    eprintln("chat: $message")
    1
}

private fun chatDrafterPath(model: string): string {
    val slash = model.lastIndexOf("/")
    val directory = if (slash >= 0) model.codePointSlice(0, slash + 1) else ""
    "${directory}dspark-Inkling-2-Mini-Q8_0.gguf"
}

// The id of a special token spelled `text`, or -1.
private fun chatSpecialId(tokenizer: Tokenizer, text: string): int {
    val ids = tokenizer.encode(text, false, true)
    if (ids.size == 1) ids[0] else -1
}

private fun chatHelp(): void {
    println("  /reset   forget the conversation and start again")
    println("  /quit    leave (so does end of input)")
    println("  /help    this text")
}

fun cmdChat(args: array<string>): int {
    var modelPath = ""
    var tokenizerPath = ""
    var drafterPath = ""
    var system = ""
    var context = CHAT_DEFAULT_CTX
    var maxTokens = CHAT_DEFAULT_MAX_TOKENS
    var showThinking = false
    var speculate = true
    var index = 0
    while (index < args.size) {
        val flag = args[index]
        if (flag == "--tokenizer" && index + 1 < args.size) {
            tokenizerPath = args[index + 1]
            index = index + 2
        } else if (flag == "--drafter" && index + 1 < args.size) {
            drafterPath = args[index + 1]
            index = index + 2
        } else if (flag == "--system" && index + 1 < args.size) {
            system = args[index + 1]
            index = index + 2
        } else if (flag == "--ctx" && index + 1 < args.size) {
            context = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--max-tokens" && index + 1 < args.size) {
            maxTokens = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--show-thinking") {
            showThinking = true
            index = index + 1
        } else if (flag == "--speculate" && index + 1 < args.size) {
            speculate = args[index + 1] != "off"
            index = index + 2
        } else if (modelPath == "" && !flag.startsWith("--")) {
            modelPath = flag
            index = index + 1
        } else {
            eprintln("chat: unknown or incomplete option $flag")
            return 2
        }
    }
    if (modelPath == "" || context < 256 || maxTokens < 1) {
        eprintln("usage: abla-grad chat <model.gguf> [--tokenizer PATH] [--drafter PATH] [--system TEXT] [--ctx N] [--max-tokens N] [--show-thinking] [--speculate off]")
        return 2
    }
    val file = ggufOpen(modelPath) ?? return chatFail(ggufLastError())
    val architecture = file.getString("general.architecture") ?? ""
    if (!isInklingChat(architecture)) return chatFail("chat supports Inkling models (architecture '$architecture')")
    val config = inklingConfigFrom(file) ?? return chatFail(inklingConfigLastError())
    val tokenizer = (if (tokenizerPath == "") tokenizerFromGguf(file) else tokenizerFromJson(tokenizerPath)) ?? return chatFail(tokenizerLastError())
    if (config.nVocab != tokenizer.vocabSize()) return chatFail("tokenizer vocabulary size does not match the model")
    if (context > (file.getInt("$architecture.context_length") ?? context)) return chatFail("--ctx exceeds the model context length")
    val draftFile = ggufOpen(if (drafterPath != "") drafterPath else chatDrafterPath(modelPath))
    if (draftFile == null) {
        return chatFail("the drafter model is missing (${ggufLastError()}); put dspark-Inkling-2-Mini-Q8_0.gguf next to the model or pass --drafter PATH")
    }
    val stops = generationStops(file, tokenizer, architecture)
    val idThinking = chatSpecialId(tokenizer, "<|content_thinking|>")
    val idText = chatSpecialId(tokenizer, "<|content_text|>")
    var backend = cudaBackend() ?? return chatFail(cudaLastError())
    eprintln("chat: loading the model...")
    var model = inklingLoad(backend, file, config, context + SPEC_CONTEXT_SLACK) ?? return chatFail(inklingLastError())
    if (!model.reset(backend)) return chatFail("could not reset the model (${cudaLastError()})")
    var session = specSessionCreate(backend, model, draftFile, SPEC_DEFAULT_PROPOSALS) ?? return chatFail(speculateLastError())
    session.exactWindow = 192
    println("Inkling chat. /help lists the commands; the model, the drafter and the conversation stay loaded between turns.")
    var turns = 0
    while (true) {
        print("\n> ")
        val line = readInputLine()
        if (!line.available) {
            println()
            break
        }
        val message = line.text.trim()
        if (message == "") continue
        if (message == "/quit" || message == "/exit") break
        if (message == "/help") {
            chatHelp()
            continue
        }
        if (message == "/reset") {
            if (!model.reset(backend)) return chatFail("could not reset the model (${cudaLastError()})")
            session.restart()
            turns = 0
            println("(new conversation)")
            continue
        }
        // this turn's tokens: the very first turn carries the template's prologue, later turns only the new user message
        val text = if (turns == 0) (renderChat(architecture, if (system != "") [ChatMessage("system", system), ChatMessage("user", message)]
            else [ChatMessage("user", message)], utcNow()) ?? return chatFail("could not render the prompt"))
            else "<|message_user|><|content_text|>$message<|end_message|>"
        val tokens = tokenizer.encode(text, turns == 0, true)
        if (session.seq.size + tokens.size + maxTokens + SPEC_CONTEXT_SLACK > context + SPEC_CONTEXT_SLACK) {
            println("(the conversation is full: /reset to start again, or lower --max-tokens)")
            continue
        }
        session.append(tokens)
        // the reply streams out as batches commit; thinking is hidden unless --show-thinking
        var mode = 0
        var thinkingShown = false
        val stream = Utf8TokenStream()
        var generated = 0
        var stats = SpecStats()
        val started = monotonicNanoseconds()
        val ok = session.turn(backend, model, maxTokens, stops, true, !speculate, SpecControl(), stats, { token ->
            generated = generated + 1
            if (token == idThinking) {
                mode = 1
                if (showThinking) print("\u001b[2m") else {
                    print("\u001b[2m...\u001b[0m")
                    thinkingShown = true
                }
            } else if (token == idText) {
                if (mode == 1 && showThinking) print("\u001b[0m\n")
                if (thinkingShown) print("\r\u001b[K")
                thinkingShown = false
                mode = 2
            } else {
                val piece = tokenizer.decode([token])
                val special = piece.startsWith("<|") && piece.endsWith("|>")
                if (!special && (mode == 2 || (mode == 1 && showThinking))) print(stream.push(piece))
            }
        })
        if (!ok) return chatFail(speculateLastError())
        print(stream.finish())
        if (mode == 1 && showThinking) print("\u001b[0m")
        println()
        // a reply cut off by --max-tokens is closed so the next turn continues a well-formed history
        if (generated >= maxTokens) {
            session.append(tokenizer.encode("<|end_message|><|content_model_end_sampling|>", false, true))
        }
        val seconds = f64FromInt(monotonicNanoseconds() - started) / 1000000000.0
        val feedSeconds = f64FromInt(stats.feedNanos) / 1000000000.0
        eprintln("[${stats.fedTokens} tokens processed in ${feedSeconds} s, ${generated} generated in ${seconds - feedSeconds} s = ${f64FromInt(generated) / (seconds - feedSeconds)} tok/s; loop ${f64FromInt(stats.loopNanos) / 1000000000.0} s; ${stats.cycleTokens} in cycles, ${stats.plainTokens} plain, ${stats.switches} switches]")
        turns = turns + 1
    }
    0
}
