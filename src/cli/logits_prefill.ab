// Inkling logits through the batched prefill (`abla-grad logits --prefill [--chunk N]`) and the prefill benchmark (`abla-grad prefill-bench`).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/process/time"
import "abla/float"
import "abla/math"
import "abla/float/text"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/inkling_prefill.ab"

// The logits of every position of `ids`, computed chunk by chunk with prefill; null on failure (the message is printed).
fun inklingPrefillLogits(var backend: Backend, model: InklingModel, ids: array<int>, chunk: int): array<f32>? {
    val ws = prefillWorkspace(backend, model.config, chunk, true)
    if (ws == null) {
        println("logits: ${inklingPrefillLastError()}")
        return null
    }
    val all: array<f32> = []
    var done = 0
    while (done < ids.size) {
        val count = if (ids.size - done < chunk) ids.size - done else chunk
        val part: array<int> = []
        for (i in 0 until count) part.append(ids[done + i])
        if (!model.prefill(backend, ws, part, done)) {
            println("logits: ${inklingPrefillLastError()} (${cudaLastError()})")
            return null
        }
        for (row in 0 until count) {
            val values = model.readPrefillLogits(backend, ws, row)
            if (values == null) {
                println("logits: ${inklingPrefillLastError()}")
                return null
            }
            for (value in values) all.append(value)
        }
        done = done + count
    }
    all
}

private fun loadFailed(): int {
    println("prefill-bench: ${inklingLastError()}")
    1
}

// abla-grad prefill-bench <model.gguf> [--tokens N] [--chunk N] [--reps N] [--decode]: tokens per second of prompt processing (the logits of the last token).
fun cmdPrefillBench(args: array<string>): int {
    var tokens = 512
    var chunk = 512
    var reps = 3
    var decode = false
    var path = ""
    var index = 0
    while (index < args.size) {
        if (args[index] == "--tokens" && index + 1 < args.size) {
            tokens = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--chunk" && index + 1 < args.size) {
            chunk = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--reps" && index + 1 < args.size) {
            reps = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--moe-tile" && index + 1 < args.size) {
            setPrefillMoeTile(args[index + 1].parseInt() ?? 32)
            index = index + 2
        } else if (args[index] == "--decode") {
            decode = true
            index = index + 1
        } else {
            path = args[index]
            index = index + 1
        }
    }
    if (path == "" || tokens < 1 || chunk < 1 || reps < 1) {
        println("usage: abla-grad prefill-bench <model.gguf> [--tokens N] [--chunk N] [--reps N] [--decode]")
        return 2
    }
    val file = ggufOpen(path)
    if (file == null) {
        println("prefill-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file)
    if (config == null) {
        println("prefill-bench: ${inklingConfigLastError()}")
        return 2
    }
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, tokens + 8) ?? return loadFailed()
    val ids: array<int> = []
    for (i in 0 until tokens) ids.append((i * 7919 + 1013) % 150000 + 500)
    val ws = if (decode) null else prefillWorkspace(backend, config, chunk, false)
    if (!decode && ws == null) {
        println("prefill-bench: ${inklingPrefillLastError()}")
        return 1
    }
    for (rep in 0 until reps + 1) {
        if (!model.reset(backend)) return 1
        val start = monotonicNanoseconds()
        if (decode) {
            for (position in 0 until tokens) if (!model.forward(backend, ids[position], position)) return 1
        } else if (ws != null && !model.prefill(backend, ws, ids, 0)) {
            println("prefill-bench: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        if (!backend.synchronize()) return 1
        val seconds = f64FromInt(monotonicNanoseconds() - start) / 1000000000.0
        val label = if (rep == 0) "warmup" else "run $rep"
        println("prefill-bench ($label): $tokens tokens in ${seconds * 1000.0} ms = ${f64FromInt(tokens) / seconds} tok/s")
    }
    0
}

private fun maxAbsDifference(a: array<f32>, b: array<f32>): f64 {
    var largest = 0.0
    for (i in 0 until a.size) {
        val d = f32ToF64(a[i]) - f32ToF64(b[i])
        val m = if (d < 0.0) -d else d
        if (m > largest) largest = m
    }
    largest
}

// |a - b|_2 / |b|_2
private fun relativeL2(a: array<f32>, b: array<f32>): f64 {
    var difference = 0.0
    var norm = 0.0
    for (i in 0 until a.size) {
        val d = f32ToF64(a[i]) - f32ToF64(b[i])
        difference += d * d
        norm += f32ToF64(b[i]) * f32ToF64(b[i])
    }
    sqrt(difference / (norm + 0.000000000001))
}

private fun maxAbsOf(a: array<f32>): f64 {
    var largest = 0.0
    for (v in a) {
        val m = if (f32ToF64(v) < 0.0) -f32ToF64(v) else f32ToF64(v)
        if (m > largest) largest = m
    }
    largest
}

private fun argmaxOf(a: array<f32>): int {
    var best = 0
    for (i in 1 until a.size) if (a[i] > a[best]) best = i
    best
}

// abla-grad verify-check <model.gguf> <ids-file>: prefill 100 tokens, verify the next 3 as one batch and commit 2 or 0 of them, then continue with one decode step,
// and compare with a plain prefill of the same tokens (rows, and the logits after the decode step).
fun cmdVerifyCheck(args: array<string>): int {
    if (args.size != 2) {
        println("usage: abla-grad verify-check <model.gguf> <ids-file>   (at least 104 ids)")
        return 2
    }
    val idsText = Path(args[1]).readTextResult()
    val ids: array<int> = []
    if (idsText.succeeded) for (line in idsText.text.split("\n")) if (line.trim() != "") ids.append(line.trim().parseInt() ?? 0)
    if (ids.size < 104) {
        println("verify-check: need at least 104 token ids")
        return 2
    }
    val file = ggufOpen(args[0])
    if (file == null) {
        println("verify-check: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file)
    if (config == null) {
        println("verify-check: ${inklingConfigLastError()}")
        return 2
    }
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, 160) ?? return loadFailed()
    val first: array<int> = []
    for (i in 0 until 100) first.append(ids[i])
    val rows: array<int> = []
    for (i in 100 until 103) rows.append(ids[i])
    val all: array<int> = []
    for (i in 0 until 103) all.append(ids[i])
    val wsA = prefillWorkspace(backend, config, 128, true) ?? return 1
    // reference: logits of every row of the plain prefill of 103 tokens
    if (!model.reset(backend) || !model.prefill(backend, wsA, all, 0)) {
        println("verify-check: ${inklingPrefillLastError()}")
        return 1
    }
    val reference: array<array<f32>> = []
    for (row in 100 until 103) reference.append(model.readPrefillLogits(backend, wsA, row - 0) ?? return 1)
    var ok = true
    // the drafter's taps: step-mode decode of the 103 tokens is the reference for what prefill and verify write
    if (!model.enableTaps(backend)) {
        println("verify-check: ${inklingLastError()}")
        return 1
    }
    model.useStep = true
    if (!model.reset(backend)) return 1
    for (position in 0 until 103) {
        if (!model.forward(backend, ids[position], position)) {
            println("verify-check: ${inklingLastError()}")
            return 1
        }
    }
    val tapReference: array<array<f32>> = []
    for (position in 0 until 103) for (slot in 0 until 4) tapReference.append(model.readTap(backend, position, slot) ?? return 1)
    if (!model.reset(backend) || !model.prefill(backend, wsA, all, 0)) {
        println("verify-check: ${inklingPrefillLastError()}")
        return 1
    }
    for (slot in 0 until 4) {
        var worst = 0.0
        var worstAt = 0
        for (position in 0 until 103) {
            val tap = model.readTap(backend, position, slot) ?? return 1
            val relative = relativeL2(tap, tapReference[position * 4 + slot])
            if (relative > worst) {
                worst = relative
                worstAt = position
            }
        }
        println("taps from prefill, slot $slot: worst relative L2 error over 103 positions = $worst at position $worstAt")
        if (worst > 0.05) ok = false
    }
    for (accepted in [2, 0]) {

        val wsV = prefillWorkspace(backend, config, 4, true, 3) ?? return 1
        if (!model.reset(backend) || !model.prefill(backend, wsV, first, 0) || !model.verify(backend, wsV, rows, 100)) {
            println("verify-check: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        val ids3 = model.verifyArgmax(backend, wsV, 3) ?? return 1
        for (slot in 0 until 4) {
            var worst = 0.0
            for (row in 0 until 3) {
                val tap = model.readTap(backend, 100 + row, slot) ?? return 1
                val relative = relativeL2(tap, tapReference[(100 + row) * 4 + slot])
                if (relative > worst) worst = relative
            }
            println("accepted $accepted: taps of the verified rows, slot $slot: worst relative difference $worst")
            if (worst > 0.05) ok = false
        }
        for (row in 0 until 3) {
            val logits = model.readPrefillLogits(backend, wsV, row) ?? return 1
            println("accepted $accepted: row $row argmax ${ids3[row]} (reference ${argmaxOf(reference[row])}), max |dlogit| vs the plain prefill ${maxAbsDifference(logits, reference[row])}")
            if (ids3[row] != argmaxOf(reference[row])) ok = false
        }
        if (!model.commitVerified(backend, wsV, accepted)) return 1
        // continue with a decode step on the first token after the committed rows
        val position = 100 + accepted
        if (!model.forward(backend, ids[position], position)) {
            println("verify-check: ${inklingLastError()}")
            return 1
        }
        val decoded = model.readLogits(backend) ?? return 1
        println("accepted $accepted: decode step at position $position: argmax ${argmaxOf(decoded)} (reference ${argmaxOf(reference[accepted])}), max |dlogit| ${maxAbsDifference(decoded, reference[accepted])}")
        if (argmaxOf(decoded) != argmaxOf(reference[accepted])) ok = false
    }
    println(if (ok) "verify-check: ok" else "verify-check: MISMATCH")
    if (ok) 0 else 1
}
