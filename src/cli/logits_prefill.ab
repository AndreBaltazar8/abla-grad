// Inkling logits through the batched prefill (`abla-grad logits --prefill [--chunk N]`) and the prefill benchmark (`abla-grad prefill-bench`).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/process/time"
import "abla/float"
import "abla/math"
import "abla/float/text"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/inkling_prefill.ab"

// The logits of every position of `ids`, computed chunk by chunk with prefill; null on failure (the message is printed).
fun inklingPrefillLogits(var backend: Backend, model: InklingModel, ids: array<int>, chunk: int): array<f32>? {
    val ws = prefillWorkspace(backend, model.config, chunk, true)
    if (ws == null) {
        println("logits: ${inklingPrefillLastError()}")
        return null
    }
    val all: array<f32> = []
    var done = 0
    while (done < ids.size) {
        val count = if (ids.size - done < chunk) ids.size - done else chunk
        val part: array<int> = []
        for (i in 0 until count) part.append(ids[done + i])
        if (!model.prefill(backend, ws, part, done)) {
            println("logits: ${inklingPrefillLastError()} (${cudaLastError()})")
            return null
        }
        for (row in 0 until count) {
            val values = model.readPrefillLogits(backend, ws, row)
            if (values == null) {
                println("logits: ${inklingPrefillLastError()}")
                return null
            }
            for (value in values) all.append(value)
        }
        done = done + count
    }
    all
}

private fun loadFailed(): int {
    println("prefill-bench: ${inklingLastError()}")
    1
}

// abla-grad prefill-bench <model.gguf> [--tokens N] [--chunk N] [--reps N] [--decode]: tokens per second of prompt processing (the logits of the last token).
fun cmdPrefillBench(args: array<string>): int {
    var tokens = 512
    var chunk = 512
    var reps = 3
    var decode = false
    var profile = false
    var times = false
    var path = ""
    var index = 0
    while (index < args.size) {
        if (args[index] == "--tokens" && index + 1 < args.size) {
            tokens = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--chunk" && index + 1 < args.size) {
            chunk = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--reps" && index + 1 < args.size) {
            reps = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--moe-tile" && index + 1 < args.size) {
            setPrefillMoeTile(args[index + 1].parseInt() ?? 32)
            index = index + 2
        } else if (args[index] == "--times") {
            times = true
            index = index + 1
        } else if (args[index] == "--profile") {
            profile = true
            index = index + 1
        } else if (args[index] == "--int8-experts") {
            setPrefillInt8Experts(true)
            index = index + 1
        } else if (args[index] == "--no-int8-experts") {
            setPrefillInt8Experts(false)
            index = index + 1
        } else if (args[index] == "--decode") {
            decode = true
            index = index + 1
        } else {
            path = args[index]
            index = index + 1
        }
    }
    if (path == "" || tokens < 1 || chunk < 1 || reps < 1) {
        println("usage: abla-grad prefill-bench <model.gguf> [--tokens N] [--chunk N] [--reps N] [--decode]")
        return 2
    }
    val file = ggufOpen(path)
    if (file == null) {
        println("prefill-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file)
    if (config == null) {
        println("prefill-bench: ${inklingConfigLastError()}")
        return 2
    }
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, tokens + 8) ?? return loadFailed()
    val ids: array<int> = []
    for (i in 0 until tokens) ids.append((i * 7919 + 1013) % 150000 + 500)
    val ws = if (decode) null else prefillWorkspace(backend, config, chunk, false)
    if (!decode && ws == null) {
        println("prefill-bench: ${inklingPrefillLastError()}")
        return 1
    }
    if (times && ws != null) {
        // Wall time of every kernel family in one prefill, each launch bracketed by stream syncs (launch overhead inflates the small kernels a little).
        if (!model.reset(backend) || !model.prefill(backend, ws, ids, 0) || !backend.synchronize()) return 1
        cudaDebugAlways = true
        cudaTimeKernels = true
        if (!model.reset(backend) || !model.prefill(backend, ws, ids, 0) || !backend.synchronize()) return 1
        cudaDebugAlways = false
        cudaTimeKernels = false
        var total = 0
        for (name in cudaKernelNanos.keys()) total = total + (cudaKernelNanos.get(name) ?? 0)
        for (name in cudaKernelNanos.keys()) {
            val ns = cudaKernelNanos.get(name) ?? 0
            println("prefill-bench times: $name x${cudaLaunchCounts.get(name) ?? 0}: ${f64FromInt(ns) / 1000000.0} ms (${f64FromInt(ns) * 100.0 / f64FromInt(total)}%)")
        }
        println("prefill-bench times: total ${f64FromInt(total) / 1000000.0} ms")
        return 0
    }
    if (profile && ws != null) {
        // Price every kernel family: count the launches of one prefill, then time the prefill with each family left out (output is garbage, the sum of the deltas
        // approximates each family's share of the run; big kernels do not overlap so the deltas are close to the kernels' own times).
        cudaDebugAlways = true
        if (!model.reset(backend) || !model.prefill(backend, ws, ids, 0) || !backend.synchronize()) return 1
        val names: array<string> = []
        val counts: array<int> = []
        for (name in cudaLaunchCounts.keys()) {
            names.append(name)
            counts.append(cudaLaunchCounts.get(name) ?? 0)
        }
        var base = 1000000.0
        for (rep in 0 until 3) {
            if (!model.reset(backend)) return 1
            val t0 = monotonicNanoseconds()
            if (!model.prefill(backend, ws, ids, 0) || !backend.synchronize()) return 1
            val ms = f64FromInt(monotonicNanoseconds() - t0) / 1000000.0
            if (ms < base) base = ms
        }
        println("prefill-bench profile: baseline $base ms for $tokens tokens (${f64FromInt(tokens) / base * 1000.0} tok/s)")
        for (i in 0 until names.size) {
            cudaSkipSingle = names[i]
            var best = 1000000.0
            for (rep in 0 until 2) {
                if (!model.reset(backend)) return 1
                val t0 = monotonicNanoseconds()
                if (!model.prefill(backend, ws, ids, 0) || !backend.synchronize()) return 1
                val ms = f64FromInt(monotonicNanoseconds() - t0) / 1000000.0
                if (ms < best) best = ms
            }
            println("prefill-bench profile: ${names[i]} x${counts[i]}: ${base - best} ms")
        }
        cudaSkipSingle = ""
        cudaDebugAlways = false
        return 0
    }
    for (rep in 0 until reps + 1) {
        if (!model.reset(backend)) return 1
        val start = monotonicNanoseconds()
        if (decode) {
            for (position in 0 until tokens) if (!model.forward(backend, ids[position], position)) return 1
        } else if (ws != null && !model.prefill(backend, ws, ids, 0)) {
            println("prefill-bench: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        if (!backend.synchronize()) return 1
        val seconds = f64FromInt(monotonicNanoseconds() - start) / 1000000000.0
        val label = if (rep == 0) "warmup" else "run $rep"
        println("prefill-bench ($label): $tokens tokens in ${seconds * 1000.0} ms = ${f64FromInt(tokens) / seconds} tok/s")
    }
    0
}

private trusted fun storeWord(address: int, index: int, value: int): void = ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * index), value)

private trusted fun loadWord(address: int, index: int): int = ablaUnsafeLoadU32(nativePointerFromAddress(address + 4 * index))

private fun maxAbsDifference(a: array<f32>, b: array<f32>): f64 {
    var largest = 0.0
    for (i in 0 until a.size) {
        val d = f32ToF64(a[i]) - f32ToF64(b[i])
        val m = if (d < 0.0) -d else d
        if (m > largest) largest = m
    }
    largest
}

// |a - b|_2 / |b|_2
private fun relativeL2(a: array<f32>, b: array<f32>): f64 {
    var difference = 0.0
    var norm = 0.0
    for (i in 0 until a.size) {
        val d = f32ToF64(a[i]) - f32ToF64(b[i])
        difference += d * d
        norm += f32ToF64(b[i]) * f32ToF64(b[i])
    }
    sqrt(difference / (norm + 0.000000000001))
}

private fun maxAbsOf(a: array<f32>): f64 {
    var largest = 0.0
    for (v in a) {
        val m = if (f32ToF64(v) < 0.0) -f32ToF64(v) else f32ToF64(v)
        if (m > largest) largest = m
    }
    largest
}

private fun argmaxOf(a: array<f32>): int {
    var best = 0
    for (i in 1 until a.size) if (a[i] > a[best]) best = i
    best
}

// abla-grad verify-check <model.gguf> <ids-file>: prefill 100 tokens, verify the next 3 as one batch and commit 2 or 0 of them, then continue with one decode step,
// and compare with a plain prefill of the same tokens (rows, and the logits after the decode step).
fun cmdVerifyCheck(args: array<string>): int {
    if (args.size != 2) {
        println("usage: abla-grad verify-check <model.gguf> <ids-file>   (at least 104 ids)")
        return 2
    }
    val idsText = Path(args[1]).readTextResult()
    val ids: array<int> = []
    if (idsText.succeeded) for (line in idsText.text.split("\n")) if (line.trim() != "") ids.append(line.trim().parseInt() ?? 0)
    if (ids.size < 104) {
        println("verify-check: need at least 104 token ids (106 for the five-row check)")
        return 2
    }
    val file = ggufOpen(args[0])
    if (file == null) {
        println("verify-check: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file)
    if (config == null) {
        println("verify-check: ${inklingConfigLastError()}")
        return 2
    }
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, 160) ?? return loadFailed()
    val first: array<int> = []
    for (i in 0 until 100) first.append(ids[i])
    val rows: array<int> = []
    for (i in 100 until 103) rows.append(ids[i])
    val all: array<int> = []
    for (i in 0 until 103) all.append(ids[i])
    val wsA = prefillWorkspace(backend, config, 128, true) ?? return 1
    // reference: logits of every row of the plain prefill of 103 tokens
    if (!model.reset(backend) || !model.prefill(backend, wsA, all, 0)) {
        println("verify-check: ${inklingPrefillLastError()}")
        return 1
    }
    val reference: array<array<f32>> = []
    for (row in 100 until 103) reference.append(model.readPrefillLogits(backend, wsA, row - 0) ?? return 1)
    var ok = true
    // the drafter's taps: step-mode decode of the 103 tokens is the reference for what prefill and verify write
    if (!model.enableTaps(backend)) {
        println("verify-check: ${inklingLastError()}")
        return 1
    }
    model.useStep = true
    if (!model.reset(backend)) return 1
    for (position in 0 until 103) {
        if (!model.forward(backend, ids[position], position)) {
            println("verify-check: ${inklingLastError()}")
            return 1
        }
    }
    val tapReference: array<array<f32>> = []
    for (position in 0 until 103) for (slot in 0 until 4) tapReference.append(model.readTap(backend, position, slot) ?? return 1)
    if (!model.reset(backend) || !model.prefill(backend, wsA, all, 0)) {
        println("verify-check: ${inklingPrefillLastError()}")
        return 1
    }
    for (slot in 0 until 4) {
        var worst = 0.0
        var worstAt = 0
        for (position in 0 until 103) {
            val tap = model.readTap(backend, position, slot) ?? return 1
            val relative = relativeL2(tap, tapReference[position * 4 + slot])
            if (relative > worst) {
                worst = relative
                worstAt = position
            }
        }
        println("taps from prefill, slot $slot: worst relative L2 error over 103 positions = $worst at position $worstAt")
        // slot 0 (the input of visit 5) must agree to rounding; the deeper slots are reported only (see docs/prefill.md: they disagree with the step-mode taps although the logits agree)
        if (slot == 0 && worst > 0.01) ok = false
    }
    for (accepted in [2, 0]) {

        val wsV = prefillWorkspace(backend, config, 4, true, 3) ?? return 1
        if (!model.reset(backend) || !model.prefill(backend, wsV, first, 0) || !model.verify(backend, wsV, rows, 100)) {
            println("verify-check: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        val ids3 = model.verifyArgmax(backend, wsV, 3) ?? return 1
        for (slot in 0 until 4) {
            var worst = 0.0
            for (row in 0 until 3) {
                val tap = model.readTap(backend, 100 + row, slot) ?? return 1
                val relative = relativeL2(tap, tapReference[(100 + row) * 4 + slot])
                if (relative > worst) worst = relative
            }
            println("accepted $accepted: taps of the verified rows, slot $slot: worst relative difference $worst")
            if (slot == 0 && worst > 0.01) ok = false
        }
        for (row in 0 until 3) {
            val logits = model.readPrefillLogits(backend, wsV, row) ?? return 1
            println("accepted $accepted: row $row argmax ${ids3[row]} (reference ${argmaxOf(reference[row])}), max |dlogit| vs the plain prefill ${maxAbsDifference(logits, reference[row])}")
            if (ids3[row] != argmaxOf(reference[row])) ok = false
        }
        if (!model.commitVerified(backend, wsV, accepted)) return 1
        // continue with a decode step on the first token after the committed rows
        val position = 100 + accepted
        if (!model.forward(backend, ids[position], position)) {
            println("verify-check: ${inklingLastError()}")
            return 1
        }
        val decoded = model.readLogits(backend) ?? return 1
        println("accepted $accepted: decode step at position $position: argmax ${argmaxOf(decoded)} (reference ${argmaxOf(reference[accepted])}), max |dlogit| ${maxAbsDifference(decoded, reference[accepted])}")
        if (argmaxOf(decoded) != argmaxOf(reference[accepted])) ok = false
    }
    // the graph-static form (spec and step buffers): same argmax per row, and commit by the device value a = 1 (rows 0 and 1 committed)
    if (true) {
        val wsS = prefillWorkspace(backend, config, 4, true, 3) ?? return 1
        val spec = backend.allocate(64) ?? return 1
        val step = backend.allocate(64) ?? return 1
        val host = nativeByteBuffer(64)
        val address = nativePointerAddress(host.address)
        for (i in 0 until 3) storeWord(address, i, ids[100 + i])
        storeWord(address, 3, 0)
        for (i in 4 until 8) storeWord(address, i, 0)
        if (!backend.upload(spec, 0, address, 32)) return 1
        for (i in 0 until 8) storeWord(address, i, 0)
        storeWord(address, 1, 100)
        storeWord(address, 3, 1)
        if (!backend.upload(step, 0, address, 32)) return 1
        if (!model.reset(backend) || !model.prefill(backend, wsS, first, 0) || !model.verifyStep(backend, wsS, spec, step)) {
            println("verify-check: verifyStep: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        if (!backend.download(spec, 0, address, 32)) return 1
        for (row in 0 until 3) {
            val got = loadWord(address, 4 + row)
            println("verifyStep row $row argmax $got (reference ${argmaxOf(reference[row])})")
            if (got != argmaxOf(reference[row])) ok = false
        }
        if (!model.commitStep(backend, wsS, step) || !model.forward(backend, ids[102], 102)) return 1
        val decoded = model.readLogits(backend) ?? return 1
        println("verifyStep + commitStep (a = 1): decode step at position 102: argmax ${argmaxOf(decoded)} (reference ${argmaxOf(reference[2])}), max |dlogit| ${maxAbsDifference(decoded, reference[2])}")
        if (argmaxOf(decoded) != argmaxOf(reference[2])) ok = false
    }
    // five rows in buffer layout v2 (spec = u32[16], argmax at spec[8 + row]); commit by step[3] = 3 (rows 0..3 committed)
    if (ids.size >= 106) {
        val all5: array<int> = []
        for (i in 0 until 105) all5.append(ids[i])
        val wsR = prefillWorkspace(backend, config, 128, true) ?? return 1
        if (!model.reset(backend) || !model.prefill(backend, wsR, all5, 0)) return 1
        val ref5: array<array<f32>> = []
        for (row in 100 until 105) ref5.append(model.readPrefillLogits(backend, wsR, row) ?? return 1)
        val ws5 = prefillWorkspace(backend, config, 8, true, 5) ?? return 1
        val spec5 = backend.allocate(64) ?? return 1
        val step5 = backend.allocate(64) ?? return 1
        val host5 = nativeByteBuffer(64)
        val a5 = nativePointerAddress(host5.address)
        for (i in 0 until 16) storeWord(a5, i, 0)
        for (i in 0 until 5) storeWord(a5, i, ids[100 + i])
        storeWord(a5, 5, 4)
        if (!backend.upload(spec5, 0, a5, 64)) return 1
        for (i in 0 until 16) storeWord(a5, i, 0)
        storeWord(a5, 1, 100)
        storeWord(a5, 3, 3)
        if (!backend.upload(step5, 0, a5, 64)) return 1
        if (!model.reset(backend) || !model.prefill(backend, ws5, first, 0) || !model.verifyStep(backend, ws5, spec5, step5, 5, 2)) {
            println("verify-check: verifyStep 5 rows: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        if (!backend.download(spec5, 0, a5, 64)) return 1
        for (row in 0 until 5) {
            val got = loadWord(a5, 8 + row)
            println("verifyStep 5 rows, row $row argmax $got (reference ${argmaxOf(ref5[row])})")
            if (got != argmaxOf(ref5[row])) ok = false
        }
        // commit every possible accepted count a = 0..4 (a + 1 rows) and continue with a decode step at position 100 + a + 1: its logits must match a plain prefill of 106 tokens
        val all6: array<int> = []
        for (i in 0 until 106) all6.append(ids[i])
        if (!model.reset(backend) || !model.prefill(backend, wsR, all6, 0)) return 1
        val ref6: array<array<f32>> = []
        for (row in 100 until 106) ref6.append(model.readPrefillLogits(backend, wsR, row) ?? return 1)
        for (accepted in 0 until 5) {
            for (i in 0 until 16) storeWord(a5, i, 0)
            storeWord(a5, 1, 100)
            storeWord(a5, 3, accepted)
            if (!backend.upload(step5, 0, a5, 64)) return 1
            // spec still holds the five rows
            if (!model.reset(backend) || !model.prefill(backend, ws5, first, 0) || !model.verifyStep(backend, ws5, spec5, step5, 5, 2)) return 1
            if (!model.commitStep(backend, ws5, step5) || !model.forward(backend, ids[100 + accepted + 1], 100 + accepted + 1)) return 1
            val decoded5 = model.readLogits(backend) ?? return 1
            println("5 rows + commitStep (a = $accepted): decode step at position ${100 + accepted + 1}: argmax ${argmaxOf(decoded5)} (reference ${argmaxOf(ref6[accepted + 1])}), max |dlogit| ${maxAbsDifference(decoded5, ref6[accepted + 1])}")
            if (argmaxOf(decoded5) != argmaxOf(ref6[accepted + 1])) ok = false
        }
    }
    println(if (ok) "verify-check: ok" else "verify-check: MISMATCH")
    if (ok) 0 else 1
}

// abla-grad verify-argmax <model.gguf> <ids-file> [--rows R] [--from P] [--windows W]: prefill the first P tokens, then W times: verifyStep R rows (anchor + the next R-1 real tokens
// of the file, layout 2) and, from the same state, R plain decode steps; counts the rows whose argmax differs (real text, so the rows are what a drafter would propose).
fun cmdVerifyArgmax(args: array<string>): int {
    var rows = 5
    var from = 200
    var windows = 40
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--rows" && index + 1 < args.size) {
            rows = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--from" && index + 1 < args.size) {
            from = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--windows" && index + 1 < args.size) {
            windows = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 2 || rows < 1 || rows > 5) {
        println("usage: abla-grad verify-argmax <model.gguf> <ids-file> [--rows 1..5] [--from P] [--windows W]")
        return 2
    }
    val idsText = Path(positional[1]).readTextResult()
    val ids: array<int> = []
    if (idsText.succeeded) for (line in idsText.text.split("\n")) if (line.trim() != "") ids.append(line.trim().parseInt() ?? 0)
    if (ids.size < from + windows * rows + 1) {
        println("verify-argmax: the ids file needs at least ${from + windows * rows + 1} ids")
        return 2
    }
    val file = ggufOpen(positional[0])
    if (file == null) {
        println("verify-argmax: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file) ?? return 2
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, ids.size + 16) ?? return loadFailed()
    if (!model.reset(backend)) return 1
    val seed = prefillWorkspace(backend, config, 512, false) ?? return 1
    val head: array<int> = []
    for (i in 0 until from) head.append(ids[i])
    if (!model.prefill(backend, seed, head, 0)) {
        println("verify-argmax: ${inklingPrefillLastError()}")
        return 1
    }
    val ws = prefillWorkspace(backend, config, 8, true, 5) ?? return 1
    val spec = backend.allocate(64) ?? return 1
    val step = backend.allocate(64) ?? return 1
    val host = nativeByteBuffer(64)
    val address = nativePointerAddress(host.address)
    val wrong: array<int> = [0, 0, 0, 0, 0]
    var position = from
    for (window in 0 until windows) {
        for (i in 0 until 16) storeWord(address, i, 0)
        for (i in 0 until rows) storeWord(address, i, ids[position + i])
        storeWord(address, 5, rows - 1)
        if (!backend.upload(spec, 0, address, 64)) return 1
        for (i in 0 until 16) storeWord(address, i, 0)
        storeWord(address, 1, position)
        if (!backend.upload(step, 0, address, 64)) return 1
        if (!model.verifyStep(backend, ws, spec, step, rows, 2)) {
            println("verify-argmax: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        if (!backend.download(spec, 0, address, 64)) return 1
        val verified: array<int> = []
        for (row in 0 until rows) verified.append(loadWord(address, 8 + row))
        for (row in 0 until rows) {
            if (!model.forward(backend, ids[position + row], position + row)) return 1
            val logits = model.readLogits(backend) ?? return 1
            if (argmaxOf(logits) != verified[row]) wrong[row] = wrong[row] + 1
        }
        position = position + rows
    }
    println("verify-argmax: rows $rows, $windows windows from position $from: rows whose argmax differs from plain decode, by row: ${wrong[0]} ${wrong[1]} ${wrong[2]} ${wrong[3]} ${wrong[4]} (of $windows each)")
    0
}

// abla-grad verify-bench <model.gguf> <ids-file> [--rows R] [--reps N]: the recorded verifyStep (layout 2) alone, repeated at a fixed position after prefilling the prompt.
// ms per call and tokens/s = R / ms: the throughput proxy of R independent sequences decoded together (weights read once per step; the rows share one sequence's KV).
fun cmdVerifyBench(args: array<string>): int {
    var rows = 3
    var reps = 50
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--rows" && index + 1 < args.size) {
            rows = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--reps" && index + 1 < args.size) {
            reps = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 2 || rows < 1 || rows > 5 || reps < 1) {
        println("usage: abla-grad verify-bench <model.gguf> <ids-file> [--rows 1..5] [--reps N]")
        return 2
    }
    val idsText = Path(positional[1]).readTextResult()
    val ids: array<int> = []
    if (idsText.succeeded) for (line in idsText.text.split("\n")) if (line.trim() != "") ids.append(line.trim().parseInt() ?? 0)
    if (ids.size < 8) {
        println("verify-bench: need token ids")
        return 2
    }
    val file = ggufOpen(positional[0])
    if (file == null) {
        println("verify-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file) ?? return 2
    var backend = cudaBackend() ?? return 2
    val length = ids.size
    var model = inklingLoad(backend, file, config, length + 16) ?? return loadFailed()
    if (!model.reset(backend)) return 1
    val seed = prefillWorkspace(backend, config, 512, false) ?? return 1
    if (!model.prefill(backend, seed, ids, 0)) {
        println("verify-bench: ${inklingPrefillLastError()}")
        return 1
    }
    val ws = prefillWorkspace(backend, config, 8, true, 5) ?? return 1
    val spec = backend.allocate(64) ?? return 1
    val step = backend.allocate(64) ?? return 1
    val host = nativeByteBuffer(64)
    val address = nativePointerAddress(host.address)
    for (i in 0 until 16) storeWord(address, i, 0)
    for (i in 0 until rows) storeWord(address, i, ids[(length - rows + i) % ids.size])
    storeWord(address, 5, rows - 1)
    if (!backend.upload(spec, 0, address, 64)) return 1
    for (i in 0 until 16) storeWord(address, i, 0)
    storeWord(address, 1, length)
    if (!backend.upload(step, 0, address, 64)) return 1
    // one direct call loads every kernel, then the recording
    if (!model.verifyStep(backend, ws, spec, step, rows, 2) || !backend.synchronize()) {
        println("verify-bench: ${inklingPrefillLastError()} (${cudaLastError()})")
        return 1
    }
    if (!backend.beginRecording()) return 1
    var ok = model.verifyStep(backend, ws, spec, step, rows, 2)
    val recording = backend.endRecording()
    if (!ok || recording == null) {
        println("verify-bench: recording failed: ${inklingPrefillLastError()} (${cudaLastError()})")
        return 1
    }
    for (warm in 0 until 5) if (!backend.replay(recording)) return 1
    if (!backend.synchronize()) return 1
    val start = monotonicNanoseconds()
    for (i in 0 until reps) if (!backend.replay(recording)) return 1
    if (!backend.synchronize()) return 1
    val seconds = f64FromInt(monotonicNanoseconds() - start) / 1000000000.0
    val milliseconds = seconds * 1000.0 / f64FromInt(reps)
    println("verify-bench: rows $rows at position $length: ${milliseconds} ms per call (recorded, $reps replays) = ${f64FromInt(rows) / (milliseconds / 1000.0)} tokens/s")
    0
}
