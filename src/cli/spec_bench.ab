// `abla-grad spec-bench <target.gguf> <drafter.gguf> <ids-file> [--n N] [--nmax K] [--adaptive] [--log file]`: greedy speculative decoding speed. The prompt is
// seeded (not timed); then N tokens are generated by the recorded speculation cycle (one graph per replay, docs/spec-cycle.md) with at most K proposals
// (2..4, default 2); `--adaptive` lets the controller choose between the plain graph and the cycles with 2..K proposals by measured rate. Prints tok/s of the
// timed loop and the generated ids (--log; comparable with decode-bench's log of the same prompt).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/speculate.ab"

fun cmdSpecBench(args: array<string>): int {
    var count = 128
    var maxProposals = SPEC_DEFAULT_PROPOSALS
    var adaptive = false
    var logPath = ""
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--n" && index + 1 < args.size) {
            count = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--nmax" && index + 1 < args.size) {
            maxProposals = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--adaptive") {
            adaptive = true
            index = index + 1
        } else if (args[index] == "--log" && index + 1 < args.size) {
            logPath = args[index + 1]
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 3 || count <= 0 || maxProposals < 2 || maxProposals > 4) {
        println("usage: abla-grad spec-bench <target.gguf> <drafter.gguf> <ids-file> [--n N] [--nmax 2..4] [--adaptive] [--log file]")
        return 2
    }
    val idsText = Path(positional[2]).readTextResult()
    if (!idsText.succeeded) {
        println("spec-bench: cannot read ${positional[2]}")
        return 2
    }
    val ids: array<int> = []
    for (rawLine in idsText.text.split("\n")) {
        val line = rawLine.trim()
        if (line == "") continue
        ids.append(line.parseInt() ?? return 2)
    }
    val file = ggufOpen(positional[0])
    val draftFile = ggufOpen(positional[1])
    if (file == null || draftFile == null) {
        println("spec-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file) ?? return 2
    var backend = cudaBackend() ?? return 2
    var model = inklingLoad(backend, file, config, ids.size + count + SPEC_CONTEXT_SLACK) ?? return 1
    if (!model.reset(backend)) return 1
    val tokens: array<int> = []
    var stats = SpecStats()
    if (!speculativeGenerate(backend, model, draftFile, ids, count, [], adaptive, maxProposals, stats, { t -> tokens.append(t) })) {
        println("spec-bench: ${speculateLastError()}")
        return 1
    }
    val seconds = f64FromInt(stats.loopNanos) / 1000000000.0
    // the first token comes from the seeding, the loop produced the rest
    val timed = tokens.size - 1
    println("spec-bench: n-max $maxProposals${if (adaptive) " adaptive" else ""}: ${tokens.size} tokens, ${timed} in the timed loop ${seconds} s = ${f64FromInt(timed) / seconds} tok/s; " +
        "${stats.cycleTokens} tokens in ${stats.cycles} cycles (${f64FromInt(stats.cycleTokens) / f64FromInt(if (stats.cycles > 0) stats.cycles else 1)} per cycle), ${stats.plainTokens} plain, ${stats.switches} switches")
    if (logPath != "") {
        var text = ""
        for (t in tokens) text = text + "$t\n"
        Path(logPath).writeText(text)
    }
    0
}
