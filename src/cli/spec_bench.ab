// `abla-grad spec-bench <target.gguf> <drafter.gguf> <ids-file> [--n N] [--batch B] [--log file]`: greedy speculative decoding with the DSpark drafter, one
// recorded cycle per replay (docs/spec-cycle.md): spec_begin, drafter taps + proposals, 3-row verification, greedy acceptance, history commit. The prompt is
// prefilled token by token in step mode (taps on); then cycles are replayed, B at a time, until N tokens are generated. Prints tok/s of the timed loop,
// tokens per cycle and the generated ids (in --log, comparable with decode-bench's log of the same prompt).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "abla/process/time"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/inkling_prefill.ab"
import "../model/dspark.ab"
import "../ops.ab"

fun cmdSpecBench(args: array<string>): int {
    var count = 128
    var batch = 4
    var logPath = ""
    var adaptive = false
    var prefill = false
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--n" && index + 1 < args.size) {
            count = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--batch" && index + 1 < args.size) {
            batch = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--prefill") {
            prefill = true
            index = index + 1
        } else if (args[index] == "--adaptive") {
            adaptive = true
            index = index + 1
        } else if (args[index] == "--log" && index + 1 < args.size) {
            logPath = args[index + 1]
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 3 || count <= 0 || batch <= 0) {
        println("usage: abla-grad spec-bench <target.gguf> <drafter.gguf> <ids-file> [--n N] [--batch B] [--log file] [--prefill]")
        return 2
    }
    val idsText = Path(positional[2]).readTextResult()
    if (!idsText.succeeded) {
        println("spec-bench: cannot read ${positional[2]}")
        return 2
    }
    val ids: array<int> = []
    for (rawLine in idsText.text.split("\n")) {
        val line = rawLine.trim()
        if (line == "") continue
        ids.append(line.parseInt() ?? return 2)
    }
    val file = ggufOpen(positional[0])
    val draftFile = ggufOpen(positional[1])
    if (file == null || draftFile == null) {
        println("spec-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file) ?? return 2
    var backend = cudaBackend() ?? return 2
    val length = ids.size
    val context = length + count + batch * 3 + 16
    var model = inklingLoad(backend, file, config, context) ?? return 1
    if (!model.reset(backend)) return 1
    model.useStep = true
    if (!model.enableTaps(backend)) return 1
    var drafter = dsparkLoad(backend, draftFile, context) ?? return 1
    val ws = prefillWorkspace(backend, config, 3, true, 3) ?? return 1
    val spec = backend.allocate(64) ?? return 1
    if (!zeroSpec(backend, spec)) return 1
    // prefill the prompt (taps for every position); the anchor is the greedy token after the last prompt token, at position `length`
    var seeded = 0
    if (prefill) {
        // the prompt except its last token through the batched prefill (state, KV and taps); the last token runs in step mode below (it sets the anchor)
        val seed = prefillWorkspace(backend, config, 512, false) ?? return 1
        val head: array<int> = []
        for (i in 0 until length - 1) head.append(ids[i])
        if (!model.prefill(backend, seed, head, 0)) {
            println("spec-bench: prefill: ${inklingPrefillLastError()} (${cudaLastError()})")
            return 1
        }
        seeded = head.size
    }
    for (position in seeded until length) {
        if (!model.forward(backend, ids[position], position)) {
            println("spec-bench: ${inklingLastError()} (${cudaLastError()})")
            return 1
        }
    }
    if (!opArgmax(backend, model.scratch, model.so("logits"), config.nVocab, model.step, 0)) return 1
    if (!opStepAdvance(backend, model.step)) return 1
    if (!drafter.pushTaps(backend, model.taps, 0, length) || !drafter.prepareStep(backend)) {
        println("spec-bench: ${dsparkLastError()}")
        return 1
    }
    if (!backend.synchronize()) return 1
    if (!backend.beginRecording()) return 1
    var ok = opSpecBegin(backend, model.step, spec)
    ok = ok && drafter.pushTapsStep(backend, model.taps, model.step)
    ok = ok && drafter.proposeStep(backend, model, model.step, spec)
    ok = ok && model.verifyStep(backend, ws, spec, model.step)
    ok = ok && opSpecAccept(backend, model.step, spec, context)
    ok = ok && model.commitStep(backend, ws, model.step)
    val recording = backend.endRecording()
    if (!ok || recording == null) {
        println("spec-bench: recording the cycle failed: ${dsparkLastError()} ${inklingLastError()} (${cudaLastError()})")
        return 1
    }
    var cycles = 0
    var position = length
    val start = monotonicNanoseconds()
    if (adaptive) {
        // Adaptive speculation: the cycle graph while its measured rate beats the plain decode graph's, the plain graph otherwise; each side is re-measured
        // now and then. Both graphs share the step buffer (anchor token, position, token log), the KV caches, the conv histories and the taps.
        val plain = model.capture(backend)
        if (plain == null) {
            println("spec-bench: recording the plain token failed: ${inklingLastError()}")
            return 1
        }
        val batchCycles = batch
        val batchTokens = 16
        var rateCycle = 0.0
        var ratePlain = 0.0
        var useCycle = false
        var sinceProbe = 0
        var plainTokens = 0
        var cycleTokens = 0
        var switches = 0
        var warm = true
        var acceptedBefore = 0
        while (position < length + count) {
            val before = position
            val t0 = monotonicNanoseconds()
            if (useCycle) {
                for (b in 0 until batchCycles) {
                    if (!backend.replay(recording)) return 1
                }
                cycles = cycles + batchCycles
            } else if (!model.replayMany(backend, plain, batchTokens)) {
                println("spec-bench: ${inklingLastError()}")
                return 1
            }
            if (!backend.synchronize()) return 1
            position = model.readStepWord(backend, 1) ?? return 1
            val seconds = f64FromInt(monotonicNanoseconds() - t0) / 1000000000.0
            val rate = f64FromInt(position - before) / seconds
            // the first batch after a switch (graph warm-up, the drafter's catch-up) only counts tokens
            if (useCycle) {
                if (!warm) rateCycle = if (rateCycle == 0.0) rate else 0.5 * rateCycle + 0.5 * rate
                cycleTokens = cycleTokens + (position - before)
            } else {
                if (!warm) ratePlain = if (ratePlain == 0.0) rate else 0.5 * ratePlain + 0.5 * rate
                plainTokens = plainTokens + (position - before)
                sinceProbe = sinceProbe + (position - before)
            }
            // decide the next batch
            var next = useCycle
            if (warm) next = useCycle
            else if (ratePlain == 0.0) next = false
            else if (rateCycle == 0.0) next = true
            else if (useCycle) next = rateCycle >= ratePlain * 0.97
            else next = sinceProbe >= 160 || rateCycle > ratePlain * 1.03
            warm = false
            if (next && !useCycle) {
                // back to the cycle graph: the drafter catches up on the plain tokens' taps
                if (!drafter.resume(backend, model.taps, position)) {
                    println("spec-bench: resume: ${dsparkLastError()}")
                    return 1
                }
                sinceProbe = 0
                rateCycle = 0.0
                warm = true
            }
            if (next != useCycle) switches = switches + 1
            useCycle = next
        }
        println("spec-bench: adaptive: $cycleTokens tokens in cycles, $plainTokens plain, $switches switches; last rates cycle ${rateCycle} tok/s, plain ${ratePlain} tok/s")
    }
    while (!adaptive && position < length + count) {
        for (b in 0 until batch) {
            if (!backend.replay(recording)) {
                println("spec-bench: replay failed (${cudaLastError()})")
                return 1
            }
        }
        cycles = cycles + batch
        if (!backend.synchronize()) {
            println("spec-bench: the device failed (${cudaLastError()})")
            return 1
        }
        position = model.readStepWord(backend, 1) ?? return 1
    }
    val elapsed = monotonicNanoseconds() - start
    val generated = position - length
    val seconds = f64FromInt(elapsed) / 1000000000.0
    println("spec-bench: $generated tokens in $cycles cycles, ${seconds} s = ${f64FromInt(generated) / seconds} tok/s, ${f64FromInt(generated) / f64FromInt(cycles)} tokens per cycle")
    if (logPath != "") {
        val log = model.readLog(backend, length, position - length) ?? return 1
        var text = ""
        for (t in log) text = text + "$t\n"
        Path(logPath).writeText(text)
    }
    0
}

// spec[0..15] = 0 (the accepted-proposal total in spec[7] starts at zero).
private trusted fun zeroSpec(var backend: Backend, spec: DeviceBuffer): bool {
    val host = nativeByteBuffer(72)
    val address = nativePointerAddress(host.address)
    for (i in 0 until 16) ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * i), 0)
    val ok = backend.upload(spec, 0, address, 64)
    host.close()
    ok
}
