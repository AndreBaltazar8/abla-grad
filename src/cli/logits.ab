// `abla-grad logits <model.gguf> <ids-file> -o <out.grdl> [--ctx N]`: the logits after every prompt position, in GRDL v1, computed on the GPU
// (CudaBackend). `ids-file` has one decimal token id per line. Llama-family models only for now.
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/llama.ab"
import "../model/llama_config.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/weights.ab"
import "../compare/grdl.ab"
import "../model/dump.ab"
import "abla/float"
import "logits_prefill.ab"
import "../model/inkling_prefill.ab"

private fun readIds(path: string): array<int>? {
    val result = Path(path).readTextResult()
    if (!result.succeeded) return null
    val ids: array<int> = []
    for (rawLine in result.text.split("\n")) {
        val line = rawLine.trim()
        if (line == "") continue
        val id = line.parseInt()
        if (id == null) return null
        ids.append(id)
    }
    ids
}

private fun inklingLoadFailed(): int {
    println("logits: ${inklingLastError()}")
    1
}

private fun noCuda(): int {
    println("logits: no CUDA device: ${cudaLastError()}")
    2
}

fun cmdLogits(args: array<string>): int {
    var out = ""
    var maxCtx = 0
    var dumpDir = ""
    var useStep = false
    var quantizeKv = false
    var halfKv = false
    var noSplit = false
    var tapsCheck = ""
    var prefill = false
    var chunk = 512
    var noFuse = false
    var noFuseController = false
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "-o" && index + 1 < args.size) {
            out = args[index + 1]
            index = index + 2
        } else if (args[index] == "--taps-check" && index + 1 < args.size) {
            tapsCheck = args[index + 1]
            index = index + 2
        } else if (args[index] == "--q8-kv") {
            quantizeKv = true
            index = index + 1
        } else if (args[index] == "--f16-kv") {
            halfKv = true
            index = index + 1
        } else if (args[index] == "--no-split") {
            noSplit = true
            index = index + 1
        } else if (args[index] == "--no-fuse") {
            noFuse = true
            index = index + 1
        } else if (args[index] == "--q6k") {
            weightsRequantQ6K = true
            index = index + 1
        } else if (args[index] == "--no-fuse-controller") {
            noFuseController = true
            index = index + 1
        } else if (args[index] == "--step") {
            useStep = true
            index = index + 1
        } else if (args[index] == "--dump" && index + 1 < args.size) {
            dumpDir = args[index + 1]
            index = index + 2
        } else if (args[index] == "--prefill") {
            prefill = true
            index = index + 1
        } else if (args[index] == "--scalar-attention") {
            setPrefillTensorAttention(false)
            index = index + 1
        } else if (args[index] == "--int8-experts") {
            setPrefillInt8Experts(true)
            index = index + 1
        } else if (args[index] == "--no-int8-experts") {
            setPrefillInt8Experts(false)
            index = index + 1
        } else if (args[index] == "--chunk" && index + 1 < args.size) {
            chunk = args[index + 1].parseInt() ?? 512
            index = index + 2
        } else if (args[index] == "--ctx" && index + 1 < args.size) {
            maxCtx = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 2 || out == "") {
        println("usage: abla-grad logits <model.gguf> <ids-file> -o <out.grdl> [--ctx N]")
        return 2
    }
    val ids = readIds(positional[1])
    if (ids == null || ids.size == 0) {
        println("logits: ${positional[1]} is not a file of token ids, one per line")
        return 2
    }
    if (halfKv && quantizeKv) { println("logits: select one KV format"); return 2 }
    val file = ggufOpen(positional[0])
    if (file == null) {
        println("logits: ${ggufLastError()}")
        return 2
    }
    var backend = cudaBackend() ?? return noCuda()
    val context = if (maxCtx > 0) maxCtx else ids.size + 8
    if (ids.size > context) {
        println("logits: ${ids.size} tokens do not fit --ctx $context")
        return 2
    }
    val architecture = file.getString("general.architecture") ?? ""
    val all: array<f32> = []
    var vocab = 0
    if (architecture == "inkling2" || architecture == "inkling2_loop") {
        val config = inklingConfigFrom(file)
        if (config == null) {
            println("logits: ${inklingConfigLastError()}")
            return 2
        }
        var model = inklingLoad(backend, file, config, context, 5, halfKv, quantizeKv) ?? return inklingLoadFailed()
        model.dumpDir = dumpDir
        model.useStep = useStep
        model.splitAttention = !noSplit
        if (tapsCheck != "" && (!useStep || !model.enableTaps(backend))) {
            println("logits: --taps-check needs --step and device memory for the taps")
            return 2
        }
        model.fused = !noFuse
        model.fusedController = !noFuseController
        if (!model.reset(backend)) {
            println("logits: could not clear the convolution state (${cudaLastError()})")
            return 1
        }
        if (prefill) {
            val rows = inklingPrefillLogits(backend, model, ids, chunk) ?? return 1
            for (value in rows) all.append(value)
        }
        for (position in 0 until (if (prefill) 0 else ids.size)) {
            if (!model.forward(backend, ids[position], position)) {
                println("logits: ${inklingLastError()} (${cudaLastError()})")
                return 1
            }
            val row = model.readLogits(backend)
            if (row == null) {
                println("logits: ${inklingLastError()}")
                return 1
            }
            for (value in row) all.append(value)
            if (tapsCheck != "" && position == 0) {
                // the taps of position 0 against a direct run's dumps (logits --dump DIR on the same one-token prompt)
                if (!tapCheck(backend, model, tapsCheck, 0, "l_out-4") || !tapCheck(backend, model, tapsCheck, 3, "result_norm")) return 1
            }
        }
        vocab = config.nVocab
    } else {
        val config = llamaConfigFrom(file)
        if (config == null) {
            println("logits: ${llamaConfigLastError()}")
            return 2
        }
        val model = llamaLoad(backend, file, config, context)
        if (model == null) {
            println("logits: ${llamaLastError()}")
            return 1
        }
        for (position in 0 until ids.size) {
            if (!model.forward(backend, ids[position], position)) {
                println("logits: ${llamaLastError()} (${cudaLastError()})")
                return 1
            }
            val row = model.readLogits(backend)
            if (row == null) {
                println("logits: ${llamaLastError()}")
                return 1
            }
            for (value in row) all.append(value)
        }
        vocab = config.nVocab
    }
    if (!grdlWrite(out, Grdl(vocab, ids, all))) {
        println("logits: cannot write $out")
        return 1
    }
    println("logits: ${ids.size} positions x $vocab written to $out")
    0
}

// `--taps-check DIR`: tap record (position 0, `slot`) against the direct run's dump DIR/name.f32.
private fun tapCheck(var backend: Backend, model: InklingModel, dir: string, slot: int, name: string): bool {
    val tap = model.readTap(backend, 0, slot)
    val dumped = readFloatFile("$dir/$name.f32")
    if (tap == null || dumped == null || tap.size != dumped.size) {
        println("logits: taps-check: cannot read $name")
        return false
    }
    var worst = 0.0
    for (i in 0 until tap.size) {
        val d = f32ToF64(tap[i]) - f32ToF64(dumped[i])
        if (d > worst) worst = d
        if (-d > worst) worst = -d
    }
    println("logits: taps-check $name: max abs difference $worst")
    worst < 0.0001
}
