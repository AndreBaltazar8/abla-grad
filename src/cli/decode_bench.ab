// `abla-grad decode-bench <model.gguf> <ids-file> [--n N] [--mode direct|graph] [--ctx N] [--batch-seed] [--f16-kv] [--global-kv 8|16|32] [--log file]`: greedy decode speed of an Inkling model, tg128-style.
// Seeding is untimed. By default it steps through the IDs. --batch-seed prefills the prefix in chunks of 512. The timed region generates N tokens:
// `direct` launches every kernel from the host each token and reads the argmax back; `graph` replays one recorded token N times with the argmax,
// the token log and the position all on the device. Prints tok/s and the generated ids (to --log if given).
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "abla/process/time"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/inkling_prefill.ab"
import "../model/weights.ab"
import "../ops.ab"

private fun readPromptIds(path: string): array<int>? {
    val result = Path(path).readTextResult()
    if (!result.succeeded) return null
    val ids: array<int> = []
    for (rawLine in result.text.split("\n")) {
        val line = rawLine.trim()
        if (line == "") continue
        val id = line.parseInt()
        if (id == null) return null
        ids.append(id)
    }
    ids
}

private fun benchReport(mode: string, count: int, nanoseconds: int, tokens: array<int>, logPath: string): int {
    val seconds = f64FromInt(nanoseconds) / 1000000000.0
    println("decode-bench: $mode $count tokens in ${seconds} s = ${f64FromInt(count) / seconds} tok/s (${seconds * 1000.0 / f64FromInt(count)} ms/token)")
    var lines = ""
    for (t in tokens) lines = lines + "$t\n"
    if (logPath != "") Path(logPath).writeText(lines)
    0
}

private fun decodeBenchSeed(var backend: Backend, model: InklingModel, ids: array<int>, prefix: array<int>, ws: PrefillWorkspace?): bool {
    if (ws != null) return model.prefill(backend, ws, prefix, 0)
    for (position in 0 until ids.size - 1) if (!model.forward(backend, ids[position], position)) return false
    true
}

fun cmdDecodeBench(args: array<string>): int {
    var count = 128
    var mode = "graph"
    var maxCtx = 0
    var logPath = ""
    var noSplit = false
    var halfKv = false
    var batchSeed = false
    var globalBits = 0
    var launches = false
    var splits = 16
    var noFuse = false
    var noFuseController = false
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--n" && index + 1 < args.size) {
            count = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--splits" && index + 1 < args.size) {
            splits = args[index + 1].parseInt() ?? 16
            index = index + 2
        } else if (args[index] == "--f16-kv") {
            halfKv = true
            index = index + 1
        } else if (args[index] == "--batch-seed") {
            batchSeed = true
            index = index + 1
        } else if (args[index] == "--global-kv" && index + 1 < args.size) {
            globalBits = args[index + 1].parseInt() ?? 0
            if (globalBits != 8 && globalBits != 16 && globalBits != 32) return 2
            index = index + 2
        } else if (args[index] == "--skip" && index + 1 < args.size) {
            for (name in args[index + 1].split(",")) cudaSkipKernels.append(name)
            index = index + 2
        } else if (args[index] == "--q6k") {
            weightsRequantQ6K = true
            index = index + 1
        } else if (args[index] == "--launches") {
            launches = true
            index = index + 1
        } else if (args[index] == "--no-split") {
            noSplit = true
            index = index + 1
        } else if (args[index] == "--no-fuse") {
            noFuse = true
            index = index + 1
        } else if (args[index] == "--no-fuse-controller") {
            noFuseController = true
            index = index + 1
        } else if (args[index] == "--mode" && index + 1 < args.size) {
            mode = args[index + 1]
            index = index + 2
        } else if (args[index] == "--ctx" && index + 1 < args.size) {
            maxCtx = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--log" && index + 1 < args.size) {
            logPath = args[index + 1]
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 2 || count <= 0 || (mode != "direct" && mode != "graph")) {
        println("usage: abla-grad decode-bench <model.gguf> <ids-file> [--n N] [--mode direct|graph] [--ctx N] [--batch-seed] [--f16-kv] [--global-kv 8|16|32] [--log file]")
        return 2
    }
    if (splits < 1 || splits > ATTENTION_SPLITS_MAX) return 2
    val ids = readPromptIds(positional[1])
    if (ids == null || ids.size == 0) {
        println("decode-bench: ${positional[1]} is not a file of token ids")
        return 2
    }
    if (maxCtx > 0 && (ids.size > maxCtx || count > maxCtx - ids.size + 1)) {
        println("decode-bench: the context must fit the prompt and generated positions")
        return 2
    }
    val file = ggufOpen(positional[0])
    if (file == null) {
        println("decode-bench: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file)
    if (config == null) {
        println("decode-bench: ${inklingConfigLastError()} (decode-bench supports Inkling models)")
        return 2
    }
    var backend = cudaBackend() ?? return 2
    val context = if (maxCtx > 0) maxCtx else ids.size + count + 8
    var model = inklingLoad(backend, file, config, context, 5, halfKv, false, globalBits) ?? return 1
    if (!model.reset(backend)) return 1
    model.useStep = true
    model.splitAttention = !noSplit
    model.attentionSplits = splits
    model.fused = !noFuse
    model.fusedController = !noFuseController
    // prefill all but the last prompt token (this also loads every kernel module, which must happen before recording)
    val prefix: array<int> = []
    if (batchSeed) for (i in 0 until ids.size - 1) prefix.append(ids[i])
    val ws = if (batchSeed && prefix.size > 0) prefillWorkspace(backend, config, 512, false) else null
    if (batchSeed && prefix.size > 0 && ws == null) return 1
    if (mode != "graph" && !decodeBenchSeed(backend, model, ids, prefix, ws)) return 1
    val last = ids.size - 1
    val generated: array<int> = []
    if (mode == "graph") {
        // one direct pass of the last prompt token warms the kernels; its effects are undone by resetting and prefilling again
        if (!model.forward(backend, ids[0], 0)) return 1
        val recording = model.capture(backend)
        if (recording == null) {
            println("decode-bench: ${inklingLastError()} (${cudaLastError()})")
            return 1
        }
        if (launches) {
            var total = 0
            for (name in cudaLaunchCounts.keys()) {
                val c = cudaLaunchCounts.get(name) ?? 0
                total = total + c
                println("decode-bench: launches $name: $c")
            }
            println("decode-bench: launches per token: $total")
        }
        if (!model.reset(backend)) return 1
        if (!decodeBenchSeed(backend, model, ids, prefix, ws)) return 1
        if (!model.seed(backend, ids[last], last)) return 1
        if (!backend.synchronize()) return 1
        val start = monotonicNanoseconds()
        if (!model.replayMany(backend, recording, count)) {
            println("decode-bench: ${inklingLastError()} (${cudaLastError()})")
            return 1
        }
        val elapsed = monotonicNanoseconds() - start
        val log = model.readLog(backend, last, count) ?? return 1
        for (t in log) generated.append(t)
        return benchReport("graph", count, elapsed, generated, logPath)
    }
    // direct: every kernel launched from the host, the argmax read back (device argmax into step[0] then a 4-byte download)
    var token = ids[last]
    val start = monotonicNanoseconds()
    for (step in 0 until count) {
        if (!model.forward(backend, token, last + step)) {
            println("decode-bench: ${inklingLastError()} (${cudaLastError()})")
            return 1
        }
        if (!opArgmax(backend, model.scratch, model.so("logits"), config.nVocab, model.step, 0)) return 1
        val next = model.readStepWord(backend, 0) ?? return 1
        generated.append(next)
        token = next
    }
    benchReport("direct", count, monotonicNanoseconds() - start, generated, logPath)
}
