// `abla-grad spec-accept <target.gguf> <drafter.gguf> <ids-file> [--n N] [--ctx N]`: the acceptance the DSpark drafter would get along plain greedy decoding.
// The target runs token by token in step mode (taps on); after every position the drafter proposes up to two ids from the committed prefix and the target's
// own greedy next token as anchor; each proposal is compared with what the target then actually generated (greedy chain), only for positions inside the generated
// part. Prints the first-proposal and second-proposal (given the first) acceptance and the tokens per verification cycle they imply.
import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/inkling_config.ab"
import "../model/dspark.ab"
import "../ops.ab"
import "../model/inkling_prefill.ab"
import "abla/process/time"

fun cmdSpecAccept(args: array<string>): int {
    var count = 128
    var maxCtx = 0
    var cost = false
    var union = false
    var nmax = 2
    var tracePath = ""
    var prefillTaps = false
    var exactWindow = 0
    val positional: array<string> = []
    var index = 0
    while (index < args.size) {
        if (args[index] == "--n" && index + 1 < args.size) {
            count = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--exact-window" && index + 1 < args.size) {
            exactWindow = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (args[index] == "--prefill-taps") {
            prefillTaps = true
            index = index + 1
        } else if (args[index] == "--trace" && index + 1 < args.size) {
            tracePath = args[index + 1]
            index = index + 2
        } else if (args[index] == "--nmax" && index + 1 < args.size) {
            nmax = args[index + 1].parseInt() ?? 2
            index = index + 2
        } else if (args[index] == "--union") {
            union = true
            index = index + 1
        } else if (args[index] == "--cost") {
            cost = true
            index = index + 1
        } else if (args[index] == "--ctx" && index + 1 < args.size) {
            maxCtx = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else {
            positional.append(args[index])
            index = index + 1
        }
    }
    if (positional.size != 3 || count <= 0) {
        println("usage: abla-grad spec-accept <target.gguf> <drafter.gguf> <ids-file> [--n N] [--ctx N]")
        return 2
    }
    val idsText = Path(positional[2]).readTextResult()
    if (!idsText.succeeded) {
        println("spec-accept: cannot read ${positional[2]}")
        return 2
    }
    val ids: array<int> = []
    for (rawLine in idsText.text.split("\n")) {
        val line = rawLine.trim()
        if (line == "") continue
        ids.append(line.parseInt() ?? return 2)
    }
    val file = ggufOpen(positional[0])
    val draftFile = ggufOpen(positional[1])
    if (file == null || draftFile == null) {
        println("spec-accept: ${ggufLastError()}")
        return 2
    }
    val config = inklingConfigFrom(file) ?? return 2
    var backend = cudaBackend() ?? return 2
    val context = if (maxCtx > 0) maxCtx else ids.size + count + 8
    var model = inklingLoad(backend, file, config, context) ?? return 1
    if (!model.reset(backend)) return 1
    model.useStep = true
    if (!model.enableTaps(backend)) return 1
    model.traceIds = union
    var drafter = dsparkLoad(backend, draftFile, context, nmax) ?? return 1
    val total = ids.size + count
    // nxt[p] = the target's greedy token after position p (the anchor for the prefix [0, p])
    val nxt: array<int> = []
    val first: array<int> = []
    val second: array<int> = []
    val third: array<int> = []
    val fourth: array<int> = []
    var token = ids[0]
    var begin = 0
    if (prefillTaps) {
        // the prompt's state and taps come from the batched prefill (f16 tensor cores) instead of step-mode decode
        val ws = prefillWorkspace(backend, config, 512, false) ?? return 1
        val head: array<int> = []
        // the last `exactWindow` prompt positions stay in step mode (exact taps for the recent context)
        for (i in 0 until (if (ids.size - 1 > exactWindow) ids.size - 1 - exactWindow else 0)) head.append(ids[i])
        if (!model.prefill(backend, ws, head, 0) || !drafter.pushTaps(backend, model.taps, 0, head.size)) {
            println("spec-accept: prefill: ${inklingPrefillLastError()} ${dsparkLastError()}")
            return 1
        }
        for (i in 0 until head.size) {
            nxt.append(-1)
            first.append(-1)
            second.append(-1)
            third.append(-1)
            fourth.append(-1)
        }
        begin = head.size
        token = ids[begin]
    }
    for (position in begin until total - 1) {
        if (!model.forward(backend, token, position)) {
            println("spec-accept: ${inklingLastError()} (${cudaLastError()})")
            return 1
        }
        if (!opArgmax(backend, model.scratch, model.so("logits"), config.nVocab, model.step, 0)) return 1
        val greedy = model.readStepWord(backend, 0) ?? return 1
        nxt.append(greedy)
        if (!drafter.pushTaps(backend, model.taps, position, 1)) {
            println("spec-accept: ${dsparkLastError()}")
            return 1
        }
        val proposals = drafter.propose(backend, model, position + 1, greedy)
        if (dsparkLastError() != "") {
            println("spec-accept: ${dsparkLastError()}")
            return 1
        }
        first.append(if (proposals.size > 0) proposals[0] else -1)
        second.append(if (proposals.size > 1) proposals[1] else -1)
        third.append(if (proposals.size > 2) proposals[2] else -1)
        fourth.append(if (proposals.size > 3) proposals[3] else -1)
        token = if (position + 1 < ids.size) ids[position + 1] else greedy
    }
    if (cost) {
        // the cost of one speculation cycle's parts at the end of the run: drafter propose, 3-row verify (+ argmax), one plain decode step
        val ws = prefillWorkspace(backend, config, 8, true, 3) ?? return 1
        val last = total - 1
        val anchor = nxt[nxt.size - 1]
        var proposeNs = 0
        var verifyNs = 0
        var decodeNs = 0
        val rounds = 20
        for (r in 0 until rounds) {
            val t0 = monotonicNanoseconds()
            val proposals = drafter.propose(backend, model, last, anchor)
            val t1 = monotonicNanoseconds()
            val rows = [anchor, if (proposals.size > 0) proposals[0] else 1, if (proposals.size > 1) proposals[1] else 1]
            if (!model.verify(backend, ws, rows, last)) return 1
            val am = model.verifyArgmax(backend, ws, 3) ?? return 1
            val t2 = monotonicNanoseconds()
            if (!model.forward(backend, anchor, last)) return 1
            if (!opArgmax(backend, model.scratch, model.so("logits"), config.nVocab, model.step, 0)) return 1
            val g = model.readStepWord(backend, 0) ?? return 1
            val t3 = monotonicNanoseconds()
            proposeNs = proposeNs + (t1 - t0)
            verifyNs = verifyNs + (t2 - t1)
            decodeNs = decodeNs + (t3 - t2)
        }
        println("spec-accept: per cycle part (ms): propose ${f64FromInt(proposeNs) / 1000000.0 / f64FromInt(rounds)}, verify 3 rows + argmax ${f64FromInt(verifyNs) / 1000000.0 / f64FromInt(rounds)}, one plain decode step (direct, step mode) ${f64FromInt(decodeNs) / 1000000.0 / f64FromInt(rounds)}")
    }
    if (union) {
        // distinct experts per layer visit over 2 and 3 consecutive generated tokens (the rows of a 2- or 3-row verification)
        val perToken = model.visits * config.nExpertUsed
        for (rows in [2, 3]) {
            val hist: array<int> = []
            for (i in 0 until rows * config.nExpertUsed + 1) hist.append(0)
            var windows = 0
            var sum = 0
            for (t in ids.size - 1 until nxt.size - rows) {
                for (v in 0 until model.visits) {
                    val seen: array<int> = []
                    for (r in 0 until rows) {
                        for (e in 0 until config.nExpertUsed) {
                            val id = inklingIdLog[(t + r) * perToken + v * config.nExpertUsed + e]
                            var found = false
                            for (s in seen) if (s == id) found = true
                            if (!found) seen.append(id)
                        }
                    }
                    hist[seen.size] = hist[seen.size] + 1
                    sum = sum + seen.size
                    windows = windows + 1
                }
            }
            var line = ""
            for (size in config.nExpertUsed until hist.size) if (hist[size] > 0) line = line + " $size:${hist[size]}"
            println("spec-accept: distinct experts per layer visit over $rows rows: mean ${f64FromInt(sum) / f64FromInt(windows)} (of ${rows * config.nExpertUsed}); histogram$line")
        }
    }
    if (tracePath != "") {
        // one line per position p >= ids.size - 1: p, the anchor (the target's greedy token after position p), the drafter's four proposals for the next
        // tokens, and the target's actual greedy continuation (the anchor is nxt[p]; nxt[p + 1 ..] follow it): "p anchor | p1 p2 p3 p4 | n1 n2 n3 n4"
        var lines = ""
        for (p in ids.size - 1 until nxt.size - 4) {
            lines = lines + "$p ${nxt[p]} | ${first[p]} ${second[p]} ${third[p]} ${fourth[p]} | ${nxt[p + 1]} ${nxt[p + 2]} ${nxt[p + 3]} ${nxt[p + 4]}\n"
        }
        Path(tracePath).writeText(lines)
    }
    // positions p >= ids.size - 1 have a greedy continuation: nxt[p+1] follows the anchor nxt[p]
    var cycles = 0
    var ok1 = 0
    var ok2 = 0
    var ok3 = 0
    var ok4 = 0
    for (p in ids.size - 1 until nxt.size - 4) {
        cycles = cycles + 1
        if (first[p] == nxt[p + 1]) {
            ok1 = ok1 + 1
            if (second[p] == nxt[p + 2]) {
                ok2 = ok2 + 1
                if (third[p] == nxt[p + 3]) {
                    ok3 = ok3 + 1
                    if (fourth[p] == nxt[p + 4]) ok4 = ok4 + 1
                }
            }
        }
    }
    val c = f64FromInt(cycles)
    val a1 = f64FromInt(ok1) / c
    val a2 = if (ok1 > 0) f64FromInt(ok2) / f64FromInt(ok1) else 0.0
    val a3 = if (ok2 > 0) f64FromInt(ok3) / f64FromInt(ok2) else 0.0
    val a4 = if (ok3 > 0) f64FromInt(ok4) / f64FromInt(ok3) else 0.0
    val t2 = 1.0 + a1 + a1 * a2
    val t3 = t2 + a1 * a2 * a3
    val t4 = t3 + a1 * a2 * a3 * a4
    println("spec-accept: $cycles cycles; accepted given the previous ones: 1st ${a1 * 100.0}%, 2nd ${a2 * 100.0}%, 3rd ${a3 * 100.0}%, 4th ${a4 * 100.0}%; tokens per verification cycle at n-max 2: $t2, 3: $t3, 4: $t4")
    0
}
