import "abla/io"
import "abla/process/arguments"
import "cli/compare.ab"
import "cli/info.ab"
import "cli/logits.ab"
import "cli/tokenize.ab"
import "cli/compare_tensors.ab"
import "cli/generate.ab"

// Commands: compare, info; tokenize and logits arrive with the tokenizer (ablac-90) and the model graph.
fun main: int {
    val args: array<string> = []
    for (index in 1 until processArgumentCount()) args.append(processArgument(index))
    val command = if (processArgumentCount() > 0) processArgument(0) else ""
    if (command == "compare") return cmdCompare(args)
    if (command == "info") return cmdInfo(args)
    if (command == "logits") return cmdLogits(args)
    if (command == "tokenize") return cmdTokenize(args)
    if (command == "generate") return cmdGenerate(args)
    if (command == "compare-tensors") return cmdCompareTensors(args)
    println("abla-grad: commands: compare <oracle.grdl> <ours.grdl> [--tolerances file]\n       abla-grad info <model.gguf>   (tokenize, logits, generate; see README.md)")
    if (command == "") 0 else 2
}
