// Per-position comparison of two logit vectors (docs/plan.md, "How we compare with llama.cpp").
import "abla/math"
import "abla/float"
import "abla/float/text"
import "abla/text"

class PositionMetrics(
    val argmaxEqual: bool,
    val top5Equal: bool,
    val maxAbs: f64,
    val meanAbs: f64,
    // KL(a || b) between the softmax of the two vectors, in nats.
    val kl: f64
)

private fun metricsArgmax(values: array<f32>, offset: int, vocab: int): int {
    var best = 0
    for (index in 1 until vocab) if (values[offset + index] > values[offset + best]) best = index
    best
}

// The `count` largest indices of values[offset ..< offset + vocab], largest first (ties: the lower index first).
private fun metricsTop(values: array<f32>, offset: int, vocab: int, count: int): array<int> {
    val chosen: array<int> = []
    for (round in 0 until count) {
        var best = -1
        for (index in 0 until vocab) {
            var taken = false
            for (each in chosen) if (each == index) taken = true
            if (!taken && (best < 0 || values[offset + index] > values[offset + best])) best = index
        }
        chosen.append(best)
    }
    chosen
}

private fun metricsSameSet(first: array<int>, second: array<int>): bool {
    if (first.size != second.size) return false
    for (each in first) {
        var found = false
        for (other in second) if (other == each) found = true
        if (!found) return false
    }
    true
}

fun comparePosition(a: array<f32>, aOffset: int, b: array<f32>, bOffset: int, vocab: int): PositionMetrics {
    var maxAbs = 0.0
    var sumAbs = 0.0
    var maxA = f32ToF64(a[aOffset])
    var maxB = f32ToF64(b[bOffset])
    for (index in 0 until vocab) {
        val x = f32ToF64(a[aOffset + index])
        val y = f32ToF64(b[bOffset + index])
        val difference = if (x > y) x - y else y - x
        if (difference > maxAbs) maxAbs = difference
        sumAbs = sumAbs + difference
        if (x > maxA) maxA = x
        if (y > maxB) maxB = y
    }
    var sumA = 0.0
    var sumB = 0.0
    for (index in 0 until vocab) {
        sumA = sumA + exp(f32ToF64(a[aOffset + index]) - maxA)
        sumB = sumB + exp(f32ToF64(b[bOffset + index]) - maxB)
    }
    val logA = log(sumA)
    val logB = log(sumB)
    var kl = 0.0
    for (index in 0 until vocab) {
        val logPa = f32ToF64(a[aOffset + index]) - maxA - logA
        val logPb = f32ToF64(b[bOffset + index]) - maxB - logB
        kl = kl + exp(logPa) * (logPa - logPb)
    }
    val top5 = if (vocab < 5) vocab else 5
    PositionMetrics(
        metricsArgmax(a, aOffset, vocab) == metricsArgmax(b, bOffset, vocab),
        metricsSameSet(metricsTop(a, aOffset, vocab, top5), metricsTop(b, bOffset, vocab, top5)),
        maxAbs, sumAbs / f64FromInt(vocab), kl
    )
}

// The limits `abla-grad compare` holds every position to: one `key value` per line (`#` comments), keys maxAbs, meanAbs, kl
// (largest allowed), requireArgmax and requireTop5 (1 or 0). A key that is absent is not checked.
class Tolerances(
    val maxAbs: f64,
    val meanAbs: f64,
    val kl: f64,
    val requireArgmax: bool,
    val requireTop5: bool
)

fun tolerancesDefault(): Tolerances = Tolerances(1.0e30, 1.0e30, 1.0e30, false, false)

fun tolerancesParse(text: string): Tolerances? {
    var maxAbs = 1.0e30
    var meanAbs = 1.0e30
    var kl = 1.0e30
    var argmax = false
    var top5 = false
    for (rawLine in text.split("\n")) {
        val line = rawLine.trim()
        if (line == "" || line.startsWith("#")) continue
        val parts = line.split(" ")
        if (parts.size != 2) return null
        val value = parts[1].trim()
        if (parts[0] == "requireArgmax") argmax = value == "1"
        else if (parts[0] == "requireTop5") top5 = value == "1"
        else {
            val number = parseDecimal(value)
            if (number == null) return null
            if (parts[0] == "maxAbs") maxAbs = number
            else if (parts[0] == "meanAbs") meanAbs = number
            else if (parts[0] == "kl") kl = number
            else return null
        }
    }
    Tolerances(maxAbs, meanAbs, kl, argmax, top5)
}

/** Why `metrics` is outside `limits`, or "" when it is inside. */
fun toleranceViolation(metrics: PositionMetrics, limits: Tolerances): string {
    if (limits.requireArgmax && !metrics.argmaxEqual) return "argmax differs"
    if (limits.requireTop5 && !metrics.top5Equal) return "top-5 sets differ"
    if (metrics.maxAbs > limits.maxAbs) return "max |dlogit| ${metrics.maxAbs} > ${limits.maxAbs}"
    if (metrics.meanAbs > limits.meanAbs) return "mean |dlogit| ${metrics.meanAbs} > ${limits.meanAbs}"
    if (metrics.kl > limits.kl) return "KL ${metrics.kl} > ${limits.kl}"
    ""
}

/** A decimal number ("0.05", "-3", "1e-3", "2.5E2"); null when `text` is not one. */
fun parseDecimal(text: string): f64? {
    var at = 0
    var negative = false
    if (at < text.size && (text[at] == 45 || text[at] == 43)) {
        negative = text[at] == 45
        at = at + 1
    }
    var mantissa = 0.0
    var digits = 0
    while (at < text.size && text[at] >= 48 && text[at] <= 57) {
        mantissa = mantissa * 10.0 + f64FromInt(text[at] - 48)
        digits = digits + 1
        at = at + 1
    }
    var scale = 0
    if (at < text.size && text[at] == 46) {
        at = at + 1
        while (at < text.size && text[at] >= 48 && text[at] <= 57) {
            mantissa = mantissa * 10.0 + f64FromInt(text[at] - 48)
            digits = digits + 1
            scale = scale - 1
            at = at + 1
        }
    }
    if (digits == 0) return null
    if (at < text.size && (text[at] == 101 || text[at] == 69)) {
        at = at + 1
        var exponentNegative = false
        if (at < text.size && (text[at] == 45 || text[at] == 43)) {
            exponentNegative = text[at] == 45
            at = at + 1
        }
        var exponent = 0
        var exponentDigits = 0
        while (at < text.size && text[at] >= 48 && text[at] <= 57) {
            exponent = exponent * 10 + (text[at] - 48)
            exponentDigits = exponentDigits + 1
            at = at + 1
        }
        if (exponentDigits == 0) return null
        scale = scale + (if (exponentNegative) -exponent else exponent)
    }
    if (at != text.size) return null
    var value = mantissa
    var steps = if (scale < 0) -scale else scale
    while (steps > 0) {
        value = if (scale < 0) value / 10.0 else value * 10.0
        steps = steps - 1
    }
    if (negative) -value else value
}
