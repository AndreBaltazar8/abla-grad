private fun cudaCountIsLast3(args: KernelArgs, problem: array<int>): bool = args.words[3] == problem[0]
private fun cudaCountIsLast2(args: KernelArgs, problem: array<int>): bool = args.words[2] == problem[0]
private fun cudaCountIsLast5(args: KernelArgs, problem: array<int>): bool = args.words[5] == problem[0]
private fun cudaSituShape(args: KernelArgs, problem: array<int>): bool = args.words[2] * args.words[3] == problem[0]
private fun cudaCheckpointWindowShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] > 0 && args.words[3] <= args.words[4] && args.words[4] <= args.words[5] &&
        args.words[6] > 0 && args.words[7] > 0 && problem[0] == args.words[3] * args.words[6] * args.words[7]
private fun cudaKvStoreShape(args: KernelArgs, problem: array<int>): bool = args.words[5] * args.words[6] == problem[0]
private fun cudaL2ClipShape(args: KernelArgs, problem: array<int>): bool = args.words[3] == problem[0] && args.words[4] > 0
private fun cudaArgmaxShape(args: KernelArgs, problem: array<int>): bool = problem[0] == 1 && args.words[1] > 0

