private fun cudaVerifyDenseShape(args: KernelArgs, problem: array<int>): bool =
    cudaF32Shape(args, problem) && ((args.words[5] >= 1 && args.words[5] <= 5) || args.words[5] == 8)

private fun cudaVerifyBf16OutputShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyDenseShape(args, problem) && args.words[0] % 2 == 0 && args.words[5] == problem[1] && problem[1] <= 5

private fun cudaF32OutputShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyBf16OutputShape(args, problem) && args.words[0] % 4 == 0

private fun cudaDsparkShortlistShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == args.words[5] && problem[0] > 0 && args.words[2] % 2 == 0 && args.words[4] % 8 == 0

private fun cudaDsparkPairShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == 1 && args.words[0] % 8 == 0 && args.words[2] > 0

private fun cudaVerifyQ8Shape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyDenseShape(args, problem) && args.words[4] % 32 == 0

private fun cudaVerifyIndexedShape(args: KernelArgs, problem: array<int>, blockElements: int, blockBytes: int): bool {
    if (!cudaF32Shape(args, problem) || args.words[5] < 1 || args.words[5] > 5 || args.words[4] % blockElements != 0 ||
        args.words[7] != problem[1]) return false
    val cols = args.words[4]
    val rowBytes = cols / blockElements * blockBytes
    val expertStride = args.words[8]
    val slots = args.words[9]
    val vectorStride = args.words[10]
    val slotStride = args.words[11]
    expertStride > 0 &&
        args.words[6] % 4 == 0 && problem[0] <= expertStride / rowBytes && slots > 0 &&
        (args.words[5] == 1 || vectorStride >= cols) && (slotStride == 0 || slotStride >= cols)
}

private fun cudaVerifyNvfp4Shape(args: KernelArgs, problem: array<int>): bool =
    args.words[0] % 4 == 0 && args.words[8] % 4 == 0 && cudaVerifyIndexedShape(args, problem, 64, 36)

private fun cudaVerifyNvfp4FiveShape(args: KernelArgs, problem: array<int>): bool {
    val cols = args.words[4]
    val gateUp = cols == 2304 && args.words[10] == cols && args.words[11] == 0
    val down = cols == 1152 && args.words[10] == 8 * cols && args.words[11] == cols
    args.words[7] == 40 && problem[1] > 0 && problem[1] <= 40 &&
        cudaVerifyNvfp4Shape(args, [problem[0], 40]) && problem[0] == 2304 &&
        args.words[5] == 5 && args.words[9] == 8 && args.words[1] % 16 == 0 && args.words[12] != 0 && (gateUp || down)
}

private fun cudaVerifyQ8IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyIndexedShape(args, problem, 32, 34)

private fun cudaVerifyQ5IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyIndexedShape(args, problem, 256, 176)

private fun cudaControllerNormDownShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == inklingControllerNormDown.geometry.problem[0]

private val cudaCtrlTailArgs = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgU]
private fun cudaCtrlTailShape(args: KernelArgs, problem: array<int>): bool =
    args.words[8] == problem[0] && args.words[8] > 0 && args.words[9] >= 1 && args.words[9] <= 5 &&
        (args.words[9] == 1 || (args.words[4] >= args.words[8] && args.words[6] >= args.words[8]))

