private fun cudaKQuantShape(args: KernelArgs, problem: array<int>): bool =
    cudaF32Shape(args, problem) && args.words[4] % 256 == 0

private fun cudaGatherShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0]

private fun cudaKGatherShape(args: KernelArgs, problem: array<int>): bool =
    cudaGatherShape(args, problem) && args.words[3] % 256 == 0

private fun cudaRmsnormShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] > 0 && args.words[4] > 0 && args.words[4] <= 0x7f7fffff

private fun cudaRmsnormThreeShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == 3 && args.words[7] > 0 && args.words[8] > 0 && args.words[8] <= 0x7f7fffff

private fun cudaRopeShape(args: KernelArgs, problem: array<int>): bool {
    val ropeDim = args.words[4]
    val pairs = ropeDim / 2
    val freqBase = args.words[6]
    ropeDim > 0 && ropeDim % 2 == 0 && ropeDim <= args.words[3] &&
        problem[0] % pairs == 0 && problem[0] / pairs == args.words[2] &&
        freqBase > 0 && freqBase <= 0x7f7fffff && args.words[7] <= 1
}

private fun cudaAttentionHeadShape(head: int, kvHead: int, dim: int, expected: int): bool =
    head == expected && kvHead > 0 && head % kvHead == 0 && dim > 0 && dim <= 256

private fun cudaAttentionShapeAt(args: KernelArgs, problem: array<int>, base: int, contextIndex: int): bool {
    val head = args.words[base]
    val kvHead = args.words[base + 1]
    val dim = args.words[base + 2]
    val first = args.words[base + 3]
    val last = args.words[base + 4]
    cudaAttentionHeadShape(head, kvHead, dim, problem[0]) && first <= last && last < args.words[contextIndex]
}

private fun cudaAttentionShape(args: KernelArgs, problem: array<int>): bool =
    cudaAttentionShapeAt(args, problem, 4, 9)

private fun cudaRelativeAttentionShape(args: KernelArgs, problem: array<int>): bool =
    cudaAttentionShapeAt(args, problem, 5, 12) && args.words[9] <= args.words[10]

private fun cudaRelativeAttentionStepShape(args: KernelArgs, problem: array<int>): bool =
    cudaAttentionHeadShape(args.words[6], args.words[7], args.words[8], problem[0]) && args.words[11] > 0

