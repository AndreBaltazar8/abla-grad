private class CudaKernelSpec(
    val name: string,
    val source: string,
    val itemsPerBlock: int,
    val blockX: int,
    val argumentKinds: array<int>,
    val validate: (KernelArgs, array<int>) -> bool,
    val problemDimensions: int = 1,
    val nullablePointer: int = -1,
    // An Abla `@kernel` (ablac #1233): its PTX comes from the compiler (kernelPtx()), not from `source`, and a pointer
    // parameter is passed as its address and its element count (KernelArgs.extents / ablaElementBytes).
    val abla: bool = false,
    // For an Abla kernel, the bytes of one element of each pointer parameter by position (0 or missing: 4).
    val ablaElementBytes: array<int> = []
)

// Each upload worker owns two bounded write-combined host slots and one stream.
// A CUDA event guards reuse of each slot while the other copy is in flight.
private val CUDA_UPLOAD_SLOT_BYTES = 4 * 1024 * 1024
private class CudaUploadResult(val status: i32, val call: string)
private resource class CudaWeightUpload(val context: int, val destination: int, val slices: array<HostUpload>) {
    trusted fun run(): CudaUploadResult? {
        val pushed = cuCtxPushCurrent_v2(nativePointerFromAddress(this.context))
        if (pushed != 0) return CudaUploadResult(pushed, "cuCtxPushCurrent")
        val storage = nativePointerCell(nativeNullPointer())
        val allocated = cuMemHostAlloc(storage.address, u64(2 * CUDA_UPLOAD_SLOT_BYTES), 4) == 0 // WRITECOMBINED
        val result = if (allocated) this.withStaging(nativePointerAddress(storage.load())) else null
        if (allocated) cuMemFreeHost(storage.load())
        cuCtxPopCurrent_v2(storage.address)
        result
    }

    trusted fun withStaging(base: int): CudaUploadResult? {
        val streamCell = nativePointerCell(nativeNullPointer())
        if (cuStreamCreate(streamCell.address, 1) != 0) return null // NON_BLOCKING
        val stream = streamCell.load()
        val events: array<int> = []
        for (index in 0 until 2) {
            val event = nativePointerCell(nativeNullPointer())
            if (cuEventCreate(event.address, 2) != 0) break // DISABLE_TIMING
            events.append(nativePointerAddress(event.load()))
        }
        val result = if (events.size == 2) this.enqueue(base, stream, events) else null
        val drained = cuStreamSynchronize(stream)
        for (event in events) cuEventDestroy_v2(nativePointerFromAddress(event))
        cuStreamDestroy_v2(stream)
        if (result != null && result.status != 0) return result
        if (drained != 0) return CudaUploadResult(drained, "cuStreamSynchronize")
        result
    }

    trusted fun enqueue(base: int, stream: i64*, events: array<int>): CudaUploadResult {
        var slot = 0
        for (slice in this.slices) {
            var sent = 0
            while (sent < slice.bytes) {
                val event = nativePointerFromAddress(events[slot])
                val waited = cuEventSynchronize(event)
                if (waited != 0) return CudaUploadResult(waited, "cuEventSynchronize")
                val remaining = slice.bytes - sent
                val bytes = if (remaining < CUDA_UPLOAD_SLOT_BYTES) remaining else CUDA_UPLOAD_SLOT_BYTES
                val staging = base + slot * CUDA_UPLOAD_SLOT_BYTES
                ablaUnsafeCopyMemory(staging, slice.address + sent, bytes)
                val copied = cuMemcpyHtoDAsync_v2(u64(this.destination + slice.offset + sent),
                    nativePointerFromAddress(staging), u64(bytes), stream)
                if (copied != 0) return CudaUploadResult(copied, "cuMemcpyHtoDAsync ($bytes bytes)")
                val queued = cuEventRecord(event, stream)
                if (queued != 0) return CudaUploadResult(queued, "cuEventRecord")
                sent += bytes
                slot = 1 - slot
            }
        }
        CudaUploadResult(0, "")
    }
}

