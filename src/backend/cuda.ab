private trusted noescape extern:"c" fun nvrtcCreateProgram(
    program: i64*, source: cstring, name: cstring,
    headerCount: i32, headers: i64*, includeNames: i64*
): i32
private trusted noescape extern:"c" fun nvrtcCompileProgram(program: i64*, optionCount: i32, options: i64*): i32
private trusted noescape extern:"c" fun nvrtcGetProgramLogSize(program: i64*, size: i64*): i32
private trusted noescape extern:"c" fun nvrtcGetProgramLog(program: i64*, text: i64*): i32
private trusted noescape extern:"c" fun nvrtcGetPTXSize(program: i64*, size: i64*): i32
