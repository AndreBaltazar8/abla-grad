private fun cudaDsparkMixShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] > 0 && args.words[4] > 0 && args.words[3] * args.words[4] == problem[0]

private fun cudaDsparkMarkovShape(args: KernelArgs, problem: array<int>): bool = args.words[4] == problem[0]
private fun cudaDsparkZeroShape(args: KernelArgs, problem: array<int>): bool = args.words[1] == problem[0]

private fun cudaDsparkTapRows(rows: int): bool = rows == 3 || rows == 5
private fun cudaDsparkMixStepShape(args: KernelArgs, problem: array<int>): bool =
    cudaDsparkTapRows(args.words[7]) && args.words[8] <= 1 &&
        args.words[5] * (if (args.words[8] == 1) 1 else args.words[7]) == problem[0]
private fun cudaDsparkCommitTapShape(args: KernelArgs, problem: array<int>): bool =
    cudaStepAdvanceShape(args, problem) && cudaDsparkTapRows(args.words[6])
private fun cudaDsparkRopeStepShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] > 0 && args.words[3] % 2 == 0 && args.words[2] * (args.words[3] / 2) * args.words[4] == problem[0]
private fun cudaDsparkKvStepShape(args: KernelArgs, problem: array<int>): bool =
    args.words[6] > 0 && args.words[7] == problem[0] && args.words[10] == problem[1] &&
        (if (args.words[11] == 1) problem[1] == 8 else args.words[11] == 0 && cudaDsparkTapRows(problem[1]))
private fun cudaDsparkAttentionStepShape(args: KernelArgs, problem: array<int>): bool =
    cudaAttentionHeadShape(args.words[5], args.words[6], args.words[7], problem[0]) &&
        args.words[8] == problem[1] && args.words[9] >= problem[1]
private fun cudaDsparkSpecCountIndex(index: int): bool = index == 3 || index == 5
private fun cudaDsparkBeginShape(args: KernelArgs, problem: array<int>): bool =
    cudaStepAdvanceShape(args, problem) && cudaDsparkSpecCountIndex(args.words[7]) &&
        args.words[6] > 0 && args.words[6] < args.words[7]
private fun cudaDsparkPadShape(args: KernelArgs, problem: array<int>): bool =
    cudaStepAdvanceShape(args, problem) && cudaDsparkSpecCountIndex(args.words[1])

private val cudaDsparkKernels = [
    CudaKernelSpec("dspark_mix_step", kernelDsparkMixStep, 256, 256,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU], cudaDsparkMixStepShape),
    CudaKernelSpec("dspark_commit_taps_step", kernelDsparkCommitTapsStep, 1, 256,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU], cudaDsparkCommitTapShape),
    CudaKernelSpec("dspark_rope_step", kernelDsparkRopeStep, 128, 128,
        [prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgF, prefillArgU], cudaDsparkRopeStepShape),
    CudaKernelSpec("dspark_rope_batch", kernelDsparkRopeBatch, 128, 128,
        [prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgF], cudaDsparkRopeStepShape),
    CudaKernelSpec("dspark_kv_step", kernelDsparkKvStep, 256, 256,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP,
            prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU], cudaDsparkKvStepShape, 2),
    CudaKernelSpec("dspark_attention_step", kernelDsparkAttentionStep, 1, 256,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU,
            prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgF], cudaDsparkAttentionStepShape, 2),
    CudaKernelSpec("dspark_gather_step", kernelDsparkGatherStep, 128, 128,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU], cudaGatherShape),
    CudaKernelSpec("dspark_begin_step", kernelDsparkSpecStep, 1, 1,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU], cudaDsparkBeginShape),
    CudaKernelSpec("dspark_pad_step", kernelDsparkSpecStep, 1, 1, [prefillArgP, prefillArgU], cudaDsparkPadShape),
    CudaKernelSpec("dspark_mix", kernelDsparkMix, 256, 256,
        [KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32], cudaDsparkMixShape),
    CudaKernelSpec("dspark_shortlist_four", kernelDsparkShortlist, 128, 128,
        [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgF], cudaDsparkShortlistShape),
    CudaKernelSpec("dspark_best_pair", kernelDsparkShortlist, 1, 256, [prefillArgP, prefillArgP, prefillArgU], cudaDsparkPairShape),
    CudaKernelSpec("dspark_markov", kernelDsparkMarkov, 256, 256,
        [KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32],
        cudaDsparkMarkovShape),
    CudaKernelSpec("dspark_zero", kernelDsparkZero, 256, 256,
        [KERNEL_ARG_POINTER, KERNEL_ARG_U32], cudaDsparkZeroShape)
]

// Reuse each linear kernel's argument contract and launch geometry. The ring
// specialization changes only the physical K/V slot and per-head stride.
private fun cudaKvVariant(spec: CudaKernelSpec, suffix: string, slots: int, half: bool): CudaKernelSpec {
    val name = spec.name + suffix
    val layout = (if (suffix == "_q8") "#define INKLING_Q8_KV\n" else if (suffix == "_fp8") "#define INKLING_FP8_KV\n" else "") + (if (half) "#define INKLING_HALF_KV\n" else "") +
        (if (slots > 0) "#define INKLING_RING_SLOTS ${slots}u\n" else "")
    val shape = if (suffix == "_ring_f16_128") "#define INKLING_SWA_GQA3_128\n" else ""
    val source = layout + shape + "#define ${spec.name} ${name}\n" + spec.source
    CudaKernelSpec(name, source, spec.itemsPerBlock, spec.blockX, spec.argumentKinds,
        if (suffix == "_ring_f16_128") cudaSliding128Shape else spec.validate, spec.problemDimensions, spec.nullablePointer)
}

private fun cudaRingSpecs(): array<CudaKernelSpec> {
    val result: array<CudaKernelSpec> = []
    val target = ["kv_store", "kv_store_step", "kv_store_batch", "kv_store_batch_ptr", "attention_decode_rel",
        "attention_decode_rel_step", "attention_rel_split_step", "attention_prefill_rel", "attention_prefill_tc", "attention_prefill_tc_split"]
    for (list in [cudaKernels, cudaPrefillKernels, cudaDsparkKernels]) for (spec in list) {
        for (base in target) if (spec.name == base) {
            result.append(cudaKvVariant(spec, "_ring", INKLING_KV_RING, false))
            result.append(cudaKvVariant(spec, "_f16", 0, true))
            result.append(cudaKvVariant(spec, "_q8", 0, false))
            result.append(cudaKvVariant(spec, "_fp8", 0, false))
            result.append(cudaKvVariant(spec, "_ring_f16", INKLING_KV_RING, true))
            if (base == "attention_rel_split_step") result.append(cudaKvVariant(spec, "_ring_f16_128", INKLING_KV_RING, true))
        }
        if (spec.name == "attention_rel_grouped_step") {
            result.append(cudaKvVariant(spec, "_f16", 0, true))
            result.append(cudaKvVariant(spec, "_q8", 0, false))
            result.append(cudaKvVariant(spec, "_fp8", 0, false))
        }
        if (spec.name == "attention_decode" || spec.name == "dspark_attention_step" || spec.name == "dspark_kv_step") {
            result.append(cudaKvVariant(spec, "_f16", 0, true))
            result.append(cudaKvVariant(spec, "_draft_ring_f16", INKLING_DRAFT_RING, true))
        }
        if (spec.name == "kv_store_batch") result.append(cudaKvVariant(spec, "_draft_ring_f16", INKLING_DRAFT_RING, true))
        if (spec.name == "tap_rows" || spec.name == "tap_store_step" || spec.name == "dspark_mix_step")
            result.append(cudaKvVariant(spec, "_tap_ring", INKLING_DRAFT_RING, false))
    }
    result
}

private val cudaRingKernels = cudaRingSpecs()

private fun cudaKernelSpec(name: string): CudaKernelSpec? {
    for (spec in cudaKernels) if (spec.name == name) return spec
    for (spec in cudaPrefillKernels) if (spec.name == name) return spec
    for (spec in cudaDsparkKernels) if (spec.name == name) return spec
    for (spec in cudaRingKernels) if (spec.name == name) return spec
    null
}

private class CudaImage(val bytes: string, val cubin: bool = false)

private class CudaImageCache(val directory: string, val identity: string) {
    fun key(source: string, abla: bool): string =
        hexEncode(sha256("cuda-image-v1:$identity:${if (abla) "ptx" else "cuda"}:${hexEncode(sha256(source))}"))

    fun read(key: string): CudaImage? {
        val entry = path("$directory/$key.image").readText()
        // Key, format byte, payload SHA-256, newline, and raw bytes. One
        // atomic file keeps the payload and its identity together.
        if (entry.size <= 130 || entry.slice(0, 64) != key || entry[129] != 10) return null
        val format = entry[64]
        if (format != 66 && format != 80) return null // B (cubin), P (PTX)
        val payload = entry.slice(130, entry.size)
        if (hexEncode(sha256(payload)) != entry.slice(65, 129)) return null
        CudaImage(payload, format == 66)
    }

    fun write(key: string, image: CudaImage): void {
        val format = if (image.cubin) "B" else "P"
        val digest = hexEncode(sha256(image.bytes))
        path("$directory/$key.image").writeTextAtomic("$key$format$digest\n${image.bytes}", 0o600)
        return
    }
}

private trusted fun cudaImageCache(architecture: string): CudaImageCache? {
    val driver = nativeI64Cell(0)
    val major = nativeI64Cell(0)
    val minor = nativeI64Cell(0)
    if (cuDriverGetVersion(driver.address) != 0 || nvrtcVersion(major.address, minor.address) != 0) return null
    // The CUDA API level alone may stay the same across a driver update.
    val release = path("/sys/module/nvidia/version").readText().trim()
    if (release == "") return null
    var root = processEnvironmentOr("XDG_CACHE_HOME", "")
    if (root == "" || root[0] != 47) {
        val home = processEnvironmentOr("HOME", "")
        if (home == "" || home[0] != 47) return null
        root = "$home/.cache"
    }
    val directory = "$root/abla-grad/cuda-images-v1"
    if (!path(directory).createDirectories(0o700)) return null
    CudaImageCache(directory, "$architecture:$release:${driver.load()}:${major.load()}.${minor.load()}")
}

// Link for the current context's architecture. The linker owns the cubin
// memory, so copy it before destroying the link state.
private trusted fun cudaLinkPtx(name: string, ptx: string): CudaImage? {
    val empty = nativeNullPointer()
    val state = nativePointerCell(empty)
    if (!cudaStatus(cuLinkCreate_v2(0, empty, empty, state.address), "cuLinkCreate")) return null
    val handle = state.load()
    val data = nativePointerCell(empty)
    val size = nativeI64Cell(0)
    var image: CudaImage? = null
    if (cudaStatus(cuLinkAddData_v2(handle, 1, ptx, u64(ptx.size + 1), name, 0, empty, empty), "cuLinkAddData") &&
        cudaStatus(cuLinkComplete(handle, data.address, size.address), "cuLinkComplete") &&
        size.load() > 0 && !pointerIsNull(data.load())) {
        val buffer = nativeByteBuffer(size.load() + 1)
        ablaUnsafeCopyMemory(nativePointerAddress(buffer.address), nativePointerAddress(data.load()), size.load())
        image = CudaImage(buffer.adoptString(size.load()), true)
    }
    cuLinkDestroy(handle)
    image
}

class CudaBackend(
    var context: int,
    val architecture: string,
    var liveBuffers: int = 0,
    val functions: array<CudaFunction> = [],
    // The stream every launch runs on (created at first use) and the recording state (docs: Backend.beginRecording).
    var stream: int = 0,
    var recording: bool = false,
    var recordedLaunches: int = 0,
    // Parallel branches of a recording: side streams and their events (created at first fork), the event the main line records at a fork, the number of
    // branches of the open fork, and the stream the next launch goes to (0 = main).
    val sideStreams: array<int> = [],
    val sideEvents: array<int> = [],
    var forkEvent: int = 0,
    var forked: int = 0,
    var currentBranch: int = 0,
    val modules: array<CudaModule> = [],
    val imageCache: CudaImageCache? = null
) : Backend {
    fun name(): string = "cuda"
    fun supportsFp8Kv(): bool = this.architecture == "compute_89"

    trusted fun pushContext(): bool {
        if (this.context == 0) {
            cudaError = "CUDA context is closed"
            return false
        }
        cudaStatus(cuCtxPushCurrent_v2(nativePointerFromAddress(this.context)), "cuCtxPushCurrent")
    }

    trusted fun popContext(): void {
        val previous = nativePointerCell(nativeNullPointer())
        cuCtxPopCurrent_v2(previous.address)
        return
    }

    // Close after the last DeviceBuffer has been dropped.
    // The stream is created lazily (the context must be current). A blocking stream: it synchronizes with the legacy default stream, which the synchronous
    // copies (upload, download) use, so copies and launches stay ordered.
    trusted fun ensureStream(): bool {
        if (this.stream != 0) return true
        val handle = nativePointerCell(nativeNullPointer())
        if (!cudaStatus(cuStreamCreate(handle.address, 0), "cuStreamCreate")) return false
        this.stream = nativePointerAddress(handle.load())
        true
    }

    trusted fun newEvent(): int {
        val handle = nativePointerCell(nativeNullPointer())
        if (!cudaStatus(cuEventCreate(handle.address, 2), "cuEventCreate")) return 0
        nativePointerAddress(handle.load())
    }

    trusted fun newSideStream(): int {
        val handle = nativePointerCell(nativeNullPointer())
        if (!cudaStatus(cuStreamCreate(handle.address, 0), "cuStreamCreate")) return 0
        nativePointerAddress(handle.load())
    }

    trusted fun fork(count: int): bool {
        if (!this.recording) return true
        if (this.forked > 0 || count < 1) {
            cudaError = "fork: a fork is already open or the count is empty"
            return false
        }
        if (!this.pushContext()) return false
        var ok = true
        if (this.forkEvent == 0) {
            this.forkEvent = this.newEvent()
            ok = this.forkEvent != 0
        }
        while (ok && this.sideStreams.size < count) {
            val s = this.newSideStream()
            val e = this.newEvent()
            ok = s != 0 && e != 0
            if (ok) {
                this.sideStreams.append(s)
                this.sideEvents.append(e)
            }
        }
        ok = ok && cudaStatus(cuEventRecord(nativePointerFromAddress(this.forkEvent), nativePointerFromAddress(this.stream)), "cuEventRecord")
        for (index in 0 until count) {
            ok = ok && cudaStatus(cuStreamWaitEvent(nativePointerFromAddress(this.sideStreams[index]), nativePointerFromAddress(this.forkEvent), 0),
                "cuStreamWaitEvent")
        }
        this.popContext()
        if (ok) {
            this.forked = count
            this.currentBranch = 0
        }
        ok
    }

    fun branch(index: int): bool {
        if (!this.recording) return true
        if (index < 0 || index > this.forked) {
            cudaError = "branch: no such branch"
            return false
        }
        this.currentBranch = index
        true
    }

    trusted fun join(): bool {
        if (!this.recording || this.forked == 0) return true
        if (!this.pushContext()) return false
        var ok = true
        for (index in 0 until this.forked) {
            ok = ok && cudaStatus(cuEventRecord(nativePointerFromAddress(this.sideEvents[index]), nativePointerFromAddress(this.sideStreams[index])),
                "cuEventRecord")
            ok = ok && cudaStatus(cuStreamWaitEvent(nativePointerFromAddress(this.stream), nativePointerFromAddress(this.sideEvents[index]), 0),
                "cuStreamWaitEvent")
        }
        this.popContext()
        this.forked = 0
        this.currentBranch = 0
        ok
    }

    trusted fun beginRecording(): bool {
        if (this.recording) {
            cudaError = "a recording is already in progress"
            return false
        }
        if (!this.pushContext()) return false
        var ok = this.ensureStream()
        // relaxed: loading a kernel's module during the recording is allowed (the first launch of a kernel compiles or loads it)
        ok = ok && cudaStatus(cuStreamBeginCapture_v2(nativePointerFromAddress(this.stream), 2), "cuStreamBeginCapture")
        this.popContext()
        if (ok) {
            this.recording = true
            this.recordedLaunches = 0
        }
        ok
    }

    trusted fun endRecording(): Recording? {
        if (!this.recording) {
            cudaError = "no recording in progress"
            return null
        }
        this.join()
        this.recording = false
        if (!this.pushContext()) return null
        val graph = nativePointerCell(nativeNullPointer())
        var recorded: Recording? = null
        if (cudaStatus(cuStreamEndCapture(nativePointerFromAddress(this.stream), graph.address), "cuStreamEndCapture")) {
            val exec = nativePointerCell(nativeNullPointer())
            if (cudaStatus(cuGraphInstantiateWithFlags(exec.address, graph.load(), u64(0)), "cuGraphInstantiate")) {
                recorded = Recording(this, nativePointerAddress(exec.load()), this.recordedLaunches)
            }
            cuGraphDestroy(graph.load())
        }
        this.popContext()
        recorded
    }

    trusted fun replay(recording: Recording): bool {
        if (this.recording) {
            cudaError = "cannot replay while recording"
            return false
        }
        if (!this.pushContext()) return false
        val ok = this.ensureStream() &&
            cudaStatus(cuGraphLaunch(nativePointerFromAddress(recording.handle), nativePointerFromAddress(this.stream)), "cuGraphLaunch")
        this.popContext()
        ok
    }

    trusted fun releaseRecording(handle: int): void {
        if (!this.pushContext()) return
        cudaStatus(cuGraphExecDestroy(nativePointerFromAddress(handle)), "cuGraphExecDestroy")
        this.popContext()
    }

    trusted fun close(): bool {
        if (this.context == 0) return true
        if (this.liveBuffers != 0) {
            cudaError = "CUDA context still owns device buffers"
            return false
        }
        if (!this.pushContext()) return false
        val waited = cudaStatus(cuCtxSynchronize(), "cuCtxSynchronize")
        for (module in this.modules) cuModuleUnload(nativePointerFromAddress(module.handle))
        this.popContext()
        val destroyed = cudaStatus(cuCtxDestroy_v2(nativePointerFromAddress(this.context)), "cuCtxDestroy")
        if (destroyed) this.context = 0
        waited && destroyed
    }

    trusted fun allocate(bytes: int): DeviceBuffer? {
        cudaClearAllocationError()
        if (bytes < 1 || !this.pushContext()) {
            if (bytes < 1) cudaError = "CUDA allocation size must be positive"
            cudaAllocationError = "$cudaError while allocating $bytes bytes"
            cudaError = cudaAllocationError
            return null
        }
        val address = nativeI64Cell(0)
        val status = cuMemAlloc_v2(address.address, u64(bytes))
        this.popContext()
        if (status != 0) {
            cudaAllocationError = "cuMemAlloc failed with status $status while allocating $bytes bytes"
            cudaError = cudaAllocationError
            return null
        }
        this.liveBuffers += 1
        DeviceBuffer(this, address.load(), bytes)
    }

    fun copyRange(buffer: DeviceBuffer, offset: int, hostAddress: int, bytes: int): bool {
        if (buffer.owner != this || offset < 0 || bytes < 0 || offset > buffer.bytes ||
            bytes > buffer.bytes - offset || (hostAddress == 0 && bytes != 0)) {
            cudaError = "CUDA copy range or buffer owner is invalid"
            return false
        }
        true
    }

    trusted fun upload(destination: DeviceBuffer, offset: int, hostAddress: int, bytes: int): bool {
        if (this.recording) {
            cudaError = "copies and synchronization are not allowed while recording"
            return false
        }
        if (!this.copyRange(destination, offset, hostAddress, bytes)) return false
        if (bytes == 0) return true
        if (!this.pushContext()) return false
        val ok = cudaStatus(cuMemcpyHtoD_v2(u64(destination.handle + offset),
            nativePointerFromAddress(hostAddress), u64(bytes)), "cuMemcpyHtoD")
        this.popContext()
        ok
    }

    trusted fun uploadBatch(destination: DeviceBuffer, slices: array<HostUpload>): bool {
        var end = 0
        var size = 0
        for (slice in slices) {
            if (!this.copyRange(destination, slice.offset, slice.address, slice.bytes)) return false
            if (slice.offset < end) return uploadBatchSync(this, destination, slices)
            end = slice.offset + slice.bytes
            size += slice.bytes
        }
        if (size < 2 * CUDA_UPLOAD_SLOT_BYTES || this.recording) return uploadBatchSync(this, destination, slices)
        // The two streams need nonoverlapping writes and must see earlier work on the arena.
        if (!this.synchronize()) return false
        val first: array<HostUpload> = []
        val second: array<HostUpload> = []
        var remaining = size / 2
        for (slice in slices) {
            val left = if (slice.bytes < remaining) slice.bytes else remaining
            if (left > 0) first.append(HostUpload(slice.offset, slice.address, left))
            if (left < slice.bytes) second.append(HostUpload(slice.offset + left, slice.address + left, slice.bytes - left))
            remaining -= left
        }
        val mine = CudaWeightUpload(this.context, destination.handle, first)
        val theirs = Shared(CudaWeightUpload(this.context, destination.handle, second))
        val worker = thread { theirs.get().run() }
        val a = mine.run()
        val b = await worker
        if (a != null && !cudaStatus(a.status, a.call)) return false
        if (b != null && !cudaStatus(b.status, b.call)) return false
        // If pinning or stream setup was unavailable, both halves are drained
        // and it is safe to redo the batch with the normal synchronous path.
        if (a == null || b == null) return uploadBatchSync(this, destination, slices)
        true
    }

    trusted fun download(source: DeviceBuffer, offset: int, hostAddress: int, bytes: int): bool {
        if (this.recording) {
            cudaError = "copies and synchronization are not allowed while recording"
            return false
        }
        if (!this.copyRange(source, offset, hostAddress, bytes)) return false
        if (bytes == 0) return this.synchronize()
        if (!this.pushContext()) return false
        val ok = cudaStatus(cuMemcpyDtoH_v2(nativePointerFromAddress(hostAddress),
            u64(source.handle + offset), u64(bytes)), "cuMemcpyDtoH")
        this.popContext()
        ok
    }

    trusted fun bindFunction(name: string, module: i64*): CudaFunction? {
        val function = nativePointerCell(nativeNullPointer())
        if (!cudaStatus(cuModuleGetFunction(function.address, module, name), "cuModuleGetFunction")) return null
        val loaded = CudaFunction(name, nativePointerAddress(function.load()))
        this.functions.append(loaded)
        loaded
    }

    trusted fun loadImage(spec: CudaKernelSpec, image: CudaImage): CudaFunction? {
        val module = nativePointerCell(nativeNullPointer())
        val data = if (image.cubin) nativeStringDataAddress(image.bytes) else nativeCStringAddress(image.bytes)
        if (!cudaStatus(cuModuleLoadData(module.address, nativePointerFromAddress(data)), "cuModuleLoadData")) return null
        val handle = module.load()
        val loaded = this.bindFunction(spec.name, handle)
        if (loaded == null) {
            cuModuleUnload(handle)
            return null
        }
        this.modules.append(CudaModule(spec.source, spec.abla, nativePointerAddress(handle)))
        loaded
    }

    trusted fun loadKernel(spec: CudaKernelSpec): CudaFunction? {
        for (function in this.functions) if (function.name == spec.name) return function
        // NVRTC compiles all entry points in a source. Resolve later symbols
        // from that same module instead of compiling and loading it again.
        // Compiler-emitted Abla kernels likewise share kernelPtx().
        for (module in this.modules) {
            if (module.abla == spec.abla && (spec.abla || module.source == spec.source)) {
                return this.bindFunction(spec.name, nativePointerFromAddress(module.handle))
            }
        }
        val source = if (spec.abla) kernelPtx() else spec.source
        val cache = this.imageCache
        val key = if (cache != null) cache.key(source, spec.abla) else ""
        if (cache != null) {
            val previous = cache.read(key)
            if (previous != null) {
                val cached = this.loadImage(spec, previous)
                if (cached != null) return cached
                cudaClearAllocationError()
            }
        }
        val ptx = if (spec.abla) source else cudaCompilePtx(source, "${spec.name}.cu", this.architecture) ?? return null
        if (cache != null) {
            val cubin = cudaLinkPtx(spec.name, ptx)
            if (cubin != null) {
                val linked = this.loadImage(spec, cubin)
                if (linked != null) {
                    cache.write(key, cubin)
                    return linked
                }
            }
            cudaClearAllocationError()
        }
        // Some PTX images can be loaded directly even when the linker cannot
        // turn them into a standalone cubin.
        val image = CudaImage(ptx)
        val loaded = this.loadImage(spec, image) ?? return null
        if (cache != null) cache.write(key, image)
        loaded
    }

    trusted fun launch(kernel: string, args: KernelArgs, problem: array<int>): bool {
        if (cudaDebugAlways && cudaSkipSingle != "" && cudaSkipSingle == kernel) return true
        if ((this.recording || cudaDebugAlways) && cudaSkipKernels.size > 0) {
            for (skipped in cudaSkipKernels) if (skipped == kernel) return true
        }
        val spec = cudaKernelSpec(kernel)
        if (spec == null || !cudaLaunchShape(spec, args, problem)) {
            cudaError = "unknown CUDA kernel or invalid launch shape or arguments"
            return false
        }
        if (!this.pushContext()) return false
        if (!this.ensureStream()) {
            this.popContext()
            return false
        }
        val function = this.loadKernel(spec)
        var ok = false
        if (function != null) {
            // The driver consumes the parameter bytes during cuLaunchKernel.
            val words = if (spec.abla) cudaAblaKernelWords(spec, args) else args.words
            val values = nativeByteBuffer(words.size * 8)
            val pointers = nativeByteBuffer(words.size * 8)
            val base = nativePointerAddress(values.address)
            for (index in 0 until words.size) {
                values.storeI64(index * 8, words[index])
                pointers.storePointer(index * 8, nativePointerFromAddress(base + index * 8))
            }
            val gridX = u32((problem[0] + spec.itemsPerBlock - 1) / spec.itemsPerBlock)
            val gridY = u32(if (spec.problemDimensions == 2) problem[1] else 1)
            var timed = 0
            if (cudaTimeKernels) {
                cuStreamSynchronize(nativePointerFromAddress(this.stream))
                timed = monotonicNanoseconds()
            }
            ok = cudaStatus(cuLaunchKernel(nativePointerFromAddress(function.handle),
                gridX, gridY, 1, u32(spec.blockX), 1, 1, 0,
                nativePointerFromAddress(if (this.currentBranch == 0) this.stream else this.sideStreams[this.currentBranch - 1]),
                pointers.address, nativeNullPointer()), "cuLaunchKernel")
            if (cudaTimeKernels) {
                cuStreamSynchronize(nativePointerFromAddress(this.stream))
                cudaKernelNanos.set(kernel, (cudaKernelNanos.get(kernel) ?? 0) + (monotonicNanoseconds() - timed))
            }
        }
        if (ok && cudaDebugAlways) cudaLaunchCounts.set(kernel, (cudaLaunchCounts.get(kernel) ?? 0) + 1)
        if (ok && this.recording) {
            this.recordedLaunches += 1
            cudaLaunchCounts.set(kernel, (cudaLaunchCounts.get(kernel) ?? 0) + 1)
        }
        this.popContext()
        ok
    }

    trusted fun synchronize(): bool {
        if (this.recording) {
            cudaError = "copies and synchronization are not allowed while recording"
            return false
        }
        if (!this.pushContext()) return false
        val ok = cudaStatus(cuCtxSynchronize(), "cuCtxSynchronize")
        this.popContext()
        ok
    }

    trusted fun freeMemory(): int {
        if (!this.pushContext()) return 0
        val free = nativeI64Cell(0)
        val total = nativeI64Cell(0)
        val ok = cudaStatus(cuMemGetInfo_v2(free.address, total.address), "cuMemGetInfo")
        this.popContext()
        if (ok) free.load() else 0
    }

    trusted fun release(handle: int, bytes: int): void {
        if (!this.pushContext()) return
        if (cudaStatus(cuMemFree_v2(u64(handle)), "cuMemFree")) this.liveBuffers -= 1
        this.popContext()
    }
}

// The parameter words of an Abla `@kernel` launch: a pointer becomes its address and its element count (ablaElementBytes),
// a null pointer (u64 0 where the spec allows one) an empty buffer; other values as they are.
private fun cudaAblaKernelWords(spec: CudaKernelSpec, args: KernelArgs): array<int> {
    val words: array<int> = []
    for (index in 0 until args.words.size) {
        words.append(args.words[index])
        if (spec.argumentKinds[index] == KERNEL_ARG_POINTER) {
            val element = if (index < spec.ablaElementBytes.size && spec.ablaElementBytes[index] > 0) spec.ablaElementBytes[index] else 4
            words.append(if (args.kinds[index] == KERNEL_ARG_POINTER) args.extents[index] / element else 0)
        }
    }
    words
}

private fun cudaLaunchShape(spec: CudaKernelSpec, args: KernelArgs, problem: array<int>): bool {
    if (problem.size != spec.problemDimensions || problem[0] < 1 ||
        problem[0] > 4294967295 || args.words.size != spec.argumentKinds.size ||
        args.kinds.size != spec.argumentKinds.size) return false
    if ((problem[0] + spec.itemsPerBlock - 1) / spec.itemsPerBlock > 2147483647 ||
        (spec.problemDimensions == 2 && (problem[1] < 1 || problem[1] > 65535))) return false

    for (index in 0 until spec.argumentKinds.size) {
        val kind = spec.argumentKinds[index]
        val actual = args.kinds[index]
        val word = args.words[index]
        val nullPointer = index == spec.nullablePointer && actual == KERNEL_ARG_U64 && word == 0
        if ((!nullPointer && (actual != kind || (kind == KERNEL_ARG_POINTER && word == 0))) ||
            (kind == KERNEL_ARG_U32 && (word < 0 || word > 4294967295)) ||
            (kind == KERNEL_ARG_I32 && (word < -2147483648 || word > 2147483647))) return false
    }
    spec.validate(args, problem)
}

trusted fun cudaBackend(ordinal: i32 = 0): CudaBackend? {
    val device = nativeI64Cell(0)
    val major = nativeI64Cell(0)
    val minor = nativeI64Cell(0)
    val context = nativePointerCell(nativeNullPointer())
    if (!cudaStatus(cuInit(0), "cuInit") ||
        !cudaStatus(cuDeviceGet(device.address, ordinal), "cuDeviceGet") ||
        !cudaStatus(cuDeviceGetAttribute(major.address, 75, i32(device.load())), "cuDeviceGetAttribute(major)") ||
        !cudaStatus(cuDeviceGetAttribute(minor.address, 76, i32(device.load())), "cuDeviceGetAttribute(minor)") ||
        !cudaStatus(cuCtxCreate_v2(context.address, 0, i32(device.load())), "cuCtxCreate")) return null
    val address = nativePointerAddress(context.load())
    if (!cudaStatus(cuCtxPopCurrent_v2(context.address), "cuCtxPopCurrent")) {
        cuCtxDestroy_v2(nativePointerFromAddress(address))
        return null
    }
    val architecture = "compute_${major.load()}${minor.load()}"
    val backend = CudaBackend(address, architecture, imageCache = cudaImageCache(architecture))
    backend
}
