private val cudaArgsCommitSelect = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU]
private fun cudaPrefillTapRowsShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[6] == problem[1] && args.words[4] < args.words[5]
private fun cudaPrefillCommitSelectShape(args: KernelArgs, problem: array<int>): bool = args.words[3] == problem[0]
private val cudaArgsMoeMapRows = [prefillArgP, prefillArgU, prefillArgU, prefillArgP, prefillArgU]
private fun cudaPrefillMoeMapRowsShape(args: KernelArgs, problem: array<int>): bool = problem[0] == 1 && args.words[1] >= 1 && args.words[1] <= 3 && args.words[2] > 0 && args.words[4] > 0
private val cudaArgsPrefillAttSplit = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgP, prefillArgU, prefillArgU, prefillArgF, prefillArgU, prefillArgU, prefillArgP, prefillArgP]
private val cudaArgsPrefillAttMerge = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private fun cudaPrefillAttentionSplitShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] == problem[0] && args.words[6] > 0 && args.words[5] % args.words[6] == 0 && args.words[12] > 0 && args.words[13] > 0 &&
        problem[1] == (args.words[12] + 31) / 32 * args.words[13] && args.words[0] % 16 == 0 && args.words[1] % 16 == 0 && args.words[2] % 16 == 0
private fun cudaPrefillAttentionMergeShape(args: KernelArgs, problem: array<int>): bool = args.words[3] == problem[0] && args.words[4] == problem[1] && args.words[5] > 0
private val cudaArgsGatherRows = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU]
private val cudaArgsCopyRows = [prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsDepthMixBatch = [prefillArgP, prefillArgU, prefillArgU, prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgU, prefillArgF, prefillArgU]
private val cudaArgsConvSeq = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgF, prefillArgU]
private val cudaArgsConvHistory = [prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsL2ClipRows = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgF, prefillArgU]
private val cudaArgsScaleTauRows = [prefillArgP, prefillArgU, prefillArgP, prefillArgU, prefillArgF, prefillArgU]
private val cudaArgsKvStoreBatchValue = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsKvStoreBatch = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsMoeRouteBatch = [prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgP, prefillArgP, prefillArgF, prefillArgF, prefillArgU]
private val cudaArgsMoeSort = [prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgP, prefillArgP, prefillArgP]
private val cudaArgsMoeCombineBatch = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsGrouped = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, KERNEL_ARG_U64]
private val cudaArgsAttentionPrefill = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgU, prefillArgF]
private fun cudaPrefillGatherShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[3] % 32 == 0 && args.words[4] == problem[1]
private fun cudaPrefillCopyRowsShape(args: KernelArgs, problem: array<int>): bool =
    args.words[4] == problem[0] && args.words[5] == problem[1]
private fun cudaPrefillDepthMixShape(args: KernelArgs, problem: array<int>): bool =
    args.words[6] == problem[0] && args.words[11] == problem[1] && args.words[2] + 1 <= 64 && args.words[9] > 0
private fun cudaPrefillConvSeqShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] == problem[0] && args.words[9] == problem[1] && args.words[6] >= 2 && args.words[6] <= 64 &&
        args.words[7] > 0 && args.words[5] % args.words[7] == 0
private fun cudaPrefillConvHistoryShape(args: KernelArgs, problem: array<int>): bool =
    args.words[2] == problem[0] && args.words[3] >= 2 && args.words[3] <= 64
private fun cudaPrefillL2ClipRowsShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[4] > 0 && args.words[6] > 0
private fun cudaPrefillScaleTauShape(args: KernelArgs, problem: array<int>): bool =
    args.words[1] == problem[0] && args.words[5] == problem[1] && args.words[3] > 0
private fun cudaPrefillKvStoreShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] * args.words[6] == problem[0] && args.words[8] == problem[1] && args.words[6] > 0
private fun cudaPrefillMoeRouteShape(args: KernelArgs, problem: array<int>): bool =
    args.words[8] == problem[0] && args.words[2] > 0 && args.words[2] <= 256 && args.words[3] > 0 && args.words[3] <= 64
private fun cudaPrefillMoeSortShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == 1 && args.words[1] > 0 && args.words[2] > 0 && args.words[3] > 0 && args.words[3] <= 256 && args.words[4] > 0
private fun cudaPrefillMoeCombineShape(args: KernelArgs, problem: array<int>): bool =
    args.words[4] == problem[0] && args.words[6] == problem[1]
private fun cudaPrefillMatmulExactShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[4] > 0 && problem[1] == (args.words[5] + 15) / 16 && args.words[5] > 0
private fun cudaPrefillGroupedShape(args: KernelArgs, problem: array<int>, blockElements: int): bool =
    args.words[6] == problem[0] && args.words[6] % 2 == 0 && args.words[7] > 0 && args.words[7] % blockElements == 0 &&
        args.words[8] > 0 && args.words[8] <= 256 && args.words[9] > 0
private fun cudaPrefillGroupedNvfp4Shape(args: KernelArgs, problem: array<int>): bool =
    cudaPrefillGroupedShape(args, problem, 64) && args.words[9] % 4 == 0 && args.words[0] % 4 == 0
private fun cudaPrefillGroupedQ8Shape(args: KernelArgs, problem: array<int>): bool =
    cudaPrefillGroupedShape(args, problem, 32) && args.words[9] % 2 == 0 && args.words[0] % 2 == 0
private fun cudaPrefillGroupedQ5Shape(args: KernelArgs, problem: array<int>): bool = args.words[9] % 16 == 0 && args.words[0] % 16 == 0 &&
    cudaPrefillGroupedShape(args, problem, 256)
private fun cudaPrefillAttentionShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] == problem[0] && args.words[6] > 0 && args.words[5] % args.words[6] == 0 && args.words[7] <= 256 && args.words[7] > 0
private fun cudaPrefillMatmulF32Shape(args: KernelArgs, problem: array<int>): bool =
    cudaPrefillMatmulShape(args, problem, 32) && args.words[0] % 16 == 0
private fun cudaPrefillMatmulBf16Shape(args: KernelArgs, problem: array<int>): bool =
    cudaPrefillMatmulShape(args, problem, 32) && args.words[0] % 2 == 0

