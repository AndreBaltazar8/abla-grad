private fun cudaKvStoreStepShape(args: KernelArgs, problem: array<int>): bool = args.words[5] * args.words[6] == problem[0]
private fun cudaScaleTauShape(args: KernelArgs, problem: array<int>): bool = args.words[4] == problem[0]
private fun cudaStepAdvanceShape(args: KernelArgs, problem: array<int>): bool = problem[0] == 1
// ---- prefill kernels (ablac-4e; sources in src/kernels/prefill_*.ab, contract in docs/prefill.md) ----
// matmul_<t>(w, x, y, rows, cols, tokens), problem [rows, tokenTiles] with tokenTiles = ceil(tokens / 64).
private val cudaArgsPrefillMatmul = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32
]
private fun cudaPrefillMatmulShape(args: KernelArgs, problem: array<int>, blockElements: int): bool {
    val rows = args.words[3]
    val cols = args.words[4]
    val tokens = args.words[5]
    rows == problem[0] && rows % 2 == 0 && cols > 0 && cols % blockElements == 0 && tokens > 0 &&
        problem[1] == (tokens + 63) / 64 && args.words[0] % 4 == 0 && args.words[1] % 16 == 0 && args.words[2] % 8 == 0
}
private fun cudaPrefillQ8Shape(args: KernelArgs, problem: array<int>): bool = cudaPrefillMatmulShape(args, problem, 32)
private fun cudaPrefillNvfp4Shape(args: KernelArgs, problem: array<int>): bool = cudaPrefillMatmulShape(args, problem, 64)

private val prefillArgP = KERNEL_ARG_POINTER
private val prefillArgU = KERNEL_ARG_U32
private val prefillArgF = KERNEL_ARG_F32
private val cudaArgsRelTableRows = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private fun cudaPrefillRelTableRowsShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] + 1 == problem[0] && args.words[6] == problem[1] && args.words[4] > 0 && args.words[4] % 4 == 0 && args.words[4] <= 32 &&
        args.words[0] % 16 == 0 && args.words[1] % 16 == 0
private val cudaArgsAttentionTc = [prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgP, prefillArgU, prefillArgU, prefillArgF, prefillArgU]
private fun cudaPrefillAttentionTcShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] == problem[0] && args.words[6] > 0 && args.words[5] % args.words[6] == 0 && args.words[12] > 0 && problem[1] == (args.words[12] + 31) / 32 &&
        args.words[0] % 16 == 0 && args.words[1] % 16 == 0 && args.words[2] % 16 == 0
private val cudaArgsMatmulSplit = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU]
private val cudaArgsSumSlices = [prefillArgP, prefillArgU, prefillArgU]
private fun cudaPrefillSplitShape(args: KernelArgs, problem: array<int>, blockElements: int): bool =
    args.words[3] == problem[0] && args.words[3] % 2 == 0 && args.words[6] > 0 && args.words[4] % (32 * args.words[6]) == 0 && args.words[5] > 0 &&
        problem[1] == (args.words[5] + 63) / 64 * args.words[6] && args.words[0] % 16 == 0 && args.words[1] % 16 == 0 && args.words[2] % 8 == 0
private fun cudaPrefillSplitF32Shape(args: KernelArgs, problem: array<int>): bool = cudaPrefillSplitShape(args, problem, 32)
private fun cudaPrefillExactSplitShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[6] > 0 && args.words[4] % (32 * args.words[6]) == 0 && args.words[5] > 0 && problem[1] == (args.words[5] + 15) / 16 * args.words[6]
private fun cudaPrefillSumSlicesShape(args: KernelArgs, problem: array<int>): bool = args.words[1] == problem[0] && args.words[2] > 0
private val cudaArgsMatmulX5 = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgP, prefillArgP, prefillArgP, prefillArgU,
    prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU]
private fun cudaPrefillX5Shape(args: KernelArgs, problem: array<int>): bool {
    var tiles = 0
    for (i in 0 until 5) {
        val rows = args.words[4 * i + 3]
        if (rows < 0 || rows % 2 != 0 || (rows > 0 && (args.words[4 * i] % 4 != 0 || args.words[4 * i + 1] % 16 != 0 || args.words[4 * i + 2] % 8 != 0))) return false
        tiles += (rows + 127) / 128
    }
    val cols = args.words[20]
    val tokens = args.words[21]
    tiles > 0 && tiles * 128 == problem[0] && cols > 0 && cols % 32 == 0 && tokens > 0 && problem[1] == (tokens + 63) / 64
}
private val cudaArgsConvHistoryRows = [prefillArgP, prefillArgP, prefillArgP, prefillArgU, prefillArgU, prefillArgU, prefillArgU]
private fun cudaPrefillConvHistoryRowsShape(args: KernelArgs, problem: array<int>): bool =
    args.words[3] == problem[0] && args.words[4] >= 2 && args.words[4] <= 64 && args.words[5] > 0
