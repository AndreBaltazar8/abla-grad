private var cudaError = ""
private var cudaAllocationError = ""

// Kernel name -> launches recorded so far (debug: decode-bench --launches prints it).
val cudaLaunchCounts: Map<string, int> = Map()

// Debug (decode-bench --skip a,b): launches of these kernels are left out of a recording, to price their share of the critical path (the output is garbage).
val cudaSkipKernels: array<string> = []
// Debug: apply the skip list to every launch (not only recordings) and count every launch (prefill-bench --profile).
var cudaDebugAlways = false
var cudaSkipSingle = ""
// Debug: when set (with cudaDebugAlways), every launch is bracketed by stream synchronizations and its wall time added to cudaKernelNanos[kernel].
var cudaTimeKernels = false
val cudaKernelNanos: Map<string, int> = Map()

fun cudaLastError(): string = cudaError

// CUDA reports sizes only for explicit allocations. Track opaque driver OOMs
// too, even if cleanup replaces the most recent CUDA error.
fun cudaLastAllocationError(): string = cudaAllocationError
fun cudaLastDiagnostic(): string = if (cudaAllocationError != "") cudaAllocationError else cudaError
fun cudaClearAllocationError(): void { cudaAllocationError = "" }

private fun cudaStatus(status: i32, call: string, outOfMemory: i32 = 2): bool {
    if (status == 0) return true
    cudaError = "${call} failed with status ${status}"
    if (status == outOfMemory) cudaAllocationError = "$cudaError (CUDA did not report the allocation size)"
    false
}

private trusted fun cudaCompilePtx(source: string, name: string, architecture: string): string? {
    val program = nativePointerCell(nativeNullPointer())
    if (!cudaStatus(nvrtcCreateProgram(program.address, source, name, 0,
        nativeNullPointer(), nativeNullPointer()), "nvrtcCreateProgram", 1)) return null
    val handle = program.load()
    val option = "--gpu-architecture=${architecture}"
    val optionBytes = nativeByteBuffer(option.size + 1)
    var index = 0
    while (index < option.size) {
        optionBytes.store(index, option[index])
        index += 1
    }
    optionBytes.store(index, 0)
    val options = nativePointerCell(optionBytes.address)
    val length = nativeI64Cell(0)
    var ptx: string? = null
    if (!cudaStatus(nvrtcCompileProgram(handle, 1, options.address), "nvrtcCompileProgram", 1)) {
        if (nvrtcGetProgramLogSize(handle, length.address) == 0 && length.load() > 0) {
            val log = nativeByteBuffer(length.load())
            if (nvrtcGetProgramLog(handle, log.address) == 0) {
                cudaError = "${cudaError}: ${nativeCString(log.address)}"
            }
        }
    } else if (cudaStatus(nvrtcGetPTXSize(handle, length.address), "nvrtcGetPTXSize", 1)) {
        val bytes = nativeByteBuffer(length.load())
        if (cudaStatus(nvrtcGetPTX(handle, bytes.address), "nvrtcGetPTX", 1)) {
            ptx = nativeCString(bytes.address)
        }
    }
    nvrtcDestroyProgram(program.address)
    ptx
}

