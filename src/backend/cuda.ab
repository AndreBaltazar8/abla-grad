private trusted noescape extern:"c" fun cuMemFree_v2(address: u64): i32
private trusted noescape extern:"c" fun cuMemcpyHtoD_v2(destination: u64, source: i64*, bytes: u64): i32
private trusted noescape extern:"c" fun cuMemcpyDtoH_v2(destination: i64*, source: u64, bytes: u64): i32
private trusted noescape extern:"c" fun cuModuleLoadData(module: i64*, data: cstring): i32
private trusted noescape extern:"c" fun cuModuleUnload(module: i64*): i32
