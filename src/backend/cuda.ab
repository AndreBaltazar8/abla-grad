private val cudaArgsMoeCombine = [KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32]
private val cudaArgsMoeRoute = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_F32, KERNEL_ARG_F32
]
private val cudaArgsRelTable = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32
]
private val cudaArgsConvStep = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER,
    KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_F32
]
private val cudaArgsDepthMix = [
    KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_F32
]
private fun cudaMoeCombineShape(args: KernelArgs, problem: array<int>): bool = args.words[3] == problem[0] && args.words[4] > 0
// The Abla moe_route (src/kernels/abla_moe_route.ab): one thread an expert, up to 256 (as the CUDA C one).
private fun cudaAblaMoeRouteShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == 1 && args.words[2] > 0 && args.words[2] <= 256 && args.words[3] > 0 && args.words[3] <= 64 && args.words[3] <= args.words[2]
private fun cudaMoeRouteShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == 1 && args.words[2] > 0 && args.words[2] <= 256 && args.words[3] > 0 && args.words[3] <= 64 && args.words[3] <= args.words[2]
private fun cudaRelTableShape(args: KernelArgs, problem: array<int>): bool =
    args.words[4] > 0 && args.words[5] > 0 && args.words[6] > 0 && (args.words[5] + 1) * args.words[6] == problem[0]
private fun cudaConvStepShape(args: KernelArgs, problem: array<int>): bool =
    args.words[5] == problem[0] && args.words[6] >= 2 && args.words[6] <= 64 && args.words[7] > 0 && args.words[5] % args.words[7] == 0
private fun cudaDepthMixShape(args: KernelArgs, problem: array<int>): bool =
    args.words[4] == problem[0] && args.words[1] + 1 <= 64 && args.words[6] > 0

private val cudaIndexedMatvecArguments = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER,
    KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_POINTER,
    KERNEL_ARG_U32, KERNEL_ARG_U64, KERNEL_ARG_U32, KERNEL_ARG_POINTER
]

private fun cudaNvfp4Shape(args: KernelArgs, problem: array<int>): bool =
    cudaF32Shape(args, problem) && args.words[4] % 64 == 0

private fun cudaQ8Shape(args: KernelArgs, problem: array<int>): bool =
    cudaF32Shape(args, problem) && args.words[4] % 32 == 0

private fun cudaQ8GatherShape(args: KernelArgs, problem: array<int>): bool =
    cudaGatherShape(args, problem) && args.words[3] % 32 == 0

private fun cudaIndexedShape(args: KernelArgs, problem: array<int>, blockElements: int, blockBytes: int): bool {
    if (!cudaF32Shape(args, problem) || args.words[4] % blockElements != 0 ||
        args.words[6] != problem[1]) return false
    val cols = args.words[4]
    val rowBytes = cols / blockElements * blockBytes
    val stride = args.words[7]
    val xStride = args.words[8]
    // NVFP4 reads aligned 32-bit words. The other layouts are read bytewise.
    stride > 0 && (blockElements != 64 || (stride % 4 == 0 && args.words[0] % 4 == 0)) &&
        problem[0] <= stride / rowBytes && (xStride == 0 || xStride >= cols)
}

private fun cudaNvfp4IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaIndexedShape(args, problem, 64, 36)

private fun cudaQ8IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaIndexedShape(args, problem, 32, 34)

private fun cudaQ4IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaIndexedShape(args, problem, 256, 144)

private fun cudaQ5IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaIndexedShape(args, problem, 256, 176)

