]
private val cudaArgsAttentionMerge = [KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32]
private fun cudaAttentionSplitShape(args: KernelArgs, problem: array<int>): bool =
    cudaAttentionHeadShape(args.words[6], args.words[7], args.words[8], problem[0] / args.words[13]) &&
        args.words[13] > 0 && args.words[13] <= 64 && problem[0] == args.words[6] * args.words[13] && args.words[11] > 0
private fun cudaAttentionMergeShape(args: KernelArgs, problem: array<int>): bool =
    args.words[2] == problem[0] && args.words[3] > 0 && args.words[3] <= 256 && args.words[4] > 0 && args.words[4] <= 64

private fun cudaInklingGateUpSituShape(args: KernelArgs, problem: array<int>): bool =
    problem[0] == inklingGateUpSitu.geometry.problem[0] && problem[1] == inklingGateUpSitu.geometry.problem[1]

private val cudaVerifyMatvecArguments = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER,
    KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32
]
private val cudaVerifyIndexedArguments = [
    KERNEL_ARG_POINTER, KERNEL_ARG_POINTER, KERNEL_ARG_POINTER,
    KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32,
    KERNEL_ARG_POINTER, KERNEL_ARG_U32, KERNEL_ARG_U64,
    KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_U32, KERNEL_ARG_POINTER
]

private fun cudaVerifyF32Shape(args: KernelArgs, problem: array<int>): bool =
    cudaF32Shape(args, problem) && args.words[5] >= 1 && args.words[5] <= 3

private fun cudaVerifyQ8Shape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyF32Shape(args, problem) && args.words[4] % 32 == 0

private fun cudaVerifyIndexedShape(args: KernelArgs, problem: array<int>, blockElements: int, blockBytes: int): bool {
    if (!cudaVerifyF32Shape(args, problem) || args.words[4] % blockElements != 0 ||
        args.words[7] != problem[1]) return false
    val cols = args.words[4]
    val rowBytes = cols / blockElements * blockBytes
    val expertStride = args.words[8]
    val slots = args.words[9]
    val vectorStride = args.words[10]
    val slotStride = args.words[11]
    expertStride > 0 &&
        args.words[6] % 4 == 0 && problem[0] <= expertStride / rowBytes && slots > 0 &&
        (args.words[5] == 1 || vectorStride >= cols) && (slotStride == 0 || slotStride >= cols)
}

private fun cudaVerifyNvfp4Shape(args: KernelArgs, problem: array<int>): bool =
    args.words[0] % 4 == 0 && args.words[8] % 4 == 0 && cudaVerifyIndexedShape(args, problem, 64, 36)

private fun cudaVerifyQ8IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyIndexedShape(args, problem, 32, 34)

private fun cudaVerifyQ5IndexedShape(args: KernelArgs, problem: array<int>): bool =
    cudaVerifyIndexedShape(args, problem, 256, 176)

