// The backend layer: the only thing the model, ops and CLI know about devices (docs/interfaces.md, section 4).
// Implementations: CudaBackend (src/backend/cuda.ab, ablac-e7), later Vulkan, CPU, Metal. Nothing above this file imports an extern.
import "abla/float"
import "abla/process"

// How one kernel parameter is packed. Pointers and 64-bit values take 8 bytes (aligned to 8), 32-bit values 4 (aligned to 4),
// as CUDA's parameter buffer and Vulkan push constants both want it.
val KERNEL_ARG_POINTER = 0
val KERNEL_ARG_U32 = 1
val KERNEL_ARG_I32 = 2
val KERNEL_ARG_U64 = 3
val KERNEL_ARG_F32 = 4

// The parameters of one launch, in the kernel's parameter order. `words[i]` holds the value (an f32 as its bit pattern),
// `kinds[i]` how it is packed.
class KernelArgs(val kinds: array<int>, val words: array<int>)

fun kernelArgs(): KernelArgs = KernelArgs([], [])

fun KernelArgs.u32(value: int): KernelArgs {
    this.kinds.append(KERNEL_ARG_U32)
    this.words.append(value)
    this
}

fun KernelArgs.i32(value: int): KernelArgs {
    this.kinds.append(KERNEL_ARG_I32)
    this.words.append(value)
    this
}

fun KernelArgs.u64(value: int): KernelArgs {
    this.kinds.append(KERNEL_ARG_U64)
    this.words.append(value)
    this
}

fun KernelArgs.f32(value: f32): KernelArgs {
    this.kinds.append(KERNEL_ARG_F32)
    this.words.append(int(f32ToBits(value)))
    this
}

// A device pointer: `buffer`'s address plus `offset` bytes. The offset must lie inside the buffer (checked here: a bad one
// panics, it is a bug in the caller, not an input error).
fun KernelArgs.pointer(buffer: DeviceBuffer, offset: int = 0): KernelArgs {
    if (offset < 0 || offset > buffer.bytes) panic("KernelArgs.pointer: offset $offset outside a buffer of ${buffer.bytes} bytes")
    this.kinds.append(KERNEL_ARG_POINTER)
    this.words.append(buffer.handle + offset)
    this
}

// Owned device memory. It is created by a Backend's `allocate` and returns itself to that backend when dropped.
// `owner` carries the context identity (the CUDA context, a Vulkan device, ...): a buffer is only valid with its owner.
resource class DeviceBuffer(val owner: Backend, val handle: int, val bytes: int) {
    fun drop(): void {
        this.owner.release(this.handle, this.bytes)
    }
}

interface Backend {
    fun name(): string
    // Device memory, uninitialised; null when the device is out of memory.
    fun allocate(bytes: int): DeviceBuffer?
    // Copies `bytes` from host memory at `hostAddress` to `destination` at `offset`. Ordered with launches.
    fun upload(destination: DeviceBuffer, offset: int, hostAddress: int, bytes: int): bool
    // Copies back to host memory at `hostAddress`; waits for every queued launch and copy first.
    fun download(source: DeviceBuffer, offset: int, hostAddress: int, bytes: int): bool
    // Queues kernel `kernel` (by name; docs/plan.md lists them) with `args` over `problem`, the op-specific sizes (a matvec:
    // [rows]; an indexed matvec: [rows, nUsed]); the backend turns them into its launch geometry. Launches run in order.
    fun launch(kernel: string, args: KernelArgs, problem: array<int>): bool
    // Waits for all queued work.
    fun synchronize(): bool
    // Bytes of device memory still free.
    fun freeMemory(): int
    // Start recording launches instead of running them (copies and synchronize are not allowed meanwhile); false when the backend cannot.
    fun beginRecording(): bool
    // Stop recording; the sequence, or null when the recording failed.
    fun endRecording(): Recording?
    // Queue the whole recorded sequence (asynchronous, ordered with launches).
    fun replay(recording: Recording): bool
    // Parallel branches inside a recording (they only matter while recording; otherwise all three do nothing and succeed): `fork(count)` starts `count`
    // branches that wait for everything launched so far, `branch(i)` sends the following launches to branch i (0 = the main line), `join()` makes the main
    // line wait for every branch. Launches of different branches may overlap on the device, so they must not touch the same buffers.
    fun fork(count: int): bool
    fun branch(index: int): bool
    fun join(): bool
    // Called by Recording.drop only.
    fun releaseRecording(handle: int): void
    // Called by DeviceBuffer.drop only.
    fun release(handle: int, bytes: int): void
}

// A recorded sequence of launches that can be replayed with one call (a CUDA graph; for other backends a list of launches). Recording captures what `launch`
// is asked to do between `beginRecording` and `endRecording`: nothing runs while recording. Everything a replay needs that changes from run to run
// (a token, a position) must live in device memory the kernels read, not in kernel parameters, since parameters are frozen at recording time.
resource class Recording(val owner: Backend, val handle: int, val launches: int) {
    fun drop(): void {
        this.owner.releaseRecording(this.handle)
    }
}
