import "abla/compiler/parser"
import "kernel.ab"
import "emit.ab"

private compile fun fuseSkip(cursor: ParserCursor) {
    parserRawSkipWhitespace(cursor)
    while (parserRawConsume(cursor, "//")) {
        parserRawTakeUntil(cursor, "\n\r")
        parserRawSkipWhitespace(cursor)
    }
}

private compile fun fuseExpect(cursor: ParserCursor, text: string) {
    fuseSkip(cursor)
    parserRawExpect(cursor, text)
}

private compile fun fuseConsume(cursor: ParserCursor, text: string): bool {
    fuseSkip(cursor)
    parserRawConsume(cursor, text)
}

private compile fun fuseKeyword(cursor: ParserCursor, word: string): bool {
    fuseSkip(cursor)
    if (!(parserRawAt(cursor, "$word ") || parserRawAt(cursor, "$word\t") ||
        parserRawAt(cursor, "$word\n") || parserRawAt(cursor, "$word\r"))) return false
    parserRawConsume(cursor, word)
}

private compile fun fuseToken(cursor: ParserCursor): string {
    fuseSkip(cursor)
    parserRawTakeUntil(cursor, " \t\r\n{}()[]:=,*/")
}

private fun fuseIdentifier(text: string): bool {
    if (text.size == 0 || text.size > 80) return false
    for (i in 0 until text.size) {
        val c = text[i]
        if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 ||
            (i > 0 && c >= 48 && c <= 57)) continue
        return false
    }
    true
}

private compile fun fuseName(cursor: ParserCursor): string {
    val text = fuseToken(cursor)
    if (!fuseIdentifier(text)) parserFail(cursor, "fuse: expected an identifier")
    text
}

private compile fun fuseAtom(cursor: ParserCursor, dimensions: Map<string, int>): int {
    val text = fuseToken(cursor)
    if (fuseIdentifier(text)) {
        val extent = dimensions.get(text)
        if (extent == null) {
            parserFail(cursor, "fuse: unknown dimension '$text'")
            return 1
        }
        return extent
    }
    var value = 0
    for (digit in text) {
        if (digit < 48 || digit > 57 || value > (2147483647 - (digit - 48)) / 10) {
            parserFail(cursor, "fuse: expected a positive integer dimension")
            return 1
        }
        value = value * 10 + digit - 48
    }
    if (value == 0) {
        parserFail(cursor, "fuse: expected a positive integer dimension")
        return 1
    }
    value
}

private compile fun fuseExtent(cursor: ParserCursor, dimensions: Map<string, int>): int {
    var extent = fuseAtom(cursor, dimensions)
    while (fuseConsume(cursor, "*")) {
        val factor = fuseAtom(cursor, dimensions)
        if (extent > 2147483647 / factor) {
            parserFail(cursor, "fuse: dimension product exceeds 2147483647")
            return 1
        }
        extent *= factor
    }
    extent
}

private compile fun fuseDimensions(cursor: ParserCursor, var dimensions: Map<string, int>) {
    var more = true
    while (more) {
        val name = fuseName(cursor)
        if (dimensions.has(name) || dimensions.size >= 32) {
            parserFail(cursor, "fuse: duplicate dimension or dimension limit exceeded")
            return
        }
        fuseExpect(cursor, "=")
        dimensions.set(name, fuseExtent(cursor, dimensions))
        more = fuseConsume(cursor, ",")
    }
}

private compile fun fuseTensors(cursor: ParserCursor, dimensions: Map<string, int>,
    var tensors: Map<string, FusedTensor>, var out: array<FusedTensor>) {
    var more = true
    while (more) {
        val name = fuseName(cursor)
        if (tensors.has(name) || tensors.size >= 32) {
            parserFail(cursor, "fuse: duplicate tensor or tensor limit exceeded")
            return
        }
        fuseExpect(cursor, ":")
        val kind = fuseName(cursor)
        if (kind != "f32" && kind != "u32" && kind != "nvfp4") {
            parserFail(cursor, "fuse: unsupported storage type '$kind'")
            return
        }
        fuseExpect(cursor, "[")
        val shape: array<int> = []
        var elements = 1
        var next = true
        while (next) {
            val extent = fuseExtent(cursor, dimensions)
            if (shape.size >= 3 || elements > 2147483647 / extent) {
                parserFail(cursor, "fuse: tensor rank or element count exceeds the limit")
                return
            }
            elements *= extent
            shape.append(extent)
            next = fuseConsume(cursor, ",")
        }
        fuseExpect(cursor, "]")
        val tensor = FusedTensor(name, kind, shape)
        tensors.set(name, tensor)
        out.append(tensor)
        more = fuseConsume(cursor, ",")
    }
}

private compile fun fuseScalar(cursor: ParserCursor, name: string): string {
    fuseExpect(cursor, name)
    fuseExpect(cursor, "=")
    val text = fuseToken(cursor)
    var digits = 0
    var dots = 0
    var nonzero = false
    for (byte in text) {
        if (byte == 46) dots += 1
        else if (byte >= 48 && byte <= 57) {
            digits += 1
            if (byte != 48) nonzero = true
        } else {
            parserFail(cursor, "fuse: '$name' needs a decimal constant")
            return "1.0"
        }
    }
    if (digits == 0 || dots > 1 || text.size > 16 || (name != "lb" && !nonzero)) {
        parserFail(cursor, "fuse: invalid '$name' constant")
        return "1.0"
    }
    if (dots == 0) text + ".0" else text
}

private compile fun fuseStep(cursor: ParserCursor): FusedStep? {
    val output = fuseName(cursor)
    fuseExpect(cursor, "=")
    val op = fuseName(cursor)
    val count = when (op) {
        "matvec_indexed" -> 4
        "situ", "rmsnorm" -> 1
        "matvec", "concat" -> 2
        else -> 0
    }
    if (count == 0) {
        parserFail(cursor, "fuse: unknown operation '$op'")
        return null
    }
    fuseExpect(cursor, "(")
    val inputs: array<string> = []
    for (at in 0 until count) {
        if (at > 0) fuseExpect(cursor, ",")
        inputs.append(fuseName(cursor))
    }
    var beta = ""
    var lb = ""
    var eps = ""
    if (op == "situ") {
        fuseExpect(cursor, ",")
        beta = fuseScalar(cursor, "beta")
        fuseExpect(cursor, ",")
        lb = fuseScalar(cursor, "lb")
    } else if (op == "rmsnorm") {
        fuseExpect(cursor, ",")
        eps = fuseScalar(cursor, "eps")
    }
    fuseExpect(cursor, ")")
    FusedStep(op, output, inputs, beta, lb, eps)
}

private compile fun fuseInput(cursor: ParserCursor, inputs: array<FusedTensor>,
    name: string, kind: string, rank: int): FusedTensor? {
    for (input in inputs) {
        if (input.name != name) continue
        if (input.kind == kind && input.shape.size == rank) return input
        parserFail(cursor, "fuse: '$name' needs type '$kind' and rank $rank")
        return null
    }
    parserFail(cursor, "fuse: tensor '$name' used before definition")
    null
}

// Only two independent weightless norms, an ordered concat and its F32 dot
// can share this geometry. The intermediate vector remains in shared memory.
private compile fun fuseController(cursor: ParserCursor, name: string,
    inputs: array<FusedTensor>, outputs: array<FusedTensor>, tensors: Map<string, FusedTensor>,
    current: FusedStep): SyntaxExpression {
    val cur = fuseInput(cursor, inputs, current.inputs[0], "f32", 1) ?? return syntaxNull()
    val message = fuseStep(cursor) ?? return syntaxNull()
    if (message.operation != "rmsnorm") {
        parserFail(cursor, "fuse: the second controller step must be a weightless norm")
        return syntaxNull()
    }
    val msg = fuseInput(cursor, inputs, message.inputs[0], "f32", 1) ?? return syntaxNull()
    if (cur.name == msg.name || cur.shape[0] != 2304 || msg.shape[0] != 2304) {
        parserFail(cursor, "fuse: controller needs two distinct 2304-value input vectors")
        return syntaxNull()
    }
    val joined = fuseStep(cursor) ?? return syntaxNull()
    if (joined.operation != "concat" || joined.inputs[0] != current.output ||
        joined.inputs[1] != message.output) {
        parserFail(cursor, "fuse: concat must consume the two normalized vectors in order")
        return syntaxNull()
    }
    val intermediates = [current.output, message.output, joined.output]
    for (index in 0 until intermediates.size) {
        val item = intermediates[index]
        if (tensors.has(item) || (index > 0 && item == intermediates[0]) ||
            (index > 1 && item == intermediates[1])) {
            parserFail(cursor, "fuse: controller intermediates must have distinct fresh names")
            return syntaxNull()
        }
    }
    val down = fuseStep(cursor) ?? return syntaxNull()
    if (down.operation != "matvec" || down.inputs[1] != joined.output) {
        parserFail(cursor, "fuse: controller matvec must consume the concatenated vector")
        return syntaxNull()
    }
    val weights = fuseInput(cursor, inputs, down.inputs[0], "f32", 2) ?? return syntaxNull()
    if (inputs.size != 3 || weights.shape[1] != 4608) {
        parserFail(cursor, "fuse: controller matvec needs a [rows, 4608] F32 weight tensor")
        return syntaxNull()
    }
    if (outputs.size != 1 || outputs[0].name != down.output) {
        parserFail(cursor, "fuse: every output must be assigned")
        return syntaxNull()
    }
    val out = outputs[0]
    if (out.kind != "f32" || out.shape.size != 1 || out.shape[0] != weights.shape[0]) {
        parserFail(cursor, "fuse: controller matvec output shape mismatch")
        return syntaxNull()
    }
    fuseExpect(cursor, "}")
    fuseEmitController(name, inputs, out, [current, message, joined, down], weights.shape[0])
}

compile fun parseFuse(cursor: ParserCursor): SyntaxExpression {
    val name = fuseName(cursor)
    val dimensions: Map<string, int> = Map()
    val tensors: Map<string, FusedTensor> = Map()
    val inputs: array<FusedTensor> = []
    val outputs: array<FusedTensor> = []
    fuseExpect(cursor, "{")
    if (fuseKeyword(cursor, "dims")) fuseDimensions(cursor, dimensions)
    while (fuseKeyword(cursor, "in")) fuseTensors(cursor, dimensions, tensors, inputs)
    while (fuseKeyword(cursor, "out")) fuseTensors(cursor, dimensions, tensors, outputs)
    val first = fuseStep(cursor) ?? return syntaxNull()
    if (first.operation == "rmsnorm") return fuseController(cursor, name, inputs, outputs, tensors, first)
    val matvec = first
    if (matvec.operation != "matvec_indexed") {
        parserFail(cursor, "fuse: the first step must be indexed NVFP4 gate/up")
        return syntaxNull()
    }
    val weights = fuseInput(cursor, inputs, matvec.inputs[0], "nvfp4", 3) ?? return syntaxNull()
    val x = fuseInput(cursor, inputs, matvec.inputs[1], "f32", 1) ?? return syntaxNull()
    val ids = fuseInput(cursor, inputs, matvec.inputs[2], "u32", 1) ?? return syntaxNull()
    val scales = fuseInput(cursor, inputs, matvec.inputs[3], "f32", 1) ?? return syntaxNull()
    if (tensors.has(matvec.output)) {
        parserFail(cursor, "fuse: the intermediate name must be fresh")
        return syntaxNull()
    }
    if (inputs.size != 4 || x.name == scales.name) {
        parserFail(cursor, "fuse: gate/up requires four distinct inputs")
        return syntaxNull()
    }
    val experts = weights.shape[0]
    val rows = weights.shape[1]
    val cols = weights.shape[2]
    val used = ids.shape[0]
    if (cols % 64 != 0 || rows % 2 != 0 || cols != x.shape[0] || experts != scales.shape[0] ||
        used > experts || used > 65535) {
        parserFail(cursor, "fuse: indexed gate/up shape mismatch")
        return syntaxNull()
    }
    val situ = fuseStep(cursor) ?? return syntaxNull()
    if (situ.operation != "situ" || situ.inputs[0] != matvec.output) {
        parserFail(cursor, "fuse: SiTU must consume the defined gate/up intermediate")
        return syntaxNull()
    }
    if (outputs.size != 1 || outputs[0].name != situ.output) {
        parserFail(cursor, "fuse: every output must be assigned")
        return syntaxNull()
    }
    val out = outputs[0]
    val ff = rows / 2
    if (out.kind != "f32" || out.shape.size != 2 || out.shape[0] != used || out.shape[1] != ff) {
        parserFail(cursor, "fuse: SiTU output shape mismatch")
        return syntaxNull()
    }
    fuseSkip(cursor)
    if (!parserRawAt(cursor, "}")) {
        parserFail(cursor, "fuse: launch boundary after gate/up and SiTU")
        return syntaxNull()
    }
    parserRawExpect(cursor, "}")
    fuseEmitGateUp(name, inputs, out, matvec, situ, experts, cols, ff, used)
}

#compilerRegisterSubparser("fuse", parseFuse)
