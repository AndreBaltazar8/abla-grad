// `abla-grad serve <model.gguf> [--port N] [--ctx N] [--tokenizer PATH] [--drafter PATH] [--model-name NAME] [--max-tokens N] [--capture-requests FILE] [--no-speculation] [--plain-from TOKENS] [--batch-decode 1..4]`: an OpenAI-compatible server for
// Inkling on the GPU, on 127.0.0.1 only. Ready requests share one generation slot. Endpoints: GET /v1/models, POST /v1/chat/completions
// (streaming SSE and plain JSON, tools and tool calls, usage), GET /health. A request with the same session ID can reuse the shared start of the previous prompt.
import "abla/io"
import "abla/text"
import "abla/integer"
import "abla/float"
import "abla/float/text"
import "abla/json"
import "abla/fs/secure"
import "abla/http"
import "abla/net"
import "abla/process/time"
import "../backend/backend.ab"
import "../backend/cuda.ab"
import "../gguf/reader.ab"
import "../model/inkling.ab"
import "../model/decode_batch.ab"
import "../model/prompt_checkpoint.ab"
import "../model/inkling_config.ab"
import "../model/speculate.ab"
import "../model/inkling_prefill.ab"
import "../tokenizer/tokenizer.ab"
import "../cli/generate.ab"
import "../cli/chat.ab"
import "template.ab"
import "outparse.ab"
import "openai.ab"
import "tool_schema.ab"
import "queue.ab"

// Speculation stops paying near this prompt length (replay of the opencode capture on b97ba0d, speculation / plain decode tok/s: 19.5k 152.8 / 126.9, 38k 121.5 / 124.8,
// 56k 115.2 / 117.6, 75k 109.1 / 113.0, 111k 101.4 / 105.2): longer prompts decode plain. The crossover lies between 19.5k and 38k.
private var servePlainFrom = 30000
// The long-session estimate (measured at 65536 and 131072) includes compact drafter K/V and rolling taps.
// Shorter sessions use the conservative estimate for the full drafter cache and taps.
private val SERVE_MAX_CTX = 131072
private val SERVE_LONG_FROM = 65536
private val SERVE_LONG_BYTES_PER_POSITION = 8192
private val SERVE_LONG_FIXED_BYTES = 20700000000

private val SERVE_BYTES_PER_POSITION = 80000
private val SERVE_FIXED_BYTES = 20300000000
// Without max_tokens (and --max-tokens) a reply may use everything the context has left after the prompt.
private val SERVE_DEFAULT_MAX_TOKENS = 1073741824

private fun serveDrafterPath(model: string): string {
    val slash = model.lastIndexOf("/")
    val directory = if (slash >= 0) model.codePointSlice(0, slash + 1) else ""
    "${directory}dspark-Inkling-2-Mini-Q8_0.gguf"
}

private fun serveSpecialId(tokenizer: Tokenizer, text: string): int {
    val ids = tokenizer.encode(text, false, true)
    if (ids.size == 1) ids[0] else -1
}

// Writes `text` to the socket `descriptor` without taking ownership (closures cannot capture the connection itself).
private fun serveSend(descriptor: int, text: string): bool {
    var link = TcpConnection(descriptor)
    val written = link.write(text)
    link.descriptor = -1
    written >= 0
}

private fun serveWriteJson(var connection: TcpConnection, status: int, body: string): void {
    val response = HttpResponse(status, [HttpHeader("Content-Type", "application/json"), HttpHeader("Access-Control-Allow-Origin", "*")], body)
    connection.write(response.render())
    return
}

private fun serveWriteError(var connection: TcpConnection, status: int, message: string, kind: string, code: string): void =
    serveWriteJson(connection, status, serveErrorBody(message, kind, code))

// The largest index <= cut that is not inside a UTF-8 sequence of `text`.
private fun serveUtf8Boundary(text: string, cut: int): int {
    var at = cut
    while (at > 0 && at < text.size && text[at] >= 128 && text[at] < 192) at = at - 1
    at
}

class ServeCounters(var requests: int = 0, var plainOnly: bool = false, var residentSession: string = "")

/** The state of one running chat request: what was sent, what is held back for stop strings, and the calls found. */
class ServeRun(
    val fd: int, val streaming: bool, var id: string, var created: int, var name: string, val stop: array<string>, var callPrefix: string,
    var content: string = "", var reasoning: string = "", var pending: string = "", var stopMatched: bool = false, var firstToken: int = 0,
    var connected: bool = true, var cancel: bool = false, var firstRaw: int = 0, val calls: array<Json> = []
) {
    fun send(chunk: string): void {
        if (this.connected && !serveSend(this.fd, chunk)) {
            this.connected = false
            this.cancel = true
        }
        return
    }

    fun delta(field: string, piece: string): void {
        this.send(serveChunk(this.id, this.created, this.name, jsonObject([field], [jsonString(piece)]), "", -1, 0, 0, true))
        return
    }

    fun deliverContent(piece: string): void {
        if (piece == "") return
        this.content = this.content + piece
        if (this.streaming) this.delta("content", piece)
        return
    }

    fun handle(event: ServeEvent): void {
        if (this.firstToken == 0) this.firstToken = monotonicNanoseconds()
        if (event.kind == 1) {
            this.reasoning = this.reasoning + event.text
            if (this.streaming) this.delta("reasoning_content", event.text)
        } else if (event.kind == 2) {
            if (this.stop.size == 0) {
                this.deliverContent(event.text)
            } else if (!this.stopMatched) {
                var maxStop = 0
                for (s in this.stop) if (s.size > maxStop) maxStop = s.size
                this.pending = this.pending + event.text
                var cut = -1
                for (s in this.stop) {
                    val at = this.pending.indexOf(s)
                    if (at >= 0 && (cut < 0 || at < cut)) cut = at
                }
                if (cut >= 0) {
                    this.stopMatched = true
                    this.cancel = true
                    this.deliverContent(this.pending.slice(0, cut))
                    this.pending = ""
                } else if (this.pending.size > maxStop - 1) {
                    val upto = serveUtf8Boundary(this.pending, this.pending.size - (maxStop - 1))
                    this.deliverContent(this.pending.slice(0, upto))
                    this.pending = this.pending.slice(upto, this.pending.size)
                }
            }
        } else {
            val index = this.calls.size
            val callId = "${this.callPrefix}_$index"
            this.calls.append(serveToolCallJson(index, callId, event.name, event.arguments, this.streaming))
            if (this.streaming) {
                this.send(serveChunk(this.id, this.created, this.name, jsonObject(["tool_calls"], [jsonArray([serveToolCallJson(index, callId, event.name, event.arguments, true)])]), "", -1, 0, 0, true))
            }
        }
        return
    }
}

private fun ServeRun.begin(): void {
    if (!this.streaming) return
    this.send("HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n")
    val role = jsonObject(["role", "content"], [jsonString("assistant"), jsonString("")])
    this.send(serveChunk(this.id, this.created, this.name, role, "", -1, 0, 0, true))
    return
}

private fun ServeRun.complete(var connection: TcpConnection, includeUsage: bool,
    promptTokens: int, generated: int, kept: int, stopped: bool): string {
    if (!this.stopMatched && this.pending != "") this.deliverContent(this.pending)
    val finish = if (this.calls.size > 0) "tool_calls" else if (this.stopMatched || stopped) "stop" else "length"
    if (this.streaming) {
        this.send(serveChunk(this.id, this.created, this.name, jsonObject([], []), finish, -1, 0, 0, true))
        if (includeUsage) this.send(serveChunk(this.id, this.created, this.name, jsonObject([], []), "", promptTokens, generated, kept, false))
        this.send("data: [DONE]\n\n")
    } else {
        serveWriteJson(connection, 200, serveCompletionBody(this.id, this.created, this.name, this.content, this.reasoning, this.calls,
            finish, promptTokens, generated, kept))
    }
    finish
}

/** Handles one chat-completions request on `connection`. */
private fun serveChat(
    var backend: Backend, var model: InklingModel, var session: SpecSession, var connection: TcpConnection, tokenizer: Tokenizer, stops: array<int>,
    ids: array<int>, body: string, modelName: string, context: int, defaultMaxTokens: int, sessionKey: string,
    var counters: ServeCounters, var queue: ServeQueue
): bool {
    val started = monotonicNanoseconds()
    val errors: array<string> = []
    val request = serveParseRequest(body, errors)
    if (request == null) {
        serveWriteError(connection, 400, if (errors.size > 0) errors[0] else "invalid request", "invalid_request_error", "")
        return true
    }
    val tools = if (request.toolChoiceNone) [] else request.tools
    val text = serveRenderPrompt(request.messages, tools, request.effort, errors)
    if (text == "") {
        serveWriteError(connection, 400, if (errors.size > 0) errors[0] else "the prompt could not be rendered", "invalid_request_error", "")
        return true
    }
    val tokens = tokenizer.encode(text, true, true)
    val room = context - tokens.size
    if (room < 16) {
        serveWriteError(connection, 400, "This model's context is ${context} tokens, but the conversation has ${tokens.size} tokens.", "invalid_request_error", "context_length_exceeded")
        return true
    }
    var maxTokens = if (request.maxTokens > 0) request.maxTokens else defaultMaxTokens
    if (maxTokens > room) maxTokens = room
    counters.requests = counters.requests + 1
    val id = "chatcmpl-${counters.requests}-${monotonicMilliseconds()}"
    val created = realtimeMilliseconds() / 1000
    val name = if (request.model != "") request.model else modelName
    cudaClearAllocationError()
    // The target and drafter have one resident KV cache. Clearing session
    // boundaries also invalidates both prompt checkpoints.
    if (counters.residentSession != sessionKey) {
        session.restart()
        counters.residentSession = sessionKey
    }
    val kept = session.reuse(backend, model, tokens)
    val parser = ServeOutputParser(ids[0], ids[1], ids[2], ids[3], ids[4])
    val streaming = request.stream
    val fd = connection.descriptor
    var run = ServeRun(fd, streaming, id, created, name, request.stop, "call_${counters.requests}")
    run.begin()
    val rules = serveToolRules(tools)
    val events: array<ServeEvent> = []
    var stats = SpecStats()
    var decodeNanos = 0
    var sampled = 0
    var remaining = maxTokens
    var bodyAt = 0
    var constraintError = ""
    var repairs = 0
    var waitingTool = ""
    var ok = true
    while (remaining > 0) {
        val control = SpecControl()
        var repair: string? = null
        var position = session.seq.size
        stats = SpecStats()
        ok = session.turn(backend, model, remaining, stops, true, counters.plainOnly || tokens.size > servePlainFrom, control, stats, { token ->
            if (run.firstRaw == 0) run.firstRaw = monotonicNanoseconds()
            if (token == ids[3] && parser.state == 1) bodyAt = position + 1
            position += 1
            if ((position & 15) == 0) queue.pump(0)
            parser.feed(token, tokenizer.decodePiece(token), events)
            for (event in events) {
                if (event.kind == 3 && rules.size > 0) {
                    if (waitingTool != "" && event.name != waitingTool) continue
                    repair = serveToolRepair(rules, event.name, parser.body, parser.parsedTool)
                    if (repair != null) {
                        waitingTool = event.name
                        control.cancel = true
                        break
                    }
                    waitingTool = ""
                }
                if (waitingTool == "") run.handle(event)
            }
            if (run.cancel) control.cancel = true
            events.clear()
        })
        if (sampled > 0) decodeNanos += stats.feedNanos
        decodeNanos += stats.loopNanos
        sampled += stats.generated
        val nextBody = repair
        if (!ok || nextBody == null || run.cancel) break
        val continuation = serveToolContinuation(tokenizer, session.seq, bodyAt, nextBody)
        remaining = maxTokens - sampled
        val outputBudget = maxTokens - (continuation.size - tokens.size)
        if (remaining > outputBudget) remaining = outputBudget
        val space = context - continuation.size
        if (remaining > space) remaining = space
        if (remaining <= 0) {
            constraintError = "the token budget ended before a required tool argument could be generated"
            ok = false
            break
        }
        repairs += 1
        session.reuse(backend, model, continuation)
        parser.body = nextBody
        parser.state = 2
        parser.kind = 3
    }
    if (ok && waitingTool != "" && !run.cancel) {
        constraintError = "generation ended before the required arguments for $waitingTool were complete"
        ok = false
    }
    if (repairs > 0) eprintln("[serve] constrained tool arguments: $repairs continuations, id $id")
    stats.loopNanos = decodeNanos
    stats.generated = session.seq.size - tokens.size - (if (stats.stopped) 1 else 0)
    if (!ok) {
        val allocation = cudaLastAllocationError()
        val detail = if (constraintError != "") constraintError else speculateLastError()
        val message = if (allocation == "") "generation failed: $detail" else "generation failed: $detail ($allocation)"
        session.restart()
        eprintln("serve: $message")
        if (!streaming) serveWriteError(connection, 500, message, "server_error", "")
        else run.send("data: ${serveErrorBody(if (allocation == "" && constraintError == "") "generation failed" else message, "server_error", "")}\n\n")
        connection.close()
        return allocation == ""
    }
    val finish = run.complete(connection, request.includeUsage, tokens.size, stats.generated, kept, stats.stopped)
    val seconds = f64FromInt(monotonicNanoseconds() - started) / 1000000000.0
    val decodeSeconds = f64FromInt(stats.loopNanos) / 1000000000.0
    connection.close()
    val rawTtft = if (run.firstRaw > 0) f64FromInt(run.firstRaw - started) / 1000000000.0 else seconds
    val ttft = if (run.firstToken > 0) f64FromInt(run.firstToken - started) / 1000000000.0 else seconds
    eprintln("[serve] ${tokens.size} prompt tokens (${kept} reused), ${stats.generated} generated, first output after ${ttft} s (first token ${rawTtft} s), ${f64FromInt(stats.generated) / (if (decodeSeconds > 0.0) decodeSeconds else 1.0)} tok/s, finish $finish${if (streaming) ", streamed" else ""}, id $id")
    true
}

private class ServeBatchRequest(
    val entry: ServeQueuedRequest, val request: ServeRequest, val tokens: array<int>, val maxTokens: int,
    val started: int, val parser: ServeOutputParser, val run: ServeRun, var opened: bool = false,
    var generated: int = 0, var stopped: bool = false
)

private fun serveBatchCandidate(entry: ServeQueuedRequest, tokenizer: Tokenizer, ids: array<int>,
    context: int, maxTokens: int, resident: string): ServeBatchRequest? {
    val started = monotonicNanoseconds()
    val request = entry.request
    if (entry.session == "" || entry.session == resident || request.method != "POST" ||
        (request.path != "/v1/chat/completions" && request.path != "/chat/completions")) return null
    val errors: array<string> = []
    val parsed = serveParseRequest(request.body, errors) ?? return null
    if (parsed.tools.size > 0 && !parsed.toolChoiceNone) return null
    val prompt = serveRenderPrompt(parsed.messages, [], parsed.effort, errors)
    if (prompt == "") return null
    val tokens = tokenizer.encode(prompt, true, true)
    val room = context - tokens.size
    if (tokens.size == 0 || room < 16) return null
    val wanted = if (parsed.maxTokens > 0) parsed.maxTokens else maxTokens
    ServeBatchRequest(entry, parsed, tokens, if (wanted < room) wanted else room, started,
        ServeOutputParser(ids[0], ids[1], ids[2], ids[3], ids[4]), ServeRun(entry.descriptor, parsed.stream, "", 0, "", parsed.stop, ""))
}

// Match the serial server's cold prompt schedule, including its trailing
// step-mode window and optional stride before that window.
private fun serveBatchPrefill(var backend: Backend, model: InklingModel, tokens: array<int>, boundary: int, recording: Recording): bool {
    if (!model.reset(backend)) return false
    val end = tokens.size - 1 - 192
    var first = 0
    if (end > 0) {
        val ws = specSeedWorkspace(backend, model.config) ?? return false
        var stride = ((tokens.size - 2) / PROMPT_CHECKPOINT_STRIDE) * PROMPT_CHECKPOINT_STRIDE
        if (stride > 0 && stride < end) stride = (stride / ws.chunk) * ws.chunk
        while (first < end) {
            val stop = if (first < stride && stride < end) stride else end
            val count = if (stop - first > ws.chunk) ws.chunk else stop - first
            val prefix: array<int> = []
            for (i in first until first + count) prefix.append(tokens[i])
            if (!model.prefill(backend, ws, prefix, first)) return false
            first += count
        }
    }
    for (p in first until boundary) if (!model.replayToken(backend, recording, tokens[p], p)) return false
    true
}

private fun ServeBatchRequest.sendToken(token: int, tokenizer: Tokenizer, stops: array<int>): void {
    if (!this.opened || this.stopped || this.run.cancel) return
    for (stop in stops) if (token == stop) {
        this.stopped = true
        return
    }
    if (this.run.firstRaw == 0) this.run.firstRaw = monotonicNanoseconds()
    this.generated += 1
    val events: array<ServeEvent> = []
    this.parser.feed(token, tokenizer.decodePiece(token), events)
    for (event in events) this.run.handle(event)
    return
}

private fun ServeBatchRequest.finished(): bool {
    this.stopped || this.generated >= this.maxTokens || !this.opened || this.run.cancel
}

private fun ServeBatchRequest.start(modelName: string, var counters: ServeCounters): void {
    val prepared = serveQueuedConnection(this.entry.descriptor)
    if (prepared.descriptor < 0) return
    prepared.descriptor = -1
    counters.requests += 1
    val id = "chatcmpl-${counters.requests}-${monotonicMilliseconds()}"
    val name = if (this.request.model != "") this.request.model else modelName
    this.run.id = id
    this.run.created = realtimeMilliseconds() / 1000
    this.run.name = name
    this.run.callPrefix = "call_${counters.requests}"
    this.opened = true
    this.run.begin()
    return
}

private fun ServeBatchRequest.finish(message: string = ""): void {
    if (!this.opened) return
    var connection = TcpConnection(this.run.fd)
    if (message != "") {
        if (this.run.streaming) this.run.send("data: ${serveErrorBody(message, "server_error", "")}\n\n")
        else serveWriteError(connection, 500, message, "server_error", "")
    } else {
        val finish = this.run.complete(connection, this.request.includeUsage,
            this.tokens.size, this.generated, 0, this.stopped)
        val ended = monotonicNanoseconds()
        val firstRaw = if (this.run.firstRaw > 0) this.run.firstRaw else ended
        val first = if (this.run.firstToken > 0) this.run.firstToken else ended
        eprintln("[serve batch] ${this.tokens.size} prompt tokens (0 reused), ${this.generated} generated, first output after ${f64FromInt(first - this.started) / 1000000000.0} s (first token ${f64FromInt(firstRaw - this.started) / 1000000000.0} s), finish $finish, id ${this.run.id}")
    }
    connection.close()
    this.opened = false
    return
}

private fun serveBatchStage(var backend: Backend, models: array<InklingModel>,
    var jobs: array<ServeBatchRequest>, steps: Recording, var active: array<int>, var at: array<int>,
    tokenizer: Tokenizer, stops: array<int>, var queue: ServeQueue): bool {
    val lanes = active.size
    val first = active[0]
    while (active.size == lanes && !tcpShutdownRequested()) {
        var count = 4
        for (i in active) {
            val remaining = jobs[i].maxTokens - jobs[i].generated
            if (remaining < count) count = remaining
        }
        if (!models[first].replayMany(backend, steps, count)) return false
        var lane = 0
        while (lane < active.size) {
            val i = active[lane]
            val tokens = models[i].readLog(backend, at[i], count) ?? return false
            at[i] += count
            for (token in tokens) {
                jobs[i].sendToken(token, tokenizer, stops)
                if (jobs[i].finished()) break
            }
            if (jobs[i].finished()) {
                jobs[i].finish()
                active.takeAt(lane)
            } else lane += 1
        }
        queue.pump(0)
    }
    !tcpShutdownRequested()
}

private fun serveBatchDecode(var backend: Backend, var models: array<InklingModel>, var jobs: array<ServeBatchRequest>,
    initial: Recording, tokenizer: Tokenizer, stops: array<int>, var queue: ServeQueue): bool {
    var active: array<int> = []
    for (i in 0 until jobs.size) if (!jobs[i].finished()) active.append(i)
    var at: array<int> = []
    for (job in jobs) at.append(job.tokens.size)
    if (active.size == jobs.size && !serveBatchStage(backend, models, jobs, initial, active, at, tokenizer, stops, queue)) return false
    while (active.size > 0) {
        val steps = if (active.size > 1) inklingCaptureLanes(backend, models, active) else models[active[0]].capture(backend)
        if (steps == null || !serveBatchStage(backend, models, jobs, steps, active, at, tokenizer, stops, queue)) return false
    }
    true
}

private fun serveBatchAllocationFail(lane: int): int {
    eprintln("serve: could not reserve batch lane $lane: ${inklingLastError()} ${cudaLastDiagnostic()}; using serial decode")
    cudaClearAllocationError()
    0
}

// Returns 0 if ordinary single-session dispatch should handle the request,
// 1 if this cohort was served, and -1 for an allocation failure after dispatch.
private fun tryServeBatch(var backend: Backend, model: InklingModel, entry: ServeQueuedRequest,
    tokenizer: Tokenizer, ids: array<int>, stops: array<int>, context: int, maxTokens: int, modelName: string,
    limit: int, var queue: ServeQueue, var counters: ServeCounters): int {
    if (entry.session == "" || entry.session == counters.residentSession) return 0
    // Admit clients accepted by the previous poll and give simultaneously
    // arriving headers a short window to enter the same cohort.
    queue.pump(0)
    if (queue.waiting.size + queue.reading.size == 0) return 0
    val deadline = monotonicMilliseconds() + 8
    while (queue.waiting.size < limit - 1 && !queue.failed && !tcpShutdownRequested()) {
        val remaining = deadline - monotonicMilliseconds()
        if (remaining <= 0) break
        queue.pump(remaining)
    }
    if (queue.waiting.size == 0) return 0
    val first = serveBatchCandidate(entry, tokenizer, ids, context, maxTokens, counters.residentSession) ?? return 0
    var jobs = [first]
    val indices: array<int> = []
    val seen = [entry.session]
    for (i in 0 until queue.waiting.size) {
        if (jobs.size >= limit) break
        val item = queue.waiting[i]
        var duplicate = false
        for (session in seen) if (session == item.session) duplicate = true
        if (duplicate) continue
        seen.append(item.session)
        val candidate = serveBatchCandidate(item, tokenizer, ids, context, maxTokens, counters.residentSession)
        if (candidate != null) {
            jobs.append(candidate)
            indices.append(i)
        }
    }
    if (jobs.size < 2) return 0
    var models: array<InklingModel> = []
    var tail = 193
    for (job in jobs) if (job.tokens.size < tail) tail = job.tokens.size
    for (i in 0 until jobs.size) {
        val tokens = jobs[i].tokens
        val positions = tokens.size + jobs[i].maxTokens
        var lane = model.newDecodeLane(backend, positions) ?? return serveBatchAllocationFail(i + 1)
        val single = lane.capture(backend) ?? return 0
        if (!serveBatchPrefill(backend, lane, tokens, tokens.size - tail, single)) {
            eprintln("serve: batch prefill failed: ${inklingPrefillLastError()} ${cudaLastDiagnostic()}; using serial decode")
            cudaClearAllocationError()
            return 0
        }
        models.append(move(lane))
    }
    val lanes: array<int> = []
    for (i in 0 until jobs.size) lanes.append(i)
    val initial = inklingCaptureLanes(backend, models, lanes) ?? return 0
    for (offset in 0 until tail) {
        for (i in lanes) {
            val position = jobs[i].tokens.size - tail + offset
            if (!models[i].seed(backend, jobs[i].tokens[position], position)) return 0
        }
        if (!backend.replay(initial)) return 0
    }
    val anchors: array<int> = []
    for (i in lanes) anchors.append(models[i].readStepWord(backend, 0) ?? return 0)
    for (i in 0 until indices.size) {
        val removed = queue.waiting.takeAt(indices[indices.size - i - 1])
        queue.bytes -= removed.bytes
    }
    queue.lastSession = jobs[jobs.size - 1].entry.session
    for (i in 0 until jobs.size) {
        jobs[i].start(modelName, counters)
        jobs[i].sendToken(anchors[i], tokenizer, stops)
        if (jobs[i].finished()) jobs[i].finish()
    }
    eprintln("[serve batch] ${jobs.size} concurrent sessions")
    if (serveBatchDecode(backend, models, jobs, initial, tokenizer, stops, queue)) return 1
    val allocation = cudaLastAllocationError()
    val message = "batched decode failed: ${cudaLastDiagnostic()}"
    eprintln("serve: $message")
    for (i in 0 until jobs.size) jobs[i].finish(message)
    if (allocation == "") 1 else -1
}

private fun serveFail(message: string): int {
    eprintln("serve: $message")
    1
}

// Keep one exclusive descriptor open so later writes cannot follow a substituted path.
private fun serveCaptureFile(path: string): SecureFile {
    val slash = path.lastIndexOf("/")
    val directory = if (slash < 0) "." else if (slash == 0) "/" else path.slice(0, slash)
    val name = if (slash < 0) path else path.slice(slash + 1, path.size)
    val parent = secureDirectory(directory)
    parent.createFile(name, 0o600)
}

fun cmdServe(args: array<string>): int {
    var modelPath = ""
    var tokenizerPath = ""
    var drafterPath = ""
    var port = 8080
    var context = 0
    var maxTokens = SERVE_DEFAULT_MAX_TOKENS
    var modelName = "inkling-2-mini"
    var capturePath = ""
    var plainOnly = false
    var batchLimit = 1
    var index = 0
    while (index < args.size) {
        val flag = args[index]
        if (flag == "--port" && index + 1 < args.size) {
            port = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--ctx" && index + 1 < args.size) {
            context = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--tokenizer" && index + 1 < args.size) {
            tokenizerPath = args[index + 1]
            index = index + 2
        } else if (flag == "--drafter" && index + 1 < args.size) {
            drafterPath = args[index + 1]
            index = index + 2
        } else if (flag == "--model-name" && index + 1 < args.size) {
            modelName = args[index + 1]
            index = index + 2
        } else if (flag == "--max-tokens" && index + 1 < args.size) {
            maxTokens = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--plain-from" && index + 1 < args.size) {
            servePlainFrom = args[index + 1].parseInt() ?? 0
            index = index + 2
        } else if (flag == "--batch-decode" && index + 1 < args.size) {
            batchLimit = args[index + 1].parseInt() ?? 0
            if (batchLimit < 1 || batchLimit > 4) return serveFail("--batch-decode needs 1 to 4 lanes")
            index += 2
        } else if (flag == "--no-speculation") {
            plainOnly = true
            index = index + 1
        } else if (flag == "--capture-requests" && index + 1 < args.size) {
            capturePath = args[index + 1]
            if (capturePath == "") return serveFail("--capture-requests needs a nonempty path")
            index = index + 2
        } else if (modelPath == "" && !flag.startsWith("--")) {
            modelPath = flag
            index = index + 1
        } else {
            eprintln("serve: unknown or incomplete option $flag")
            return 2
        }
    }
    if (batchLimit > 1 && !plainOnly) return serveFail("--batch-decode above 1 needs --no-speculation")
    if (modelPath == "" || port < 1 || port > 65535 || (context != 0 && context < 512) || maxTokens < 1) {
        eprintln("usage: abla-grad serve <model.gguf> [--port N] [--ctx N] [--tokenizer PATH] [--drafter PATH] [--model-name NAME] [--max-tokens N] [--capture-requests FILE] [--no-speculation] [--plain-from TOKENS]")
        return 2
    }
    val file = ggufOpen(modelPath)
    if (file == null) {
        eprintln("serve: ${ggufLastError()}")
        return 1
    }
    val architecture = file.getString("general.architecture") ?? ""
    if (!isInklingChat(architecture)) {
        eprintln("serve: only Inkling models are supported (architecture '$architecture')")
        return 1
    }
    val config = inklingConfigFrom(file) ?? return serveFail("the model configuration is not usable: ${inklingConfigLastError()}")
    val tokenizer = (if (tokenizerPath == "") tokenizerFromGguf(file) else tokenizerFromJson(tokenizerPath)) ?? return serveFail("the tokenizer could not be loaded: ${tokenizerLastError()}")
    val draftFile = ggufOpen(if (drafterPath != "") drafterPath else serveDrafterPath(modelPath))
    if (draftFile == null) {
        eprintln("serve: the drafter model is missing (${ggufLastError()}); put dspark-Inkling-2-Mini-Q8_0.gguf next to the model or pass --drafter PATH")
        return 1
    }
    val stops = generationStops(file, tokenizer, architecture)
    val ids = [serveSpecialId(tokenizer, "<|message_model|>"), serveSpecialId(tokenizer, "<|content_thinking|>"), serveSpecialId(tokenizer, "<|content_text|>"),
        serveSpecialId(tokenizer, "<|content_invoke_tool_json|>"), serveSpecialId(tokenizer, "<|end_message|>")]
    var backend = cudaBackend() ?? return serveFail("creating the CUDA backend failed: ${cudaLastDiagnostic()}")
    val freeBefore = backend.freeMemory()
    if (context == 0) {
        // The allocation includes SPEC_CONTEXT_SLACK above the advertised context.
        val longRoom = (freeBefore - SERVE_LONG_FIXED_BYTES) / SERVE_LONG_BYTES_PER_POSITION - SPEC_CONTEXT_SLACK
        if (longRoom + SPEC_CONTEXT_SLACK >= SERVE_LONG_FROM) {
            context = longRoom
            if (context > SERVE_MAX_CTX) context = SERVE_MAX_CTX
        } else {
            context = (freeBefore - SERVE_FIXED_BYTES) / SERVE_BYTES_PER_POSITION - SPEC_CONTEXT_SLACK
            if (context + SPEC_CONTEXT_SLACK >= SERVE_LONG_FROM) context = SERVE_LONG_FROM - SPEC_CONTEXT_SLACK - 1
        }
        if (context < 1024) {
            val minimum = SERVE_FIXED_BYTES + SERVE_BYTES_PER_POSITION * (1024 + SPEC_CONTEXT_SLACK)
            return serveFail("the minimum model context needs an estimated $minimum bytes of device memory ($freeBefore bytes free)")
        }
    }
    eprintln("serve: ${freeBefore / 1048576} MiB of device memory free; loading the model (context $context tokens)...")
    var model = inklingLoad(backend, file, config, context + SPEC_CONTEXT_SLACK) ?? return serveFail("loading the model failed (context $context): ${inklingLastError()} ${cudaLastDiagnostic()}; try a smaller --ctx")
    if (!model.reset(backend)) return serveFail("clearing the model state failed: ${cudaLastDiagnostic()}")
    var session = specSessionCreate(backend, model, draftFile, SPEC_DEFAULT_PROPOSALS, true) ?? return serveFail("setting up speculation failed: ${speculateLastError()} ${cudaLastDiagnostic()}; try a smaller --ctx")
    session.exactWindow = 192
    if (!serveWarmPrefill(backend, model, context)) return 1
    val listener = tcpListenAddress(ipv4SocketAddress("127.0.0.1", port), 16)
    if (listener.descriptor < 0 || !listener.setNonblocking()) return serveFail("cannot listen on 127.0.0.1:$port")
    val poller = socketPoller()
    if (poller.descriptor < 0 || !poller.watchDescriptor(listener.descriptor) || !poller.watchGracefulShutdown()) {
        return serveFail("cannot start the request poller")
    }
    val queue = ServeQueue(listener.descriptor, poller.descriptor)
    defer { queue.closePending() }
    val capture = if (capturePath == "") null else serveCaptureFile(capturePath)
    if (capture != null && capture.descriptor < 0) return serveFail("could not create a new request capture file at $capturePath")
    eprintln("serve: listening on http://127.0.0.1:$port (model '$modelName')")
    val counters = ServeCounters()
    counters.plainOnly = plainOnly
    val created = realtimeMilliseconds() / 1000
    while (!tcpShutdownRequested()) {
        queue.pump(if (queue.waiting.size == 0) 1000 else 0)
        if (queue.failed) return serveFail("the request poller failed")
        if (tcpShutdownRequested()) break
        val entry = queue.take()
        if (entry == null) continue
        if (batchLimit > 1 && capture == null) {
            val result = tryServeBatch(backend, model, entry, tokenizer, ids, stops, context, maxTokens, modelName, batchLimit, queue, counters)
            if (result < 0) return 1
            if (result > 0) continue
        }
        var connection = serveQueuedConnection(entry.descriptor)
        if (connection.descriptor < 0) continue
        val request = entry.request
        val path = request.path
        if (request.method == "OPTIONS") {
            connection.write("HTTP/1.1 204 No Content\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\nAccess-Control-Allow-Headers: *\r\nConnection: close\r\n\r\n")
            connection.close()
        } else if (request.method == "GET" && (path == "/v1/models" || path == "/models")) {
            serveWriteJson(connection, 200, serveModelsBody(modelName, created))
            connection.close()
        } else if (request.method == "GET" && (path == "/health" || path == "/")) {
            serveWriteJson(connection, 200, "{\"status\":\"ok\"}")
            connection.close()
        } else if (request.method == "POST" && (path == "/v1/chat/completions" || path == "/chat/completions")) {
            if (capture != null && !capture.write(jsonStringify(jsonObject(["body"], [jsonString(request.body)])) + "\n")) {
                serveWriteError(connection, 500, "request capture failed", "server_error", "")
                connection.close()
                return serveFail("writing the request capture failed")
            }
            val keepServing = serveChat(backend, model, session, connection, tokenizer, stops, ids, request.body, modelName, context, maxTokens, entry.session, counters, queue)
            connection.close()
            if (!keepServing) return 1
        } else {
            serveWriteError(connection, 404, "no such endpoint: ${request.method} $path", "invalid_request_error", "not_found")
            connection.close()
        }
    }
    0
}

// Load short and batched prefill kernels before accepting requests. The
// temporary workspace is released before listening. Each request sizes its own.
private fun serveWarmPrefill(var backend: Backend, var model: InklingModel, context: int): bool {
    val probe = specSeedWorkspace(backend, model.config)
    if (probe == null) {
        eprintln("serve: setting up prefill at context $context failed: ${inklingPrefillLastError()} (${cudaLastDiagnostic()}); use a smaller --ctx")
        return false
    }
    // Token zero is only a warmup input. Reset the convolution history
    // afterwards; the first request overwrites the old KV and tap entries.
    val batch: array<int> = []
    val rows = if (probe.chunk < 64) probe.chunk else 64
    for (i in 0 until rows) batch.append(0)
    if (!model.prefill(backend, probe, batch, 0) || (rows > 1 && !model.prefill(backend, probe, [0], 0)) ||
        !backend.synchronize()) {
        eprintln("serve: warming the prefill kernels failed: ${inklingPrefillLastError()} (${cudaLastDiagnostic()})")
        return false
    }
    if (!model.reset(backend)) {
        eprintln("serve: clearing the warmup state failed: ${cudaLastDiagnostic()}")
        return false
    }
    eprintln("serve: prefill chunk ${probe.chunk}, ${backend.freeMemory() / 1048576} MiB of device memory to spare")
    true
}
