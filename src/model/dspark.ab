// The Inkling 2 Mini DSpark drafter. Target taps enter only after verification commits them.
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../gguf/quant.ab"
import "../backend/backend.ab"
import "../gguf/reader.ab"
import "../ops.ab"
import "dspark_config.ab"
import "inkling.ab"
import "weights.ab"

private val dsparkBatchRows = 64
private val dsparkWidth = DSPARK_TAP_WIDTH
private val dsparkQuery = DSPARK_HEADS * DSPARK_HEAD_DIM
private val dsparkKv = DSPARK_KV_HEADS * DSPARK_HEAD_DIM
private val dsparkHiddenContext = (2 * DSPARK_RANK + dsparkWidth) * 4

private var dsparkError = ""

fun dsparkLastError(): string = dsparkError

private fun dsparkScratch(maxProposals: int): ScratchMap {
    val offsets: Map<string, int> = Map()
    var total = 0
    val widths = [dsparkWidth * DSPARK_BLOCK, dsparkWidth * dsparkBatchRows, dsparkQuery * DSPARK_BLOCK,
        dsparkKv * dsparkBatchRows, dsparkKv * dsparkBatchRows, DSPARK_FFN * DSPARK_BLOCK,
        DSPARK_FFN * DSPARK_BLOCK, 2 * (DSPARK_RANK + dsparkWidth), 3 * DSPARK_RANK, DSPARK_RANK,
        maxProposals * DSPARK_VOCAB, DSPARK_VOCAB, 1, 1]
    val names = ["x", "norm", "q", "k", "v", "gate", "up", "joint", "projected", "latent", "base", "delta", "id", "cursor"]
    for (i in 0 until names.size) {
        offsets.set(names[i], total)
        total = total + alignUp(widths[i] * 4)
    }
    ScratchMap(offsets, total)
}

resource class DsparkDrafter(
    val config: DsparkConfig,
    val plan: ArenaPlan,
    val layout: ScratchMap,
    val maxCtx: int,
    val maxProposals: int,
    val arena: DeviceBuffer,
    val scratch: DeviceBuffer,
    val kCache: DeviceBuffer,
    val vCache: DeviceBuffer,
    var committed: int = 0,
    var stepPrepared: bool = false
)

/** Uploads the unpadded drafter. maxCtx counts target positions. Host proposals support limits one through four. */
fun dsparkLoad(var backend: Backend, file: GgufFile, maxCtx: int, maxProposals: int = 2): DsparkDrafter? {
    dsparkError = ""
    val config = dsparkConfig(file)
    val names = if (config != null) dsparkTensorNames(file) else null
    if (config == null || names == null) {
        dsparkError = dsparkConfigLastError()
        return null
    }
    if (maxCtx < 1 || maxCtx > config.maxPositions || maxProposals < 1 || maxProposals > 4) {
        dsparkError = "invalid drafter context or proposal limit"
        return null
    }
    val plan = planWeights(file, names)
    val arena = if (plan != null) uploadWeights(backend, file, plan) else null
    if (plan == null || arena == null) {
        dsparkError = weightsLastError()
        return null
    }
    val layout = dsparkScratch(maxProposals)
    val cacheBytes = DSPARK_LAYERS * (maxCtx + DSPARK_BLOCK - 1) * dsparkKv * 4
    dsparkError = "allocating DSpark scratch or KV failed"
    val scratch = backend.allocate(layout.total) ?? return null
    val keys = backend.allocate(cacheBytes) ?? return null
    val values = backend.allocate(cacheBytes) ?? return null
    dsparkError = ""
    DsparkDrafter(config, plan, layout, maxCtx, maxProposals, move(arena), move(scratch), move(keys), move(values))
}

/** Makes the existing scratch and cache available for a new independent sequence. */
fun DsparkDrafter.reset(): void {
    this.committed = 0
    this.stepPrepared = false
}

private fun DsparkDrafter.o(name: string): int = this.layout.offsets.get(name) ?? 0
private fun DsparkDrafter.w(name: string): WeightRef = weightOf(this.plan, name)
private fun DsparkDrafter.cacheCtx(): int = this.maxCtx + DSPARK_BLOCK - 1
private fun DsparkDrafter.cacheOffset(layer: int): int = layer * this.cacheCtx() * dsparkKv * 4

private fun DsparkDrafter.dense(var backend: Backend, name: string, src: int, dst: int, rows: int): bool {
    val w = this.w(name)
    val kind = weightKind(w.type)
    if (rows == 1) return opMatvec(backend, kind, this.arena, w.offset, this.scratch, src, this.scratch, dst, w.rows, w.cols)
    if (rows <= 3 || rows == DSPARK_BLOCK) return this.projectRows(backend, this.arena, w, w.rows, src, dst, rows)
    backend.launch("matmul_$kind", kernelArgs().pointer(this.arena, w.offset).pointer(this.scratch, src).pointer(this.scratch, dst)
        .u32(w.rows).u32(w.cols).u32(rows), [w.rows, (rows + 63) / 64])
}

private fun DsparkDrafter.projectRows(var backend: Backend, arena: DeviceBuffer, w: WeightRef, outputs: int,
    src: int, dst: int, rows: int): bool {
    val kind = weightKind(w.type)
    if (w.type == GGML_TYPE_Q8_0 || w.type == GGML_TYPE_F32 || w.type == GGML_TYPE_BF16) {
        return backend.launch("matvec_${kind}_rows", kernelArgs().pointer(arena, w.offset).pointer(this.scratch, src)
            .pointer(this.scratch, dst).u32(outputs).u32(w.cols).u32(rows), [outputs])
    }
    // A compatible target can use another supported packing for its shared output.
    for (row in 0 until rows) {
        if (!opMatvec(backend, kind, arena, w.offset, this.scratch, src + row * w.cols * 4,
            this.scratch, dst + row * outputs * 4, outputs, w.cols)) return false
    }
    true
}

private fun DsparkDrafter.norm(var backend: Backend, name: string, src: int, dst: int, width: int, rows: int): bool =
    opRmsNorm(backend, this.scratch, src, this.arena, this.w(name).offset, this.scratch, dst, width, this.config.rmsEps, rows)

// DFlash uses NeoX (split-half) rotary pairs.
private fun DsparkDrafter.rope(var backend: Backend, offset: int, heads: int, pos: int): bool =
    opRope(backend, this.scratch, offset, this.arena, 0, false, heads, DSPARK_HEAD_DIM, DSPARK_HEAD_DIM, pos, this.config.ropeBase, 1)

private fun DsparkDrafter.storeKv(var backend: Backend, layer: int, first: int, rows: int): bool {
    val cache = this.cacheOffset(layer)
    val k = this.o("k")
    val v = this.o("v")
    for (row in 0 until rows) {
        val at = row * dsparkKv * 4
        if (!opKvStore(backend, this.scratch, k + at, this.scratch, v + at, this.kCache, cache, this.vCache, cache,
            first + row, DSPARK_KV_HEADS, DSPARK_HEAD_DIM, this.cacheCtx())) return false
    }
    true
}

private fun DsparkDrafter.mixTaps(var backend: Backend, taps: DeviceBuffer, offset: int, mix: string, norm: string, rows: int): bool {
    val dst = this.o("norm")
    backend.launch("dspark_mix", kernelArgs().pointer(taps, offset).pointer(this.arena, this.w(mix).offset)
        .pointer(this.scratch, dst).u32(dsparkWidth).u32(rows), [dsparkWidth * rows]) &&
        this.norm(backend, norm, dst, dst, dsparkWidth, rows)
}

private fun DsparkDrafter.inject(var backend: Backend, taps: DeviceBuffer, source: int, first: int, rows: int): bool {
    val k = this.o("k")
    for (layer in 0 until DSPARK_LAYERS) {
        val prefix = "blk.$layer"
        if (!this.mixTaps(backend, taps, source, "$prefix.ctx_mix.weight", "$prefix.ctx_norm.weight", rows) ||
            !this.dense(backend, "$prefix.attn_k_ctx.weight", this.o("norm"), k, rows) ||
            !this.dense(backend, "$prefix.attn_v_ctx.weight", this.o("norm"), this.o("v"), rows) ||
            !this.norm(backend, "$prefix.attn_k_ctx_norm.weight", k, k, DSPARK_HEAD_DIM, rows * DSPARK_KV_HEADS)) return false
        for (row in 0 until rows) {
            if (!this.rope(backend, k + row * dsparkKv * 4, DSPARK_KV_HEADS, first + row)) return false
        }
        if (!this.storeKv(backend, layer, first, rows)) return false
    }
    true
}

/** Appends a committed range. The source buffer starts at position zero with f32[position][4][2304]. */
fun DsparkDrafter.pushTaps(var backend: Backend, taps: DeviceBuffer, first: int, count: int): bool {
    dsparkError = ""
    if (first != this.committed || first < 0 || count < 0 || count > this.maxCtx - first ||
        first > taps.bytes / DSPARK_TAP_BYTES || count > taps.bytes / DSPARK_TAP_BYTES - first) {
        dsparkError = "DSpark taps must be a contiguous committed range inside the source buffer and drafter cache"
        return false
    }
    if (count == 0) return true
    var at = first
    val end = first + count
    while (at < end) {
        val rows = if (end - at < dsparkBatchRows) end - at else dsparkBatchRows
        if (!this.inject(backend, taps, at * DSPARK_TAP_BYTES, at, rows)) {
            dsparkError = "projecting DSpark context K/V at position $at failed"
            return false
        }
        at = at + rows
    }
    if (!this.mixTaps(backend, taps, (end - 1) * DSPARK_TAP_BYTES, "markov_ctx_mix.weight", "markov_ctx_norm.weight", 1) ||
        !opCopy(backend, this.scratch, this.o("norm"), this.scratch, this.o("joint") + dsparkHiddenContext, dsparkWidth)) {
        dsparkError = "projecting the DSpark Markov context failed"
        return false
    }
    this.committed = end
    true
}

/** Seeds the device cursor from the prefix already injected by pushTaps. Call outside recording. */
trusted fun DsparkDrafter.prepareStep(var backend: Backend): bool {
    val host = nativeByteBuffer(8)
    val address = nativePointerAddress(host.address)
    ablaUnsafeStoreU32(nativePointerFromAddress(address), this.committed)
    if (!backend.upload(this.scratch, this.o("cursor"), address, 4)) {
        dsparkError = "uploading the DSpark cursor failed"
        return false
    }
    this.stepPrepared = true
    true
}

/** Injects the missing committed taps through position p (exclusive) and seeds the next replay. Wait for in-flight replays first. */
trusted fun DsparkDrafter.resume(var backend: Backend, taps: DeviceBuffer, p: int): bool {
    dsparkError = ""
    if (p < 0 || p > this.maxCtx || p > taps.bytes / DSPARK_TAP_BYTES) {
        dsparkError = "the DSpark resume position is outside the tap buffer or drafter cache"
        return false
    }
    var first = this.committed
    if (this.stepPrepared) {
        val host = nativeByteBuffer(8)
        val address = nativePointerAddress(host.address)
        if (!backend.download(this.scratch, this.o("cursor"), address, 4)) {
            dsparkError = "downloading the DSpark cursor failed"
            return false
        }
        first = int(ablaUnsafeLoadU32(nativePointerFromAddress(address)))
    }
    if (first > p) {
        dsparkError = "cannot resume DSpark behind its committed prefix (cursor $first, position $p)"
        return false
    }
    this.committed = first
    this.pushTaps(backend, taps, first, p - first) && this.prepareStep(backend)
}

private fun DsparkDrafter.mixStep(var backend: Backend, taps: DeviceBuffer, step: DeviceBuffer,
    mix: string, norm: string, limit: int, capacity: int, lastOnly: bool): bool {
    val dst = this.o("norm")
    val rows = if (lastOnly) 1 else capacity
    backend.launch("dspark_mix_step", kernelArgs().pointer(taps).pointer(this.arena, this.w(mix).offset)
        .pointer(this.scratch, dst).pointer(step).pointer(this.scratch, this.o("cursor")).u32(dsparkWidth)
        .u32(limit).u32(capacity).u32(if (lastOnly) 1 else 0), [dsparkWidth * rows]) &&
        this.norm(backend, norm, dst, dst, dsparkWidth, rows)
}

private fun DsparkDrafter.rotateStep(var backend: Backend, offset: int, positions: DeviceBuffer, positionOffset: int,
    heads: int, rows: int): bool =
    backend.launch("dspark_rope_step", kernelArgs().pointer(this.scratch, offset).pointer(positions, positionOffset)
        .u32(heads).u32(DSPARK_HEAD_DIM).u32(rows).f32(this.config.ropeBase).u32(this.maxCtx),
        [heads * (DSPARK_HEAD_DIM / 2) * rows])

private fun DsparkDrafter.storeKvStep(var backend: Backend, layer: int, step: DeviceBuffer, limit: int, rows: int, block: bool): bool {
    val cache = this.cacheOffset(layer)
    backend.launch("dspark_kv_step", kernelArgs().pointer(this.scratch, this.o("k")).pointer(this.scratch, this.o("v"))
        .pointer(this.kCache, cache).pointer(this.vCache, cache).pointer(step).pointer(this.scratch, this.o("cursor"))
        .u32(DSPARK_HEAD_DIM).u32(dsparkKv).u32(this.cacheCtx()).u32(limit).u32(rows).u32(if (block) 1 else 0), [dsparkKv, rows])
}

/** Appends committed taps using the device cursor and step[1], step[3]. Layout v2 accepts a preceding cycle of up to five rows. */
fun DsparkDrafter.pushTapsStep(var backend: Backend, taps: DeviceBuffer, step: DeviceBuffer, layoutV2: bool = false): bool {
    if (step.bytes < 16 || taps.bytes < DSPARK_TAP_BYTES) return false
    val available = taps.bytes / DSPARK_TAP_BYTES
    val limit = if (available < this.maxCtx) available else this.maxCtx
    val rows = if (layoutV2) 5 else 3
    val k = this.o("k")
    val norm = this.o("norm")
    for (layer in 0 until DSPARK_LAYERS) {
        val prefix = "blk.$layer"
        if (!this.mixStep(backend, taps, step, "$prefix.ctx_mix.weight", "$prefix.ctx_norm.weight", limit, rows, false) ||
            !this.projectRows(backend, this.arena, this.w("$prefix.attn_k_ctx.weight"), dsparkKv, norm, k, rows) ||
            !this.projectRows(backend, this.arena, this.w("$prefix.attn_v_ctx.weight"), dsparkKv, norm, this.o("v"), rows) ||
            !this.norm(backend, "$prefix.attn_k_ctx_norm.weight", k, k, DSPARK_HEAD_DIM, rows * DSPARK_KV_HEADS) ||
            !this.rotateStep(backend, k, this.scratch, this.o("cursor"), DSPARK_KV_HEADS, rows) ||
            !this.storeKvStep(backend, layer, step, limit, rows, false)) return false
    }
    this.mixStep(backend, taps, step, "markov_ctx_mix.weight", "markov_ctx_norm.weight", limit, rows, true) &&
        backend.launch("dspark_commit_taps_step", kernelArgs().pointer(this.scratch, norm)
            .pointer(this.scratch, this.o("joint") + dsparkHiddenContext).pointer(step)
            .pointer(this.scratch, this.o("cursor")).u32(dsparkWidth).u32(limit).u32(rows), [1])
}

private fun DsparkDrafter.attention(var backend: Backend, layer: int, anchor: int, step: DeviceBuffer?): bool {
    val rows = DSPARK_BLOCK
    val q = this.o("q")
    val k = this.o("k")
    val norm = this.o("norm")
    val window = if (layer == 1) 0 else DSPARK_WINDOW
    val cache = this.cacheOffset(layer)
    val scale: f32 = 0.08838834764831845
    if (step != null) {
        return this.storeKvStep(backend, layer, step, this.maxCtx, rows, true) &&
            backend.launch("dspark_attention_step", kernelArgs().pointer(this.scratch, q).pointer(this.kCache, cache)
                .pointer(this.vCache, cache).pointer(this.scratch, norm).pointer(step).u32(DSPARK_HEADS)
                .u32(DSPARK_KV_HEADS).u32(DSPARK_HEAD_DIM).u32(rows).u32(this.cacheCtx()).u32(window).f32(scale),
                [DSPARK_HEADS, rows])
    }

    // All rows see the whole noise block, and the SWA cutoff is relative to its anchor.
    for (row in 0 until rows) {
        val pos = anchor + row
        if (!this.rope(backend, q + row * dsparkQuery * 4, DSPARK_HEADS, pos) ||
            !this.rope(backend, k + row * dsparkKv * 4, DSPARK_KV_HEADS, pos)) return false
    }
    if (!this.storeKv(backend, layer, anchor, rows)) return false
    val first = if (window > 0 && anchor >= window) anchor + 1 - window else 0
    val last = anchor + rows - 1
    for (row in 0 until rows) {
        val offset = row * dsparkQuery * 4
        if (!opAttentionDecode(backend, this.scratch, q + offset, this.kCache, cache, this.vCache, cache,
            this.scratch, norm + offset, DSPARK_HEADS, DSPARK_KV_HEADS, DSPARK_HEAD_DIM,
            first, last, this.cacheCtx(), scale)) return false
    }
    true
}

private fun DsparkDrafter.layer(var backend: Backend, layer: int, anchor: int, step: DeviceBuffer? = null): bool {
    val prefix = "blk.$layer"
    val x = this.o("x")
    val norm = this.o("norm")
    val q = this.o("q")
    val k = this.o("k")
    val v = this.o("v")
    val gate = this.o("gate")
    val up = this.o("up")
    val rows = DSPARK_BLOCK
    if (!this.norm(backend, "$prefix.attn_norm.weight", x, norm, dsparkWidth, rows) || !backend.fork(2)) return false
    var ok = this.dense(backend, "$prefix.attn_q.weight", norm, q, rows) &&
        this.norm(backend, "$prefix.attn_q_norm.weight", q, q, DSPARK_HEAD_DIM, rows * DSPARK_HEADS)
    if (step != null) ok = ok && this.rotateStep(backend, q, step, 4, DSPARK_HEADS, rows)
    ok = ok && backend.branch(1) && this.dense(backend, "$prefix.attn_k.weight", norm, k, rows) &&
        this.norm(backend, "$prefix.attn_k_norm.weight", k, k, DSPARK_HEAD_DIM, rows * DSPARK_KV_HEADS)
    if (step != null) ok = ok && this.rotateStep(backend, k, step, 4, DSPARK_KV_HEADS, rows)
    ok = ok && backend.branch(2) && this.dense(backend, "$prefix.attn_v.weight", norm, v, rows)
    if (!backend.join() || !ok) return false
    if (!this.attention(backend, layer, anchor, step)) return false
    val width = dsparkWidth * rows
    if (!this.dense(backend, "$prefix.attn_output.weight", norm, q, rows) ||
        !opAdd(backend, this.scratch, x, this.scratch, q, this.scratch, x, width) ||
        !this.norm(backend, "$prefix.ffn_norm.weight", x, norm, dsparkWidth, rows) || !backend.fork(1)) return false
    ok = this.dense(backend, "$prefix.ffn_gate.weight", norm, gate, rows) &&
        backend.branch(1) && this.dense(backend, "$prefix.ffn_up.weight", norm, up, rows)
    if (!backend.join() || !ok) return false
    opSiluMul(backend, this.scratch, gate, this.scratch, up, this.scratch, gate, DSPARK_FFN * rows) &&
        this.dense(backend, "$prefix.ffn_down.weight", gate, norm, rows) &&
        opAdd(backend, this.scratch, x, this.scratch, norm, this.scratch, x, width)
}

private fun DsparkDrafter.markovDelta(var backend: Backend, row: int, shortlist: bool = false): bool {
    val joint = this.o("joint")
    val projected = this.o("projected")
    val latent = this.o("latent")
    val delta = this.o("delta")
    val rank = DSPARK_RANK
    val hidden = this.o("x") + row * dsparkWidth * 4
    val ok = opCopy(backend, this.scratch, hidden, this.scratch, joint + 2 * rank * 4, dsparkWidth) &&
        this.dense(backend, "joint_proj.weight", joint, projected, 1) &&
        backend.launch("dspark_markov", kernelArgs().pointer(this.scratch, projected).pointer(this.arena, this.w("joint_proj.bias").offset)
            .pointer(this.scratch, joint).pointer(this.scratch, latent).u32(rank), [rank])
    if (shortlist) return ok
    ok && this.dense(backend, "markov_w2.weight", latent, delta, 1) &&
        opAdd(backend, this.scratch, delta, this.arena, this.w("markov_w2.bias").offset, this.scratch, delta, DSPARK_VOCAB)
}

private fun DsparkDrafter.pick(var backend: Backend, base: int, ids: DeviceBuffer, idOffset: int): bool =
    opAdd(backend, this.scratch, base, this.scratch, this.o("delta"), this.scratch, base, DSPARK_VOCAB) &&
        opSoftcap(backend, this.scratch, base, this.config.softcap, DSPARK_VOCAB) &&
        opArgmax(backend, this.scratch, base, DSPARK_VOCAB, ids, idOffset)

// Only the recorded path shortlists. Other supported W2 storage types retain the full projection.
private fun DsparkDrafter.pickRecorded(var backend: Backend, base: int, spec: DeviceBuffer, idOffset: int, shortlist: bool): bool {
    if (!shortlist) return this.pick(backend, base, spec, idOffset)
    val pairs = this.o("delta")
    val args = kernelArgs().pointer(this.scratch, base).pointer(this.scratch, this.o("latent"))
        .pointer(this.arena, this.w("markov_w2.weight").offset).pointer(this.arena, this.w("markov_w2.bias").offset)
        .pointer(this.scratch, pairs).u32(DSPARK_VOCAB).f32(this.config.softcap)
    return backend.launch("dspark_shortlist_four", args, [DSPARK_VOCAB]) &&
        backend.launch("dspark_best_pair", kernelArgs().pointer(this.scratch, pairs).pointer(spec, idOffset).u32((DSPARK_VOCAB + 127) / 128), [1])
}

private trusted fun DsparkDrafter.choose(var backend: Backend, target: InklingModel, output: WeightRef,
    prev: int, row: int, host: NativeByteBuffer): int {
    val embedding = this.w("markov_w1.weight")
    val out = this.o("id")
    val address = nativePointerAddress(host.address)
    if (!opGatherRow(backend, weightKind(embedding.type), this.arena, embedding.offset, prev, this.scratch,
        this.o("joint") + DSPARK_RANK * 4, DSPARK_RANK) ||
        !this.markovDelta(backend, row) ||
        !opMatvec(backend, weightKind(output.type), target.arena, output.offset, this.scratch,
            this.o("x") + row * dsparkWidth * 4, this.scratch, this.o("base"), DSPARK_VOCAB, dsparkWidth) ||
        !this.pick(backend, this.o("base"), this.scratch, out) ||
        !backend.download(this.scratch, out, address, 4)) return -1
    int(ablaUnsafeLoadU32(nativePointerFromAddress(address)))
}

private fun DsparkDrafter.maskRows(var backend: Backend): bool {
    val x = this.o("x")
    val mask = this.w("mask_embd.weight")
    for (row in 1 until DSPARK_BLOCK) {
        if (!opGatherRow(backend, weightKind(mask.type), this.arena, mask.offset, row - 1, this.scratch,
            x + row * dsparkWidth * 4, dsparkWidth)) return false
    }
    true
}

private fun DsparkDrafter.block(var backend: Backend, anchor: int, step: DeviceBuffer?): bool {
    for (layer in 0 until DSPARK_LAYERS) if (!this.layer(backend, layer, anchor, step)) return false
    val x = this.o("x")
    this.norm(backend, "output_norm.weight", x, x, dsparkWidth, DSPARK_BLOCK)
}

private fun DsparkDrafter.zeroMarkov(var backend: Backend): bool =
    backend.launch("dspark_zero", kernelArgs().pointer(this.scratch, this.o("joint")).u32(DSPARK_RANK), [DSPARK_RANK])

private fun dsparkTargetShape(target: InklingModel, embedding: WeightRef, output: WeightRef): bool =
    target.config.nVocab == DSPARK_VOCAB && target.config.nEmbd == dsparkWidth && target.visits == 48 &&
        embedding.cols == dsparkWidth && embedding.rows >= DSPARK_VOCAB &&
        output.cols == dsparkWidth && output.rows >= DSPARK_VOCAB

private fun DsparkDrafter.gatherStep(var backend: Backend, arena: DeviceBuffer, weight: WeightRef,
    ids: DeviceBuffer, idOffset: int, dst: int): bool {
    val args = kernelArgs().pointer(arena, weight.offset).pointer(ids, idOffset).pointer(this.scratch, dst).u32(weight.cols)
    if (weight.type == GGML_TYPE_Q8_0) return backend.launch("gather_row_q8_0_step", args, [weight.cols])
    if (weight.type != GGML_TYPE_F32 && weight.type != GGML_TYPE_BF16) return false
    backend.launch("dspark_gather_step", args.u32(if (weight.type == GGML_TYPE_BF16) 1 else 0), [weight.cols])
}

/** Records fixed-shape proposals. Layout v2 writes IDs in words 0..4 and count in word 5.
    A proposalLimit of zero uses the drafter's configured limit. */
fun DsparkDrafter.proposeStep(var backend: Backend, target: InklingModel, step: DeviceBuffer, spec: DeviceBuffer,
    layoutV2: bool = false, proposalLimit: int = 0): bool {
    val proposals = if (proposalLimit == 0) this.maxProposals else proposalLimit
    if (!layoutV2 && proposals > 2) {
        dsparkError = "recorded DSpark supports at most two proposals"
        return false
    }
    if (proposals < (if (layoutV2) 2 else 1) || proposals > this.maxProposals || proposals > 4) {
        dsparkError = "invalid DSpark recording proposal limit"
        return false
    }
    val embedding = weightOf(target.plan, "token_embd.weight")
    val output = weightOf(target.plan, "output.weight")
    val specBytes = if (layoutV2) 64 else 32
    val countIndex = if (layoutV2) 5 else 3
    if (step.bytes < 16 || spec.bytes < specBytes || !dsparkTargetShape(target, embedding, output)) return false
    val limit = if (this.maxCtx < target.maxCtx) this.maxCtx else target.maxCtx
    val x = this.o("x")
    if (!backend.launch("dspark_begin_step", kernelArgs().pointer(step).pointer(spec).pointer(this.scratch, this.o("cursor"))
            .u32(limit).u32(this.config.maxPositions - DSPARK_BLOCK).u32(DSPARK_VOCAB).u32(proposals).u32(countIndex), [1]) ||
        !backend.fork(1)) return false
    // Only the backbone needs the normalized anchor and mask rows. Start the Markov state and embedding independently.
    val markov = this.w("markov_w1.weight")
    val previous = this.o("joint") + DSPARK_RANK * 4
    var ok = this.gatherStep(backend, target.arena, embedding, spec, 0, x) &&
        this.norm(backend, "token_embd_norm.weight", x, x, dsparkWidth, 1) && this.maskRows(backend)
    ok = ok && backend.branch(1) && this.zeroMarkov(backend) &&
        this.gatherStep(backend, this.arena, markov, spec, 0, previous)
    if (!backend.join() || !ok || !this.block(backend, 0, step) || !backend.fork(1)) return false

    val shortlist = this.w("markov_w2.weight").type == GGML_TYPE_BF16
    // Project all base rows in one shared lm_head pass. Later corrections depend on the preceding sampled ID.
    val base = this.o("base")
    ok = this.projectRows(backend, target.arena, output, DSPARK_VOCAB, x + dsparkWidth * 4, base, proposals) &&
        backend.branch(1) && this.markovDelta(backend, 1, shortlist)
    if (!backend.join() || !ok || !this.pickRecorded(backend, base, spec, 4, shortlist)) return false
    for (row in 2 until proposals + 1) {
        if (!this.gatherStep(backend, this.arena, markov, spec, (row - 1) * 4, previous) ||
            !this.markovDelta(backend, row, shortlist) || !this.pickRecorded(backend, base + (row - 1) * DSPARK_VOCAB * 4, spec, row * 4, shortlist)) return false
    }
    backend.launch("dspark_pad_step", kernelArgs().pointer(spec).u32(countIndex), [1])
}

/** Returns up to the configured number of greedy proposals. ctxLen is the anchor position. */
fun DsparkDrafter.propose(var backend: Backend, target: InklingModel, ctxLen: int, anchorToken: int): array<int> {
    dsparkError = ""
    if (ctxLen != this.committed || ctxLen < 0 || ctxLen >= this.maxCtx || ctxLen >= target.maxCtx ||
        anchorToken < 0 || anchorToken >= DSPARK_VOCAB) {
        dsparkError = "incompatible Inkling target, anchor or committed prefix"
        return []
    }
    val capacity = if (this.maxCtx < target.maxCtx) this.maxCtx else target.maxCtx
    val remaining = capacity - ctxLen - 1
    if (ctxLen == 0 || remaining == 0 || ctxLen > this.config.maxPositions - DSPARK_BLOCK) return []
    val embedding = weightOf(target.plan, "token_embd.weight")
    val output = weightOf(target.plan, "output.weight")
    if (!dsparkTargetShape(target, embedding, output)) {
        dsparkError = "target embedding or output projection has an incompatible shape"
        return []
    }
    val x = this.o("x")
    if (!opGatherRow(backend, weightKind(embedding.type), target.arena, embedding.offset, anchorToken, this.scratch, x, dsparkWidth) ||
        !this.norm(backend, "token_embd_norm.weight", x, x, dsparkWidth, 1) ||
        !this.maskRows(backend) || !this.block(backend, ctxLen, null) || !this.zeroMarkov(backend)) {
        dsparkError = "preparing the DSpark draft block and Markov head failed"
        return []
    }

    val ids: array<int> = []
    val host = nativeByteBuffer(8)
    var prev = anchorToken
    val limit = if (remaining < this.maxProposals) remaining else this.maxProposals
    for (row in 1 until limit + 1) {
        val id = this.choose(backend, target, output, prev, row, host)
        if (id < 0 || id >= DSPARK_VOCAB) {
            dsparkError = "DSpark proposal $row failed"
            return []
        }
        ids.append(id)
        prev = id
    }
    ids
}
