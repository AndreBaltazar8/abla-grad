// A model's weights in one device arena, in their stored quantization: a plan (tensor name -> offset/shape/type) and the upload.
import "../backend/backend.ab"
import "../gguf/reader.ab"
import "../gguf/quant.ab"
import "../gguf/inkling_packing.ab"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "abla/text"

private var weightsError = ""

fun weightsLastError(): string = weightsError

// The kernel-name suffix of a weight storage type ("" when no kernel exists for it).
fun weightKind(type: int): string = when (type) {
    GGML_TYPE_F32 -> "f32"
    GGML_TYPE_BF16 -> "bf16"
    GGML_TYPE_Q8_0 -> "q8_0"
    GGML_TYPE_Q4_K -> "q4_k"
    GGML_TYPE_Q5_K -> "q5_k"
    GGML_TYPE_Q6_K -> "q6_k"
    GGML_TYPE_NVFP4 -> "nvfp4"
    else -> ""
}

// A tensor in the arena: byte offset, stored size, ggml type, and shape: `cols` = elements per row (dims[0]), `rows` = the product of the other dims.
class WeightRef(val offset: int, val bytes: int, val type: int, val rows: int, val cols: int)

// Debug/experiment: store the attention projections (Q8_0 in the GGUF) as Q6_K, converted on the device at load (docs/speed.md; decode-bench --q6k).
var weightsRequantQ6K = false

private fun requantTarget(name: string, info: GgufTensorInfo): bool =
    weightsRequantQ6K && info.type == GGML_TYPE_Q8_0 && info.dims.size == 2 && info.dims[0] % 256 == 0 &&
        (name.endsWith(".attn_q.weight") || name.endsWith(".attn_k.weight") || name.endsWith(".attn_v.weight") ||
         name.endsWith(".attn_output.weight") || name.endsWith(".attn_gate.weight"))

class ArenaPlan(val refs: Map<string, WeightRef>, val names: array<string>, val total: int)

fun alignUp(value: int): int = (value + 255) / 256 * 256

/** Offsets for `names` (each must exist in `file`), 256-byte aligned. */
fun planWeights(file: GgufFile, names: array<string>): ArenaPlan? {
    weightsError = ""
    val refs: Map<string, WeightRef> = Map()
    val inkling = file.getString("general.architecture") == "inkling2_loop"
    var at = 0
    for (name in names) {
        val info = file.tensor(name)
        if (info == null) {
            weightsError = "tensor $name is missing"
            return null
        }
        var rows = 1
        for (index in 1 until info.dims.size) rows = rows * info.dims[index]
        val requant = requantTarget(name, info)
        // Router and controller kernels consume FP32, including expert selection during prefill.
        val expand = inkling && info.dims.size == 2 && info.type == GGML_TYPE_BF16 && inklingPackableMatrix(name)
        if (expand && info.bytes > (9223372036854775807 - at - 255) / 2) return null
        val stored = if (expand) info.bytes * 2 else if (requant) rows * (info.dims[0] / 256) * 210 else info.bytes
        refs.set(name, WeightRef(at, stored, if (expand) GGML_TYPE_F32 else if (requant) GGML_TYPE_Q6_K else info.type, rows, info.dims[0]))
        at = at + alignUp(stored)
    }
    ArenaPlan(refs, names, at)
}

fun weightOf(plan: ArenaPlan, name: string): WeightRef = plan.refs.get(name) ?? WeightRef(0, 0, 0, 0, 0)

private trusted fun uploadBf16AsF32(var backend: Backend, arena: DeviceBuffer, offset: int, src: int, bytes: int): bool {
    val elements = bytes / 2
    val capacity = if (elements < 262144) elements else 262144
    val buffer = nativeByteBuffer(capacity * 4)
    val address = nativePointerAddress(buffer.address)
    var first = 0
    var ok = true
    while (ok && first < elements) {
        val left = elements - first
        val count = if (left < capacity) left else capacity
        for (i in 0 until count) {
            val word = ablaUnsafeLoadU16(nativePointerFromAddress(src + (first + i) * 2))
            ablaUnsafeStoreU32(nativePointerFromAddress(address + i * 4), word << 16)
        }
        ok = backend.upload(arena, offset + first * 4, address, count * 4)
        first = first + count
    }
    buffer.close()
    ok
}

/** Allocates the arena and copies every planned tensor from the mapped file. */
fun uploadWeights(var backend: Backend, file: GgufFile, plan: ArenaPlan): DeviceBuffer? {
    val arena = backend.allocate(plan.total)
    if (arena == null) {
        weightsError = "device memory for ${plan.total} bytes of weights is not available"
        return null
    }
    for (name in plan.names) {
        val info = file.tensor(name)
        val ref = plan.refs.get(name)
        if (info == null || ref == null) return null
        val address = file.tensorAddress(info)
        if (address == 0) {
            weightsError = "uploading $name failed"
            return null
        }
        if (ref.type == GGML_TYPE_Q6_K && info.type == GGML_TYPE_Q8_0) {
            // re-quantize to Q6_K on the device: the Q8_0 bytes go to a temporary buffer, a kernel writes the Q6_K blocks into the arena
            val temp = backend.allocate(info.bytes)
            val blocksPerRow = ref.cols / 256
            if (temp == null || !backend.upload(temp, 0, address, info.bytes) ||
                !backend.launch("requant_q8_to_q6k", kernelArgs().pointer(temp, 0).pointer(arena, ref.offset).u32(ref.rows).u32(blocksPerRow), [ref.rows * blocksPerRow]) ||
                !backend.synchronize()) {
                weightsError = "re-quantizing $name failed"
                return null
            }
        } else if (ref.type == GGML_TYPE_F32 && info.type == GGML_TYPE_BF16) {
            if (!uploadBf16AsF32(backend, arena, ref.offset, address, info.bytes)) {
                weightsError = "expanding BF16 weight $name failed"
                return null
            }
        } else if (!backend.upload(arena, ref.offset, address, info.bytes)) {
            weightsError = "uploading $name failed"
            return null
        }
    }
    arena
}
