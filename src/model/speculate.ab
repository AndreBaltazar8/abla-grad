import "inkling_config.ab"
// Greedy speculative decoding of an Inkling model with the DSpark drafter (docs/spec-cycle.md): one recorded graph per cycle (draft, 3-row verification,
// greedy acceptance, history commit) and, when `adaptive`, the plain decode graph whenever it is faster for the text at hand. Used by `generate` and
// `spec-check`. Greedy only: a proposal is accepted when it is the target's argmax, so the output is the plain greedy output up to numerical near-ties.
import "abla/process/time"
import "abla/array"
import "abla/io"
import "abla/float/text"
import "abla/float"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../backend/backend.ab"
import "../gguf/reader.ab"
import "../ops.ab"
import "inkling.ab"
import "inkling_prefill.ab"
import "dspark.ab"

private var speculateError = ""

fun speculateLastError(): string = if (speculateError != "") speculateError else dsparkLastError()

// Set by the caller (from the emit callback) to end the running turn after the current batch of tokens.
class SpecControl(var cancel: bool = false)

class SpecStats(
    var cycleTokens: int = 0, var plainTokens: int = 0, var cycles: int = 0, var switches: int = 0, var loopNanos: int = 0, var feedNanos: int = 0, var fedTokens: int = 0,
    // set when a stop token ended the turn (not the token limit, not a cancel)
    var stopped: bool = false, var generated: int = 0
)

// Extra positions the context needs beyond prompt + generated tokens (a batch of cycles can overshoot the last token by up to 3 rows each).
val SPEC_CONTEXT_SLACK = 40

// Proposals per cycle the product uses at most (2..4); the adaptive controller may use fewer.
val SPEC_DEFAULT_PROPOSALS = 2

private val SPEC_BATCH_CYCLES = 2          // while sweeping or probing; the steady state uses twice that
private val SPEC_BATCH_CYCLES_RUN = 3
private val SPEC_BATCH_TOKENS = 8
private val SPEC_BATCH_TOKENS_RUN = 16
// The drafter attends to at most this many recent taps (dspark_config: sliding window 1025); older prompt positions may come from the batched prefill.
private val SPEC_EXACT_WINDOW = 1025

private trusted fun specZero(var backend: Backend, spec: DeviceBuffer): bool {
    val host = nativeByteBuffer(136)
    val address = nativePointerAddress(host.address)
    for (i in 0 until 32) ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * i), 0)
    val ok = backend.upload(spec, 0, address, 128)
    host.close()
    ok
}

/** A speculative-decoding session over one model: the drafter, the verification workspace and the recorded graphs (plain decode and the cycles), plus the
 *  conversation so far. Turns can follow each other: the model's KV caches, convolution histories and taps stay, and a turn feeds only what is new.
 *  `seq` holds the tokens of positions 0 .. seq.size - 1 (the prompt and what was generated); `position` is how many of them the model has processed
 *  (state restored to the last batch boundary after a turn, so the tokens from there on are fed again at the start of the next turn). */
resource class SpecSession(
    var drafter: DsparkDrafter,
    val ws: PrefillWorkspace,
    val spec: DeviceBuffer,
    val snap: DeviceBuffer,
    val promptSnap: DeviceBuffer,
    val plain: Recording,
    val cycle2: Recording,
    val cycle3: Recording?,
    val cycle4: Recording?,
    val maxProposals: int,
    val seq: array<int> = [],
    var position: int = 0,
    // the length of the prompt of the last turn (positions < promptPos hold its state; promptSnap the convolution histories at that point)
    var promptPos: int = 0,
    val tc: array<f64> = [0.0, 0.0, 0.0, 0.0],
    var tp: f64 = 0.0,
    val hist: array<f64> = [],
    val histTick: array<int> = [0, 0, 0, 0],
    val deviceHist: array<int> = [0, 0, 0, 0, 0],
    var tick: int = 0,
    var sweepDone: bool = false,
    var sweepArm: int = 0,
    var lastArm: int = 0,
    var refreshEvery: int = 64,
    // feeds longer than this many tokens go through the batched prefill except for their last `exactWindow` tokens (step mode: exact taps for the drafter)
    var exactWindow: int = SPEC_EXACT_WINDOW
)

/** Creates a session: enables the taps, loads the drafter and records the graphs (nothing runs). The model must be reset. */
fun specSessionCreate(var backend: Backend, var model: InklingModel, draftFile: GgufFile, maxProposals: int): SpecSession? {
    speculateError = ""
    model.useStep = true
    if (!model.enableTaps(backend)) {
        speculateError = inklingLastError()
        return null
    }
    var drafter = dsparkLoad(backend, draftFile, model.maxCtx, maxProposals) ?? return null
    val ws = prefillWorkspace(backend, model.config, 5, true, 5)
    if (ws == null) {
        speculateError = inklingPrefillLastError()
        return null
    }
    val spec = backend.allocate(128)
    if (spec == null || !specZero(backend, spec)) {
        speculateError = "device memory for the speculation state is not available"
        return null
    }
    val snap = backend.allocate(model.history.bytes + 16)
    if (snap == null) {
        speculateError = "device memory for the history snapshot is not available"
        return null
    }
    // the graphs: kernels are loaded as the recording launches them; recording runs nothing
    val plain = model.capture(backend)
    if (plain == null) {
        speculateError = inklingLastError()
        return null
    }
    val cycle2 = recordCycle(backend, model, drafter, ws, spec, 2)
    val cycle3 = if (maxProposals >= 3) recordCycle(backend, model, drafter, ws, spec, 3) else null
    val cycle4 = if (maxProposals >= 4) recordCycle(backend, model, drafter, ws, spec, 4) else null
    if (cycle2 == null || (maxProposals >= 3 && cycle3 == null) || (maxProposals >= 4 && cycle4 == null)) {
        speculateError = "recording a cycle failed: ${dsparkLastError()} ${inklingLastError()}"
        return null
    }
    val promptSnap = backend.allocate(model.history.bytes + 16)
    if (promptSnap == null) {
        speculateError = "device memory for the prompt snapshot is not available"
        return null
    }
    val session = SpecSession(move(drafter), move(ws), move(spec), move(snap), move(promptSnap), move(plain), move(cycle2), move(cycle3), move(cycle4), maxProposals)
    for (i in 0 until 20) session.hist.append(0.0)
    session
}

/** Forgets the conversation (the model must be reset by the caller); the controller's measurements stay. */
fun SpecSession.restart(): void {
    this.seq.clear()
    this.position = 0
    this.promptPos = 0
}

/** Prepares the session for a conversation whose full token list is `tokens` (the prompt of a request): keeps the longest usable prefix of what the model
 *  already holds, resets the rest, and queues the remaining tokens (fed by the next `turn`). Returns the number of leading tokens that are reused (not fed
 *  again). The state is valid at `position` (the start of the last batch of the last turn) and at `promptPos` (the last prompt token's position): a request that
 *  shares at least that many leading tokens continues from the later of them; otherwise the model starts from zero. At least the last token is always fed.
 *  
 *  The caller keeps the model's context in mind: seq.size + maxTokens + SPEC_CONTEXT_SLACK <= model.maxCtx. */
fun SpecSession.reuse(var backend: Backend, var model: InklingModel, tokens: array<int>): int {
    var common = 0
    while (common < tokens.size && common < this.seq.size && tokens[common] == this.seq[common]) common = common + 1
    if (common > tokens.size - 1) common = tokens.size - 1
    if (common < 0) common = 0
    var kept = 0
    if (this.position > 0 && common >= this.position) {
        kept = this.position
    } else if (this.promptPos > 0 && common >= this.promptPos) {
        // back to the end of the last prompt: the convolution histories come from its snapshot
        val floats = model.history.bytes / 4
        if (backend.launch("copy_f32", kernelArgs().pointer(this.promptSnap).pointer(model.history).u32(floats), [floats]) && backend.synchronize()) {
            this.position = this.promptPos
            kept = this.promptPos
        }
    }
    if (kept == 0) {
        model.reset(backend)
        this.position = 0
        this.promptPos = 0
    }
    while (this.seq.size > kept) this.seq.removeLast()
    for (i in kept until tokens.size) this.seq.append(tokens[i])
    kept
}

/** Appends tokens to the conversation without generating them (fed at the start of the next turn). */
fun SpecSession.append(tokens: array<int>): void {
    for (token in tokens) this.seq.append(token)
}

/** Processes the tokens not yet in the model's state, then generates up to `maxTokens` greedy tokens (not including stop tokens), calling `emit` for each as
 *  soon as a batch commits it. The generated tokens (and the stop token, if one ended the turn) join `seq`. The model's context must hold seq.size + maxTokens
 *  + SPEC_CONTEXT_SLACK positions. With `adaptive` the controller chooses between the plain graph and the cycles; otherwise the top cycle arm runs. */
fun SpecSession.turn(
    var backend: Backend, var model: InklingModel, maxTokens: int, stops: array<int>, adaptive: bool, plainOnly: bool, control: SpecControl, var stats: SpecStats,
    var emit: FnMut(int) -> void
): bool {
    speculateError = ""
    val config = model.config
    val start = this.position
    val length = this.seq.size
    if (length == 0 || maxTokens <= 0 || model.maxCtx < length + maxTokens + SPEC_CONTEXT_SLACK) {
        speculateError = "the context must hold the conversation, the generated tokens and ${SPEC_CONTEXT_SLACK} positions of slack"
        return false
    }
    // the drafter forgets everything from `start` on (its taps are pushed again for the tokens fed below)
    val fed = monotonicNanoseconds()
    this.drafter.committed = start
    this.drafter.stepPrepared = false
    // feed: older positions through the batched prefill when there are many, the last SPEC_EXACT_WINDOW in step mode (exact taps)
    var seeded = start
    if (length - 1 - start > this.exactWindow) {
        val seedWs = specSeedWorkspace(backend, config)
        if (seedWs == null) {
            speculateError = inklingPrefillLastError()
            return false
        }
        val head: array<int> = []
        for (i in start until length - 1 - this.exactWindow) head.append(this.seq[i])
        if (!model.prefill(backend, seedWs, head, start)) {
            speculateError = inklingPrefillLastError()
            return false
        }
        seeded = start + head.size
    }
    for (p in seeded until length) {
        if (p == length - 1) {
            // the state before the last prompt token: a later request that shares the prompt continues from here (its last token is always fed again)
            val historyFloats = model.history.bytes / 4
            if (!backend.launch("copy_f32", kernelArgs().pointer(model.history).pointer(this.promptSnap).u32(historyFloats), [historyFloats])) {
                speculateError = "the prompt snapshot failed"
                return false
            }
            this.promptPos = length - 1
        }
        if (!model.forward(backend, this.seq[p], p)) {
            speculateError = inklingLastError()
            return false
        }
    }
    if (!opArgmax(backend, model.scratch, model.so("logits"), config.nVocab, model.step, 0) || !opStepAdvance(backend, model.step)) {
        speculateError = "the first token could not be chosen"
        return false
    }
    if (!this.drafter.pushTaps(backend, model.taps, start, length - start) || !this.drafter.prepareStep(backend) || !backend.synchronize()) {
        speculateError = dsparkLastError()
        return false
    }
    this.position = length
    stats.feedNanos = stats.feedNanos + (monotonicNanoseconds() - fed)
    stats.fedTokens = stats.fedTokens + (length - start)
    // the first generated token is the anchor chosen above (position `length`); later ones come from the token log (log[j] = the token at position j + 1)
    val anchor = model.readStepWord(backend, 0)
    if (anchor == null) {
        speculateError = inklingLastError()
        return false
    }
    var produced = 0
    this.seq.append(anchor)
    for (stop in stops) if (stop == anchor) {
        stats.stopped = true
        return true
    }
    emit(anchor)
    produced = 1
    stats.generated = 1
    if (control.cancel) return true
    var position = length
    var logged = length
    // Arms: 0 = the plain graph, 1 = cycle with 2 proposals, 2 = 3 proposals, 3 = 4 proposals. Without `adaptive` the top arm runs alone. The controller
    // scores every arm in tokens/s from two stable costs and one text-dependent quantity: seconds per plain token (tp) and per cycle of each arm (tc, they do
    // not depend on the text), and the tokens per cycle, which the device's histogram of accepted proposals gives: a cycle with n proposals accepts
    // min(a, n) of the proposals a cycle with more proposals would have accepted, so one histogram from the top arm prices every smaller arm.
    // Costs and histograms stay in the session: later turns start on the best arm without a sweep.
    val arms = if (this.maxProposals >= 4) 4 else if (this.maxProposals >= 3) 3 else 2
    val top = arms - 1
    var arm = if (plainOnly) 0 else if (!adaptive) top else if (this.sweepDone) this.lastArm else this.sweepArm
    var sweeping = adaptive && !plainOnly && !this.sweepDone
    var refreshing = false
    var batchesOnArm = 0
    var sinceRefresh = 0
    var armBeforeRefresh = 0
    val floats = model.history.bytes / 4
    val started = monotonicNanoseconds()
    var batchStart = position
    while (produced < maxTokens) {
        val before = position
        batchStart = position
        // the conversation can end inside this batch: the convolution histories are restored to this point afterwards
        if (!backend.launch("copy_f32", kernelArgs().pointer(model.history).pointer(this.snap).u32(floats), [floats])) {
            speculateError = "the history snapshot failed"
            return false
        }
        val warm = batchesOnArm == 0
        val small = sweeping || refreshing || warm
        val t0 = monotonicNanoseconds()
        var batchCycles = 0
        if (arm == 0) {
            if (!model.replayMany(backend, this.plain, specBound(if (small) SPEC_BATCH_TOKENS else SPEC_BATCH_TOKENS_RUN, maxTokens - produced))) {
                speculateError = inklingLastError()
                return false
            }
        } else {
            batchCycles = specBound(if (small) SPEC_BATCH_CYCLES else SPEC_BATCH_CYCLES_RUN, (maxTokens - produced + 2) / 3)
            for (b in 0 until batchCycles) {
                val replayed = if (arm == 1) backend.replay(this.cycle2) else if (arm == 2) replayOptional(backend, this.cycle3) else replayOptional(backend, this.cycle4)
                if (!replayed) {
                    speculateError = "replaying a cycle failed"
                    return false
                }
            }
            stats.cycles = stats.cycles + batchCycles
        }
        if (!backend.synchronize()) {
            speculateError = "the device failed while decoding"
            return false
        }
        val now = model.readStepWord(backend, 1)
        if (now == null) {
            speculateError = inklingLastError()
            return false
        }
        position = now
        // The final verify cycle can write up to n rejected slots past now.
        // Once one overwrites a key from the old prompt, reuse() must refill.
        val writtenEnd = now + (if (arm == 0) 0 else arm + 1)
        if (this.promptPos > 0 && !model.canRestoreKv(this.promptPos, writtenEnd)) {
            if (!model.canRestoreKv(this.promptPos, now)) this.promptPos = 0
            else {
                // Only the speculative tail straddles the boundary. The final cycle's
                // accepted length gives the exact highest slot that was written.
                val accepted = model.readStepWord(backend, 3)
                if (accepted == null || !model.canRestoreKv(this.promptPos, writtenEnd - accepted)) this.promptPos = 0
            }
        }
        val seconds = f64FromInt(monotonicNanoseconds() - t0) / 1000000000.0
        if (arm == 0) stats.plainTokens = stats.plainTokens + (position - before) else stats.cycleTokens = stats.cycleTokens + (position - before)
        // hand the new tokens to the caller: log[logged .. position)
        val fresh = model.readLog(backend, logged, position - logged)
        if (fresh == null) {
            speculateError = inklingLastError()
            return false
        }
        logged = position
        var ended = false
        for (token in fresh) {
            this.seq.append(token)
            var isStop = false
            for (stop in stops) if (stop == token) isStop = true
            if (isStop) {
                stats.stopped = true
                ended = true
                break
            }
            emit(token)
            produced = produced + 1
            stats.generated = produced
            if (control.cancel) {
                ended = true
                break
            }
            if (produced >= maxTokens) {
                ended = true
                break
            }
        }
        if (ended) {
            // the state is back at the start of this batch (convolution histories from the snapshot); the tokens from there on are fed again next turn
            if (!backend.launch("copy_f32", kernelArgs().pointer(this.snap).pointer(model.history).u32(floats), [floats]) || !backend.synchronize()) {
                speculateError = "restoring the history failed"
                return false
            }
            this.position = batchStart
            this.lastArm = arm
            this.sweepDone = adaptive && !plainOnly && !sweeping
            this.sweepArm = arm
            stats.loopNanos = stats.loopNanos + (monotonicNanoseconds() - started)
            return true
        }
        if (!adaptive || plainOnly) continue
        // learn: costs (not from the warm-up batch) and the accepted-proposal histogram
        this.tick = this.tick + 1
        if (arm == 0) {
            if (!warm && position > before) this.tp = if (this.tp == 0.0) seconds / f64FromInt(position - before) else 0.5 * this.tp + 0.5 * seconds / f64FromInt(position - before)
        } else {
            if (!warm && batchCycles > 0) this.tc[arm] = if (this.tc[arm] == 0.0) seconds / f64FromInt(batchCycles) else 0.5 * this.tc[arm] + 0.5 * seconds / f64FromInt(batchCycles)
            val words = model.readSpecHist(backend, this.spec)
            if (words == null) {
                speculateError = inklingLastError()
                return false
            }
            for (a in 0 until 5) {
                this.hist[arm * 5 + a] = this.hist[arm * 5 + a] * 0.97 + f64FromInt(words[a] - this.deviceHist[a])
                this.deviceHist[a] = words[a]
            }
            this.histTick[arm] = this.tick
        }
        batchesOnArm = batchesOnArm + 1
        // choose the next arm
        var next = arm
        sinceRefresh = sinceRefresh + (position - before)
        if (sweeping) {
            // plain and every cycle arm once (a warm-up batch and a measured one); the top arm runs longer to fill the histogram
            val need = if (arm == top) 6 else 2
            if (batchesOnArm >= need) {
                if (arm < top) {
                    next = arm + 1
                } else {
                    sweeping = false
                    next = specBest(arms, this.tp, this.tc, this.hist, this.histTick)
                    sinceRefresh = 0
                }
            }
        } else if (refreshing) {
            if (batchesOnArm >= 3) {
                refreshing = false
                next = specBest(arms, this.tp, this.tc, this.hist, this.histTick)
                // a refresh that changed nothing makes the next one rarer; one that changed the arm makes it sooner
                this.refreshEvery = if (next == armBeforeRefresh) (if (this.refreshEvery * 2 > 768) 768 else this.refreshEvery * 2) else 192
                sinceRefresh = 0
            }
        } else {
            val best = specBest(arms, this.tp, this.tc, this.hist, this.histTick)
            // hysteresis: leaving plain needs 5% more, leaving a cycle arm for plain 10% more, between cycle arms 8%
            val margin = if (arm == 0) 1.05 else if (best == 0) 1.10 else 1.08
            if (best != arm && batchesOnArm >= 3 &&
                specScore(best, this.tp, this.tc, this.hist, this.histTick) > specScore(arm, this.tp, this.tc, this.hist, this.histTick) * margin) next = best
            if (next == arm && sinceRefresh >= this.refreshEvery && arm != top) {
                armBeforeRefresh = arm
                // the histogram of the top arm is stale: run it for a few batches
                next = top
                refreshing = true
                sinceRefresh = 0
            }
        }
        if (next != arm) {
            if (arm == 0) {
                // back to a cycle graph: the drafter catches up on the plain tokens' taps
                if (!this.drafter.resume(backend, model.taps, position)) {
                    speculateError = dsparkLastError()
                    return false
                }
            }
            stats.switches = stats.switches + 1
            arm = next
            batchesOnArm = 0
        }
    }
    // the token budget ended exactly at the anchor (maxTokens 1): the state is the fed prompt
    this.lastArm = arm
    stats.loopNanos = stats.loopNanos + (monotonicNanoseconds() - started)
    true
}

/** One conversation turn in a new session: generates up to `maxTokens` greedy tokens after `prompt` (not including stop tokens). The model must be freshly reset
 *  and loaded with a context of at least prompt.size + maxTokens + SPEC_CONTEXT_SLACK. */
fun speculativeGenerate(
    var backend: Backend, var model: InklingModel, draftFile: GgufFile, prompt: array<int>, maxTokens: int, stops: array<int>,
    adaptive: bool, maxProposals: int, var stats: SpecStats, var emit: FnMut(int) -> void
): bool {
    var session = specSessionCreate(backend, model, draftFile, maxProposals) ?? return false
    session.append(prompt)
    session.turn(backend, model, maxTokens, stops, adaptive, false, SpecControl(), stats, emit)
}

// Tokens per second of an arm from the measured costs: plain 1 / tp; a cycle arm with n proposals yields 1 + sum_{j <= n} P(accepted >= j) tokens per cycle, with the
// probabilities from the freshest histogram of an arm with at least n proposals. 0 when something is not measured yet.
private fun specScore(arm: int, tp: f64, tc: array<f64>, hist: array<f64>, histTick: array<int>): f64 {
    if (arm == 0) return if (tp > 0.0) 1.0 / tp else 0.0
    if (tc[arm] <= 0.0) return 0.0
    var source = -1
    for (b in arm until 4) if (histTick[b] > 0 && (source < 0 || histTick[b] > histTick[source])) source = b
    if (source < 0) return 0.0
    var total = 0.0
    for (a in 0 until 5) total = total + hist[source * 5 + a]
    if (total < 6.0) return 0.0
    var tokens = 1.0
    for (j in 1 until arm + 2) {
        var atLeast = 0.0
        for (a in j until 5) atLeast = atLeast + hist[source * 5 + a]
        tokens = tokens + atLeast / total
    }
    tokens / tc[arm]
}

private fun specBest(arms: int, tp: f64, tc: array<f64>, hist: array<f64>, histTick: array<int>): int {
    var best = 0
    var bestScore = specScore(0, tp, tc, hist, histTick)
    for (a in 1 until arms) {
        val score = specScore(a, tp, tc, hist, histTick)
        if (score > bestScore * 1.02) {
            best = a
            bestScore = score
        }
    }
    best
}

// Records one speculation cycle with `n` proposals: drafter taps + proposals, an (n + 1)-row verification, greedy acceptance, history commit.
private fun recordCycle(
    var backend: Backend, var model: InklingModel, var drafter: DsparkDrafter, ws: PrefillWorkspace, spec: DeviceBuffer, n: int
): Recording? {
    if (!backend.beginRecording()) return null
    var ok = opSpecBegin(backend, model.step, spec)
    ok = ok && drafter.pushTapsStep(backend, model.taps, model.step, true)
    ok = ok && drafter.proposeStep(backend, model, model.step, spec, true, n)
    ok = ok && model.verifyStep(backend, ws, spec, model.step, n + 1, 2)
    ok = ok && opSpecAcceptN(backend, model.step, spec, model.maxCtx)
    ok = ok && model.commitStep(backend, ws, model.step)
    val recording = backend.endRecording()
    if (!ok) return null
    recording
}

// Long serving contexts keep target/drafter caches and graphs resident while seeding.
fun specSeedWorkspace(var backend: Backend, config: InklingConfig): PrefillWorkspace? {
    var chunk = 512
    while (chunk >= 1) {
        val workspace = prefillWorkspace(backend, config, chunk, false)
        if (workspace != null) return move(workspace)
        chunk = chunk / 2
    }
    null
}

private fun replayOptional(var backend: Backend, recording: Recording?): bool {
    if (recording == null) return false
    backend.replay(recording)
}

// A batch never runs further than the tokens still wanted need (a cycle yields about 3), but at least one replay.
private fun specBound(batch: int, wanted: int): int = if (wanted < 1) 1 else if (wanted < batch) wanted else batch
