import "../kernels/kv_layout.ab"
// Batched prefill for Inkling-2 (docs/prefill.md): `model.prefill(backend, ws, tokens, startPos, allLogits)` runs a chunk of prompt tokens through every
// layer visit at once (the graph of docs/inkling-graph.md with each op over [token][...]) and leaves the model's state ready for `forward`: the KV
// caches of positions startPos .. startPos + tokens - 1 and the short-convolution histories. Matrix products run on tensor cores (src/kernels/prefill_matmul.ab),
// the MoE experts as one matmul per expert over the tokens routed to it. The result is the logits of the last token (or of every token with `allLogits`).
import "abla/float"
import "abla/math"
import "abla/unsafe/memory"
import "abla/unsafe/memory/raw"
import "../backend/backend.ab"
import "../ops.ab"
import "../gguf/quant.ab"
import "../gguf/inkling_packing.ab"
import "inkling_config.ab"
import "weights.ab"
import "inkling.ab"

private var prefillError = ""

// Tokens per tile of the expert-grouped matmuls (64 or 32; the plan and the kernel must agree).
private var prefillMoeTile = 64

// NVFP4 experts through the register-direct kernel (64-token tiles only).
private var prefillRegisterDirect = false

// NVFP4 experts through the int8 kernels (activations quantized to Q8_1-style s8 with one f32 scale per 32 values; ablac-90's `matmul_nvfp4_grouped_i8`). On by default (--no-int8-experts selects the f16 experts).
private var prefillInt8Experts = true

fun setPrefillInt8Experts(on: bool): void {
    prefillInt8Experts = on
}

fun setPrefillRegisterDirect(on: bool): void {
    prefillRegisterDirect = on
}

// > 0 while `verify` runs: the convolution histories are left unchanged and the history after each of that many rows goes into the workspace's snapshots.
private var prefillVerifyRows = 0

// The most rows the R-row matvec kernels take (3 until the 4/5-row union kernels land); more rows use the tile kernels.
private val prefillRowsMax = 5

// false: the scalar attention kernel (f32 throughout), for A/B checks.
private var prefillTensorAttention = true

fun setPrefillTensorAttention(on: bool): void {
    prefillTensorAttention = on
}

fun setPrefillMoeTile(tile: int): void {
    prefillMoeTile = tile
}

fun inklingPrefillLastError(): string = prefillError

// Device memory of a chunk of at most `chunk` tokens: named f32 (or u32) arrays inside one buffer.
resource class PrefillWorkspace(
    val chunk: int,
    val allLogits: bool,
    val offsets: Map<string, int>,
    val buffer: DeviceBuffer,
    // [chunk][nLayer + 2][nEmbd] depth-mixing states (the block bank) and the looped core's bank, one set per token
    val blocks: DeviceBuffer,
    val bank: DeviceBuffer,
    // `verifyRows` snapshots of the whole convolution history (docs/prefill.md, verify); a one-byte buffer when verification is off
    val snapshots: DeviceBuffer,
    val verifyRows: int,
    val historyBytes: int
)

private fun wsAdd(var offsets: Map<string, int>, name: string, elements: int, at: int): int {
    offsets.set(name, at)
    at + alignUp(elements * 4)
}

fun prefillWorkspace(var backend: Backend, c: InklingConfig, chunk: int, allLogits: bool, verifyRows: int = 0): PrefillWorkspace? {
    prefillError = ""
    val offsets: Map<string, int> = Map()
    val n = c.nEmbd
    val qDim = c.nHead * c.headDim
    val kvDim = c.nHeadKv * c.headDim
    val pairs = chunk * c.nExpertUsed
    val maxTiles = pairs / 32 + c.nExpert
    var at = 0
    at = wsAdd(offsets, "tokenIds", chunk, at)
    at = wsAdd(offsets, "ctl", 4 + chunk / INKLING_KV_SEGMENT, at)
    at = wsAdd(offsets, "x", chunk * n, at)
    at = wsAdd(offsets, "inpSA", chunk * n, at)
    at = wsAdd(offsets, "inputs", 3 * chunk * n, at)
    at = wsAdd(offsets, "normed", 3 * chunk * n, at)
    at = wsAdd(offsets, "mixed", 3 * chunk * n, at)
    at = wsAdd(offsets, "q", chunk * qDim, at)
    at = wsAdd(offsets, "kRaw", chunk * kvDim, at)
    at = wsAdd(offsets, "vRaw", chunk * kvDim, at)
    at = wsAdd(offsets, "k", chunk * kvDim, at)
    at = wsAdd(offsets, "v", chunk * kvDim, at)
    at = wsAdd(offsets, "r", chunk * c.nRel * c.nHead, at)
    at = wsAdd(offsets, "kDyn", 8 * chunk * c.nConv * c.nHeadKv, at)
    at = wsAdd(offsets, "vDyn", 8 * chunk * c.nConv * c.nHeadKv, at)
    at = wsAdd(offsets, "sinks", 8 * chunk * c.nHead, at)
    at = wsAdd(offsets, "table", chunk * c.nHead * (c.extent + 1), at)
    at = wsAdd(offsets, "att", chunk * qDim, at)
    at = wsAdd(offsets, "gate", chunk * qDim, at)
    at = wsAdd(offsets, "oproj", chunk * n, at)
    at = wsAdd(offsets, "ffnInp", chunk * n, at)
    at = wsAdd(offsets, "moeLogits", 4 * chunk * c.nExpert, at)
    at = wsAdd(offsets, "ids", pairs, at)
    at = wsAdd(offsets, "weights", pairs, at)
    at = wsAdd(offsets, "sortedToken", pairs, at)
    at = wsAdd(offsets, "slotOfPair", pairs, at)
    at = wsAdd(offsets, "iota", pairs, at)
    at = wsAdd(offsets, "attPartO", 8 * chunk * c.nHead * 128, at)
    at = wsAdd(offsets, "attPartML", 8 * chunk * c.nHead * 2, at)
    // int8 activations of the expert matmuls (bytes, in float units): the gate/up input (one row per token) and the down input (one row per pair)
    at = wsAdd(offsets, "qxA", (chunk * c.nEmbd + 3) / 4, at)
    at = wsAdd(offsets, "sxA", chunk * (c.nEmbd / 32), at)
    at = wsAdd(offsets, "qxB", (pairs * c.nFfExp + 3) / 4, at)
    at = wsAdd(offsets, "sxB", pairs * (c.nFfExp / 32), at)
    at = wsAdd(offsets, "expertMap", 8 * 5 * c.nExpertUsed, at)
    at = wsAdd(offsets, "plan", c.nExpert + 2 + 2 * maxTiles, at)
    at = wsAdd(offsets, "gu", pairs * 2 * c.nFfExp, at)
    at = wsAdd(offsets, "act", pairs * c.nFfExp, at)
    at = wsAdd(offsets, "down", pairs * n, at)
    at = wsAdd(offsets, "moe", chunk * n, at)
    at = wsAdd(offsets, "msgs", chunk * 4 * n, at)
    // three lanes of controller scratch: the q, k and v controllers of a layer run as parallel branches in a recording
    for (lane in 0 until 3) {
        at = wsAdd(offsets, "ctrlIn$lane", chunk * 2 * n, at)
        at = wsAdd(offsets, "ctrlGate$lane", 8 * chunk * c.gateRank, at)
        at = wsAdd(offsets, "ctrlGain$lane", chunk * n, at)
        at = wsAdd(offsets, "ctrlForget$lane", chunk * n, at)
        at = wsAdd(offsets, "ctrlOut$lane", chunk * n, at)
        at = wsAdd(offsets, "tmpA$lane", chunk * n, at)
        at = wsAdd(offsets, "tmpB$lane", chunk * n, at)
    }
    at = wsAdd(offsets, "preludeOut", chunk * n, at)
    at = wsAdd(offsets, "bankOut", chunk * n, at)
    at = wsAdd(offsets, "logits", (if (allLogits) chunk else 1) * c.nVocabPadded, at)
    val buffer = backend.allocate(at)
    val blocks = backend.allocate(chunk * (c.nLayer + 2) * n * 4)
    val bank = backend.allocate(chunk * (c.nLayer + 2) * n * 4)
    if (buffer == null || blocks == null || bank == null) {
        prefillError = "device memory for the prefill workspace (chunk $chunk) is not available"
        return null
    }
    val historyBytes = inklingVisits(c) * (c.nConv - 1) * (2 * c.nHeadKv * c.headDim + 2 * n) * 4
    val snapshots = backend.allocate(if (verifyRows > 0) verifyRows * historyBytes else 256)
    if (snapshots == null) {
        prefillError = "device memory for the verification snapshots is not available"
        return null
    }
    val workspace = PrefillWorkspace(chunk, allLogits, offsets, move(buffer), move(blocks), move(bank), move(snapshots), verifyRows, historyBytes)
    // iota[i] = i: the identity row map of the down projection
    val host = nativeByteBuffer(pairs * 4 + 8)
    prefillStoreIota(host, pairs)
    val iotaOk = uploadFrom(backend, workspace.buffer, offsets.get("iota") ?? 0, host, pairs * 4)
    host.close()
    if (!iotaOk) {
        prefillError = "uploading the prefill workspace failed"
        return null
    }
    workspace
}

private trusted fun prefillStoreIota(host: NativeByteBuffer, count: int): void {
    val address = nativePointerAddress(host.address)
    for (i in 0 until count) ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * i), i)
}

private fun PrefillWorkspace.o(name: string): int = this.offsets.get(name) ?? 0

private fun InklingModel.wr(name: string): WeightRef = weightOf(this.plan, name)

private fun InklingModel.hasWeight(name: string): bool = this.plan.refs.get(name) != null

// One dense matrix product y[t][row] = sum_k w[row][k] * x[t][k] for `tokens` tokens of x at `xOffset` (bytes into the workspace buffer).
private fun InklingModel.dense(var backend: Backend, ws: PrefillWorkspace, name: string, xOffset: int, yOffset: int, tokens: int, exact: bool = false): bool {
    val ref = this.wr(name)
    val kind = weightKind(ref.type)
    val packedMatrix = kind == "bf16" && inklingPackableMatrix(name)
    var kernel = ""
    var problem: array<int> = []
    if (prefillVerifyRows > 0 && tokens <= 5 && kind == "bf16" && !packedMatrix && ref.rows <= 128 && ref.cols >= 1024) {
        return backend.launch("matvec_bf16_output", kernelArgs().pointer(this.arena, ref.offset).pointer(ws.buffer, xOffset).pointer(ws.buffer, yOffset)
            .u32(ref.rows).u32(ref.cols).u32(tokens), [ref.rows, tokens])
    }
    if (prefillVerifyRows > 0 && tokens <= prefillRowsMax && (kind == "q8_0" || kind == "f32" || packedMatrix)) {
        // the few rows of a verification: one weight read for all of them (e7's R-row matvecs, exact f32 arithmetic on the activations)
        return backend.launch("matvec_${kind}_rows", kernelArgs().pointer(this.arena, ref.offset).pointer(ws.buffer, xOffset).pointer(ws.buffer, yOffset)
            .u32(ref.rows).u32(ref.cols).u32(tokens), [ref.rows])
    }
    if (exact && (kind == "f32" || packedMatrix)) {
        var split = 4
        while (split > 1 && ref.cols / 32 % split != 0) split = split / 2
        val launched = backend.launch("matmul_${kind}_exact_split", kernelArgs().pointer(this.arena, ref.offset).pointer(ws.buffer, xOffset).pointer(ws.buffer, yOffset)
            .u32(ref.rows).u32(ref.cols).u32(tokens).u32(split), [ref.rows, (tokens + 15) / 16 * split])
        if (!launched) return false
        if (split == 1) return true
        return backend.launch("sum_slices", kernelArgs().pointer(ws.buffer, yOffset).u32(tokens * ref.rows).u32(split), [tokens * ref.rows])
    } else if ((kind == "f32" || kind == "bf16") && ref.rows <= 128 && ref.cols >= 1024 && (tokens >= 64 || prefillVerifyRows > 0)) {
        // few rows, long k: split k over blocks so the whole GPU works, then add the slices
        var split = 8
        while (split > 1 && ref.cols / 32 % split != 0) split = split / 2
        val tiles = (tokens + 63) / 64
        val launched = backend.launch("matmul_${kind}_split", kernelArgs().pointer(this.arena, ref.offset).pointer(ws.buffer, xOffset).pointer(ws.buffer, yOffset)
            .u32(ref.rows).u32(ref.cols).u32(tokens).u32(split), [ref.rows, tiles * split])
        if (!launched) return false
        if (split == 1) return true
        return backend.launch("sum_slices", kernelArgs().pointer(ws.buffer, yOffset).u32(tokens * ref.rows).u32(split), [tokens * ref.rows])
    } else if (kind == "q8_0" || kind == "nvfp4" || kind == "bf16" || kind == "f32") {
        kernel = "matmul_$kind"
        problem = [ref.rows, (tokens + 63) / 64]
    } else {
        prefillError = "no prefill matmul for ${ggmlTypeName(ref.type)} ($name)"
        return false
    }
    backend.launch(kernel, kernelArgs().pointer(this.arena, ref.offset).pointer(ws.buffer, xOffset).pointer(ws.buffer, yOffset)
        .u32(ref.rows).u32(ref.cols).u32(tokens), problem)
}

// q, k, v, rel and gate projections of a layer in one launch when all five are Q8_0 (else one launch each).
private fun InklingModel.denseX5(var backend: Backend, ws: PrefillWorkspace, ip: int, normedQ: int, normedK: int, normedV: int, q: int, kRaw: int, vRaw: int,
    r: int, gate: int, tokens: int): bool {
    val wq = this.wr("blk.$ip.attn_q.weight")
    val wk = this.wr("blk.$ip.attn_k.weight")
    val wv = this.wr("blk.$ip.attn_v.weight")
    val wrel = this.wr("blk.$ip.attn_rel.weight")
    val wg = this.wr("blk.$ip.attn_gate.weight")
    if (prefillVerifyRows > 0 || weightKind(wq.type) != "q8_0" || weightKind(wk.type) != "q8_0" || weightKind(wv.type) != "q8_0" || weightKind(wrel.type) != "q8_0" ||
        weightKind(wg.type) != "q8_0" || wq.cols != wk.cols || wq.cols != wv.cols || wq.cols != wrel.cols || wq.cols != wg.cols) {
        var ok = this.dense(backend, ws, "blk.$ip.attn_q.weight", normedQ, q, tokens)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_k.weight", normedK, kRaw, tokens)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_v.weight", normedV, vRaw, tokens)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_rel.weight", normedQ, r, tokens)
        return ok && this.dense(backend, ws, "blk.$ip.attn_gate.weight", normedQ, gate, tokens)
    }
    val tiles = (wq.rows + 127) / 128 + (wk.rows + 127) / 128 + (wv.rows + 127) / 128 + (wrel.rows + 127) / 128 + (wg.rows + 127) / 128
    var args = kernelArgs()
    args.pointer(this.arena, wq.offset)
    args.pointer(ws.buffer, normedQ)
    args.pointer(ws.buffer, q)
    args.u32(wq.rows)
    args.pointer(this.arena, wk.offset)
    args.pointer(ws.buffer, normedK)
    args.pointer(ws.buffer, kRaw)
    args.u32(wk.rows)
    args.pointer(this.arena, wv.offset)
    args.pointer(ws.buffer, normedV)
    args.pointer(ws.buffer, vRaw)
    args.u32(wv.rows)
    args.pointer(this.arena, wrel.offset)
    args.pointer(ws.buffer, normedQ)
    args.pointer(ws.buffer, r)
    args.u32(wrel.rows)
    args.pointer(this.arena, wg.offset)
    args.pointer(ws.buffer, normedQ)
    args.pointer(ws.buffer, gate)
    args.u32(wg.rows)
    args.u32(wq.cols)
    args.u32(tokens)
    return backend.launch("matmul_q8_0_x5", args, [tiles * 128, (tokens + 63) / 64])
}

// rmsnorm of `tokens` rows of n values with the weight tensor `name` (null weight: plain), in place allowed.
private fun InklingModel.normRows(var backend: Backend, ws: PrefillWorkspace, name: string, input: int, output: int, tokens: int): bool {
    val ref = this.wr(name)
    opRmsNorm(backend, ws.buffer, input, this.arena, ref.offset, ws.buffer, output, this.config.nEmbd, this.config.rmsEps, tokens)
}

private fun InklingModel.copyRows(var backend: Backend, src: DeviceBuffer, srcOffset: int, srcStride: int, dst: DeviceBuffer, dstOffset: int, dstStride: int,
    count: int, rows: int): bool =
    backend.launch("copy_rows", kernelArgs().pointer(src, srcOffset).u32(srcStride).pointer(dst, dstOffset).u32(dstStride).u32(count).u32(rows), [count, rows])

// Depth mixing for every token of the chunk: states = blocks[t][0 .. nBlocks) (or `bankBuffer`) + cur[t]; nQuery queries; out[t][q][n] at `output`.
private fun InklingModel.mixRows(var backend: Backend, ws: PrefillWorkspace, bankBuffer: DeviceBuffer, nBlocks: int, cur: int, queryName: string, nQuery: int,
    output: int, outStride: int, tokens: int): bool {
    val n = this.config.nEmbd
    val ref = this.wr(queryName)
    backend.launch("depth_mix_batch", kernelArgs().pointer(bankBuffer).u32((this.config.nLayer + 2) * n).u32(nBlocks).pointer(ws.buffer, cur).u32(n)
        .pointer(this.arena, ref.offset).u32(nQuery).pointer(ws.buffer, output).u32(outStride).u32(n).f32(0.000001).u32(tokens), [nQuery, tokens])
}

// control(cur, message) for every token (loop passes > 0): cur - tanh(forget) cur + tanh(gain) message with the gates of physical layer `ip`.
// `message` is token t's n values at messageBase + t * messageStride (floats), `cur` and `output` contiguous [t][n].
private fun InklingModel.controlRows(var backend: Backend, ws: PrefillWorkspace, ip: int, which: string, cur: int, curStride: int, messageBase: int, messageStride: int,
    output: int, tokens: int, lane: int = 0): bool {
    val n = this.config.nEmbd
    val down = this.wr("blk.$ip.loop_${which}_ctrl_down.weight")
    val gain = this.wr("blk.$ip.loop_${which}_ctrl_gain.weight")
    val forget = this.wr("blk.$ip.loop_${which}_ctrl_forget.weight")
    val ctrlIn = ws.o("ctrlIn$lane")
    // both vectors normalized (weightless) straight into the [t][2n] controller input: one launch, no row copies (the message is read in place, strided)
    var ok = backend.launch("ctrl_in_rows", kernelArgs().pointer(ws.buffer, cur).u32(curStride).pointer(ws.buffer, messageBase).u32(messageStride).pointer(ws.buffer, ctrlIn).u32(n).f32(0.000001), [tokens])
    val smallVerify = prefillVerifyRows > 0 && tokens <= 5
    if (smallVerify && down.rows == 64 && down.cols == 2 * n && (down.type == GGML_TYPE_F32 || down.type == GGML_TYPE_BF16)) {
        val args = kernelArgs().pointer(this.arena, down.offset).pointer(ws.buffer, ctrlIn).pointer(ws.buffer, ws.o("ctrlGate$lane"))
            .u32(down.rows).u32(down.cols).u32(tokens)
        ok = ok && backend.launch("matvec_${weightKind(down.type)}_output", args, [down.rows, tokens])
    } else {
        ok = ok && this.dense(backend, ws, "blk.$ip.loop_${which}_ctrl_down.weight", ctrlIn, ws.o("ctrlGate$lane"), tokens)
    }
    if (smallVerify && gain.cols == 64 && forget.cols == 64 && gain.rows == n && forget.rows == n &&
        gain.type == GGML_TYPE_F32 && forget.type == GGML_TYPE_F32) {
        val args = kernelArgs().pointer(this.arena, gain.offset).pointer(this.arena, forget.offset).pointer(ws.buffer, ws.o("ctrlGate$lane"))
            .pointer(ws.buffer, cur).u32(curStride).pointer(ws.buffer, messageBase).u32(messageStride).pointer(ws.buffer, output).u32(n).u32(tokens)
        return ok && backend.launch("controller_gain_forget_mix", args, [n])
    }
    ok = ok && this.dense(backend, ws, "blk.$ip.loop_${which}_ctrl_gain.weight", ws.o("ctrlGate$lane"), ws.o("ctrlGain$lane"), tokens)
    ok = ok && this.dense(backend, ws, "blk.$ip.loop_${which}_ctrl_forget.weight", ws.o("ctrlGate$lane"), ws.o("ctrlForget$lane"), tokens)
    ok && backend.launch("control_mix_rows", kernelArgs().pointer(ws.buffer, cur).u32(curStride).pointer(ws.buffer, messageBase).u32(messageStride).pointer(ws.buffer, ws.o("ctrlGain$lane"))
        .pointer(ws.buffer, ws.o("ctrlForget$lane")).pointer(ws.buffer, output).u32(n), [n, tokens])
}

// One layer visit for the whole chunk; returns the new block count or -1.
private fun InklingModel.layerRows(var backend: Backend, ws: PrefillWorkspace, ip: int, visit: int, loopPass: int, nBank: int, firstPos: int, posBuf: DeviceBuffer,
    posOff: int, tokens: int, nBlocks: int): int {
    val c = this.config
    val n = c.nEmbd
    val nb = n * 4
    val qDim = c.nHead * c.headDim
    val kvDim = c.nHeadKv * c.headDim
    val isSwa = !this.hasWeight("blk.$ip.attn_q_inp_norm.weight")
    val extent = if (isSwa) c.nSwa else c.extent
    // only the distances up to the last position of the chunk are ever read (d <= pos), so the table is filled up to there (the host knows firstPos in prefill)
    val relLimit = if (firstPos >= 0 && firstPos + tokens - 1 < extent) firstPos + tokens - 1 else extent
    val x = ws.o("x")
    val inpSA = ws.o("inpSA")
    val inputs = ws.o("inputs")
    val normed = ws.o("normed")
    val mixed = ws.o("mixed")
    val rowBytes = tokens * nb
    var blocks = nBlocks
    var ok = true
    if (this.tapsOn && (visit == 5 || visit == 23 || visit == 41)) {
        // the drafter's tap: the layer input of this visit, position-major [position][4][n]
        ok = backend.launch(if (this.rollingTaps) "tap_rows_tap_ring" else "tap_rows", kernelArgs().pointer(ws.buffer, x).pointer(this.taps).pointer(posBuf, posOff).u32(n).u32(if (visit == 5) 0 else if (visit == 23) 1 else 2).u32(4).u32(tokens), [n, tokens])
    }
    ok = ok && opCopy(backend, ws.buffer, x, ws.buffer, inpSA, tokens * n)

    // attention inputs. A sliding-window layer outside the loop's later passes feeds the same normalized vector to q, k, v: one mix row, one norm.
    val sharedInput = isSwa && loopPass == 0
    if (sharedInput) {
        var source = x
        if (ip > 0) {
            ok = ok && this.mixRows(backend, ws, ws.blocks, blocks, x, "blk.$ip.attn_res_query.weight", 1, mixed, n, tokens)
            source = mixed
        }
        ok = ok && this.normRows(backend, ws, "blk.$ip.attn_norm.weight", source, normed, tokens)
    } else {
        // the three rows (q, k, v) of every token live where the depth mix put them ([t][nq][n]) or in x; nothing is copied: the controllers (later loop passes)
        // read them in place and write [j][chunk][n] into `inputs`, and one launch normalizes all three
        var source = x
        var tokenStride = n
        var queryStride = 0
        if (ip > 0) {
            val nq = if (isSwa) 1 else 3
            ok = ok && this.mixRows(backend, ws, ws.blocks, blocks, x, "blk.$ip.attn_res_query.weight", nq, mixed, nq * n, tokens)
            source = mixed
            tokenStride = nq * n
            queryStride = if (isSwa) 0 else n
        }
        if (loopPass > 0) {
            ok = ok && backend.fork(2)
            var j = 0
            for (which in ["q", "k", "v"]) {
                ok = ok && backend.branch(j)
                ok = ok && this.controlRows(backend, ws, ip, which, source + j * queryStride * 4, tokenStride, ws.o("msgs") + j * nb, 4 * n,
                    inputs + j * ws.chunk * nb, tokens, j)
                j = j + 1
            }
            ok = ok && backend.join()
            source = inputs
            tokenStride = n
            queryStride = ws.chunk * n
        }
        val w0 = this.wr(if (isSwa) "blk.$ip.attn_norm.weight" else "blk.$ip.attn_q_inp_norm.weight")
        val w1 = this.wr(if (isSwa) "blk.$ip.attn_norm.weight" else "blk.$ip.attn_k_inp_norm.weight")
        val w2 = this.wr(if (isSwa) "blk.$ip.attn_norm.weight" else "blk.$ip.attn_v_inp_norm.weight")
        ok = ok && backend.launch("rmsnorm_three_rows", kernelArgs().pointer(ws.buffer, source).u32(tokenStride).u32(queryStride)
            .pointer(this.arena, w0.offset).pointer(this.arena, w1.offset).pointer(this.arena, w2.offset).pointer(ws.buffer, normed).u32(ws.chunk * n).u32(n)
            .f32(c.rmsEps), [tokens, 3])
    }
    val normedQ = normed
    val normedK = if (sharedInput) normed else normed + ws.chunk * nb
    val normedV = if (sharedInput) normed else normed + 2 * ws.chunk * nb
    if (!ok) return -1

    // projections
    val q = ws.o("q")
    val kRaw = ws.o("kRaw")
    val vRaw = ws.o("vRaw")
    val k = ws.o("k")
    val v = ws.o("v")
    val r = ws.o("r")
    val historyBytes = (c.nConv - 1) * (2 * kvDim + 2 * n) * 4
    val historyBase = visit * historyBytes
    val kHistory = historyBase
    val vHistory = historyBase + (c.nConv - 1) * kvDim * 4
    val aHistory = historyBase + (c.nConv - 1) * 2 * kvDim * 4
    val fHistory = aHistory + (c.nConv - 1) * n * 4
    val dynScale = f64ToF32(1.0 / sqrt(f64FromInt((if (isSwa) 1 else 2) * c.nConv + 1)))
    val plainScale = f64ToF32(1.0 / sqrt(f64FromInt(c.nConv + 1)))
    val kConv = this.wr("blk.$ip.attn_k_conv.weight")
    val vConv = this.wr("blk.$ip.attn_v_conv.weight")
    val qClip = this.wr("blk.$ip.attn_q_clip.weight")
    val relClip = this.wr("blk.$ip.attn_rel_clip.weight")
    val sinks = ws.o("sinks")
    val table = ws.o("table")
    val relBias = this.wr("blk.$ip.attn_rel_bias.weight")
    if (prefillVerifyRows > 0) {
        // verification (recorded): the chains q; k; v; the relative table with the sinks; the output gate only read the norm outputs, so they run as parallel branches
        ok = backend.fork(4)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_q.weight", normedQ, q, tokens)
        ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, q).pointer(this.arena, qClip.offset).pointer(ws.buffer, q)
            .u32(tokens * c.nHead).u32(c.headDim).f32(c.qkClip).u32(c.nHead), [tokens * c.nHead])
        ok = ok && backend.branch(1)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_k.weight", normedK, kRaw, tokens)
        if (!isSwa) ok = ok && this.dense(backend, ws, "blk.$ip.attn_k_conv_proj.weight", normedK, ws.o("kDyn"), tokens)
        ok = ok && this.convRows(backend, ws, kRaw, kHistory, kConv.offset, ws.o("kDyn"), !isSwa, k, kvDim, c.nHeadKv, dynScale, tokens)
        ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, k).u64(0).pointer(ws.buffer, k)
            .u32(tokens * c.nHeadKv).u32(c.headDim).f32(c.qkClip).u32(1), [tokens * c.nHeadKv])
        ok = ok && backend.branch(2)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_v.weight", normedV, vRaw, tokens)
        if (!isSwa) ok = ok && this.dense(backend, ws, "blk.$ip.attn_v_conv_proj.weight", normedV, ws.o("vDyn"), tokens)
        ok = ok && this.convRows(backend, ws, vRaw, vHistory, vConv.offset, ws.o("vDyn"), !isSwa, v, kvDim, c.nHeadKv, dynScale, tokens)
        ok = ok && opRmsNormPlain(backend, ws.buffer, v, ws.buffer, v, c.headDim, c.rmsEps, tokens * c.nHeadKv)
        ok = ok && backend.branch(3)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_rel.weight", normedQ, r, tokens)
        ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, r).pointer(this.arena, relClip.offset).pointer(ws.buffer, r)
            .u32(tokens * c.nHead).u32(c.nRel).f32(c.relClip).u32(c.nHead), [tokens * c.nHead])
        if (!isSwa) {
            ok = ok && backend.launch("scale_tau_rows", kernelArgs().pointer(ws.buffer, r).u32(c.nRel * c.nHead).pointer(posBuf, posOff).u32(c.logFloor).f32(c.logAlpha).u32(tokens),
                [c.nRel * c.nHead, tokens])
        }
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_sink_proj.weight", normedQ, sinks, tokens)
        ok = ok && backend.launch("rel_table_rows", kernelArgs().pointer(this.arena, relBias.offset).pointer(ws.buffer, r).pointer(ws.buffer, sinks)
            .pointer(ws.buffer, table).u32(c.nRel).u32(extent).u32(tokens * c.nHead), [relLimit + 1, tokens * c.nHead])
        ok = ok && backend.branch(4)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_gate.weight", normedQ, ws.o("gate"), tokens)
        ok = ok && backend.branch(0)
        if (!isSwa) {
            ok = ok && backend.launch("scale_tau_rows", kernelArgs().pointer(ws.buffer, q).u32(qDim).pointer(posBuf, posOff).u32(c.logFloor).f32(c.logAlpha).u32(tokens), [qDim, tokens])
        }
        ok = ok && backend.join()
    } else {
    ok = this.denseX5(backend, ws, ip, normedQ, normedK, normedV, q, kRaw, vRaw, r, ws.o("gate"), tokens)
    if (!isSwa) {
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_k_conv_proj.weight", normedK, ws.o("kDyn"), tokens)
        ok = ok && this.dense(backend, ws, "blk.$ip.attn_v_conv_proj.weight", normedV, ws.o("vDyn"), tokens)
    }
    if (!ok) return -1

    // short convolutions on K and V
    ok = this.convRows(backend, ws, kRaw, kHistory, kConv.offset, ws.o("kDyn"), !isSwa, k, kvDim, c.nHeadKv, dynScale, tokens)
    ok = ok && this.convRows(backend, ws, vRaw, vHistory, vConv.offset, ws.o("vDyn"), !isSwa, v, kvDim, c.nHeadKv, dynScale, tokens)

    // clip / normalize
    ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, q).pointer(this.arena, qClip.offset).pointer(ws.buffer, q)
        .u32(tokens * c.nHead).u32(c.headDim).f32(c.qkClip).u32(c.nHead), [tokens * c.nHead])
    ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, k).u64(0).pointer(ws.buffer, k)
        .u32(tokens * c.nHeadKv).u32(c.headDim).f32(c.qkClip).u32(1), [tokens * c.nHeadKv])
    ok = ok && opRmsNormPlain(backend, ws.buffer, v, ws.buffer, v, c.headDim, c.rmsEps, tokens * c.nHeadKv)
    ok = ok && backend.launch("l2clip_rows", kernelArgs().pointer(ws.buffer, r).pointer(this.arena, relClip.offset).pointer(ws.buffer, r)
        .u32(tokens * c.nHead).u32(c.nRel).f32(c.relClip).u32(c.nHead), [tokens * c.nHead])
    if (!isSwa) {
        ok = ok && backend.launch("scale_tau_rows", kernelArgs().pointer(ws.buffer, q).u32(qDim).pointer(posBuf, posOff).u32(c.logFloor).f32(c.logAlpha).u32(tokens), [qDim, tokens])
        ok = ok && backend.launch("scale_tau_rows", kernelArgs().pointer(ws.buffer, r).u32(c.nRel * c.nHead).pointer(posBuf, posOff).u32(c.logFloor).f32(c.logAlpha).u32(tokens),
            [c.nRel * c.nHead, tokens])
    }
    if (!ok) return -1

    // relative-position bias table (sinks folded in)
    ok = this.dense(backend, ws, "blk.$ip.attn_sink_proj.weight", normedQ, sinks, tokens)
    ok = ok && backend.launch("rel_table_rows", kernelArgs().pointer(this.arena, relBias.offset).pointer(ws.buffer, r).pointer(ws.buffer, sinks)
        .pointer(ws.buffer, table).u32(c.nRel).u32(extent).u32(tokens * c.nHead), [relLimit + 1, tokens * c.nHead])
    }
    if (!ok) return -1
    // KV store, attention
    val cache = this.cacheOffsets[visit]
    val ring = this.ringVisit(visit)
    val suffix = kvKernelSuffix(ring, this.kvElementBytes == 2, this.quantizedGlobalKv && !isSwa)
    val scale = f64ToF32(1.0 / sqrt(f64FromInt(c.headDim)))
    val att = ws.o("att")
    // Store one segment before computing its attention. Other operations still
    // see the caller's entire chunk; all query-tile boundaries are preserved.
    var start = 0
    while (ok && start < tokens) {
        val count = if (ring && tokens - start > INKLING_KV_SEGMENT) INKLING_KV_SEGMENT else tokens - start
        val segmentPosOffset = posOff + 4 * (start / INKLING_KV_SEGMENT)
        ok = ok && backend.launch("kv_store_batch_ptr" + suffix, kernelArgs().pointer(ws.buffer, k + start * kvDim * 4).pointer(ws.buffer, v + start * kvDim * 4).pointer(this.kCache, cache)
            .pointer(this.vCache, cache).pointer(posBuf, segmentPosOffset).u32(c.nHeadKv).u32(c.headDim).u32(this.maxCtx).u32(count), [kvDim, count])
        if (!prefillTensorAttention) {
            ok = ok && backend.launch("attention_prefill_rel" + suffix, kernelArgs().pointer(ws.buffer, q + start * qDim * 4).pointer(this.kCache, cache)
                .pointer(this.vCache, cache).pointer(ws.buffer, table + start * c.nHead * (extent + 1) * 4).pointer(ws.buffer, att + start * qDim * 4).u32(c.nHead).u32(c.nHeadKv).u32(c.headDim)
                .u32(if (isSwa) c.nSwa else 0).u32(firstPos + start).u32(extent).u32(this.maxCtx).f32(scale), [c.nHead, count])
        } else if (prefillVerifyRows > 0 && count <= 32) {
            // few rows, many keys: split the keys over 8 blocks per head and merge (with the sink)
            ok = ok && backend.launch("attention_prefill_tc_split" + suffix, kernelArgs().pointer(ws.buffer, q + start * qDim * 4).pointer(this.kCache, cache)
                .pointer(this.vCache, cache).pointer(ws.buffer, table + start * c.nHead * (extent + 1) * 4).pointer(ws.buffer, att + start * qDim * 4).u32(c.nHead).u32(c.nHeadKv)
                .u32(if (isSwa) c.nSwa else 0).pointer(posBuf, segmentPosOffset).u32(extent).u32(this.maxCtx).f32(scale).u32(count).u32(8)
                .pointer(ws.buffer, ws.o("attPartO")).pointer(ws.buffer, ws.o("attPartML")), [c.nHead, (count + 31) / 32 * 8])
            ok = ok && backend.launch("attention_prefill_merge", kernelArgs().pointer(ws.buffer, ws.o("attPartO")).pointer(ws.buffer, ws.o("attPartML"))
                .pointer(ws.buffer, att + start * qDim * 4).u32(c.nHead).u32(count).u32(8), [c.nHead, count])
        } else {
            ok = ok && backend.launch("attention_prefill_tc" + suffix, kernelArgs().pointer(ws.buffer, q + start * qDim * 4).pointer(this.kCache, cache)
                .pointer(this.vCache, cache).pointer(ws.buffer, table + start * c.nHead * (extent + 1) * 4).pointer(ws.buffer, att + start * qDim * 4).u32(c.nHead).u32(c.nHeadKv)
                .u32(if (isSwa) c.nSwa else 0).pointer(posBuf, segmentPosOffset).u32(extent).u32(this.maxCtx).f32(scale).u32(count), [c.nHead, (count + 31) / 32])
        }
        start = start + count
    }
    ok = ok && opSigmoidMul(backend, ws.buffer, att, ws.buffer, ws.o("gate"), ws.buffer, att, tokens * qDim)
    val oproj = ws.o("oproj")
    ok = ok && this.dense(backend, ws, "blk.$ip.attn_output.weight", att, oproj, tokens)
    val postConv = this.wr("blk.$ip.attn_post_conv.weight")
    ok = ok && this.convRows(backend, ws, oproj, aHistory, postConv.offset, 0, false, x, n, 1, plainScale, tokens)
    if (!ok) return -1

    // block residual
    if (ip % c.blockSize == 0) {
        ok = this.copyRows(backend, ws.buffer, inpSA, n, ws.blocks, blocks * nb, (c.nLayer + 2) * n, n, tokens)
        blocks = blocks + 1
    } else {
        ok = opAdd(backend, ws.buffer, inpSA, ws.buffer, x, ws.buffer, x, tokens * n)
    }
    val ffnInp = ws.o("ffnInp")
    ok = ok && opCopy(backend, ws.buffer, x, ws.buffer, ffnInp, tokens * n)

    // MoE
    ok = ok && this.mixRows(backend, ws, ws.blocks, blocks, x, "blk.$ip.ffn_res_query.weight", 1, x, n, tokens)
    if (loopPass > 0) {
        ok = ok && this.controlRows(backend, ws, ip, "ffn", x, n, ws.o("msgs") + 3 * nb, 4 * n, x, tokens)
    }
    ok = ok && this.normRows(backend, ws, "blk.$ip.ffn_norm.weight", x, x, tokens)
    if (!ok) return -1
    val pairs = tokens * c.nExpertUsed
    val ids = ws.o("ids")
    val weights = ws.o("weights")
    val sortedToken = ws.o("sortedToken")
    val slotOfPair = ws.o("slotOfPair")
    val plan = ws.o("plan")
    val bias = this.wr("blk.$ip.exp_probs_b.bias")
    ok = this.dense(backend, ws, "blk.$ip.ffn_gate_inp.weight", x, ws.o("moeLogits"), tokens, true)
    ok = ok && backend.launch("moe_route_batch", kernelArgs().pointer(ws.buffer, ws.o("moeLogits")).pointer(this.arena, bias.offset).u32(c.nExpert)
        .u32(c.nExpertUsed).pointer(ws.buffer, ids).pointer(ws.buffer, weights).f32(0.00000000000000000001).f32(c.expertScale).u32(tokens), [tokens])
    val guRef = this.wr("blk.$ip.ffn_gate_up_exps.weight")
    val downRef = this.wr("blk.$ip.ffn_down_exps.weight")
    val guKind = weightKind(guRef.type)
    val downKind = weightKind(downRef.type)
    val rowsKinds = (guKind == "nvfp4" || guKind == "q5_k" || guKind == "q8_0") && (downKind == "nvfp4" || downKind == "q5_k" || downKind == "q8_0")
    val rowsPath = prefillVerifyRows > 0 && tokens <= prefillRowsMax && rowsKinds
    if (rowsPath) {
        // verification: the experts of the few rows through the indexed R-row matvecs (one read of each distinct expert); pair p = row * k + slot keeps its place
        val capacity = tokens * c.nExpertUsed
        val guScalesRows = this.wr("blk.$ip.ffn_gate_up_exps.scale")
        val downScalesRows = this.wr("blk.$ip.ffn_down_exps.scale")
        val nFfRows = c.nFfExp
        ok = ok && backend.launch("moe_map_rows", kernelArgs().pointer(ws.buffer, ids).u32(tokens).u32(c.nExpertUsed).pointer(ws.buffer, ws.o("expertMap")).u32(capacity), [1])
        var guArgs = kernelArgs()
        guArgs.pointer(this.arena, guRef.offset)
        guArgs.pointer(ws.buffer, x)
        guArgs.pointer(ws.buffer, ws.o("gu"))
        guArgs.u32(2 * nFfRows)
        guArgs.u32(n)
        guArgs.u32(tokens)
        guArgs.pointer(ws.buffer, ws.o("expertMap"))
        guArgs.u32(capacity)
        guArgs.u64(ggmlRowBytes(guRef.type, guRef.cols) * 2 * nFfRows)
        guArgs.u32(c.nExpertUsed)
        guArgs.u32(n)
        guArgs.u32(0)
        val fiveRowShape = tokens == 5 && c.nExpertUsed == 8 && n == 2304 && nFfRows == 1152
        val guScaled = this.hasWeight("blk.$ip.ffn_gate_up_exps.scale")
        if (guScaled) guArgs.pointer(this.arena, guScalesRows.offset) else guArgs.u64(0)
        val guKernel = if (fiveRowShape && guScaled && guKind == "nvfp4" && x % 16 == 0) "matvec_nvfp4_inkling_five" else "matvec_${guKind}_indexed_rows"
        ok = ok && backend.launch(guKernel, guArgs, [2 * nFfRows, if (guKernel == "matvec_nvfp4_inkling_five") 20 else capacity])
        ok = ok && opSitu(backend, ws.buffer, ws.o("gu"), ws.buffer, ws.o("act"), pairs, nFfRows, c.situBeta, c.situLinear)
        var downArgs = kernelArgs()
        downArgs.pointer(this.arena, downRef.offset)
        downArgs.pointer(ws.buffer, ws.o("act"))
        downArgs.pointer(ws.buffer, ws.o("down"))
        downArgs.u32(n)
        downArgs.u32(nFfRows)
        downArgs.u32(tokens)
        downArgs.pointer(ws.buffer, ws.o("expertMap"))
        downArgs.u32(capacity)
        downArgs.u64(ggmlRowBytes(downRef.type, downRef.cols) * n)
        downArgs.u32(c.nExpertUsed)
        downArgs.u32(c.nExpertUsed * nFfRows)
        downArgs.u32(nFfRows)
        val downScaled = this.hasWeight("blk.$ip.ffn_down_exps.scale")
        if (downScaled) downArgs.pointer(this.arena, downScalesRows.offset) else downArgs.u64(0)
        val downKernel = if (fiveRowShape && downScaled && downKind == "nvfp4" && ws.o("act") % 16 == 0) "matvec_nvfp4_inkling_five" else "matvec_${downKind}_indexed_rows"
        ok = ok && backend.launch(downKernel, downArgs, [n, if (downKernel == "matvec_nvfp4_inkling_five") 20 else capacity])
        ok = ok && backend.launch("moe_combine_batch", kernelArgs().pointer(ws.buffer, ws.o("down")).pointer(ws.buffer, ws.o("iota")).pointer(ws.buffer, weights)
            .pointer(ws.buffer, ws.o("moe")).u32(n).u32(c.nExpertUsed).u32(tokens), [n, tokens])
    } else {
    ok = ok && backend.launch("moe_sort", kernelArgs().pointer(ws.buffer, ids).u32(pairs).u32(c.nExpertUsed).u32(c.nExpert).u32(prefillMoeTile).pointer(ws.buffer, sortedToken)
        .pointer(ws.buffer, slotOfPair).pointer(ws.buffer, plan), [1])
    if ((guKind != "nvfp4" && guKind != "q8_0" && guKind != "q5_k") || (downKind != "nvfp4" && downKind != "q8_0" && downKind != "q5_k")) {
        prefillError = "no grouped prefill matmul for the expert types ${ggmlTypeName(guRef.type)} / ${ggmlTypeName(downRef.type)}"
        return -1
    }
    val nFf = c.nFfExp
    val maxTiles = pairs / prefillMoeTile + c.nExpert
    val guScales = this.wr("blk.$ip.ffn_gate_up_exps.scale")
    val downScales = this.wr("blk.$ip.ffn_down_exps.scale")
    val guStride = ggmlRowBytes(guRef.type, guRef.cols) * 2 * nFf
    val downStride = ggmlRowBytes(downRef.type, downRef.cols) * n
    ok = ok && this.grouped(backend, ws, guKind, guRef.offset, x, sortedToken, ws.o("gu"), this.hasWeight("blk.$ip.ffn_gate_up_exps.scale"), guScales.offset, plan,
        2 * nFf, n, c.nExpert, guStride, maxTiles, tokens, "A")
    ok = ok && opSitu(backend, ws.buffer, ws.o("gu"), ws.buffer, ws.o("act"), pairs, nFf, c.situBeta, c.situLinear)
    ok = ok && this.grouped(backend, ws, downKind, downRef.offset, ws.o("act"), ws.o("iota"), ws.o("down"), this.hasWeight("blk.$ip.ffn_down_exps.scale"),
        downScales.offset, plan, n, nFf, c.nExpert, downStride, maxTiles, pairs, "B")
    ok = ok && backend.launch("moe_combine_batch", kernelArgs().pointer(ws.buffer, ws.o("down")).pointer(ws.buffer, slotOfPair).pointer(ws.buffer, weights)
        .pointer(ws.buffer, ws.o("moe")).u32(n).u32(c.nExpertUsed).u32(tokens), [n, tokens])
    }
    val ffnPost = this.wr("blk.$ip.ffn_post_conv.weight")
    ok = ok && this.convRows(backend, ws, ws.o("moe"), fHistory, ffnPost.offset, 0, false, x, n, 1, plainScale, tokens)
    ok = ok && opAdd(backend, ws.buffer, ffnInp, ws.buffer, x, ws.buffer, x, tokens * n)
    if (!ok) {
        prefillError = "a launch failed in layer $ip (visit $visit)"
        return -1
    }
    blocks
}

// conv_seq + conv_history for one convolution: `input` [t][channels] in the workspace, the history at `historyOffset` bytes in the model's history buffer,
// the taps at `wOffset` in the arena; `dynOffset` the dynamic taps (workspace) when `dynamic`; the result at `output`.
private fun InklingModel.convRows(var backend: Backend, ws: PrefillWorkspace, input: int, historyOffset: int, wOffset: int, dynOffset: int, dynamic: bool,
    output: int, channels: int, heads: int, outScale: f32, tokens: int): bool {
    val c = this.config
    var args = kernelArgs().pointer(ws.buffer, input).pointer(this.history, historyOffset).pointer(this.arena, wOffset)
    if (dynamic) args.pointer(ws.buffer, dynOffset) else args.u64(0)
    args.pointer(ws.buffer, output)
    args.u32(channels)
    args.u32(c.nConv)
    args.u32(heads)
    args.f32(outScale)
    args.u32(tokens)
    if (prefillVerifyRows > 0 && c.nConv == 4) {
        args.pointer(ws.snapshots, historyOffset)
        args.u32(ws.historyBytes / 4)
        return backend.launch("conv_verify_four", args, [channels, tokens])
    }
    if (!backend.launch("conv_seq", args, [channels, tokens])) return false
    if (prefillVerifyRows > 0) {
        return backend.launch("conv_history_rows", kernelArgs().pointer(ws.buffer, input).pointer(this.history, historyOffset).pointer(ws.snapshots, historyOffset)
            .u32(channels).u32(c.nConv).u32(tokens).u32(ws.historyBytes / 4), [channels])
    }
    backend.launch("conv_history", kernelArgs().pointer(ws.buffer, input).pointer(this.history, historyOffset).u32(channels).u32(c.nConv).u32(tokens), [channels])
}

private fun InklingModel.grouped(var backend: Backend, ws: PrefillWorkspace, kind: string, wOffset: int, x: int, xmap: int, y: int, useScales: bool, scalesOffset: int,
    plan: int, rows: int, cols: int, nExpert: int, stride: int, maxTiles: int, xRows: int = 0, quantName: string = "A"): bool {
    if (kind == "nvfp4" && prefillInt8Experts && prefillMoeTile == 64 && xRows > 0 && cols % 32 == 0) {
        // int8: quantize the f32 rows once (the kernel gathers rows through xmap), then the s8 grouped matmul
        val qx = ws.o("qx" + quantName)
        val sx = ws.o("sx" + quantName)
        if (!backend.launch("quantize_rows_i8", kernelArgs().pointer(ws.buffer, x).pointer(ws.buffer, qx).pointer(ws.buffer, sx).u32(xRows).u32(cols), [cols / 4, xRows])) return false
        var iargs = kernelArgs().pointer(this.arena, wOffset).pointer(ws.buffer, qx).pointer(ws.buffer, xmap).pointer(ws.buffer, y)
        if (useScales) iargs.pointer(this.arena, scalesOffset) else iargs.u64(0)
        iargs.pointer(ws.buffer, plan)
        iargs.u32(rows)
        iargs.u32(cols)
        iargs.u32(nExpert)
        iargs.u64(stride)
        iargs.pointer(ws.buffer, sx)
        return backend.launch("matmul_nvfp4_grouped_i8", iargs, [rows, maxTiles])
    }
    var args = kernelArgs().pointer(this.arena, wOffset).pointer(ws.buffer, x).pointer(ws.buffer, xmap).pointer(ws.buffer, y)
    if (useScales) args.pointer(this.arena, scalesOffset) else args.u64(0)
    args.pointer(ws.buffer, plan)
    args.u32(rows)
    args.u32(cols)
    args.u32(nExpert)
    args.u64(stride)
    backend.launch(if (kind == "nvfp4" && prefillRegisterDirect && prefillMoeTile == 64) "matmul_nvfp4_grouped_rd" else "matmul_${kind}_grouped${if (prefillMoeTile == 32) "32" else ""}", args, [rows, maxTiles])
}

// Runs `tokens` prompt tokens (positions startPos ..) through the model in chunks of at most ws.chunk. Afterwards the KV caches and convolution histories
// hold them; the logits of the last token are in `ws` (row 0 of "logits" without allLogits, else row t of the last chunk) and readable with `readPrefillLogits`.
fun InklingModel.prefill(var backend: Backend, ws: PrefillWorkspace, tokenIds: array<int>, startPos: int): bool {
    prefillError = ""
    var done = 0
    while (done < tokenIds.size) {
        val count = if (tokenIds.size - done < ws.chunk) tokenIds.size - done else ws.chunk
        if (!this.uploadChunk(backend, ws, tokenIds, done, count, startPos + done)) {
            prefillError = "uploading the token ids failed"
            return false
        }
        if (!this.prefillChunk(backend, ws, count, startPos + done, done + count == tokenIds.size, ws.buffer, ws.o("tokenIds"), ws.buffer, ws.o("ctl"))) return false
        done = done + count
    }
    true
}

// Uploads the ids of `count` tokens and the position of the first one (the kernels read both from device memory, so a recording can replace them).
private trusted fun InklingModel.uploadChunk(var backend: Backend, ws: PrefillWorkspace, tokenIds: array<int>, from: int, count: int, firstPos: int): bool {
    val host = nativeByteBuffer(count * 4 + 8)
    val address = nativePointerAddress(host.address)
    for (i in 0 until count) ablaUnsafeStoreU32(nativePointerFromAddress(address + 4 * i), tokenIds[from + i])
    var ok = backend.upload(ws.buffer, ws.o("tokenIds"), address, count * 4)
    val segments = (count + INKLING_KV_SEGMENT - 1) / INKLING_KV_SEGMENT
    for (segment in 0 until segments) ablaUnsafeStoreU32(nativePointerFromAddress(address + segment * 4), firstPos + segment * INKLING_KV_SEGMENT)
    ok = ok && backend.upload(ws.buffer, ws.o("ctl"), address, segments * 4)
    host.close()
    ok
}

// `firstPos` is the host's knowledge of the first position (-1 when only the device knows it: recorded cycles); the kernels read it from posBuf at posOff,
// the token ids from idsBuf at idsOff.
private fun InklingModel.prefillChunk(var backend: Backend, ws: PrefillWorkspace, tokens: int, firstPos: int, last: bool, idsBuf: DeviceBuffer, idsOff: int,
    posBuf: DeviceBuffer, posOff: int): bool {
    val c = this.config
    val n = c.nEmbd
    val nb = n * 4
    if (firstPos >= 0 && firstPos + tokens > this.maxCtx) {
        prefillError = "positions $firstPos .. ${firstPos + tokens - 1} are outside the cache of ${this.maxCtx}"
        return false
    }
    val embd = this.wr("token_embd.weight")
    if (weightKind(embd.type) != "q8_0") {
        prefillError = "the prefill embedding supports Q8_0 only, not ${ggmlTypeName(embd.type)}"
        return false
    }
    val x = ws.o("x")
    var ok = backend.launch("gather_rows_q8_0", kernelArgs().pointer(this.arena, embd.offset).pointer(idsBuf, idsOff).pointer(ws.buffer, x)
        .u32(n).u32(tokens), [n, tokens])
    ok = ok && this.normRows(backend, ws, "token_embd_norm.weight", x, x, tokens)
    if (!ok) {
        prefillError = "the embedding failed"
        return false
    }
    var blocks = 0
    var visit = 0
    val loopStart = if (c.looped) c.loopStart else c.nLayer
    val loopEnd = if (c.looped) c.loopEnd else c.nLayer
    for (ip in 0 until loopStart) {
        blocks = this.layerRows(backend, ws, ip, visit, 0, 0, firstPos, posBuf, posOff, tokens, blocks)
        visit = visit + 1
        if (blocks < 0) return false
    }
    if (c.looped) {
        val preludeBlocks = blocks
        ok = opCopy(backend, ws.buffer, x, ws.buffer, ws.o("preludeOut"), tokens * n)
        var nBank = 0
        for (pass in 0 until c.loopCount) {
            if (pass > 0) {
                nBank = blocks - preludeBlocks - 1
                ok = ok && opCopy(backend, ws.buffer, x, ws.buffer, ws.o("bankOut"), tokens * n)
                if (nBank > 0) ok = ok && this.copyRows(backend, ws.blocks, (preludeBlocks + 1) * nb, (c.nLayer + 2) * n, ws.bank, 0, (c.nLayer + 2) * n, nBank * n, tokens)
                ok = ok && opCopy(backend, ws.buffer, ws.o("preludeOut"), ws.buffer, x, tokens * n)
                blocks = preludeBlocks
            }
            for (ip in loopStart until loopEnd) {
                if (pass > 0) {
                    ok = ok && this.mixRows(backend, ws, ws.bank, nBank, ws.o("bankOut"), "blk.$ip.loop_msg_query.weight", 4, ws.o("msgs"), 4 * n, tokens)
                    if (!ok) {
                        prefillError = "the loop messages failed in layer $ip"
                        return false
                    }
                }
                blocks = this.layerRows(backend, ws, ip, visit, pass, nBank, firstPos, posBuf, posOff, tokens, blocks)
                visit = visit + 1
                if (blocks < 0) return false
            }
        }
    }
    for (ip in loopEnd until c.nLayer) {
        blocks = this.layerRows(backend, ws, ip, visit, 0, 0, firstPos, posBuf, posOff, tokens, blocks)
        visit = visit + 1
        if (blocks < 0) return false
    }
    // output: only chunks that end the prompt need logits (every chunk with allLogits); with taps on, every chunk needs the final norm output for its positions
    val withLogits = last || ws.allLogits
    if (!withLogits && !this.tapsOn) return true
    ok = this.mixRows(backend, ws, ws.blocks, blocks, x, "output_res_query.weight", 1, x, n, tokens)
    ok = ok && this.normRows(backend, ws, "output_norm.weight", x, x, tokens)
    if (this.tapsOn) ok = ok && backend.launch(if (this.rollingTaps) "tap_rows_tap_ring" else "tap_rows", kernelArgs().pointer(ws.buffer, x).pointer(this.taps).pointer(posBuf, posOff).u32(n).u32(3).u32(4).u32(tokens), [n, tokens])
    if (!withLogits) return ok
    val output = this.wr("output.weight")
    val outputKind = weightKind(output.type)
    if (outputKind != "q8_0") {
        prefillError = "the prefill output projection supports Q8_0 only, not ${ggmlTypeName(output.type)}"
        return false
    }
    val rowsOut = if (ws.allLogits) tokens else 1
    val xRows = if (ws.allLogits) x else x + (tokens - 1) * nb
    if (prefillVerifyRows > 0 && rowsOut <= prefillRowsMax) {
        ok = ok && this.dense(backend, ws, "output.weight", xRows, ws.o("logits"), rowsOut)
    } else {
        ok = ok && backend.launch("matmul_q8_0", kernelArgs().pointer(this.arena, output.offset).pointer(ws.buffer, xRows).pointer(ws.buffer, ws.o("logits"))
        .u32(output.rows).u32(output.cols).u32(rowsOut), [output.rows, (rowsOut + 63) / 64])
    }
    if (c.softcap != 0.0) ok = ok && opSoftcap(backend, ws.buffer, ws.o("logits"), c.softcap, rowsOut * c.nVocabPadded)
    if (!ok) prefillError = "the output projection failed"
    ok
}

// The logits of row `row` of the last chunk (0 unless the workspace keeps all logits), real vocabulary only.
trusted fun InklingModel.readPrefillLogits(var backend: Backend, ws: PrefillWorkspace, row: int): array<f32>? {
    val count = this.config.nVocab
    val bytes = count * 4
    val host = nativeByteBuffer(bytes + 8)
    if (!backend.download(ws.buffer, ws.o("logits") + row * this.config.nVocabPadded * 4, nativePointerAddress(host.address), bytes)) {
        prefillError = "downloading the logits failed"
        host.close()
        return null
    }
    val address = nativePointerAddress(host.address)
    val logits: array<f32> = []
    for (index in 0 until count) logits.append(f32FromBits(u32(ablaUnsafeLoadU32(nativePointerFromAddress(address + 4 * index)))))
    host.close()
    logits
}

// Speculative-decoding verification: runs `ids` (1 .. ws.verifyRows tokens: the anchor and the proposals) as one causal batch from `startPos`, leaves the logits of each
// row in the workspace ("logits" row k, readable with `readPrefillLogits(ws, k)`; `verifyArgmax` gives the argmax of every row), writes the KV rows of the batch, and does NOT
// change the live convolution histories: they stay as they were before the call. `commitVerified(accepted)` then makes the state that of the first `accepted` rows
// (accepted = 0 keeps the old state; the KV rows beyond the accepted prefix are simply overwritten by later steps).
fun InklingModel.verify(var backend: Backend, ws: PrefillWorkspace, ids: array<int>, startPos: int): bool {
    prefillError = ""
    if (ws.verifyRows < 1 || ids.size < 1 || ids.size > ws.verifyRows || ids.size > ws.chunk || !ws.allLogits) {
        prefillError = "verify needs a workspace with allLogits and verifyRows >= the number of rows (1 .. ${ws.verifyRows}, got ${ids.size})"
        return false
    }
    if (!this.canRestoreKv(startPos, startPos + ids.size)) {
        prefillError = "this batch would evict uncommitted KV; pass its maximum row count to inklingLoad"
        return false
    }
    prefillVerifyRows = ids.size
    if (!this.uploadChunk(backend, ws, ids, 0, ids.size, startPos)) {
        prefillError = "uploading the verification rows failed"
        prefillVerifyRows = 0
        return false
    }
    val ok = this.prefillChunk(backend, ws, ids.size, startPos, true, ws.buffer, ws.o("tokenIds"), ws.buffer, ws.o("ctl"))
    prefillVerifyRows = 0
    ok
}

// Makes the first `accepted` rows of the last `verify` the model's state (the convolution histories after row `accepted`).
fun InklingModel.commitVerified(var backend: Backend, ws: PrefillWorkspace, accepted: int): bool {
    if (accepted < 0 || accepted > ws.verifyRows) {
        prefillError = "commitVerified: $accepted rows were not verified"
        return false
    }
    if (accepted == 0) return true
    val floats = ws.historyBytes / 4
    backend.launch("copy_f32", kernelArgs().pointer(ws.snapshots, (accepted - 1) * ws.historyBytes).pointer(this.history).u32(floats), [floats])
}

// The argmax (lowest index on ties) of the logits of rows 0 .. rows - 1 of the last `verify`.
trusted fun InklingModel.verifyArgmax(var backend: Backend, ws: PrefillWorkspace, rows: int): array<int>? {
    val out = backend.allocate(rows * 4 + 16)
    if (out == null) {
        prefillError = "device memory for the argmax results is not available"
        return null
    }
    for (row in 0 until rows) {
        if (!backend.launch("argmax", kernelArgs().pointer(ws.buffer, ws.o("logits") + row * this.config.nVocabPadded * 4).u32(this.config.nVocab).pointer(out, row * 4), [1])) {
            prefillError = "argmax failed"
            return null
        }
    }
    val host = nativeByteBuffer(rows * 4 + 8)
    if (!backend.download(out, 0, nativePointerAddress(host.address), rows * 4)) {
        prefillError = "downloading the argmax results failed"
        host.close()
        return null
    }
    val address = nativePointerAddress(host.address)
    val result: array<int> = []
    for (row in 0 until rows) result.append(ablaUnsafeLoadU32(nativePointerFromAddress(address + 4 * row)))
    host.close()
    result
}

// ---- the graph-static forms for the speculative cycle (docs/spec-cycle.md): nothing is read from kernel parameters that changes from cycle to cycle ----
// `spec` words: [0..2] the rows' token ids (anchor, proposal 1, proposal 2), [3] padding, [4..6] the argmax of rows 0..2 (written here); `step` words: [1] = P, the position
// of row 0 (rows are P, P+1, P+2), [3] = the accepted proposals of the cycle, read by `commitStep`. Always 3 rows (padding rows run and are ignored). Only launches: it
// can be recorded.
// `rows` (1 .. ws.verifyRows) rows with ids spec[0 .. rows - 1]. `layout` 1: the argmax of row r goes to spec[4 + r] (docs/spec-cycle.md); layout 2 (spec = u32[16], up to 5 rows):
// to spec[8 + r]. Rows beyond 3 use the tile kernels where the R-row matvecs do not reach yet.
fun InklingModel.verifyStep(var backend: Backend, ws: PrefillWorkspace, spec: DeviceBuffer, step: DeviceBuffer, rows: int = 3, layout: int = 1): bool {
    prefillError = ""
    if (rows < 1 || ws.verifyRows < rows || ws.chunk < rows || !ws.allLogits || (layout != 1 && layout != 2) || (layout == 1 && rows > 3) || (layout == 2 && rows > 5)) {
        prefillError = "verifyStep needs a workspace with allLogits, chunk >= rows and verifyRows >= rows (layout 1: at most 3 rows, layout 2: at most 5)"
        return false
    }
    prefillVerifyRows = rows
    var ok = this.prefillChunk(backend, ws, rows, -1, true, spec, 0, step, 4)
    prefillVerifyRows = 0
    val argmaxAt = if (layout == 2) 8 else 4
    for (row in 0 until rows) {
        ok = ok && backend.launch("argmax", kernelArgs().pointer(ws.buffer, ws.o("logits") + row * this.config.nVocabPadded * 4).u32(this.config.nVocab)
            .pointer(spec, (argmaxAt + row) * 4), [1])
    }
    ok
}

// history := the snapshot after row step[3] (0-based: the last committed row, i.e. a + 1 rows committed when a proposals were accepted).
fun InklingModel.commitStep(var backend: Backend, ws: PrefillWorkspace, step: DeviceBuffer): bool {
    val floats = ws.historyBytes / 4
    backend.launch("commit_select", kernelArgs().pointer(ws.snapshots).pointer(this.history).pointer(step, 12).u32(floats).u32(ws.verifyRows - 1), [floats])
}
