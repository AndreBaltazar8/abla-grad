import "unicode.ab"
import "abla/text"

// These are the supported GGUF and tokenizer.json pre-tokenizer variants.
val BPE_PRE_LLAMA3 = 1
val BPE_PRE_INKLING = 2

// Decodes each scalar once and records byte positions. Invalid UTF-8 bytes
// stay individually encodable so arbitrary input bytes round-trip.
class BpeRunes(val scalars: array<int>, val flags: array<int>, val offsets: array<int>)

fun bpeRunes(text: string, start: int, end: int): BpeRunes {
    val scalars: array<int> = []
    val flags: array<int> = []
    val offsets: array<int> = []
    var offset = start
    while (offset < end) {
        var width = utf8SequenceLength(text[offset])
        var scalar = -1
        if (width > 0 && width <= end - offset) scalar = utf8DecodeAt(text, offset)
        if (scalar < 0) width = 1
        offsets.append(offset)
        scalars.append(scalar)
        flags.append(bpeUnicodeFlags(scalar))
        offset += width
    }
    offsets.append(end)
    BpeRunes(scalars, flags, offsets)
}

private fun bpeAsciiLower(value: int): int =
    if (value >= 65 && value <= 90) value + 32 else value

private fun BpeRunes.contraction(at: int): int {
    if (at + 1 >= this.scalars.size || this.scalars[at] != 39) return at
    val first = bpeAsciiLower(this.scalars[at + 1])
    if (first == 115 || first == 116 || first == 109 || first == 100) return at + 2
    if (at + 2 >= this.scalars.size) return at
    val second = bpeAsciiLower(this.scalars[at + 2])
    if (((first == 114 || first == 118) && second == 101) || (first == 108 && second == 108))
        return at + 3
    at
}

private fun BpeRunes.prefixAllowed(at: int): bool =
    this.scalars[at] != 10 && this.scalars[at] != 13 && (this.flags[at] & 3) == 0

private fun BpeRunes.wordRun(at: int, mask: int): int {
    var end = at
    while (end < this.flags.size && (this.flags[end] & mask) != 0) end += 1
    end
}

private fun BpeRunes.inklingLetters(at: int, upperFirst: bool): int {
    val uppers = this.wordRun(at, 8)
    if (upperFirst) {
        if (uppers == at) return at
        return this.wordRun(uppers, 16)
    }
    // U* L+, with L+ required. Backtrack only as far as needed for its
    // first element when a scalar belongs to both classes.
    var split = uppers
    while (split >= at) {
        if (split < this.flags.size && (this.flags[split] & 16) != 0)
            return this.wordRun(split, 16)
        split -= 1
    }
    at
}

private fun BpeRunes.inklingWord(at: int): int {
    for (branch in [false, true]) {
        if (this.prefixAllowed(at)) {
            val prefixed = this.inklingLetters(at + 1, branch)
            if (prefixed > at + 1) return this.contraction(prefixed)
        }
        val bare = this.inklingLetters(at, branch)
        if (bare > at) return this.contraction(bare)
    }
    at
}

// Returns the end of the next pre-tokenizer segment, in scalar indices.
fun BpeRunes.pieceEnd(at: int, variant: int): int {
    val count = this.scalars.size
    if (variant == BPE_PRE_INKLING) {
        val word = this.inklingWord(at)
        if (word > at) return word
    } else {
        val contraction = this.contraction(at)
        if (contraction > at) return contraction
        val prefix = if (this.prefixAllowed(at)) at + 1 else at
        val word = this.wordRun(prefix, 2)
        if (word > prefix) return word
    }

    if ((this.flags[at] & 1) != 0) {
        var end = at + 1
        while (end < count && end - at < 3 && (this.flags[end] & 1) != 0) end += 1
        return end
    }

    val punct = if (this.scalars[at] == 32) at + 1 else at
    var end = punct
    while (end < count && (this.flags[end] & 35) == 0) end += 1
    if (end > punct) {
        while (end < count && (this.scalars[end] == 10 || this.scalars[end] == 13 ||
            (variant == BPE_PRE_INKLING && this.scalars[end] == 47))) end += 1
        return end
    }

    end = at
    var lastLine = at
    while (end < count && (this.flags[end] & 32) != 0) {
        if (this.scalars[end] == 10 || this.scalars[end] == 13) lastLine = end + 1
        end += 1
    }
    if (lastLine > at) return lastLine
    if (end == at) return at + 1
    if (end < count && end - at > 1) return end - 1
    end
}
