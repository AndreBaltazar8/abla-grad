// Returns flags: number 1, letter 2, mark 4, upper 8, lower 16, whitespace 32.
fun bpeUnicodeFlags(scalar: int): int {
    if (scalar < 0 || scalar > 0x10ffff) return 0
    var lo = 0
    var hi = bpeUnicodeRanges.size
    while (hi - lo > 1) {
        val mid = (lo + hi) / 2
        if (bpeUnicodeRanges[mid] >> 6 <= scalar) lo = mid
        else hi = mid
    }
    bpeUnicodeRanges[lo] & 63
}
